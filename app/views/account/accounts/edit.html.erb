<% content_for :title, "Editar Conta da Empresa" %>

<div class="max-w-4xl mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold mb-6 text-gray-800">Editar Conta da Empresa</h1>

  <%= form_with model: @account, url: account_account_path, method: :patch, local: true, class: "space-y-6" do |f| %>
    <div>
      <%= f.label :name, "Nome da Empresa", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500 sm:text-sm" %>
    </div>

    <div>
      <%= f.label :nif, "NIF", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :nif, value: @account.nif, readonly: true, class: "mt-1 block w-full bg-gray-100 rounded-md border-gray-300 shadow-sm sm:text-sm" %>
    </div>

    <div>
      <%= f.label :farm_type, "Tipo de Produção", class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :farm_type, [['Agricultura', 'agriculture'], ['Aquacultura (Tanque)', 'aquaculture_tank'], ['Aquacultura (Marinha)', 'aquaculture_sea']],
            {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500 sm:text-sm" %>
    </div>

    <div class="flex justify-between items-center">
      <%= link_to "← Voltar", dashboard_path, class: "text-sm text-gray-500 hover:underline" %>
      <%= f.submit "💾 Guardar Alterações", class: "px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700 transition" %>
    </div>
  <% end %>
</div>
