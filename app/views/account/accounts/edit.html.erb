<% content_for :title, "Editar Conta da Empresa" %>

<div class="max-w-4xl mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold mb-6 text-gray-800">✏️ Editar Conta</h1>

  <%= form_with(model: [:admin, @account], local: true, class: "space-y-6") do |form| %>
    <div>
      <%= form.label :name, "Nome da Empresa", class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
    </div>

    <div>
      <%= form.label :nif, "NIF", class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :nif, value: @account.nif, readonly: true, class: "mt-1 block w-full bg-gray-100 text-gray-500 rounded-md border-gray-300 shadow-sm sm:text-sm" %>
    </div>

    <div>
      <%= form.label :farm_type, "Tipo de Produção", class: "block text-sm font-medium text-gray-700" %>
      <%= form.select :farm_type, [["Agricultura", "agriculture"], ["Aquacultura (Marinha)", "aquaculture_sea"], ["Aquacultura (Tanque)", "aquaculture_tank"]],
            {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
    </div>

    <div class="flex justify-between items-center pt-4">
      <%= link_to "← Voltar", admin_accounts_path, class: "text-sm text-gray-600 hover:underline" %>
      <%= form.submit "💾 Guardar Alterações", class: "px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition" %>
    </div>
  <% end %>
</div>
