<%# app/views/users/edit.html.erb %>
<% content_for :title, t("users.edit.title", default: "Editar Utilizador") %>

<div class="max-w-4xl mx-auto mt-8">
  <%# Flash messages %>
  <% if flash[:notice].present? %>
    <div class="mb-4 px-4 py-3 bg-green-50 text-green-800 rounded-lg border border-green-200">
      ✅ <%= flash[:notice] %>
    </div>
  <% elsif flash[:alert].present? %>
    <div class="mb-4 px-4 py-3 bg-rose-50 text-rose-700 rounded-lg border border-rose-200">
      ⚠️ <%= flash[:alert] %>
    </div>
  <% end %>

  <div class="bg-white shadow-sm rounded-xl p-6 border">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 flex items-center gap-2">
        <i class="lucide lucide-user h-6 w-6 text-emerald-600" aria-hidden="true"></i>
        <%= t("users.edit.title", default: "Editar Utilizador") %>
      </h1>

      <%= link_to t("profile.actions.back", default: "Voltar"),
                  (defined?(admin_accounts_path) ? admin_accounts_path : (request.referer || root_path)),
                  class: "text-sm text-slate-600 hover:text-emerald-600 underline" %>
    </div>

    <% if @user.errors.any? %>
      <div class="mb-5 rounded-lg border border-rose-200 bg-rose-50 p-4 text-rose-700">
        <p class="font-semibold mb-2"><%= t("users.new.errors_title", default: "Erros ao guardar:") %></p>
        <ul class="list-disc list-inside text-sm">
          <% @user.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with(model: @user, local: true, html: { multipart: true }, class: "space-y-8") do |f| %>
      <!-- Dados Pessoais -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <%= f.label :name, t("users.forms.shared.name", default: "Nome"),
                      class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.text_field :name,
                class: "w-full px-4 py-2 border border-slate-300 rounded-md shadow-sm focus:ring focus:ring-emerald-200 focus:border-emerald-500",
                required: true, autocomplete: "name" %>
        </div>

        <div>
          <%= f.label :email, t("users.forms.shared.email", default: "Email"),
                      class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.email_field :email,
                class: "w-full px-4 py-2 border border-slate-300 rounded-md shadow-sm focus:ring focus:ring-emerald-200 focus:border-emerald-500",
                required: true, autocomplete: "email" %>
        </div>

        <div>
          <%= f.label :role, t("users.forms.shared.role", default: "Função"),
                      class: "block text-sm font-medium text-slate-700 mb-1" %>
          <% role_options = User.roles.keys.map { |r|
               label = t("admin.users.roles.#{r}", default: r.humanize)
               [label, r]
             } %>
          <%= f.select :role, role_options, {},
                class: "w-full px-4 py-2 border border-slate-300 rounded-md shadow-sm focus:ring focus:ring-emerald-200 focus:border-emerald-500" %>
        </div>

        <%# Só mostra o selector se existir a coluna/atributo :status %>
        <% if @user.respond_to?(:status) %>
          <div>
            <%= f.label :status, t("profile.status", default: "Estado"),
                        class: "block text-sm font-medium text-slate-700 mb-1" %>
            <%= f.select :status,
                  [[t("users.status.active", default: "Ativo"), "active"],
                   [t("users.status.inactive", default: "Inativo"), "inactive"]],
                  {},
                  class: "w-full px-4 py-2 border border-slate-300 rounded-md shadow-sm focus:ring focus:ring-emerald-200 focus:border-emerald-500" %>
          </div>
        <% end %>
      </div>

      <!-- Atualizar Palavra-passe -->
      <div>
        <h2 class="text-lg font-semibold text-slate-700 mb-4 border-b pb-1">
          <%= t("settings.security.change_password", default: "Alterar Palavra-passe") %>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <%= f.label :password, t("team.users.forms.shared.password", default: "Nova Password"),
                        class: "block text-sm font-medium text-slate-700 mb-1" %>
            <%= f.password_field :password,
                  class: "w-full px-4 py-2 border border-slate-300 rounded-md shadow-sm focus:ring focus:ring-emerald-200 focus:border-emerald-500",
                  autocomplete: "new-password" %>
            <p class="text-xs text-slate-500 italic">
              <%= t("team.users.forms.shared.password_placeholder", default: "Deixa em branco para manter a atual") %>.
            </p>
          </div>

          <div>
            <%= f.label :password_confirmation, t("users.forms.shared.password_confirmation", default: "Confirmar Password"),
                        class: "block text-sm font-medium text-slate-700 mb-1" %>
            <%= f.password_field :password_confirmation,
                  class: "w-full px-4 py-2 border border-slate-300 rounded-md shadow-sm focus:ring focus:ring-emerald-200 focus:border-emerald-500",
                  autocomplete: "new-password" %>
          </div>
        </div>
      </div>

      <!-- Foto de Perfil -->
      <div>
        <h2 class="text-lg font-semibold text-slate-700 mb-4 border-b pb-1">
          <%= t("users.forms.shared.photo", default: "Foto de Perfil") %>
        </h2>
        <div class="flex items-center gap-4">
          <%# Fallback seguro caso não exista foto configurada %>
          <%= image_tag(
                (@user.try(:photo)&.respond_to?(:url) && @user.photo.present?) ? @user.photo.url : image_path("placeholder-user.png"),
                class: "w-16 h-16 rounded-full object-cover border border-slate-300",
                alt: t("users.forms.shared.photo", default: "Foto de Perfil")
              ) %>

          <%= f.file_field :photo,
                class: "text-sm text-slate-700 file:mr-3 file:py-2 file:px-3 file:rounded-md file:border-0 file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100" %>
        </div>
      </div>

      <!-- Ações -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pt-4 border-t">
        <%= link_to t("profile.actions.back", default: "Voltar"),
                    (defined?(admin_accounts_path) ? admin_accounts_path : (request.referer || root_path)),
                    class: "inline-flex items-center justify-center px-4 py-2 rounded-md border border-slate-300 text-slate-700 hover:bg-slate-50" %>

        <%= f.submit t("team.users.edit.submit", default: "Guardar Alterações"),
                     class: "inline-flex items-center justify-center px-4 py-2 rounded-md bg-emerald-600 text-white hover:bg-emerald-700 shadow-sm" %>
      </div>
    <% end %>
  </div>
</div>
