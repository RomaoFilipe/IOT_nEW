<% content_for :title, "Painel de Administração" %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-4xl font-bold text-gray-900">👤 Utilizadores</h1>
      <p class="text-sm text-gray-500 mt-1">Gerir contas de utilizadores registados na plataforma.</p>
    </div>
    <%= link_to new_user_path, class: "inline-flex items-center px-4 py-2 bg-indigo-600 text-white text-sm font-semibold rounded hover:bg-indigo-700 shadow" do %>
      <i class="bi bi-person-plus-fill mr-2"></i> Novo Utilizador
    <% end %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @users.each do |user| %>
      <div class="relative bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md transition-all">
        <div class="flex items-center justify-between mb-2">
          <h3 class="text-xl font-semibold text-gray-800"><%= user.name %></h3>
          <span class="text-sm text-gray-400"><%= user.role.capitalize %></span>
        </div>

        <p class="text-sm text-gray-600 truncate"><i class="bi bi-envelope-fill mr-1"></i> <%= user.email %></p>
        <p class="text-xs text-gray-500 mt-1"><i class="bi bi-calendar3 mr-1"></i> Criado em <%= user.created_at.strftime("%d/%m/%Y") %></p>

        <% if user.admin? %>
          <span class="mt-4 inline-block text-xs font-semibold bg-red-100 text-red-700 px-3 py-1 rounded-full">Administrador</span>
        <% elsif user.manager? %>
          <span class="mt-4 inline-block text-xs font-semibold bg-yellow-100 text-yellow-800 px-3 py-1 rounded-full">Gestor</span>
        <% else %>
          <span class="mt-4 inline-block text-xs font-semibold bg-gray-100 text-gray-800 px-3 py-1 rounded-full">Utilizador</span>
        <% end %>

        <div class="flex flex-wrap mt-4 gap-2">
          <%= link_to edit_user_path(user), class: "inline-flex items-center px-3 py-1.5 text-xs bg-blue-100 text-blue-700 rounded hover:bg-blue-200" do %>
            <i class="bi bi-pencil-fill mr-1"></i> Editar
          <% end %>

          <%= link_to user_path(user), method: :delete, data: { confirm: "Tens a certeza que queres eliminar este utilizador?" }, class: "inline-flex items-center px-3 py-1.5 text-xs bg-red-100 text-red-700 rounded hover:bg-red-200" do %>
            <i class="bi bi-trash-fill mr-1"></i> Eliminar
          <% end %>

          <% if policy(user).entrar_como? && user != current_user %>
            <%= link_to entrar_como_user_path(user), method: :post, class: "inline-flex items-center px-3 py-1.5 text-xs bg-green-100 text-green-700 rounded hover:bg-green-200" do %>
              <i class="bi bi-person-check-fill mr-1"></i> Entrar como
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
