<% content_for :title, t("users.dashboard.title") %>

<style>
  input[type="text"]::placeholder {
    color: #9ca3af;
  }
  .transition {
    transition: all 0.3s ease-in-out;
  }
</style>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

  <% if session[:admin_user_id].present? %>
    <div class="mb-6 rounded-lg border border-yellow-300 bg-yellow-50 p-4 flex justify-between items-center shadow-sm">
      <div class="flex items-center text-sm text-yellow-800">
        <i class="bi bi-person-check-fill text-xl mr-2"></i>
        <%= t("users.dashboard.simulating_as") %> <strong class="mx-1"><%= current_user.name %></strong>
      </div>
      <%= button_to t("users.dashboard.return_to_admin"), retornar_como_admin_users_path, method: :post, class: "inline-flex items-center gap-2 px-3 py-1.5 bg-yellow-500 text-white text-sm font-semibold rounded hover:bg-yellow-600 transition" do %>
        <i class="bi bi-arrow-return-left"></i> <%= t("users.dashboard.back") %>
      <% end %>
    </div>
  <% end %>

  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8 gap-4">
    <div class="w-full sm:w-auto">
      <h1 class="text-4xl font-extrabold text-gray-900 tracking-tight">👤 <%= t("users.dashboard.users") %></h1>
      <p class="mt-1 text-sm text-gray-500"><%= t("users.dashboard.description") %></p>
    </div>
    <div class="w-full sm:w-auto flex flex-col sm:flex-row items-stretch gap-2">
      <input
        type="text"
        placeholder="<%= t("users.dashboard.search_placeholder") %>"
        class="w-full sm:w-64 px-4 py-2 rounded-lg border border-gray-300 focus:ring-indigo-300 focus:border-indigo-400 focus:outline-none text-sm"
        oninput="filtrarUtilizadores(this.value)"
        autocomplete="off"
      />
      <%= link_to new_user_path, class: "inline-flex justify-center items-center gap-2 px-4 py-2 bg-indigo-600 text-white text-sm font-semibold rounded-lg hover:bg-indigo-700 shadow transition" do %>
        <i class="bi bi-person-plus-fill"></i>
        <%= t("users.dashboard.new_user") %>
      <% end %>
    </div>
  </div>

  <div class="mb-6">
    <%= link_to home_path, class: "inline-flex items-center gap-2 text-sm px-4 py-2 bg-white border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-100 shadow-sm transition" do %>
      <i class="bi bi-house-door-fill text-lg"></i>
      <span><%= t("users.dashboard.back_to_home") %></span>
    <% end %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
    <% @users.each do |user| %>
      <div class="bg-white rounded-2xl shadow border border-gray-200 p-6 hover:shadow-lg transition" data-user-card data-user-name="<%= user.name %>" data-user-email="<%= user.email %>">
        <div class="flex items-center justify-between mb-3">
          <h2 class="text-lg font-semibold text-gray-900 truncate"><%= user.name %></h2>
          <span class="text-xs font-medium text-gray-400 capitalize"><%= user.role %></span>
        </div>

        <p class="text-sm text-gray-600 break-words"><i class="bi bi-envelope-fill mr-1"></i> <%= user.email %></p>
        <p class="text-xs text-gray-500 mt-1"><i class="bi bi-calendar3 mr-1"></i> <%= t("users.dashboard.created_at") %> <%= user.created_at.strftime("%d/%m/%Y") %></p>

        <% if user.admin? %>
          <span class="mt-4 inline-block text-xs font-semibold bg-red-100 text-red-700 px-3 py-1 rounded-full"><%= t("users.roles.admin") %></span>
        <% elsif user.manager? %>
          <span class="mt-4 inline-block text-xs font-semibold bg-yellow-100 text-yellow-800 px-3 py-1 rounded-full"><%= t("users.roles.manager") %></span>
        <% else %>
          <span class="mt-4 inline-block text-xs font-semibold bg-gray-100 text-gray-800 px-3 py-1 rounded-full"><%= t("users.roles.user") %></span>
        <% end %>

        <div class="flex flex-wrap mt-5 gap-2">
          <%= link_to edit_user_path(user), class: "inline-flex items-center px-3 py-1.5 text-xs font-medium bg-blue-100 text-blue-700 rounded hover:bg-blue-200 transition" do %>
            <i class="bi bi-pencil-fill mr-1"></i> <%= t("actions.edit") %>
          <% end %>

          <%= link_to user_path(user), method: :delete, data: { confirm: t("users.dashboard.confirm_delete") }, class: "inline-flex items-center px-3 py-1.5 text-xs font-medium bg-red-100 text-red-700 rounded hover:bg-red-200 transition" do %>
            <i class="bi bi-trash-fill mr-1"></i> <%= t("actions.delete") %>
          <% end %>

          <% if policy(user).entrar_como? && user != current_user %>
            <%= link_to entrar_como_user_path(user), method: :post, class: "inline-flex items-center px-3 py-1.5 text-xs font-medium bg-green-100 text-green-700 rounded hover:bg-green-200 transition" do %>
              <i class="bi bi-person-check-fill mr-1"></i> <%= t("users.dashboard.login_as") %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<script>
  function filtrarUtilizadores(termo) {
    const cards = document.querySelectorAll('[data-user-card]');
    termo = termo.toLowerCase();

    cards.forEach(card => {
      const nome = card.getAttribute('data-user-name').toLowerCase();
      const email = card.getAttribute('data-user-email').toLowerCase();

      if (nome.includes(termo) || email.includes(termo)) {
        card.style.display = 'block';
      } else {
        card.style.display = 'none';
      }
    });
  }
</script>

<!-- Tailwind CSS e Bootstrap Icons -->
<script src="https://cdn.tailwindcss.com"></script>
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
