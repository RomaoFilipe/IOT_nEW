<%# app/views/team/users/index.html.erb %>

<div class="max-w-7xl mx-auto px-6 py-8 space-y-8">

  <!-- 🔧 Informações da Empresa -->
  <div class="bg-white shadow-lg rounded-2xl p-6 border border-slate-200">
    <div class="flex items-center justify-between mb-5">
      <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2">
        <i class="lucide lucide-building-2 w-5 h-5 text-blue-600"></i>
        Editar Conta da Empresa
      </h2>
      <%= link_to "← Voltar", team_users_path, class: "text-sm text-slate-600 hover:underline" %>
    </div>

    <%= form_with model: @account, url: update_account_team_users_path, method: :patch, local: true, class: "space-y-4" do |f| %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Nome da Empresa -->
        <div>
          <%= f.label :name, "Nome da Empresa", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.text_field :name, class: "w-full rounded-lg border-slate-300 shadow-sm px-4 py-2 text-sm focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <!-- NIF (não editável) -->
        <div>
          <%= f.label :nif, "NIF", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.text_field :nif, value: @account.nif, disabled: true,
                class: "w-full bg-slate-100 text-slate-600 border border-slate-300 rounded-lg px-4 py-2 text-sm cursor-not-allowed" %>
        </div>

        <!-- Tipo de Produção -->
        <div class="md:col-span-2">
          <%= f.label :farm_type, "Tipo de Produção", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.select :farm_type,
                Account.farm_types.keys.map { |type| [type.humanize.capitalize, type] },
                {},
                disabled: @account.fields.exists?,
                class: "w-full rounded-lg border-slate-300 shadow-sm px-4 py-2 text-sm focus:ring-blue-500 focus:border-blue-500" %>

          <% if @account.fields.exists? %>
            <p class="text-xs text-rose-600 mt-1">⚠ Não é possível alterar o tipo de produção com campos existentes.</p>
          <% end %>
        </div>
      </div>

      <!-- Ações -->
      <div class="flex items-center justify-end gap-3 pt-4">
        <%= link_to "Cancelar", team_users_path, class: "text-sm text-slate-600 hover:underline" %>
        <%= f.submit "💾 Guardar Alterações", class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold px-5 py-2 rounded-md text-sm transition shadow-sm" %>
      </div>
    <% end %>
  </div>

  <!-- 👥 Equipa da Empresa -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div>
      <h2 class="text-2xl font-bold text-slate-900 flex items-center gap-2">
        <i class="lucide lucide-users w-5 h-5 text-emerald-600"></i>
        Equipa da Empresa
      </h2>
      <p class="text-sm text-slate-500 mt-1">Utilizadores nesta conta: <span class="font-medium"><%= @users.size %></span></p>
    </div>

    <%= link_to "➕ Adicionar Utilizador", new_team_user_path,
      class: "inline-flex items-center justify-center bg-emerald-600 text-white px-5 py-2 rounded-md font-semibold hover:bg-emerald-700 transition text-sm shadow-sm" %>
  </div>

  <% if @users.any? %>
    <div class="grid gap-6 sm:grid-cols-1 md:grid-cols-2 xl:grid-cols-3">
      <% @users.each do |user| %>
        <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-5 flex flex-col justify-between h-full">
          <!-- Perfil -->
          <div class="flex items-start gap-4">
            <% if user.photo.present? %>
              <img src="<%= user.photo.url %>" class="w-14 h-14 rounded-full object-cover border border-slate-200" alt="<%= user.name %>">
            <% else %>
              <div class="w-14 h-14 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 text-base font-semibold border border-slate-200">
                <%= user.name.to_s.strip.first(2).upcase.presence || "US" %>
              </div>
            <% end %>

            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-slate-900 truncate">
                <%= user.name %>
                <% if user == current_user %>
                  <span class="ml-2 text-xs italic text-slate-400">(Tu)</span>
                <% end %>
              </p>
              <p class="text-sm text-slate-600 truncate"><%= user.email %></p>

              <% badge_class =
                   case user.role
                   when "admin"      then "bg-amber-100 text-amber-800"
                   when "manager"    then "bg-emerald-100 text-emerald-700"
                   when "technician" then "bg-indigo-100 text-indigo-700"
                   when "viewer"     then "bg-slate-100 text-slate-700"
                   when "owner"      then "bg-yellow-100 text-yellow-800"
                   else "bg-rose-100 text-rose-700"
                   end %>

              <span class="inline-block mt-1 text-[11px] px-2.5 py-1 rounded-full font-semibold <%= badge_class %>">
                <%= user.role.to_s.capitalize %>
              </span>

              <div class="mt-2 text-xs text-slate-500 flex flex-wrap gap-x-4 gap-y-1">
                <span class="flex items-center gap-1">
                  <i class="lucide lucide-clock w-3.5 h-3.5"></i>
                  Último acesso:
                  <%= user.last_sign_in_at ? time_ago_in_words(user.last_sign_in_at) : "Nunca" %>
                </span>
                <span class="flex items-center gap-1">
                  <i class="lucide lucide-hash w-3.5 h-3.5"></i>
                  Logins: <%= user.sign_in_count || 0 %>
                </span>
              </div>
            </div>
          </div>

          <!-- Botões -->
          <div class="mt-4 flex flex-wrap gap-2">
            <%= link_to "✏️ Editar", edit_team_user_path(user),
              class: "flex-1 text-center px-3 py-2 text-sm border border-slate-300 text-slate-700 rounded-md hover:bg-slate-50 transition" %>

            <% unless user == current_user %>
              <%= button_to "🗑 Apagar", team_user_path(user), method: :delete,
                data: { confirm: "Tens a certeza que queres apagar este utilizador?" },
                class: "flex-1 text-center px-3 py-2 text-sm border border-rose-600 text-rose-600 rounded-md hover:bg-rose-50 transition" %>

              <%# Hierarquia para simular %>
              <% can_impersonate =
                   case current_user.role
                   when "admin"   then true
                   when "manager" then !user.admin? && !user.owner?
                   else false
                   end %>

              <% if can_impersonate %>
                <%= button_to "👀 Simular", impersonate_team_user_path(user), method: :post,
                  class: "flex-1 text-center px-3 py-2 text-sm border border-blue-600 text-blue-600 rounded-md hover:bg-blue-50 transition" %>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-10 text-center">
      <div class="mx-auto w-12 h-12 rounded-full bg-slate-100 flex items-center justify-center mb-3">
        <i class="lucide lucide-user-round-plus w-6 h-6 text-slate-500"></i>
      </div>
      <h3 class="text-lg font-semibold text-slate-900">Ainda não existem utilizadores</h3>
      <p class="text-sm text-slate-500 mt-1">Adiciona membros da equipa para colaborarem na tua conta.</p>
      <div class="mt-4">
        <%= link_to "➕ Adicionar Utilizador", new_team_user_path,
          class: "inline-flex items-center justify-center bg-emerald-600 text-white px-4 py-2 rounded-md text-sm font-semibold hover:bg-emerald-700 transition shadow-sm" %>
      </div>
    </div>
  <% end %>

</div>

<!-- Icons -->
<script src="https://unpkg.com/lucide@latest"></script>
<script>lucide.createIcons();</script>
