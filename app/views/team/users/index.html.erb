
<div class="max-w-7xl mx-auto px-6 py-8 space-y-8">
<!-- 🔧 Informações da Empresa -->
  <div class="mb-10 bg-white shadow-lg rounded-2xl p-6">
    <h2 class="text-xl font-bold text-gray-900 mb-5 flex items-center gap-2">
      <i class="lucide lucide-building-2 w-5 h-5 text-blue-600"></i>
      Editar Conta da Empresa
    </h2>

    <%= form_with model: @account, url: update_account_team_users_path, method: :patch, local: true do |f| %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Nome da Empresa -->
        <div>
          <%= f.label :name, "Nome da Empresa", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :name, class: "w-full rounded-lg border-gray-300 shadow-sm px-4 py-2 text-sm focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <!-- NIF (não editável) -->
        <div>
          <%= f.label :nif, "NIF", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :nif, value: @account.nif, disabled: true,
                class: "w-full bg-gray-100 text-gray-600 border border-gray-300 rounded-lg px-4 py-2 text-sm cursor-not-allowed" %>
        </div>

        <!-- Tipo de Produção -->
        <div class="md:col-span-2">
          <%= f.label :farm_type, "Tipo de Produção", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :farm_type,
                Account.farm_types.keys.map { |type| [type.humanize.capitalize, type] },
                {}, disabled: @account.fields.exists?,
                class: "w-full rounded-lg border-gray-300 shadow-sm px-4 py-2 text-sm focus:ring-blue-500 focus:border-blue-500" %>

          <% if @account.fields.exists? %>
            <p class="text-xs text-red-500 mt-1">⚠ Não é possível alterar o tipo de produção com campos existentes.</p>
          <% end %>
        </div>
      </div>

      <!-- Ações -->
      <div class="flex justify-between items-center pt-6">
        <%= link_to "← Voltar", team_users_path, class: "text-sm text-gray-600 hover:underline" %>
        <%= f.submit "💾 Guardar Alterações", class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold px-5 py-2 rounded-md text-sm transition shadow-sm" %>
      </div>
    <% end %>
  </div>


  <!-- Team -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div>
      <h2 class="text-2xl font-bold text-slate-900 flex items-center gap-2">
        <i class="lucide lucide-users w-5 h-5 text-emerald-600"></i>
        <%= t("team.users.index.title", default: "Company Team") %>
      </h2>
      <p class="text-sm text-slate-500 mt-1">
        <%= t("team.users.index.count", default: "Users in this account:") %>
        <span class="font-medium"><%= @users.size %></span>
      </p>
    </div>

    <%= link_to t("team.users.index.add", default: "Add User"), new_team_user_path,
      class: "inline-flex items-center justify-center bg-emerald-600 text-white px-5 py-2 rounded-md font-semibold hover:bg-emerald-700 transition text-sm shadow-sm" %>
  </div>

  <% if @users.any? %>
    <div class="grid gap-6 sm:grid-cols-1 md:grid-cols-2 xl:grid-cols-3">
      <% @users.each do |user| %>
        <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-5 flex flex-col justify-between h-full">
          <div class="flex items-start gap-4">
            <% if user.respond_to?(:photo) && user.photo.present? %>
              <img src="<%= user.photo.url %>" class="w-14 h-14 rounded-full object-cover border border-slate-200" alt="<%= user.name %>">
            <% else %>
              <div class="w-14 h-14 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 text-base font-semibold border border-slate-200">
                <%= user.name.to_s.strip.first(2).upcase.presence || "US" %>
              </div>
            <% end %>

            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-slate-900 truncate">
                <%= user.name %>
                <% if user == current_user %>
                  <span class="ml-2 text-xs italic text-slate-400">(<%= t("team.users.index.you", default: "You") %>)</span>
                <% end %>
              </p>
              <p class="text-sm text-slate-600 truncate"><%= user.email %></p>

              <% badge_class =
                   case user.role.to_s
                   when "owner"      then "bg-yellow-100 text-yellow-800"
                   when "admin"      then "bg-amber-100 text-amber-800"
                   when "manager"    then "bg-emerald-100 text-emerald-700"
                   when "technician" then "bg-indigo-100 text-indigo-700"
                   else "bg-slate-100 text-slate-700"
                   end %>

              <span class="inline-block mt-1 text-[11px] px-2.5 py-1 rounded-full font-semibold <%= badge_class %>">
                <%= user.role.to_s.capitalize %>
              </span>

              <div class="mt-2 text-xs text-slate-500 flex flex-wrap gap-x-4 gap-y-1">
                <span class="flex items-center gap-1">
                  <i class="lucide lucide-clock w-3.5 h-3.5"></i>
                  <%= t("team.users.index.last_login", default: "Last login") %>:
                  <%= user.last_sign_in_at ? time_ago_in_words(user.last_sign_in_at) : t("common.never", default: "Never") %>
                </span>
                <span class="flex items-center gap-1">
                  <i class="lucide lucide-hash w-3.5 h-3.5"></i>
                  <%= t("team.users.index.total_logins", default: "Logins") %>: <%= user.sign_in_count || 0 %>
                </span>
              </div>
            </div>
          </div>

          <div class="mt-4 flex flex-wrap gap-2">
            <%= link_to "✏️ " + t("common.edit", default: "Edit"), edit_team_user_path(user),
              class: "flex-1 text-center px-3 py-2 text-sm border border-slate-300 text-slate-700 rounded-md hover:bg-slate-50 transition" %>

            <% unless user == current_user %>
              <%= button_to "🗑 " + t("common.delete", default: "Delete"), team_user_path(user), method: :delete,
                data: { turbo_confirm: t("team.users.index.confirm_delete", default: "Are you sure you want to delete this user?") },
                class: "flex-1 text-center px-3 py-2 text-sm border border-rose-600 text-rose-600 rounded-md hover:bg-rose-50 transition" %>

              <% can_impersonate =
                   (current_user.owner? && user.role.to_s != "owner") ||
                   (current_user.admin? && !%w[owner admin].include?(user.role.to_s)) ||
                   (current_user.manager? && !%w[owner admin manager].include?(user.role.to_s)) %>
              <% if can_impersonate %>
                <%= button_to "👀 " + t("team.users.index.impersonate", default: "Impersonate"), impersonate_team_user_path(user), method: :post,
                  class: "flex-1 text-center px-3 py-2 text-sm border border-blue-600 text-blue-600 rounded-md hover:bg-blue-50 transition" %>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-10 text-center">
      <div class="mx-auto w-12 h-12 rounded-full bg-slate-100 flex items-center justify-center mb-3">
        <i class="lucide lucide-user-round-plus w-6 h-6 text-slate-500"></i>
      </div>
      <h3 class="text-lg font-semibold text-slate-900"><%= t("team.users.index.empty_title", default: "No users yet") %></h3>
      <p class="text-sm text-slate-500 mt-1"><%= t("team.users.index.empty_sub", default: "Add team members to collaborate on your account.") %></p>
      <div class="mt-4">
        <%= link_to t("team.users.index.add", default: "Add User"), new_team_user_path,
          class: "inline-flex items-center justify-center bg-emerald-600 text-white px-4 py-2 rounded-md text-sm font-semibold hover:bg-emerald-700 transition shadow-sm" %>
      </div>
    </div>
  <% end %>
</div>

<script src="https://unpkg.com/lucide@latest"></script>
<script>lucide.createIcons();</script>
