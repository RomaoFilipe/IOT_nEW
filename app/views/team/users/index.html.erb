<h1 class="text-2xl font-bold mb-6">Equipa da Empresa</h1>

<%= link_to "➕ Adicionar Utilizador", new_team_user_path, class: "mb-4 inline-block bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700 transition" %>

<% if @users.any? %>
  <div class="space-y-4">
    <% @users.each do |user| %>
      <div x-data="{ open: false }" class="bg-white shadow rounded-lg p-4 flex flex-col md:flex-row md:justify-between md:items-center">
        <!-- Info -->
        <div class="flex items-start gap-4">
          <i class="lucide lucide-user w-6 h-6 text-blue-600 mt-1"></i>
          <div>
            <h2 class="text-lg font-bold text-gray-800"><%= user.name %></h2>
            <p class="text-sm text-gray-500">📧 <%= user.email %></p>
            <span class="inline-flex items-center text-xs mt-1 px-3 py-1 rounded-full font-semibold 
              <%= case user.role
                when "admin" then "bg-yellow-100 text-yellow-800"
                when "manager" then "bg-green-100 text-green-700"
                when "technician" then "bg-purple-100 text-purple-700"
                when "viewer" then "bg-gray-100 text-gray-600"
                else "bg-red-100 text-red-600"
              end %>">
              <i class="lucide lucide-badge-info w-3 h-3 mr-1"></i>
              <%= user.role.capitalize %>
            </span>
          </div>
        </div>

        <!-- Ações -->
        <div class="flex gap-2 mt-4 md:mt-0 md:ml-auto">
          <%= link_to "✏️ Editar", edit_team_user_path(user), class: "px-4 py-1 border rounded text-sm hover:bg-gray-100 transition" %>
          
          <% unless user == current_user %>
            <%= button_to "❌ Apagar", team_user_path(user), method: :delete, data: { confirm: "Tens a certeza que queres apagar este utilizador?" }, class: "px-4 py-1 border border-red-600 text-red-600 rounded text-sm hover:bg-red-50 transition" %>
            <%= button_to "👀 Simular", impersonate_team_user_path(user), method: :post, class: "px-4 py-1 border text-blue-600 border-blue-600 rounded text-sm hover:bg-blue-50 transition" %>
          <% else %>
            <span class="text-gray-400 italic text-sm">Tu</span>
          <% end %>

          <button @click="open = !open" class="px-4 py-1 border rounded text-sm hover:bg-gray-50 transition">
            <span x-show="!open">➤ Expandir</span>
            <span x-show="open">⮝ Recolher</span>
          </button>
        </div>

        <!-- Detalhes Expandidos -->
        <div x-show="open" class="mt-4 border-t pt-3 text-sm text-gray-600 w-full">
          <p><strong>ID:</strong> <%= user.id %></p>
          <p><strong>Status:</strong> <%= user.status.capitalize %></p>
          <p><strong>Notificações:</strong> 
            <%= user.notif_email ? "📧 Email " : "" %>
            <%= user.notif_sms ? "📱 SMS" : "" %>
          </p>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="text-gray-500">Ainda não existem utilizadores nesta conta.</p>
<% end %>
