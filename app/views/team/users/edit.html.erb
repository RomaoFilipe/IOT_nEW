<!-- app/views/team/users/edit.html.erb -->

<h1 class="text-3xl font-bold mb-6 text-gray-800">✏️ <%= t("team.users.edit.title") %></h1>

<%= form_with model: @user, url: team_user_path(@user), method: :patch, local: true, class: "space-y-6 max-w-xl bg-white p-6 rounded-lg shadow-md" do |f| %>
  <div>
    <%= f.label :name, t("team.users.form.name"), class: "block text-sm font-semibold text-gray-700" %>
    <%= f.text_field :name, placeholder: t("team.users.form.name_placeholder"), class: "mt-1 w-full rounded-md border-gray-300 shadow-sm focus:ring-green-500 focus:border-green-500" %>
  </div>

  <div>
    <%= f.label :email, t("team.users.form.email"), class: "block text-sm font-semibold text-gray-700" %>
    <%= f.email_field :email, placeholder: t("team.users.form.email_placeholder"), class: "mt-1 w-full rounded-md border-gray-300 shadow-sm focus:ring-green-500 focus:border-green-500" %>
  </div>

  <div>
    <%= f.label :password, t("team.users.form.password"), class: "block text-sm font-semibold text-gray-700" %>
    <%= f.password_field :password, placeholder: t("team.users.form.password_placeholder"), class: "mt-1 w-full rounded-md border-gray-300 shadow-sm focus:ring-green-500 focus:border-green-500" %>
  </div>

  <div>
    <%= f.label :password_confirmation, t("team.users.form.password_confirmation"), class: "block text-sm font-semibold text-gray-700" %>
    <%= f.password_field :password_confirmation, class: "mt-1 w-full rounded-md border-gray-300 shadow-sm focus:ring-green-500 focus:border-green-500" %>
  </div>

  <div>
    <%= f.label :role, t("team.users.form.role"), class: "block text-sm font-semibold text-gray-700" %>
    <%= f.select :role, User.roles.except("owner", "admin").keys.map { |r| [r.capitalize, r] }, {}, class: "mt-1 w-full rounded-md border-gray-300 shadow-sm focus:ring-green-500 focus:border-green-500" %>
  </div>

  <div>
    <%= f.label :photo, t("team.users.form.photo"), class: "block text-sm font-semibold text-gray-700" %>
    <%= f.file_field :photo, class: "mt-1 w-full rounded-md border-gray-300 shadow-sm" %>

    <% if @user.photo.present? %>
      <div class="mt-3">
        <p class="text-xs text-gray-500 mb-1"><%= t("team.users.form.current_photo") %></p>
        <img src="<%= @user.photo.url %>" class="w-20 h-20 rounded-full object-cover border" />
      </div>
    <% end %>
  </div>

  <div class="flex items-center gap-2">
    <%= f.check_box :notif_email, class: "rounded border-gray-300 text-green-600 shadow-sm focus:ring-green-500" %>
    <%= f.label :notif_email, t("team.users.form.notif_email"), class: "text-sm text-gray-700" %>
  </div>

  <div class="flex items-center gap-2">
    <%= f.check_box :notif_sms, class: "rounded border-gray-300 text-green-600 shadow-sm focus:ring-green-500" %>
    <%= f.label :notif_sms, t("team.users.form.notif_sms"), class: "text-sm text-gray-700" %>
  </div>

  <div class="pt-4">
    <%= f.submit t("team.users.edit.submit"), class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2 rounded-md transition duration-200" %>
  </div>
<% end %>

<%= link_to t("team.users.edit.back"), team_users_path, class: "inline-block mt-6 text-sm text-gray-600 hover:underline" %>