<h1 class="text-2xl font-bold mb-6">➕ Novo Utilizador</h1>

<%= form_with model: @user, url: team_users_path, local: true, class: "space-y-6 max-w-xl" do |f| %>
  <div>
    <%= f.label :name, "Nome", class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm", required: true %>
  </div>

  <div>
    <%= f.label :email, "Email", class: "block text-sm font-medium text-gray-700" %>
    <%= f.email_field :email, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm", required: true %>
  </div>

  <div>
    <%= f.label :role, "Função", class: "block text-sm font-medium text-gray-700" %>
    <%= f.select :role, User.roles.except("owner").keys.map { |r| [r.capitalize, r] }, {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm", required: true %>
  </div>

  <div>
    <%= f.label :password, "Palavra-passe", class: "block text-sm font-medium text-gray-700" %>
    <%= f.password_field :password, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm", required: true %>
  </div>

  <div>
    <%= f.label :password_confirmation, "Confirmação de Palavra-passe", class: "block text-sm font-medium text-gray-700" %>
    <%= f.password_field :password_confirmation, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm", required: true %>
  </div>

  <div>
    <%= f.label :photo, "Foto de perfil (opcional)", class: "block text-sm font-medium text-gray-700" %>
    <%= f.file_field :photo, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
  </div>

  <div class="flex items-center gap-3">
    <%= f.check_box :notif_email, checked: true %>
    <%= f.label :notif_email, "Receber notificações por email", class: "text-sm text-gray-600" %>
  </div>

  <div class="flex items-center gap-3">
    <%= f.check_box :notif_sms %>
    <%= f.label :notif_sms, "Receber notificações por SMS", class: "text-sm text-gray-600" %>
  </div>

  <div>
    <%= f.submit "💾 Criar Utilizador", class: "bg-green-600 text-white px-6 py-2 rounded hover:bg-green-700 transition" %>
  </div>
<% end %>

<%= link_to "← Voltar", team_users_path, class: "inline-block mt-6 text-sm text-gray-600 hover:underline" %>
