<% if session[:admin_user_id] %>
  <div 
    x-data="{ visible: true }" 
    x-init="setTimeout(() => visible = false, 10000)"
    x-show="visible"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0 -translate-y-2"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    class="fixed top-0 left-0 right-0 z-50 bg-gradient-to-r from-yellow-100 to-yellow-200 border-b border-yellow-300 text-yellow-900 px-6 py-3 flex items-center justify-between shadow-lg"
  >
    <div class="flex items-center space-x-3">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-yellow-600 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M12 18a6 6 0 100-12 6 6 0 000 12z" />
      </svg>
      <p class="text-sm font-medium">
        Estás a usar a conta de <strong><%= current_user.name %></strong> como simulação. ⚠
      </p>
    </div>

    <div class="flex items-center space-x-3">
      <%= button_to "🔙 Retornar ao modo Owner", retornar_como_admin_users_path, method: :post,
        class: "inline-flex items-center px-4 py-1.5 bg-yellow-500 text-white font-semibold text-sm rounded-md hover:bg-yellow-600 shadow transition",
        data: { turbo_stream: true, turbo_frame: "_top" } %>
      <button @click="visible = false" class="text-yellow-700 hover:text-yellow-900 transition" title="Fechar banner">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Ajuste de margem para não tapar conteúdo -->
  <style>
    .main-content {
      padding-top: 4.5rem;
    }
  </style>
<% end %>
