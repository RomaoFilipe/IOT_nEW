<div class="relative" x-data="{ openLang: false }">
  <button @click="openLang = !openLang" class="flex items-center gap-1 text-sm text-gray-700 hover:text-green-700 transition">
    🌐 <%= t("languages.#{I18n.locale}") %>
    <i data-lucide="chevron-down" class="w-4 h-4"></i>
  </button>

  <div x-show="openLang" @click.away="openLang = false" class="absolute right-0 mt-2 w-36 bg-white border rounded shadow-md z-50 py-2 text-sm">
    <%= link_to "🇵🇹 Português", url_for(locale: 'pt'), class: "block px-4 py-2 text-left hover:bg-gray-100" %>
    <%= link_to "🇬🇧 English", url_for(locale: 'en'), class: "block px-4 py-2 text-left hover:bg-gray-100" %>
    <%= link_to "🇪🇸 Español", url_for(locale: 'es'), class: "block px-4 py-2 text-left hover:bg-gray-100" %>
  </div>
</div>
