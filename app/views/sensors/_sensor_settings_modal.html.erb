<dialog id="sensorSettingsModal-<%= sensor.id %>" class="rounded-xl w-full max-w-2xl shadow-xl backdrop:bg-black/30">
  <div class="bg-white rounded-xl p-6 space-y-6">

    <!-- Cabeçalho -->
    <div class="flex justify-between items-start">
      <div>
        <h2 class="text-xl font-semibold text-gray-800 flex items-center gap-2">
          <i class="fa-solid fa-gear text-green-500"></i>
          Gerir Sensor
        </h2>
        <p class="text-sm text-gray-500">
          <%= sensor.icon || "💧" %> Sensor de <%= sensor.sensor_type.capitalize %> <strong><%= sensor.name %></strong>
        </p>
      </div>
      <div class="text-sm">
        <span class="px-2 py-1 rounded-full text-xs font-semibold <%= sensor.status.in?(["Active", "parado"]) ? "bg-green-100 text-green-700" : "bg-red-100 text-red-700" %>">
          <%= sensor.status == "parado" ? "Ativo" : sensor.status %>
        </span>
      </div>
    </div>

    <!-- Info do Campo -->
    <div class="bg-gray-50 border rounded-lg p-3 text-sm flex justify-between items-center text-gray-700">
      <div>
        <strong>Campo:</strong> <%= sensor.field&.name || "-" %>
      </div>
      <div>
        <strong>Última leitura:</strong> <%= sensor.last_reading&.strftime("%d/%m/%Y %H:%M") || "-" %>
      </div>
    </div>

    <!-- AÇÕES -->
    <h3 class="text-md font-semibold text-gray-700 uppercase mt-4">Ações</h3>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      <%= link_to readings_sensor_path(sensor), class: "bg-blue-50 hover:bg-blue-100 transition border border-blue-100 p-3 rounded-lg text-center text-blue-600 font-medium text-sm flex items-center justify-center gap-2" do %>
        <i class="fa-solid fa-chart-line"></i> Ver Gráfico
      <% end %>

      <%= button_to toggle_status_api_sensor_path(sensor), method: :patch, form: { data: { turbo_stream: true } },
        class: "bg-red-50 hover:bg-red-100 border border-red-100 p-3 rounded-lg text-center text-red-600 font-medium text-sm flex items-center justify-center gap-2" do %>
        <i class="fa-solid fa-power-off"></i> <%= sensor.status == "Active" || sensor.status == "parado" ? "Desligar" : "Ligar" %>
      <% end %>

      <%= button_to unassign_field_sensor_path(sensor), method: :patch,
        data: { turbo_confirm: "Tens a certeza que queres desassociar este sensor do campo?" },
        class: "bg-yellow-50 hover:bg-yellow-100 border border-yellow-100 p-3 rounded-lg text-center text-yellow-600 font-medium text-sm flex items-center justify-center gap-2" do %>
        <i class="fa-solid fa-link-slash"></i> Desassociar Campo
      <% end %>

      <%= button_to simulate_api_sensor_path(sensor), method: :post, form: { data: { turbo: false } },
        class: "bg-green-50 hover:bg-green-100 border border-green-100 p-3 rounded-lg text-center text-green-700 font-medium text-sm flex items-center justify-center gap-2" do %>
        <i class="fa-solid fa-flask"></i> Simular Leitura
      <% end %>
    </div>

    <!-- Apagar -->
    <div class="mt-4">
      <%= button_to sensor_path(sensor), method: :delete,
        data: { turbo_confirm: "Apagar permanentemente este sensor?" },
        class: "w-full bg-red-100 border border-red-200 p-3 rounded-lg text-center text-red-700 font-semibold text-sm flex items-center justify-center gap-2 hover:bg-red-200 transition" do %>
        <i class="fa-solid fa-trash"></i> Apagar Sensor Permanentemente
      <% end %>
    </div>

    <!-- Agendamento de Irrigação -->
    <% if sensor.sensor_type == "irrigation" %>
      <hr class="my-4 border-gray-200">
      <h3 class="text-md font-semibold text-gray-800 flex items-center gap-2">
        <i class="fa-solid fa-calendar-days text-green-500"></i>
        Agendar Irrigação
      </h3>

      <%= form_with model: IrrigationSchedule.new, url: field_irrigation_schedules_path(sensor.field), local: true do |f| %>
        <%= f.hidden_field :sensor_id, value: sensor.id %>

        <div class="grid grid-cols-7 gap-2 mt-2 text-sm text-gray-700">
          <% Date::DAYNAMES.each_with_index do |day, i| %>
            <label class="flex items-center gap-1">
              <%= check_box_tag "days[]", i, false, class: "text-green-600" %> <%= day[0..2] %>
            </label>
          <% end %>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mt-4 text-sm">
          <div>
            <%= f.label :hour, "Hora", class: "block text-sm mb-1" %>
            <%= f.number_field :hour, in: 0..23, class: "w-full px-3 py-2 border rounded", autocomplete: "off" %>
          </div>
          <div>
            <%= f.label :minute, "Minuto", class: "block text-sm mb-1" %>
            <%= f.number_field :minute, in: 0..59, class: "w-full px-3 py-2 border rounded", autocomplete: "off" %>
          </div>
          <div class="col-span-full">
            <%= f.label :duration, "Duração", class: "block text-sm mb-1" %>
            <%= f.range_field :duration, in: 5..120, step: 5, value: 30,
              class: "w-full duration-slider",
              id: "duration_slider_#{sensor.id}", data: { sensor_id: sensor.id },
              oninput: "document.getElementById('duration_#{sensor.id}').textContent = this.value + ' min'" %>
            <div class="text-right text-sm text-green-600 mt-1" id="duration_<%= sensor.id %>">30 min</div>
          </div>
        </div>

        <div class="flex justify-end gap-3 mt-6">
          <button type="button" onclick="document.getElementById('sensorSettingsModal-<%= sensor.id %>').close()" class="px-4 py-2 text-sm border rounded hover:bg-gray-100">Cancelar</button>
          <%= f.submit "Confirmar Agendamento", class: "px-4 py-2 text-sm text-white bg-green-600 rounded hover:bg-green-700" %>
        </div>
      <% end %>

      <!-- 📋 Agendamentos Existentes -->
      <div class="mt-6 space-y-2">
        <h4 class="text-md font-semibold text-gray-700">📅 Agendamentos Existentes</h4>
        <div id="schedules_container_<%= sensor.id %>">
          <% if sensor.irrigation_schedules.any? %>
            <%= render partial: "irrigation_schedules/list", locals: { sensor: sensor, schedules: sensor.irrigation_schedules.order(:day_of_week, :hour, :minute) } %>
          <% else %>
            <p class="text-gray-400 italic">Ainda não existem agendamentos.</p>
          <% end %>
        </div>
      </div>
    <% end %>

  </div>
</dialog>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll(".duration-slider").forEach(slider => {
      const sensorId = slider.dataset.sensorId;
      const label = document.getElementById(`duration_${sensorId}`);
      if (label) {
        label.textContent = `${slider.value} min`;
        slider.addEventListener("input", () => {
          label.textContent = `${slider.value} min`;
        });
      }
    });
  });
</script>
