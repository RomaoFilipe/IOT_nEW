<tr class="text-sm hover:bg-gray-50 border-b" x-data="{ open: false }">
  <!-- Nome -->
  <td class="px-4 py-3 font-semibold text-gray-900 whitespace-nowrap">
    <div class="flex items-center gap-2">
      <%# Ícone por tipo %>
      <% case sensor.sensor_type.downcase %>
        <% when "temperatura" %>
          <i class="fa-solid fa-temperature-three-quarters text-red-500"></i>
        <% when "humidade" %>
          <i class="fa-solid fa-droplet text-blue-500"></i>
        <% when "irrigation" %>
          <i class="fa-solid fa-water text-blue-700"></i>
        <% else %>
          <i class="fa-solid fa-microchip text-gray-400"></i>
      <% end %>
      <span><%= sensor.name %></span>
    </div>
  </td>

  <!-- Tipo -->
  <td class="px-4 py-3 capitalize text-gray-700"><%= sensor.sensor_type %></td>

  <!-- Estado -->
  <td class="px-4 py-3">
    <% status_class = sensor.status == "Active" ? "text-green-600" : "text-red-600" %>
    <span class="flex items-center gap-1 <%= status_class %>">
      <span class="w-2 h-2 rounded-full bg-current"></span>
      <%= sensor.status %>
    </span>
  </td>

  <!-- Bateria -->
  <td class="px-4 py-3 text-gray-700">
    <span class="flex items-center gap-1">
      <%= battery_icon(sensor.battery) %>
      <%= sensor.battery || 0 %>%
    </span>
  </td>

  <!-- Sinal -->
  <td class="px-4 py-3 text-gray-700">
    <span class="flex items-center gap-1">
      <%= signal_icon(sensor.signal) %>
      <%= sensor.signal || 0 %>%
    </span>
  </td>

  <!-- Última Leitura -->
  <td class="px-4 py-3 text-gray-600">
    <%= sensor.last_reading&.strftime("%d/%m, %H:%M") || "—" %>
  </td>

  <!-- AÇÕES COM DROPDOWN BONITO -->
<td class="px-4 py-3 text-right relative" x-data="{ open: false }">
  <button @click="open = !open" class="text-gray-500 hover:text-gray-700 px-2">
    <i class="fa-solid fa-ellipsis-vertical"></i>
  </button>

  <div x-show="open" @click.away="open = false" x-transition class="absolute right-0 z-20 mt-2 w-52 bg-white rounded-md border shadow-lg overflow-hidden">
    <ul class="text-sm text-gray-700 divide-y">
      <li>
        <%= link_to readings_sensor_path(sensor), class: "flex items-center gap-2 px-4 py-2 hover:bg-gray-50" do %>
          <i class="fa-solid fa-chart-line text-blue-500"></i> Ver Leituras
        <% end %>
      </li>

      <% if sensor.sensor_type == "irrigation" %>
        <li>
          <button onclick="document.getElementById('scheduleModal-<%= sensor.id %>').showModal(); open = false;" class="w-full text-left px-4 py-2 hover:bg-gray-50 flex items-center gap-2">
            <i class="fa-solid fa-calendar-days text-green-500"></i> Agendar Irrigação
          </button>
        </li>
        <li>
          <%= link_to irrigation_history_sensor_path(sensor), class: "flex items-center gap-2 px-4 py-2 hover:bg-gray-50" do %>
            <i class="fa-solid fa-clock-rotate-left text-gray-500"></i> Histórico
          <% end %>
        </li>
      <% end %>

      <li>
        <%= button_to sensor_path(sensor), method: :delete, data: { turbo_confirm: "Apagar este sensor?" },
          class: "w-full text-left px-4 py-2 text-red-600 hover:bg-red-100 flex items-center gap-2" do %>
          <i class="fa-solid fa-trash"></i> Apagar
        <% end %>
      </li>
    </ul>
  </div>
</td>

</tr>


<% if sensor.sensor_type == "irrigation" %>
  <dialog id="scheduleModal-<%= sensor.id %>" class="rounded-xl p-0 w-full max-w-md shadow-xl backdrop:bg-black/30">
    <div class="p-6 bg-white rounded-xl">
      <h3 class="text-lg font-semibold text-gray-800">🕒 Agendar Irrigação</h3>
      <p class="text-sm text-gray-500 mb-4">Configure o agendamento para <%= sensor.name %></p>

      <%= form_with model: IrrigationSchedule.new, url: field_irrigation_schedules_path(sensor.field), method: :post, local: true do |f| %>
        <%= f.hidden_field :sensor_id, value: sensor.id %>

        <!-- Dias -->
        <label class="block text-sm font-medium mb-1">Dias da Semana</label>
        <div class="flex gap-2 flex-wrap">
          <% Date::DAYNAMES.each_with_index do |day, i| %>
            <label class="flex items-center gap-1 text-sm">
              <%= check_box_tag "days[]", i, false, class: "text-green-600" %>
              <%= day[0..2] %>
            </label>
          <% end %>
        </div>

        <!-- Hora e Minuto -->
        <div class="grid grid-cols-2 gap-4 mt-4">
          <div>
            <%= f.label :hour, "Hora", class: "block text-sm mb-1" %>
            <%= f.number_field :hour, in: 0..23, class: "w-full px-3 py-2 border rounded" %>
          </div>
          <div>
            <%= f.label :minute, "Minuto", class: "block text-sm mb-1" %>
            <%= f.number_field :minute, in: 0..59, class: "w-full px-3 py-2 border rounded" %>
          </div>
        </div>

        <!-- Duração -->
        <div class="mt-4">
          <%= f.label :duration, "Duração (minutos)", class: "block text-sm mb-1" %>
<%= f.range_field :duration,
  in: 5..60,
  step: 5,
  class: "w-full duration-slider",
  id: "duration_slider_#{sensor.id}",
  data: { sensor_id: sensor.id },
  oninput: "document.getElementById('duration_#{sensor.id}').textContent = this.value + ' min'" %>

          <div class="text-right text-sm text-green-600 mt-1" id="duration_<%= sensor.id %>">30 min</div>
        </div>

        <!-- Ações -->
        <div class="flex justify-end gap-3 mt-6">
          <button type="button" onclick="document.getElementById('scheduleModal-<%= sensor.id %>').close()" class="px-4 py-2 text-sm border rounded hover:bg-gray-100">Cancelar</button>
          <%= f.submit "Confirmar", class: "px-4 py-2 text-sm text-white bg-green-600 rounded hover:bg-green-700" %>
        </div>
      <% end %>
    </div>
  </dialog>
<% end %>


<script>
  function updateDurationDisplay(value, sensorId) {
    const label = document.getElementById(`duration_${sensorId}`);
    if (label) label.textContent = `${value} min`;
  }

  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll(".duration-slider").forEach(slider => {
      const sensorId = slider.dataset.sensorId;
      updateDurationDisplay(slider.value, sensorId);
      slider.addEventListener("input", () => {
        updateDurationDisplay(slider.value, sensorId);
      });
    });
  });
</script>
<script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>

