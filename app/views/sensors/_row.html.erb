<tr class="text-sm hover:bg-gray-50 border-b">
  <!-- Nome -->
  <td class="px-4 py-3 font-semibold text-gray-900 whitespace-nowrap">
    <div class="flex items-center gap-2">
      <% case sensor.sensor_type.downcase %>
      <% when "temperatura" %>
        <svg class="w-4 h-4 text-red-500" fill="currentColor" viewBox="0 0 20 20"><path d="..." /></svg>
      <% when "humidade" %>
        <svg class="w-4 h-4 text-blue-400" fill="currentColor" viewBox="0 0 20 20"><path d="..." /></svg>
      <% when "irrigation" %>
        <svg class="w-4 h-4 text-blue-600" fill="currentColor" viewBox="0 0 20 20"><path d="..." /></svg>
      <% else %>
        <svg class="w-4 h-4 text-gray-400" fill="currentColor" viewBox="0 0 20 20"><path d="..." /></svg>
      <% end %>
      <span><%= sensor.name %></span>
    </div>
  </td>

  <!-- Tipo -->
  <td class="px-4 py-3 capitalize text-gray-700">
    <%= t("sensors.types.#{sensor.sensor_type.downcase}", default: sensor.sensor_type.capitalize) %>
  </td>

  <!-- Estado -->
  <td class="px-4 py-3">
    <% status_class = sensor.status == "Active" ? "text-green-600" : "text-red-600" %>
    <span class="flex items-center gap-1 <%= status_class %>">
      <span class="w-2 h-2 rounded-full bg-current"></span>
      <%= t("sensors.status.states.#{sensor.status.downcase}", default: sensor.status.capitalize) %>
    </span>
  </td>

  <!-- Bateria -->
  <td class="px-4 py-3">
    <span class="flex items-center gap-1 text-gray-700">
      <%= battery_icon(sensor.battery) %>
      <%= sensor.battery || 0 %>%
    </span>
  </td>

  <!-- Sinal -->
  <td class="px-4 py-3">
    <span class="flex items-center gap-1 text-gray-700">
      <%= signal_icon(sensor.signal) %>
      <%= sensor.signal || 0 %>%
    </span>
  </td>

  <!-- Última leitura -->
  <td class="px-4 py-3 text-gray-600">
    <%= sensor.last_reading&.strftime("%d/%m, %H:%M") || "—" %>
  </td>

  <!-- Ações -->
  <td class="px-4 py-3 whitespace-nowrap">
    <div class="flex flex-col gap-2">
      <!-- Switch -->
      <div>
        <%= form_with url: toggle_status_sensor_path(sensor), method: :patch, data: { turbo_stream: true }, class: "inline-block" do %>
          <label class="relative inline-flex items-center cursor-pointer">
            <% disabled = sensor.status == "Inactive" && (sensor.last_reading.nil? || sensor.last_reading < 5.minutes.ago) %>
            <input type="checkbox" name="active" onchange="this.form.submit()" class="sr-only peer"
              <%= 'checked' if sensor.status == "Active" %>
              <%= 'disabled' if disabled %>>
            <div class="w-11 h-6 bg-gray-300 rounded-full peer peer-checked:bg-green-500 transition-colors"></div>
            <div class="absolute left-0.5 top-0.5 w-5 h-5 bg-white rounded-full shadow transform peer-checked:translate-x-full transition-transform"></div>
          </label>
        <% end %>
      </div>

      <!-- Botões -->
      <div class="flex flex-wrap gap-2">
        <%= link_to "📋", today_field_irrigation_schedules_path(sensor.field), class: "text-sm text-blue-700 underline hover:text-blue-900", title: t("sensors.row.view_today_schedules") %>

        <% if sensor.sensor_type == "irrigation" %>
          <%= link_to "💧", irrigation_history_sensor_path(sensor), class: "text-blue-600 hover:text-blue-800 text-lg", title: t("sensors.row.irrigation_history") %>
          <button onclick="document.getElementById('scheduleModal-<%= sensor.id %>').showModal()" class="bg-white border border-blue-500 text-blue-600 px-3 py-1 rounded-md text-sm hover:bg-blue-50">
            <i class="fa-solid fa-calendar-plus"></i> <%= t("sensors.row.schedule") %>
          </button>

          <!-- Modal -->
          <dialog id="scheduleModal-<%= sensor.id %>" class="rounded-xl p-0 w-full max-w-md shadow-xl">
            <div class="p-6 bg-white rounded-xl">
              <h3 class="text-lg font-semibold text-gray-800">🕒 <%= t("sensors.row.schedule_irrigation") %></h3>
              <p class="text-sm text-gray-500 mb-4"><%= t("sensors.row.schedule_for", name: sensor.name) %></p>

              <%= form_with model: IrrigationSchedule.new, url: field_irrigation_schedules_path(sensor.field), method: :post, local: true do |f| %>
                <%= f.hidden_field :sensor_id, value: sensor.id %>

                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-1"><%= t("sensors.row.weekdays") %></label>
                  <div class="flex gap-2 flex-wrap">
                    <% Date::DAYNAMES.each_with_index do |day, i| %>
                      <label class="w-10 h-10 flex items-center justify-center rounded-full text-sm font-medium bg-gray-100 text-gray-700 hover:bg-green-100 hover:text-green-600 cursor-pointer">
                        <%= check_box_tag "days[]", i, false, class: "hidden peer" %>
                        <span class="peer-checked:bg-green-500 peer-checked:text-white w-full h-full flex items-center justify-center rounded-full"><%= day[0..2] %></span>
                      </label>
                    <% end %>
                  </div>
                </div>

                <div class="grid grid-cols-2 gap-4 mt-4">
                  <div>
                    <%= f.label :hour, t("sensors.row.hour"), class: "block text-sm font-medium mb-1" %>
                    <%= f.number_field :hour, in: 0..23, class: "w-full px-3 py-2 border rounded focus:ring-green-500", placeholder: "HH" %>
                  </div>
                  <div>
                    <%= f.label :minute, t("sensors.row.minute"), class: "block text-sm font-medium mb-1" %>
                    <%= f.number_field :minute, in: 0..59, class: "w-full px-3 py-2 border rounded focus:ring-green-500", placeholder: "MM" %>
                  </div>
                </div>

                <div class="mt-4">
                  <%= f.label :duration_slider, t("sensors.row.duration"), class: "block text-sm font-semibold text-gray-700 mb-1" %>
                  <%= range_field_tag "irrigation_schedule[duration_slider]", 2, min: 1, max: 40, step: 1,
                      id: "duration_slider_#{sensor.id}",
                      class: "w-full duration-slider",
                      oninput: "updateDurationDisplay(this.value, '#{sensor.id}')" %>
                  <p class="text-right text-sm text-green-600 duration-display" id="display_<%= sensor.id %>">1h 0m</p>
                </div>

                <div class="flex justify-end gap-3 mt-6">
                  <button type="button" onclick="document.getElementById('scheduleModal-<%= sensor.id %>').close()" class="px-4 py-2 text-sm border rounded-md hover:bg-gray-100"><%= t("actions.cancel") %></button>
                  <%= f.submit t("actions.confirm"), class: "px-4 py-2 text-sm text-white bg-green-600 rounded-md hover:bg-green-700" %>
                </div>
              <% end %>
            </div>
          </dialog>
        <% else %>
          <%= link_to "📊", readings_sensor_path(sensor), class: "text-blue-600 hover:text-blue-800 text-lg", title: t("sensors.row.readings_history") %>
        <% end %>

        <%= button_to sensor_path(sensor), method: :delete, data: { turbo_confirm: t("sensors.card.confirm_delete") }, class: "text-red-600 hover:text-red-800 text-sm", title: t("actions.delete") do %>
          🗑️
        <% end %>
      </div>
    </div>
  </td>
</tr>


<script>
  function updateDurationDisplay(value, sensorId) {
    const steps = parseInt(value);
    const totalMinutes = steps * 30;
    const h = Math.floor(totalMinutes / 60);
    const m = totalMinutes % 60;
    const label = document.getElementById(`display_${sensorId}`);
    label.textContent = `${h}h${m > 0 ? ' ' + m + 'm' : ''}`;
  }

  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll(".duration-slider").forEach(slider => {
      const sensorId = slider.id.split("_").pop();
      updateDurationDisplay(slider.value, sensorId);
      slider.addEventListener("input", () => {
        updateDurationDisplay(slider.value, sensorId);
      });
    });
  });
</script>
