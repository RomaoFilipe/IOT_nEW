<%= turbo_frame_tag dom_id(sensor, :row) do %>
  <tr class="border-t text-sm hover:bg-gray-50 transition">
    <!-- Nome -->
    <td class="px-4 py-2 font-medium text-gray-900"><%= sensor.name %></td>

    <!-- Tipo -->
    <td class="px-4 py-2 capitalize"><%= sensor.sensor_type %></td>

    <!-- Estado -->
    <td class="px-4 py-2">
      <% status_class = sensor.status == "Active" ? "text-green-600" : "text-red-600" %>
      <span class="<%= status_class %> font-semibold">● <%= sensor.status %></span>
    </td>

    <!-- Bateria -->
    <td class="px-4 py-2"><%= sensor.battery || 0 %>%</td>

    <!-- Sinal -->
    <td class="px-4 py-2"><%= sensor.signal || 0 %>%</td>

    <!-- Última leitura -->
    <td class="px-4 py-2"><%= sensor.last_reading&.strftime("%d/%m, %H:%M") || "—" %></td>

<% if sensor.sensor_type == "irrigation" %>
  <td class="px-4 py-2 text-sm space-y-2">
    <!-- Botão para abrir o modal -->
    <button onclick="document.getElementById('scheduleModal-<%= sensor.id %>').showModal()"
      class="bg-blue-600 hover:bg-blue-700 text-white px-3 py-1 rounded-md transition w-full">
      🕓 Agendar
    </button>

    <!-- Agendamentos existentes -->
    <% sensor.irrigation_schedules.each do |s| %>
      <div class="flex justify-between items-center text-xs text-gray-700 bg-gray-50 p-2 rounded border">
        <span>
          <%= Date::DAYNAMES[s.day_of_week] %> às <%= "%02d:%02d" % [s.hour, s.minute] %> — <%= s.duration %>s
        </span>
        <%= button_to field_irrigation_schedule_path(sensor.field, s), method: :delete,
              data: { turbo_confirm: "Remover este agendamento?" },
              class: "text-red-500 text-xs" do %>🗑️<% end %>
      </div>
    <% end %>

    <!-- Modal de agendamento -->
    <dialog id="scheduleModal-<%= sensor.id %>" class="rounded-xl p-0 w-96 shadow-xl">
      <div class="p-4 bg-white rounded-xl">
        <h3 class="text-lg font-semibold mb-2">🕒 Agendar Irrigação</h3>

        <%= form_with model: IrrigationSchedule.new, url: field_irrigation_schedules_path(sensor.field), method: :post, local: true do |f| %>
          <%= hidden_field_tag :sensor_id, sensor.id %>

          <div class="mb-3">
            <label class="block text-sm font-medium mb-1">Dias da Semana</label>
            <div class="grid grid-cols-2 gap-2">
              <% Date::DAYNAMES.each_with_index do |day, i| %>
                <label class="inline-flex items-center gap-2">
                  <%= check_box_tag "days[]", i, false, class: "rounded border-gray-300 text-green-600 focus:ring-green-500" %>
                  <span><%= day %></span>
                </label>
              <% end %>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4 mb-3">
            <div>
              <%= f.label :hour, "Hora", class: "block text-sm font-medium mb-1" %>
              <%= f.number_field :hour, in: 0..23, class: "w-full px-3 py-2 border rounded focus:ring-green-500", placeholder: "HH" %>
            </div>
            <div>
              <%= f.label :minute, "Minuto", class: "block text-sm font-medium mb-1" %>
              <%= f.number_field :minute, in: 0..59, class: "w-full px-3 py-2 border rounded focus:ring-green-500", placeholder: "MM" %>
            </div>
          </div>

          <div class="mb-4">
            <%= f.label :duration, "Duração (segundos)", class: "block text-sm font-medium mb-1" %>
            <%= f.number_field :duration, in: 10..3600, step: 10, class: "w-full px-3 py-2 border rounded focus:ring-green-500", placeholder: "Ex: 60" %>
          </div>

          <div class="flex justify-end gap-2">
            <button type="button" onclick="document.getElementById('scheduleModal-<%= sensor.id %>').close()" class="px-4 py-2 rounded border text-gray-600 hover:bg-gray-100">
              Cancelar
            </button>
            <%= f.submit "Confirmar", class: "px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700" %>
          </div>
        <% end %>
      </div>
    </dialog>
  </td>
<% else %>
  <td class="px-4 py-2 text-center">—</td>
<% end %>




    <!-- Switch de estado -->
    <td class="px-4 py-2 text-center">
      <%= form_with url: toggle_status_sensor_path(sensor), method: :patch, data: { turbo_stream: true }, class: "inline-block" do %>
        <label class="relative inline-flex items-center cursor-pointer" title="Ativar/Desativar sensor">
          <% disabled = sensor.status == "Inactive" && (sensor.last_reading.nil? || sensor.last_reading < 5.minutes.ago) %>
          <input type="checkbox" name="active" onchange="this.form.submit()" class="sr-only peer"
            <%= 'checked' if sensor.status == "Active" %>
            <%= 'disabled' if disabled %>>
          <div class="w-11 h-6 bg-gray-300 rounded-full peer peer-checked:bg-green-500 transition-colors"></div>
          <div class="absolute left-0.5 top-0.5 w-5 h-5 bg-white rounded-full shadow transform peer-checked:translate-x-full transition-transform"></div>
        </label>
      <% end %>
    </td>

    <!-- Ações -->
    <td class="px-4 py-2 flex flex-wrap gap-2 text-sm">

      <!-- Simular -->
      <%= link_to "🛠️", simulate_sensor_path(sensor), method: :post, class: "text-green-600 hover:text-green-800", title: "Simular dados" %>

      <!-- Histórico -->
      <%= link_to "📊", readings_sensor_path(sensor), class: "text-blue-600 hover:text-blue-800", title: "Ver histórico" %>

      <!-- Apagar -->
      <%= button_to sensor_path(sensor), method: :delete, data: { turbo_confirm: "Apagar este sensor?" }, class: "text-red-600 hover:text-red-800", title: "Remover sensor" do %>
        🗑️
      <% end %>
    </td>
  </tr>
<% end %>
