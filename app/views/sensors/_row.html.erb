<tr class="text-sm hover:bg-gray-50 border-b" x-data="{ open: false }">
  <!-- Nome -->
  <td class="px-4 py-3 font-semibold text-gray-900 whitespace-nowrap">
    <div class="flex items-center gap-2">
      <% case sensor.sensor_type.downcase %>
        <% when "temperatura" %>
          <i class="fa-solid fa-temperature-three-quarters text-red-500"></i>
        <% when "humidade" %>
          <i class="fa-solid fa-droplet text-blue-500"></i>
        <% when "irrigation" %>
          <i class="fa-solid fa-water text-blue-700"></i>
        <% else %>
          <i class="fa-solid fa-microchip text-gray-400"></i>
      <% end %>
      <span title="Última leitura: <%= sensor.last_reading&.strftime('%d/%m %H:%M') || '—' %>">
        <%= sensor.name %>
      </span>
    </div>
  </td>

  <!-- Tipo -->
  <td class="px-4 py-3 capitalize text-gray-700"><%= sensor.sensor_type %></td>

  <!-- Estado -->
  <td class="px-4 py-3">
    <% status_class = sensor.status.in?(["Active", "parado"]) ? "text-green-600" : "text-red-600 animate-pulse" %>
    <span class="flex items-center gap-1 <%= status_class %>">
      <span class="w-2 h-2 rounded-full bg-current"></span>
      <%= sensor.status == "parado" ? "Pronto" : sensor.status %>
    </span>
  </td>

  <!-- Bateria -->
  <td class="px-4 py-3 text-gray-700">
    <span class="flex items-center gap-1">
      <%= battery_icon(sensor.battery) %>
      <% if sensor.battery.to_i < 20 %>
        <span class="text-red-600 font-semibold"><%= sensor.battery || 0 %>%</span>
      <% else %>
        <%= sensor.battery || 0 %>%
      <% end %>
    </span>
  </td>

  <!-- Sinal -->
  <td class="px-4 py-3 text-gray-700">
    <span class="flex items-center gap-1">
      <%= signal_icon(sensor.signal) %>
      <% if sensor.signal.to_i == 0 %>
        <span class="text-red-600 font-semibold">0%</span>
      <% else %>
        <%= sensor.signal || 0 %>%
      <% end %>
    </span>
  </td>

  <!-- Última Leitura -->
  <td class="px-4 py-3 text-gray-600">
    <%= sensor.last_reading&.strftime("%Y-%m-%d %H:%M") || "—" %>
  </td>

  <!-- Ações -->
  <td class="px-4 py-3 text-right">
    <button onclick="document.getElementById('sensorSettingsModal-<%= sensor.id %>').showModal()"
            class="px-3 py-1 bg-gray-100 hover:bg-gray-200 text-sm rounded-md font-medium text-gray-700 inline-flex items-center gap-2">
      <i class="fa-solid fa-gear text-gray-600"></i>
      <span class="hidden md:inline">Configurações</span>
    </button>
  </td>
</tr>


<!-- 🔧 Modal de Configurações do Sensor -->
<%= render partial: "sensors/sensor_settings_modal", locals: { sensor: sensor } %>


<% if sensor.sensor_type == "irrigation" %>
  <%= render partial: "sensors/modal_schedule_view", locals: { sensor: sensor } %>
<% end %>
