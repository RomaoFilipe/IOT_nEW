<turbo-stream action="append" target="sensorsList">
  <template>
    <%= render partial: "sensors/sensor", locals: { sensor: @sensor } %>
  </template>
</turbo-stream>

<turbo-stream action="replace" target="addSensorForm">
  <template>
    <div id="addSensorForm" class="hidden mt-6"></div>
  </template>
</turbo-stream>
