<div id="sensorModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50 hidden px-2">
  <div class="bg-white rounded-xl shadow-lg w-full max-w-lg p-4 sm:p-6 relative max-h-[95vh] overflow-y-auto">
    <button onclick="toggleSensorModal()" class="absolute top-4 right-4 text-gray-500 hover:text-gray-800 text-2xl">
      &times;
    </button>

    <h2 class="text-xl font-semibold text-gray-800 mb-1">Adicionar Equipamento IoT</h2>
    <p class="text-sm text-gray-500 mb-6">Configuração para <strong><%= field.name %></strong></p>

    <%= form_with(model: [field, Sensor.new], local: true) do |form| %>
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700">Nome do Sensor</label>
          <%= form.text_field :name, placeholder: 'e.g., Sensor de Solo Norte', class: 'w-full mt-1 px-3 py-2 border rounded-md shadow-sm focus:ring-green-600 focus:border-green-600' %>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700">Tipo</label>
          <%= form.select :sensor_type, ["Temperatura", "Humidade", "Outro"], {}, class: 'w-full mt-1 px-3 py-2 border rounded-md shadow-sm focus:ring-green-600 focus:border-green-600' %>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700">Device ID</label>
          <%= form.text_field :device_id, id: "device_id_input", placeholder: 'e.g., sensor_001', class: 'w-full mt-1 px-3 py-2 border rounded-md shadow-sm', oninput: "resetVerification()", required: true %>
        </div>

        <div class="flex items-center gap-3 mt-1">
          <button type="button" onclick="verifyDevice()" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Verificar dispositivo</button>
          <p id="deviceCheckResult" class="text-sm mt-2 text-gray-700"></p>
        </div>

        <%= form.hidden_field :field_id, value: field.id %>

        <div class="flex flex-col sm:flex-row justify-end mt-6 gap-2">
          <button type="button" onclick="toggleSensorModal()" class="px-4 py-2 text-gray-600 hover:text-gray-800">Cancelar</button>
          <%= form.submit 'Guardar Sensor', id: 'saveButton', disabled: true, class: 'px-4 py-2 bg-green-700 text-white rounded-md hover:bg-green-800' %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<script>
  let isVerified = false;

  function toggleSensorModal() {
    document.getElementById('sensorModal').classList.toggle('hidden');
  }

  function verifyDevice() {
    const input = document.getElementById('device_id_input');
    const saveBtn = document.getElementById('saveButton');
    const result = document.getElementById('deviceCheckResult');
    const deviceId = input.value.trim();

    if (!deviceId) {
      result.textContent = "⚠️ Introduz um Device ID.";
      result.className = "text-sm mt-2 text-yellow-600";
      saveBtn.disabled = true;
      return;
    }

    fetch(`/api/sensors/identify?device_id=${encodeURIComponent(deviceId)}`)
      .then(response => {
        if (response.status === 200 || response.status === 201) {
          return response.json();
        } else {
          throw new Error("Não encontrado");
        }
      })
      .then(data => {
        isVerified = true;
        saveBtn.disabled = false;
        result.textContent = `✅ Dispositivo verificado: ${data.name}`;
        result.className = "text-sm mt-2 text-green-600";
      })
      .catch(() => {
        isVerified = false;
        saveBtn.disabled = true;
        result.textContent = "❌ Erro: Dispositivo não encontrado.";
        result.className = "text-sm mt-2 text-red-600";
      });
  }

  function resetVerification() {
    isVerified = false;
    const saveBtn = document.getElementById('saveButton');
    const result = document.getElementById('deviceCheckResult');
    saveBtn.disabled = true;
    result.textContent = "";
  }
</script>
