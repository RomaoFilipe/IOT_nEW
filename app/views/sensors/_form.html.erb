<!-- app/views/sensors/_form.html.erb -->
<%= form_with model: Sensor.new, url: field_sensors_path(field), method: :post, data: { turbo_stream: true }, html: { id: "addSensorForm", class: "..." } do |f| %>
  <%= f.hidden_field :field_id, value: field.id %>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div>
      <%= f.label :name, "Nome do Sensor", class: "text-sm font-medium text-gray-700" %>
      <%= f.text_field :name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
    </div>
    <div>
      <%= f.label :sensor_type, "Tipo de Sensor", class: "text-sm font-medium text-gray-700" %>
      <%= f.select :sensor_type, ["Solo", "Temperatura", "Humidade", "Irrigação"], {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
    </div>
    <div class="flex items-end">
      <%= f.submit "Criar Sensor", class: "bg-green-600 text-white px-4 py-2 rounded-md hover:bg-green-700 w-full" %>
    </div>
  </div>
<% end %>
