<% if field.present? %>
  <div id="addSensorForm" class="hidden mt-6">
    <%= form_with url: field_sensors_path(field), method: :post, data: { turbo_stream: true }, local: true do |f| %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <%= f.label :name, "Nome do Sensor", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :name, placeholder: "Ex: Soil Moisture Sensor", class: "block w-full rounded-md border-gray-300 focus:border-green-500 focus:ring-green-500 shadow-sm" %>
        </div>

        <div>
          <%= f.label :sensor_type, "Tipo de Sensor", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :sensor_type, Sensor::SENSOR_TYPES, {}, class: "block w-full rounded-md border-gray-300 focus:border-green-500 focus:ring-green-500 shadow-sm" %>
        </div>
      </div>

      <div class="flex justify-end">
        <%= f.submit "Guardar Sensor", class: "inline-flex items-center px-6 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500" %>
      </div>
    <% end %>
  </div>
<% end %>
