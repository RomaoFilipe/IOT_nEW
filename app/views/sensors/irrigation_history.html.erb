<div class="max-w-4xl mx-auto mt-10 px-4">
  <% if @sensor.present? %>
    <h2 class="text-2xl font-semibold mb-4">💧 <%= t("sensors.irrigation.title", name: @sensor.name) %></h2>
  <% else %>
    <p class="text-red-600"><%= t("sensors.irrigation.not_found") %></p>
  <% end %>

  <canvas id="irrigationChart" class="mb-6"></canvas>

  <table class="min-w-full bg-white border rounded-lg shadow">
    <thead class="bg-gray-100 text-left text-sm font-medium text-gray-700">
      <tr>
        <th class="px-4 py-2"><%= t("sensors.irrigation.date") %></th>
        <th class="px-4 py-2"><%= t("sensors.irrigation.duration") %></th>
        <th class="px-4 py-2"><%= t("sensors.irrigation.status") %></th>
      </tr>
    </thead>
    <tbody class="text-sm divide-y divide-gray-100">
      <% (@irrigation_logs || []).each do |log| %>
        <tr>
          <td class="px-4 py-2"><%= log.executed_at.strftime("%d/%m/%Y %H:%M") %></td>
          <td class="px-4 py-2"><%= log.duration %></td>
          <td class="px-4 py-2">
            <% status_color = case log.status
              when "executado" then "text-green-600"
              when "falhou" then "text-red-600"
              else "text-gray-600"
            end %>
            <span class="font-medium <%= status_color %>"><%= t("sensors.irrigation.statuses.#{log.status}") %></span>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="mt-6">
    <%= link_to "← #{t("sensors.irrigation.back")}", fields_path, class: "text-blue-600 hover:underline" %>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/luxon@3.3.0/build/global/luxon.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-luxon@1.1.0"></script>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const ctx = document.getElementById("irrigationChart").getContext("2d");

    const chart = new Chart(ctx, {
      type: "bar",
      data: {
        labels: <%= raw @irrigation_logs.map { |r| r.executed_at.strftime("%Y-%m-%dT%H:%M:%S") }.reverse.to_json %>,
        datasets: [
          {
            label: "<%= t("sensors.irrigation.chart_label") %>",
            data: <%= raw @irrigation_logs.map(&:duration).reverse.to_json %>,
            backgroundColor: "rgba(75, 192, 192, 0.6)",
            borderColor: "rgba(75, 192, 192, 1)",
            borderWidth: 1
          }
        ]
      },
      options: {
        responsive: true,
        plugins: {
          legend: { display: false },
          title: { display: true, text: "<%= t("sensors.irrigation.chart_title") %>" }
        },
        scales: {
          x: {
            type: 'time',
            time: {
              parser: 'yyyy-MM-dd\'T\'HH:mm:ss',
              tooltipFormat: 'dd/MM HH:mm',
              unit: 'minute',
              displayFormats: {
                minute: 'dd/MM HH:mm'
              }
            },
            title: {
              display: true,
              text: "<%= t("sensors.irrigation.x_axis") %>"
            }
          },
          y: {
            beginAtZero: true,
            title: {
              display: true,
              text: "<%= t("sensors.irrigation.y_axis") %>"
            }
          }
        }
      }
    });
  });
</script>
