<% unassigned = Sensor.where(field_id: nil) %>
<% if unassigned.any? %>
  <h3 class="text-lg font-bold mt-10 mb-4 text-gray-800 flex items-center gap-2">
    <i class="fa-solid fa-plug-circle-exclamation text-yellow-500"></i>
    Sensores Não Atribuídos
  </h3>

  <div class="overflow-x-auto border rounded-xl shadow-sm bg-white">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50 text-gray-600 uppercase text-xs font-semibold">
        <tr>
          <th class="px-4 py-3 text-left">Nome</th>
          <th class="px-4 py-3 text-left">Tipo</th>
          <th class="px-4 py-3 text-left">Bateria</th>
          <th class="px-4 py-3 text-left">Sinal</th>
          <th class="px-4 py-3 text-left">Última Leitura</th>
          <th class="px-4 py-3 text-center">Ações</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% unassigned.each do |sensor| %>
          <tr class="hover:bg-gray-50">
            <!-- Nome -->
            <td class="px-4 py-3 font-medium text-gray-900 whitespace-nowrap">
              <div class="flex items-center gap-2">
                <% case sensor.sensor_type.downcase %>
                  <% when "temperatura" %>
                    <i class="fa-solid fa-temperature-three-quarters text-red-500"></i>
                  <% when "humidade" %>
                    <i class="fa-solid fa-droplet text-blue-500"></i>
                  <% when "irrigation" %>
                    <i class="fa-solid fa-water text-blue-700"></i>
                  <% else %>
                    <i class="fa-solid fa-microchip text-gray-400"></i>
                <% end %>
                <%= sensor.name %>
              </div>
              <% suggested = sensor.suggested_field %>
              <% if suggested %>
                <p class="text-xs text-gray-600 italic mt-1">
                  Sugestão: <strong><%= suggested.name %></strong>
                </p>
                <%= button_to "Atribuir automaticamente", assign_field_sensor_path(sensor),
                      method: :patch,
                      params: { field_id: suggested.id },
                      class: "mt-1 bg-green-600 text-white text-xs px-2 py-1 rounded hover:bg-green-700 transition" %>
              <% end %>
            </td>

            <!-- Tipo -->
            <td class="px-4 py-3 capitalize text-gray-700"><%= sensor.sensor_type %></td>

            <!-- Bateria -->
            <td class="px-4 py-3">
              <span class="flex items-center gap-1">
                <%= battery_icon(sensor.battery) %>
                <% if sensor.battery.to_i < 20 %>
                  <span class="text-red-600 font-semibold"><%= sensor.battery %>%</span>
                <% else %>
                  <%= sensor.battery || 0 %>%
                <% end %>
              </span>
            </td>

            <!-- Sinal -->
            <td class="px-4 py-3">
              <span class="flex items-center gap-1">
                <%= signal_icon(sensor.signal) %>
                <% if sensor.signal.to_i == 0 %>
                  <span class="text-red-600 font-semibold">Sem sinal</span>
                <% else %>
                  <%= sensor.signal || 0 %>%
                <% end %>
              </span>
            </td>

            <!-- Última leitura -->
            <td class="px-4 py-3 text-gray-600" title="Atualizado em <%= sensor.last_reading&.strftime('%d/%m/%Y %H:%M') || 'Nunca' %>">
              <%= sensor.last_reading&.strftime("%Y-%m-%d %H:%M") || "Sem dados" %>
            </td>

            <!-- AÇÕES -->
            <td class="px-4 py-3 text-center">
              <%= button_to assign_field_sensor_path(sensor),
                  method: :patch,
                  params: { field_id: field.id },
                  class: "bg-green-600 text-white rounded px-3 py-2 flex items-center gap-2 justify-center" do %>
                <i class="fa-solid fa-link"></i>
                <span>Atribuir</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
