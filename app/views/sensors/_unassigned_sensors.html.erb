<% unassigned = Sensor.where(field_id: nil) %>
<% if unassigned.any? %>
  <h3 class="text-md font-semibold mt-6 mb-2 text-gray-800">Sensores Não Atribuídos</h3>
  <table class="min-w-full border rounded-lg shadow-sm divide-y divide-gray-200">
    <thead class="bg-gray-100">
      <tr class="text-sm text-gray-700">
        <th class="px-4 py-2 text-left">Nome</th>
        <th class="px-4 py-2 text-left">Tipo</th>
        <th class="px-4 py-2 text-left">Última leitura</th>
        <th class="px-4 py-2 text-left">Ações</th>
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-gray-100">
      <% unassigned.each do |sensor| %>
        <tr>
          <td class="px-4 py-2"><%= sensor.name %></td>
          <td class="px-4 py-2"><%= sensor.sensor_type %></td>
          <td class="px-4 py-2"><%= sensor.last_reading&.strftime("%d/%m %H:%M") || "Sem dados" %></td>
          <td class="px-4 py-2">
            <%= button_to "Atribuir a este campo", assign_field_sensor_path(sensor), method: :patch,
                params: { field_id: field.id },
                class: "text-sm bg-blue-600 text-white px-3 py-1 rounded hover:bg-blue-700 transition" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
