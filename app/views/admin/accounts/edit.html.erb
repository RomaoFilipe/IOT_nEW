<% content_for :title, "Editar Conta" %>

<% if flash[:notice] %>
  <div class="mb-4 px-4 py-3 bg-green-100 text-green-800 rounded shadow">
    ✅ <%= flash[:notice] %>
  </div>
<% elsif flash[:alert] %>
  <div class="mb-4 px-4 py-3 bg-red-100 text-red-800 rounded shadow">
    ⚠️ <%= flash[:alert] %>
  </div>
<% end %>

<div class="max-w-3xl mx-auto p-6 bg-white shadow rounded-lg mt-6">
  <h1 class="text-2xl font-bold text-gray-800 mb-6">✏️ Editar Conta</h1>

  <%= form_with(model: [:admin, @account], local: true, class: "space-y-6") do |form| %>
    <div>
      <%= form.label :name, "Nome da Empresa", class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500" %>
    </div>

    <div>
      <%= form.label :nif, "NIF", class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :nif, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500" %>
    </div>

<div>
  <%= form.label :farm_type, "Tipo de Produção", class: "block text-sm font-medium text-gray-700" %>

  <% if @account.fields.any? %>
    <%= form.select :farm_type, Account.farm_types.keys.map { |t| [t.humanize, t] },
          {}, class: "mt-1 block w-full bg-gray-100 text-gray-500 border-gray-300 rounded-md shadow-sm", disabled: true %>
    <p class="text-sm text-red-500 mt-1">⚠ Não é possível alterar o tipo de produção porque existem campos registados.</p>
  <% else %>
    <%= form.select :farm_type, Account.farm_types.keys.map { |t| [t.humanize, t] },
          {}, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" %>
  <% end %>
</div>



    <div class="flex justify-between items-center pt-4"> <%= link_to "← Voltar", admin_accounts_path, 
      class: "text-sm text-gray-600 hover:underline" %> <%= form.submit "Guardar Alterações", class: 
      "px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition" %>
    </div>
  <% end %>
</div>
