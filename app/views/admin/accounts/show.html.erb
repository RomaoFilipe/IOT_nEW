<% content_for :title, t("admin.accounts.show.title") %>

<div class="max-w-5xl mx-auto px-4 py-8 space-y-6">
  <!-- Cabeçalho -->
  <div class="flex items-start gap-4">
    <i class="lucide lucide-building-2 w-8 h-8 text-blue-600 mt-1"></i>
    <div>
      <h1 class="text-3xl font-bold text-gray-800"><%= @account.name %></h1>
      <p class="text-sm text-gray-500"><%= t("admin.accounts.show.nif") %>: <%= @account.nif %></p>

      <% tipo_txt = t("enums.account.farm_type.#{@account.farm_type}", default: t("enums.account.farm_type.undefined")) %>
      <span class="inline-flex items-center text-xs mt-2 px-3 py-1 rounded-full font-semibold <%= chip_class_for_farm_type(@account.farm_type) %>">
        <i class="lucide lucide-bar-chart-3 w-3 h-3 mr-1"></i>
        <%= tipo_txt %>
      </span>
    </div>
  </div>

  <!-- Estatísticas -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div class="bg-gray-50 p-4 rounded-lg shadow-sm">
      <p class="text-sm text-gray-500"><%= t("admin.accounts.show.stats.users") %></p>
      <p class="text-lg font-bold text-gray-800"><%= @account.users.count %></p>
    </div>
    <div class="bg-gray-50 p-4 rounded-lg shadow-sm">
      <p class="text-sm text-gray-500"><%= t("admin.accounts.show.stats.fields") %></p>
      <p class="text-lg font-bold text-gray-800"><%= @account.fields.count %></p>
    </div>
  </div>

  <!-- Lista de utilizadores -->
  <div>
    <h2 class="text-xl font-semibold text-gray-700 mb-4"><%= t("admin.accounts.show.users_title") %></h2>

    <% @account.users.each do |user| %>
      <% role_label = t("admin.users.roles.#{user.role}", default: user.role.to_s.humanize) %>
      <div class="bg-white rounded-lg px-4 py-3 mb-3 shadow-sm flex justify-between items-center hover:bg-gray-50">
        <div class="flex items-center gap-3">
          <span class="text-2xl"><%= { "admin"=>"👑", "manager"=>"🧑‍🌾", "technician"=>"🔧", "viewer"=>"👀" }[user.role] || "❓" %></span>
          <div>
            <p class="font-semibold text-sm text-gray-800"><%= user.name %></p>
            <p class="text-xs text-gray-500"><%= user.email %></p>
          </div>
        </div>
        <span class="text-xs font-semibold px-3 py-1 rounded-full <%= chip_class_for_role(user.role) %>">
          <%= role_label %>
        </span>
      </div>
    <% end %>
  </div>

  <!-- Botão voltar -->
  <div class="pt-4">
    <%= link_to t("admin.accounts.show.back"), admin_accounts_path, class: "text-sm text-gray-600 hover:underline" %>
  </div>
</div>
