<% content_for :title, t("admin.accounts.index.title") %>

<div class="max-w-6xl mx-auto px-4 py-8 space-y-6" x-data="{ q: '', type: 'all' }">
  <!-- Título + Toolbar -->
  <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="text-3xl font-bold text-slate-900">
        🏢 <%= t("admin.accounts.index.title") %>
      </h1>
      <p class="text-sm text-slate-500 mt-1">
        <%= t("admin.accounts.index.subtitle") %>
      </p>
    </div>

    <div class="flex flex-col sm:flex-row gap-2 sm:items-center">
      <!-- Pesquisa -->
      <div class="relative">
        <input
          x-model="q"
          type="search"
          placeholder="<%= t('admin.accounts.index.search_placeholder') %>"
          class="w-full sm:w-64 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-400"
        />
        <i class="lucide lucide-search absolute right-3 top-2.5 h-4 w-4 text-slate-400"></i>
      </div>

      <!-- Filtro por tipo -->
      <select
        x-model="type"
        class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-400"
        title="<%= t('admin.accounts.index.filter_label') %>"
      >
        <option value="all"><%= t("admin.accounts.index.filter_all") %></option>
        <option value="agriculture"><%= t("admin.accounts.index.types.agriculture") %></option>
        <option value="aquaculture_sea"><%= t("admin.accounts.index.types.aquaculture_sea") %></option>
        <option value="aquaculture_tank"><%= t("admin.accounts.index.types.aquaculture_tank") %></option>
      </select>
    </div>
  </div>
</div>


  <!-- Grid de contas -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <% @accounts.each do |account| %>
      <% tipo_txt   = t("enums.account.farm_type.#{account.farm_type}", default: t("enums.account.farm_type.undefined")) %>
      <% tipo_badge = badge_class_for_farm_type(account.farm_type) %>

      <div class="group bg-white border border-slate-200 rounded-2xl p-5 shadow-sm hover:shadow-md transition"
           x-data="{ open: false }"
           x-show="(q === '' || $el.dataset.n.includes(q.toLowerCase()) || $el.dataset.nif.includes(q.toLowerCase())) && (type === 'all' || $el.dataset.type === type)"
           x-transition
           data-n="<%= account.name.to_s.downcase %>"
           data-nif="<%= account.nif.to_s.downcase %>"
           data-type="<%= account.farm_type %>">

        <!-- Cabeçalho -->
        <div class="flex items-start justify-between gap-4">
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <i class="lucide lucide-building-2 h-5 w-5 text-blue-600"></i>
              <h2 class="font-semibold text-slate-900 truncate"><%= account.name %></h2>
            </div>
            <p class="text-xs text-slate-500 mt-1"><%= t("admin.accounts.show.nif") %>: <%= account.nif %></p>
            <span class="mt-2 inline-flex items-center gap-2 px-2.5 py-1 rounded-full text-xs font-medium <%= tipo_badge %>">
              <i class="lucide lucide-bar-chart-3 h-3.5 w-3.5"></i>
              <%= tipo_txt %>
            </span>
          </div>

          <!-- Ações rápidas -->
          <div class="flex flex-col items-end gap-2 shrink-0">
            <div class="inline-flex items-center gap-1">
              <%= link_to edit_admin_account_path(account), class: "inline-flex items-center gap-1 text-xs px-2 py-1 rounded border border-slate-300 hover:bg-slate-50" do %>
                <i class="lucide lucide-pencil h-3.5 w-3.5"></i> <%= t("admin.accounts.index.actions.edit") %>
              <% end %>

              <%= link_to admin_account_path(account), class: "inline-flex items-center gap-1 text-xs px-2 py-1 rounded border border-slate-300 hover:bg-slate-50" do %>
                <i class="lucide lucide-file-text h-3.5 w-3.5"></i> <%= t("admin.accounts.index.actions.view") %>
              <% end %>

              <%= button_to admin_account_path(account), method: :delete,
                    data: { turbo_confirm: t("admin.accounts.index.actions.delete_confirm") },
                    class: "inline-flex items-center gap-1 text-xs px-2 py-1 rounded border border-rose-300 text-rose-700 hover:bg-rose-50" do %>
                <i class="lucide lucide-trash-2 h-3.5 w-3.5"></i> <%= t("admin.accounts.index.actions.delete") %>
              <% end %>
            </div>

            <!-- Simulação de conta -->
            <div class="inline-flex items-center gap-1">
              <%= button_to simulate_admin_account_path(account), method: :post,
                    class: "inline-flex items-center gap-1 text-xs px-2 py-1 rounded border border-emerald-300 text-emerald-700 hover:bg-emerald-50" do %>
                <i class="lucide lucide-log-in h-3.5 w-3.5"></i> <%= t("admin.accounts.index.actions.impersonate") %>
              <% end %>

              <% if session[:simulated_account_id].present? %>
                <%= button_to stop_simulation_admin_accounts_path, method: :delete,
                      class: "inline-flex items-center gap-1 text-xs px-2 py-1 rounded border border-amber-300 text-amber-700 hover:bg-amber-50" do %>
                  <i class="lucide lucide-log-out h-3.5 w-3.5"></i> <%= t("admin.accounts.index.actions.stop_impersonation") %>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Meta / números -->
        <div class="mt-4 grid grid-cols-3 gap-3 text-center">
          <div class="rounded-lg bg-slate-50 p-3">
            <p class="text-[11px] uppercase tracking-wide text-slate-500"><%= t("admin.accounts.index.metrics.users") %></p>
            <p class="mt-0.5 text-base font-semibold text-slate-900"><%= account.users.size %></p>
          </div>
          <div class="rounded-lg bg-slate-50 p-3">
            <p class="text-[11px] uppercase tracking-wide text-slate-500"><%= t("admin.accounts.index.metrics.created_at") %></p>
            <p class="mt-0.5 text-base font-semibold text-slate-900"><%= l(account.created_at.to_date) %></p>
          </div>
          <div class="rounded-lg bg-slate-50 p-3">
            <p class="text-[11px] uppercase tracking-wide text-slate-500"><%= t("admin.accounts.index.metrics.updated_at") %></p>
            <p class="mt-0.5 text-base font-semibold text-slate-900"><%= time_ago_in_words(account.updated_at) %> <%= t("admin.accounts.index.metrics.updated_ago_suffix") %></p>
          </div>
        </div>

        <!-- Toggle lista de utilizadores -->
        <div class="mt-4">
<button @click="open = !open"
        class="w-full inline-flex items-center justify-center gap-2 text-sm px-3 py-2 rounded-lg border border-slate-300 hover:bg-slate-50 transition"
        :aria-expanded="open">
  <i :class="open ? 'lucide-chevron-up' : 'lucide-chevron-down'" class="lucide h-4 w-4"></i>

  <span x-show="!open"><%= t("admin.accounts.index.users_list.show") %></span>
  <span x-show="open"><%= t("admin.accounts.index.users_list.hide") %></span>
</button>


          <div x-show="open" x-transition x-cloak class="mt-3 rounded-xl border border-slate-200">
            <% if account.users.any? %>
              <ul class="divide-y divide-slate-100">
                <% account.users.each do |user| %>
                  <% role_label = t("admin.users.roles.#{user.role}", default: user.role.to_s.humanize) %>
                  <li class="px-4 py-3 flex items-center justify-between">
                    <div class="flex items-center gap-3 min-w-0">
                      <span class="text-xl"><%= { "admin"=>"👑", "manager"=>"🧑‍🌾", "technician"=>"🔧", "viewer"=>"👀" }[user.role] || "❓" %></span>
                      <div class="min-w-0">
                        <p class="text-sm font-medium text-slate-900 truncate"><%= user.name %></p>
                        <p class="text-xs text-slate-500 truncate"><%= user.email %></p>
                      </div>
                    </div>
                    <div class="flex items-center gap-2 shrink-0">
                      <span class="px-2.5 py-1 rounded-full text-xs font-semibold <%= chip_class_for_role(user.role) %>"><%= role_label %></span>
                      <%= link_to edit_user_path(user), class: "inline-flex items-center gap-1 text-xs px-2 py-1 rounded border border-slate-300 hover:bg-slate-50" do %>
                        <i class="lucide lucide-pencil h-3.5 w-3.5"></i> <%= t("admin.accounts.index.users_list.edit") %>
                      <% end %>
                      <%= button_to user_path(user), method: :delete,
                            data: { turbo_confirm: t("admin.accounts.index.users_list.remove_confirm") },
                            class: "inline-flex items-center gap-1 text-xs px-2 py-1 rounded border border-rose-300 text-rose-700 hover:bg-rose-50" do %>
                        <i class="lucide lucide-trash-2 h-3.5 w-3.5"></i> <%= t("admin.accounts.index.users_list.remove") %>
                      <% end %>
                    </div>
                  </li>
                <% end %>
              </ul>
            <% else %>
              <div class="p-6 text-center text-sm text-slate-500"><%= t("admin.accounts.index.users_list.empty") %></div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Vazio -->
  <% if @accounts.blank? %>
    <div class="rounded-xl border border-dashed border-slate-300 bg-white p-10 text-center">
      <p class="text-slate-600"><%= t("admin.accounts.index.empty_state.title") %></p>
      <%= link_to t("admin.accounts.index.empty_state.cta"),
            new_admin_account_path,
            class: "inline-flex items-center gap-2 mt-3 px-4 py-2 rounded-lg bg-emerald-600 text-white hover:bg-emerald-700" %>
    </div>
  <% end %>
</div>
