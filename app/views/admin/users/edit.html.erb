<% content_for :title, t("admin.users.edit.title") %>

<% if flash[:notice].present? %>
  <div class="mb-4 px-4 py-3 bg-green-50 text-green-800 rounded-lg border border-green-200">✅ <%= flash[:notice] %></div>
<% elsif flash[:alert].present? %>
  <div class="mb-4 px-4 py-3 bg-rose-50 text-rose-700 rounded-lg border border-rose-200">⚠️ <%= flash[:alert] %></div>
<% end %>

<div class="max-w-4xl mx-auto mt-6 space-y-6">
  <!-- Cabeçalho -->
  <div class="bg-white rounded-xl border shadow-sm p-5">
    <div class="flex items-start justify-between gap-3">
      <div class="flex items-center gap-3">
        <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 text-xl">✏️</span>
        <div>
          <h1 class="text-xl sm:text-2xl font-bold text-slate-900"><%= t("admin.users.edit.title") %></h1>
          <p class="text-sm text-slate-500"><%= t("admin.users.edit.subtitle") %></p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <%= link_to t("admin.users.edit.back"), (defined?(admin_users_path) ? admin_users_path : :back),
                    class: "px-3 py-2 text-sm rounded-md border border-slate-300 text-slate-700 hover:bg-slate-50" %>
      </div>
    </div>
  </div>

  <!-- Formulário -->
  <div class="bg-white rounded-xl border shadow-sm p-6">
    <% if @user.errors.any? %>
      <div class="mb-5 rounded-lg border border-rose-200 bg-rose-50 p-4 text-rose-700">
        <p class="font-semibold mb-2"><%= t("admin.users.edit.errors_intro") %></p>
        <ul class="list-disc list-inside text-sm">
          <% @user.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: [:admin, @user], local: true, class: "space-y-8" do |f| %>
      <!-- Identidade -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="md:col-span-2 space-y-4">
          <div>
            <%= f.label :name, t("admin.users.edit.form.name"), class: "block text-sm font-medium text-slate-700" %>
            <%= f.text_field :name, class: "mt-1 block w-full rounded-lg border-slate-300 shadow-sm focus:ring-emerald-500 focus:border-emerald-500" %>
          </div>

          <div>
            <%= f.label :email, t("admin.users.edit.form.email"), class: "block text-sm font-medium text-slate-700" %>
            <%= f.email_field :email, autocomplete: "email", class: "mt-1 block w-full rounded-lg border-slate-300 shadow-sm focus:ring-emerald-500 focus:border-emerald-500" %>
          </div>

          <div>
            <%= f.label :role, t("admin.users.edit.form.role"), class: "block text-sm font-medium text-slate-700" %>
            <% roles = User.roles.keys.map { |r| [t("admin.users.roles.#{r}", default: r.humanize), r] } %>
            <%= f.select :role, roles, {}, class: "mt-1 block w-full rounded-lg border-slate-300 shadow-sm focus:ring-emerald-500 focus:border-emerald-500" %>
          </div>

          <!-- Preferências -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <% if @user.respond_to?(:notif_email) %>
              <label class="flex items-center justify-between gap-3 rounded-lg border p-3">
                <span class="text-sm font-medium text-slate-700"><%= t("admin.users.edit.form.prefs_email") %></span>
                <%= f.check_box :notif_email, { class: "toggle-switch" }, true, false %>
              </label>
            <% end %>
            <% if @user.respond_to?(:notif_sms) %>
              <label class="flex items-center justify-between gap-3 rounded-lg border p-3">
                <span class="text-sm font-medium text-slate-700"><%= t("admin.users.edit.form.prefs_sms") %></span>
                <%= f.check_box :notif_sms, { class: "toggle-switch" }, true, false %>
              </label>
            <% end %>
          </div>
        </div>

        <!-- Foto -->
        <div class="space-y-3">
          <p class="text-sm font-medium text-slate-700"><%= t("admin.users.edit.form.photo_label") %></p>
          <div class="rounded-lg border p-3 bg-slate-50 flex items-center gap-3">
            <%= image_tag(@user.photo&.url || image_path("placeholder-user.png"),
                          class: "w-16 h-16 rounded-full object-cover border", alt: "Foto") %>
            <div class="flex-1">
              <%= f.file_field :photo, class: "block w-full text-sm text-slate-700 file:mr-3 file:py-2 file:px-3 file:rounded-md file:border-0 file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100" %>
              <p class="text-xs text-slate-500 mt-1"><%= t("admin.users.edit.form.photo_hint") %></p>
            </div>
          </div>

          <% if current_user.owner? %>
            <div>
              <%= f.label :account_id, t("admin.users.edit.form.account"), class: "block text-sm font-medium text-slate-700" %>
              <%= f.collection_select :account_id, Account.all, :id, :name, {},
                    class: "mt-1 block w-full rounded-lg border-slate-300 shadow-sm focus:ring-emerald-500 focus:border-emerald-500" %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Password -->
      <div class="rounded-xl border p-5 bg-slate-50">
        <h2 class="text-sm font-semibold text-slate-700 mb-3"><%= t("admin.users.edit.form.password_section") %></h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <%= f.label :password, t("admin.users.edit.form.password"), class: "block text-sm font-medium text-slate-700" %>
            <%= f.password_field :password, autocomplete: "new-password", class: "mt-1 block w-full rounded-lg border-slate-300 shadow-sm focus:ring-emerald-500 focus:border-emerald-500" %>
            <p class="text-xs text-slate-500 mt-1"><%= t("admin.users.edit.form.password_hint") %></p>
          </div>
          <div>
            <%= f.label :password_confirmation, t("admin.users.edit.form.password_confirmation"), class: "block text-sm font-medium text-slate-700" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "mt-1 block w-full rounded-lg border-slate-300 shadow-sm focus:ring-emerald-500 focus:border-emerald-500" %>
          </div>
        </div>
      </div>

      <!-- Ações -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pt-4 border-t">
        <%= link_to t("admin.users.edit.back"), (defined?(admin_users_path) ? admin_users_path : :back),
            class: "inline-flex items-center justify-center px-4 py-2 rounded-md border border-slate-300 text-slate-700 hover:bg-slate-50" %>

        <%= f.submit t("admin.users.edit.form.save"),
            class: "inline-flex items-center justify-center px-4 py-2 rounded-md bg-emerald-600 text-white hover:bg-emerald-700 shadow-sm" %>
      </div>
    <% end %>
  </div>

  <!-- Zona de Perigo -->
  <% if current_user.owner? || (current_user.admin? && @user != current_user) %>
    <div class="bg-white rounded-xl border shadow-sm p-6">
      <h2 class="text-lg font-semibold text-rose-700 flex items-center gap-2">
        <span>🗑️</span> <%= t("admin.users.edit.danger.title") %>
      </h2>
      <p class="text-sm text-slate-600 mt-1"><%= t("admin.users.edit.danger.description") %></p>

      <div class="mt-4">
        <%= button_to t("admin.users.edit.danger.destroy"),
              [:admin, @user],
              method: :delete,
              data: { turbo_confirm: t("admin.users.edit.danger.confirm") },
              class: "px-4 py-2 rounded-md bg-rose-600 text-white hover:bg-rose-700" %>
      </div>
    </div>
  <% end %>
</div>

<style>
  .toggle-switch {
    appearance: none; -webkit-appearance: none; position: relative; width: 42px; height: 24px;
    background: #d1d5db; border-radius: 9999px; outline: none; cursor: pointer; transition: background .3s;
  }
  .toggle-switch:checked { background: #22c55e; }
  .toggle-switch:before { content: ''; position: absolute; top: 2px; left: 2px; width: 20px; height: 20px; background: #fff; border-radius: 9999px; transition: transform .3s; }
  .toggle-switch:checked:before { transform: translateX(18px); }
</style>
