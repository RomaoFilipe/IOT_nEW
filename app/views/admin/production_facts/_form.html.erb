<%= form_with model: [:admin, @fact], class: "space-y-4" do |f| %>
  <div class="grid grid-cols-2 gap-4">
    <div><%= f.label :period_start, t("production_facts.form.period_start") %><%= f.date_field :period_start, class:"input" %></div>
    <div><%= f.label :period_end, t("production_facts.form.period_end") %><%= f.date_field :period_end, class:"input" %></div>
    <div><%= f.label :target_output_kg, t("production_facts.form.target_output_kg") %><%= f.number_field :target_output_kg, step: 0.01, class:"input" %></div>
    <div><%= f.label :realized_output_kg, t("production_facts.form.realized_output_kg") %><%= f.number_field :realized_output_kg, step: 0.01, class:"input" %></div>
    <div><%= f.label :costs_eur, t("production_facts.form.costs_eur") %><%= f.number_field :costs_eur, step: 0.01, class:"input" %></div>
    <div><%= f.label :efficiency_pct, t("production_facts.form.efficiency_pct") %><%= f.number_field :efficiency_pct, step: 0.01, class:"input" %></div>
  </div>
  <%= f.submit t("production_facts.form.save"), class:"btn btn--on" %>
<% end %>
