<%= form_with model: field, local: true do |f| %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    
    <!-- Nome -->
    <div>
      <%= f.label :name, t("fields.form.labels.name"), class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :name, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm" %>
    </div>

    <!-- Tipo de Campo (automático, apenas leitura) -->
    <div>
      <label class="block text-sm font-medium text-gray-700"><%= t("fields.form.labels.farm_type_readonly") %></label>
      <input
        type="text"
        value="<%= t("field_types.#{current_user.account.farm_type}") %>"
        readonly
        class="mt-1 block w-full bg-gray-100 text-gray-600 border border-gray-300 rounded-md px-4 py-2 text-sm cursor-not-allowed" />
      <!-- Mantém o valor para o JS e para submissão -->
      <%= f.hidden_field :field_type, value: current_user.account.farm_type %>
    </div>

    <!-- Área -->
    <div>
      <%= f.label :area, t("fields.form.labels.area"), class: "block text-sm font-medium text-gray-700" %>
      <%= f.number_field :area, step: 0.01, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm" %>
    </div>

    <!-- Latitude -->
    <div>
      <%= f.label :latitude, t("fields.form.labels.latitude"), class: "block text-sm font-medium text-gray-700" %>
      <%= f.number_field :latitude, step: 0.00001, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm" %>
    </div>

    <!-- Longitude -->
    <div>
      <%= f.label :longitude, t("fields.form.labels.longitude"), class: "block text-sm font-medium text-gray-700" %>
      <%= f.number_field :longitude, step: 0.00001, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm" %>
    </div>

    <!-- Notas -->
    <div class="md:col-span-2">
      <%= f.label :notes, t("fields.form.labels.notes"), class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_area :notes, rows: 3, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm" %>
    </div>

    <!-- 🔁 Campos específicos para Aquacultura em Tanque -->
    <div id="aquaculture_fields" class="md:col-span-2" style="<%= current_user.account.farm_type == 'aquaculture_tank' ? '' : 'display:none' %>">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div>
          <%= f.label :species, t("fields.form.aquaculture_tank.species"), class: "block text-sm font-medium text-gray-700" %>
          <%= f.text_field :species, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm" %>
        </div>

        <div>
          <%= f.label :tank_volume, t("fields.form.aquaculture_tank.tank_volume"), class: "block text-sm font-medium text-gray-700" %>
          <%= f.number_field :tank_volume, step: 0.1, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm" %>
        </div>

        <div>
          <%= f.label :stocking_density, t("fields.form.aquaculture_tank.stocking_density"), class: "block text-sm font-medium text-gray-700" %>
          <%= f.number_field :stocking_density, step: 0.1, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm" %>
        </div>

        <div>
          <%= f.label :feeding_regime, t("fields.form.aquaculture_tank.feeding_regime"), class: "block text-sm font-medium text-gray-700" %>
          <%= f.text_field :feeding_regime, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm" %>
        </div>

        <div>
          <%= f.label :fish_placement_date, t("fields.form.aquaculture_tank.fish_placement_date"), class: "block text-sm font-medium text-gray-700" %>
          <%= f.date_field :fish_placement_date, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm" %>
        </div>

        <div>
          <%= f.label :estimated_harvest_date, t("fields.form.aquaculture_tank.estimated_harvest_date"), class: "block text-sm font-medium text-gray-700" %>
          <%= f.date_field :estimated_harvest_date, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm" %>
        </div>
      </div>
    </div>
  </div>

  <!-- Botões -->
  <div class="mt-6 flex justify-end gap-4">
    <%= link_to t("fields.form.buttons.cancel"), fields_path, class: "inline-block px-4 py-2 text-sm rounded-md bg-gray-100 hover:bg-gray-200" %>
    <%= f.submit t("fields.form.buttons.save"), class: "inline-block px-4 py-2 text-sm rounded-md bg-green-600 text-white hover:bg-green-700" %>
  </div>
<% end %>

<!-- Mostrar/ocultar campos de aquacultura dinamicamente -->
<script>
(function () {
  function selectEl() {
    // aceita field_type OU production_kind, conforme o teu form
    return document.querySelector("[name='field[field_type]'], [name='field[production_kind]']");
  }

  function toggleAquaFields() {
    var sel = selectEl();
    var block = document.getElementById("aquaculture_fields");
    if (!sel || !block) return;
    var v = sel.value;
    var show = (v === "aquaculture_tank" || v === "aquaculture_sea");
    // usa classList para não conflitar com estilos inline
    block.classList.toggle("hidden", !show);
  }

  function bind() {
    var sel = selectEl();
    if (!sel) return;
    sel.removeEventListener("change", toggleAquaFields);
    sel.addEventListener("change", toggleAquaFields);
    toggleAquaFields();
  }

  ["DOMContentLoaded", "turbo:load", "turbo:render", "turbo:frame-load"]
    .forEach(function (evt) { document.addEventListener(evt, bind); });
})();
</script>
