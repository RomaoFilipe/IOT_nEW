<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Fields Overview</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://api.mapbox.com/mapbox-gl-js/v2.6.1/mapbox-gl.js"></script>
  <link href="https://api.mapbox.com/mapbox-gl-js/v2.6.1/mapbox-gl.css" rel="stylesheet" />
  <style>
    .mini-map-container {
      position: relative;
      width: 100%;
      height: 144px !important;
    }

    .mini-map-container > div {
      width: 100%;
      height: 100%;
      border-radius: 0.5rem;
    }

    .mini-map-button {
      position: absolute;
      bottom: 0.5rem;
      right: 0.5rem;
      font-size: 0.75rem;
      background: white;
      color: #4B5563;
      border: 1px solid #D1D5DB;
      padding: 0.25rem 0.5rem;
      border-radius: 0.25rem;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
    }
  </style>
</head>
<body class="bg-gray-100">

  <div class="container mx-auto p-6">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-2xl font-bold text-gray-900">Fields Overview</h1>
      <div class="flex space-x-4">
        <div class="inline-flex h-10 items-center justify-center rounded-md bg-gray-200 p-1 text-gray-700">
          <button id="listViewBtn" type="button" class="tab-btn px-4 py-2 text-sm font-medium rounded-md">List View</button>
          <button id="mapViewBtn" type="button" class="tab-btn px-4 py-2 text-sm font-medium rounded-md">Map View</button>
        </div>
        <button class="px-4 py-2 border rounded-md text-gray-700 hover:bg-gray-100">Filter</button>
        <button onclick="toggleModal()" class="px-4 py-2 bg-green-600 text-white rounded-md">+ Add Field</button>
      </div>
    </div>

    <%= render 'fields/list_view' %>
    <%= render 'fields/map_view' %>

    <%= render 'fields/modal' %>
<div id="viewDetailsModal" class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50 hidden z-50">
  <div class="bg-white p-6 rounded-lg shadow-lg w-full max-w-5xl max-h-[90vh] overflow-hidden flex flex-col">
    <div class="flex justify-between items-center border-b pb-4">
      <h2 class="text-2xl font-semibold flex items-center gap-2" id="modalFieldName">Detalhes do Campo</h2>
      <button onclick="closeViewDetails()" class="text-gray-600 hover:text-black">X</button>
    </div>
    <div id="viewDetailsContent" class="overflow-y-auto flex-1 pr-1 mt-4">
      A carregar...
    </div>
  </div>
</div>



  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const listViewBtn = document.getElementById("listViewBtn");
      const mapViewBtn = document.getElementById("mapViewBtn");
      const listViewContainer = document.getElementById("listViewContainer");
      const mapViewContainer = document.getElementById("mapViewContainer");

      listViewBtn.addEventListener("click", () => {
        listViewContainer.classList.remove("hidden");
        mapViewContainer.classList.add("hidden");
        listViewBtn.classList.add("bg-white", "shadow-md");
        mapViewBtn.classList.remove("bg-white", "shadow-md");
      });

      mapViewBtn.addEventListener("click", () => {
        listViewContainer.classList.add("hidden");
        mapViewContainer.classList.remove("hidden");
        mapViewBtn.classList.add("bg-white", "shadow-md");
        listViewBtn.classList.remove("bg-white", "shadow-md");

        if (!window.mapInitialized) {
          initializeMapbox();
          window.mapInitialized = true;
        }
      });

      // Ativa o modo lista por padrão
      listViewBtn.click();

      initializeMiniMaps();
    });

    function toggleModal() {
      const modal = document.getElementById("addFieldModal");
      modal.classList.toggle("hidden");
    }

// ⚡ Correto: JS sempre no index, sem depender do conteúdo carregado
function setupViewDetailsTabs() {
  const buttons = document.querySelectorAll('#viewDetailsContent .tab-button');
  buttons.forEach(btn => {
    btn.addEventListener('click', function(e) {
      const tab = e.target.getAttribute('data-tab');
      document.querySelectorAll('#viewDetailsContent .tab-content').forEach(tabEl => tabEl.classList.add("hidden"));
      document.querySelector(`#viewDetailsContent #${tab}`).classList.remove("hidden");
      document.querySelectorAll('#viewDetailsContent .tab-button').forEach(btn => btn.classList.remove("active"));
      e.target.classList.add("active");
    });
  });
}

// A tua função toggleViewDetails já deve chamar isto após carregar o HTML via fetch:
function toggleViewDetails(fieldId) {
  const modal = document.getElementById("viewDetailsModal");
  const content = document.getElementById("viewDetailsContent");

  content.innerHTML = "Loading...";

  fetch(`/fields/${fieldId}`)
    .then(response => response.text())
    .then(html => {
      content.innerHTML = html;
      setupViewDetailsTabs(); // ⚡ Liga as tabs sempre após o conteúdo ser carregado
    })
    .catch(() => {
      content.innerHTML = "<p>Erro ao carregar detalhes.</p>";
    });

  modal.classList.remove("hidden");
}

function closeViewDetails() {
  const modal = document.getElementById("viewDetailsModal");
  modal.classList.add("hidden");
}

function deleteField(fieldId) {
  if (!confirm("Tens a certeza que queres eliminar este campo? Esta ação não pode ser anulada.")) return;

  fetch(`/fields/${fieldId}`, {
    method: 'DELETE',
    headers: {
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content'),
      'Accept': 'application/json'
    }
  }).then(response => {
    if (response.ok) {
      alert("Campo eliminado com sucesso!");
      document.getElementById("viewDetailsModal").classList.add("hidden");
      location.reload();
    } else {
      response.json().then(data => {
        const content = document.getElementById("viewDetailsContent");
        content.innerHTML = `<div class="bg-red-100 text-red-800 p-4 rounded-md mb-4">❌ ${data.message || "Erro ao eliminar campo."}</div>` + content.innerHTML;
      });
    }
  }).catch(() => {
    const content = document.getElementById("viewDetailsContent");
    content.innerHTML = `<div class="bg-red-100 text-red-800 p-4 rounded-md mb-4">❌ Erro ao contactar o servidor.</div>` + content.innerHTML;
  });
}


  </script>
</body>
</html>
