<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= t("fields.index.title") %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://api.mapbox.com/mapbox-gl-js/v2.6.1/mapbox-gl.js"></script>
  <link href="https://api.mapbox.com/mapbox-gl-js/v2.6.1/mapbox-gl.css" rel="stylesheet" />

  <style>
    .mini-map-container {
      position: relative;
      width: 100%;
      height: 144px !important;
    }

    .mini-map-container > div {
      width: 100%;
      height: 100%;
      border-radius: 0.5rem;
    }

    .mini-map-button {
      position: absolute;
      bottom: 0.5rem;
      right: 0.5rem;
      font-size: 0.75rem;
      background: white;
      color: #4B5563;
      border: 1px solid #D1D5DB;
      padding: 0.25rem 0.5rem;
      border-radius: 0.25rem;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
    }
  </style>
</head>
<body class="bg-gray-100">

<div class="max-w-7xl mx-auto p-4 sm:p-6">
  <!-- Header responsivo -->
  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4 mb-6">
    <h1 class="text-2xl font-bold text-gray-900"><%= t("fields.index.heading") %></h1>

    <div class="flex flex-wrap gap-2">
      <!-- Tabs -->
      <div class="inline-flex h-10 items-center justify-center rounded-md bg-gray-200 text-gray-700">
        <button id="listViewBtn" type="button" class="tab-btn px-4 py-2 text-sm font-medium rounded-md">
          <%= t("fields.index.list_view") %>
        </button>
        <button id="mapViewBtn" type="button" class="tab-btn px-4 py-2 text-sm font-medium rounded-md">
          <%= t("fields.index.map_view") %>
        </button>
      </div>

      <!-- Filter -->
      <button class="px-4 py-2 border rounded-md text-gray-700 hover:bg-gray-100 w-full sm:w-auto">
        <%= t("fields.index.filter") %>
      </button>

      <!-- Add Field -->
      <button onclick="toggleModal()" class="px-4 py-2 bg-green-600 text-white rounded-md w-full sm:w-auto">
        + <%= t("fields.index.add_field") %>
      </button>
    </div>
  </div>

  <!-- Partials -->
  <%= render 'fields/list_view' %>
  <%= render 'fields/map_view' %>
  <%= render 'fields/modal' %>

  <% @fields.each do |field| %>
    <%= render partial: 'fields/view_details', locals: { field: field } %>
  <% end %>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const listViewBtn = document.getElementById("listViewBtn");
    const mapViewBtn = document.getElementById("mapViewBtn");
    const listViewContainer = document.getElementById("listViewContainer");
    const mapViewContainer = document.getElementById("mapViewContainer");

    listViewBtn.addEventListener("click", () => {
      listViewContainer.classList.remove("hidden");
      mapViewContainer.classList.add("hidden");
      listViewBtn.classList.add("bg-white", "shadow-md");
      mapViewBtn.classList.remove("bg-white", "shadow-md");
    });

    mapViewBtn.addEventListener("click", () => {
      listViewContainer.classList.add("hidden");
      mapViewContainer.classList.remove("hidden");
      mapViewBtn.classList.add("bg-white", "shadow-md");
      listViewBtn.classList.remove("bg-white", "shadow-md");

      if (!window.mapInitialized) {
        initializeMapbox();
        window.mapInitialized = true;
      }
    });

    // Iniciar com lista visível
    listViewBtn.click();

    initializeMiniMaps();
  });

  function toggleModal() {
    const modal = document.getElementById("addFieldModal");
    modal.classList.toggle("hidden");
  }

  function toggleViewDetails(id) {
    document.querySelectorAll('[id^="viewDetailsModal-"]').forEach(modal => modal.classList.add("hidden"));
    const target = document.getElementById(`viewDetailsModal-${id}`);
    if (target) target.classList.toggle("hidden");
  }
</script>

</body>
</html>
