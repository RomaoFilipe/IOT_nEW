<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Farm Operations Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Adicionando Mapbox -->
    <script src="https://api.mapbox.com/mapbox-gl-js/v2.6.1/mapbox-gl.js"></script>
    <link href="https://api.mapbox.com/mapbox-gl-js/v2.6.1/mapbox-gl.css" rel="stylesheet" />
</head>
<body>
<div class="container mx-auto p-6">
  <!-- Título e Opções -->
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Fields Overview</h1>

    <div class="flex space-x-4">
      <div class="inline-flex h-10 items-center justify-center rounded-md bg-gray-200 p-1 text-gray-700">
        <button id="listViewBtn" type="button" class="tab-btn px-4 py-2 text-sm font-medium rounded-md focus:outline-none transition-all">
          List View
        </button>
        <button id="mapViewBtn" type="button" class="tab-btn px-4 py-2 text-sm font-medium rounded-md focus:outline-none transition-all">
          Map View
        </button>
      </div>
      <button class="px-4 py-2 border rounded-md text-gray-700 hover:bg-gray-100">Filter</button>
      <button onclick="toggleModal()" class="px-4 py-2 bg-green-600 text-white rounded-md">+ Add Field</button>
    </div>
  </div>

<!-- LIST VIEW (INICIALMENTE VISÍVEL) -->
<div id="listViewContainer">
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 justify-center">
    <% @fields.each do |field| %>
      <div class="field-card">
        <div class="relative flex items-center justify-center bg-gray-100 h-36">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400">
            <path d="M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z"/>
            <path d="M15 5.764v15"/>
            <path d="M9 3.236v15"/>
          </svg>
        </div>

        <div class="field-content">
          <h2 class="field-title"><%= field.name %></h2>
          <p><strong>Crop:</strong> <%= field.field_type %></p>
          <p><strong>Location:</strong> <%= field.formatted_location %></p>
          <p><strong>Area:</strong> <%= field.area %> ha</p>

          <!-- Indicadores de sensores -->
          <div class="sensor-info flex justify-between items-center mt-4">
            <p class="field-info flex items-center">
              <i class="bi bi-droplet-fill text-blue-500 mr-2"></i> <%= rand(40..80) %>%
            </p>
            <p class="field-info flex items-center">
              <i class="bi bi-thermometer-half text-red-500 mr-2"></i> <%= rand(20..30) %>°C
            </p>
          </div>

          <!-- Última atualização -->
          <p class="last-updated text-sm text-gray-600 mt-2">
            Last updated: <%= time_ago_in_words(field.updated_at) %> ago
          </p>

          <!-- Botão "View Details" -->
          <div class="mt-4">
            <button 
              class="px-4 py-2 bg-green-700 text-white rounded-md w-full" 
              onclick="toggleViewDetails(<%= field.id %>)">
              View Details
            </button>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>

<!-- MAP VIEW (INICIALMENTE ESCONDIDO) -->
<div id="mapViewContainer" class="hidden">
  <div id="map" class="w-full h-96 rounded-lg shadow-lg"></div>
  <div id="fieldDetailsContainer" class="mt-4 p-4 border rounded-md bg-white shadow-md hidden">
    <h3 id="fieldName" class="text-xl font-bold"></h3>
    <p><strong>Crop:</strong> <span id="fieldCrop"></span></p>
    <p><strong>Area:</strong> <span id="fieldArea"></span> ha</p>
    <p><strong>Last Updated:</strong> <span id="fieldUpdated"></span></p>
  </div>
</div>

<%= render 'fields/modal' %>
<%= render 'fields/view_details' %>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const listViewBtn = document.getElementById("listViewBtn");
  const mapViewBtn = document.getElementById("mapViewBtn");
  const listViewContainer = document.getElementById("listViewContainer");
  const mapViewContainer = document.getElementById("mapViewContainer");

  function setActive(button) {
    document.querySelectorAll(".tab-btn").forEach(btn => {
      btn.classList.remove("bg-white", "shadow-md");
    });
    button.classList.add("bg-white", "shadow-md");
  }

  listViewBtn.addEventListener("click", () => {
    setActive(listViewBtn);
    listViewContainer.classList.remove("hidden");
    mapViewContainer.classList.add("hidden");
  });

  mapViewBtn.addEventListener("click", () => {
    setActive(mapViewBtn);
    listViewContainer.classList.add("hidden");
    mapViewContainer.classList.remove("hidden");

    if (!window.mapInitialized) {
      initializeMapbox();
      window.mapInitialized = true;
    }
  });

  setActive(listViewBtn);
  listViewContainer.classList.remove("hidden");
  mapViewContainer.classList.add("hidden");
});

function initializeMapbox() {
  mapboxgl.accessToken = 'pk.eyJ1Ijoicm9tYW9maWxpcGUiLCJhIjoiY204Mzd0dDV4MGw2NjJqc2FnemFvNjdhNiJ9.eij5JSF01xc0MChaIjhLTA';

  const map = new mapboxgl.Map({
    container: "map",
    style: "mapbox://styles/romaofilipe/cm8ft8p27008g01qw5i4ngmki",
    center: [-98.4936, 29.4241],
    zoom: 12,
  });

  const fields = <%= raw @fields.to_json %>;

  fields.forEach((field) => {
    const marker = new mapboxgl.Marker({ color: "blue" })
      .setLngLat([field.longitude, field.latitude])
      .setPopup(new mapboxgl.Popup().setText(field.name))
      .addTo(map);

    marker.getElement().addEventListener("click", () => {
      document.getElementById("fieldName").innerText = field.name;
      document.getElementById("fieldCrop").innerText = field.field_type;
      document.getElementById("fieldArea").innerText = field.area;
      document.getElementById("fieldUpdated").innerText = field.updated_at;
      fieldDetailsContainer.classList.remove("hidden");
    });
  });
}

// ✅ Mover esta função para fora
function toggleViewDetails(fieldId = null) {
  const modal = document.getElementById("viewDetailsModal");
  modal.classList.toggle("hidden");

  if (fieldId) {
    console.log("Abrir detalhes do campo com ID:", fieldId);
    // (Opcional: fetch dinâmico aqui)
  }
}
</script>


</body>
</html>
