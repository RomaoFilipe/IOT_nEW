<% field_id = (defined?(field) && field.present?) ? field.id : "dynamic" %>

<div id="viewDetailsModal-<%= field_id %>"
     class="fixed inset-0 z-50 hidden"
     aria-modal="true"
     role="dialog"
     aria-labelledby="fd-title-<%= field_id %>">

  <!-- overlay -->
  <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm" onclick="closeFieldModal('<%= field_id %>')"></div>

  <!-- card -->
  <div class="relative mx-auto my-6 w-[min(92vw,1000px)] max-h-[92vh] overflow-y-auto rounded-2xl bg-white shadow-2xl">
    <!-- header -->
    <div class="sticky top-0 z-10 flex items-center justify-between gap-3 border-b bg-white/90 px-5 py-4 backdrop-blur">
      <div class="min-w-0">
        <h2 id="fd-title-<%= field_id %>" class="flex items-center gap-2 text-lg sm:text-xl font-semibold text-slate-900 truncate">
          <i class="lucide lucide-map w-5 h-5 text-emerald-600"></i>
          <span id="modalFieldName" class="truncate"><%= field&.name || t('fields.common.field', default: 'Field') %></span>
        </h2>

        <% status_text = field&.status.presence || t('common.unknown', default: 'Unknown') %>
        <% good = %w[ativo active running ok good].include?(status_text.to_s.downcase) %>
        <span class="mt-1 inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-xs font-medium ring-1
                     <%= good ? 'bg-emerald-50 text-emerald-700 ring-emerald-200' : 'bg-amber-50 text-amber-700 ring-amber-200' %>">
          <span class="text-[10px]">●</span> <%= status_text %>
        </span>
      </div>

      <button type="button"
              class="shrink-0 rounded-full p-2 text-slate-500 hover:bg-slate-100 hover:text-slate-700"
              aria-label="<%= t('common.close', default: 'Close') %>"
              onclick="closeFieldModal('<%= field_id %>')">
        <i class="lucide lucide-x w-5 h-5"></i>
      </button>
    </div>

    <!-- tabs -->
    <div class="px-5 pt-4">
      <div class="mx-auto w-full max-w-md rounded-xl bg-slate-50 p-1 text-sm font-medium shadow-inner">
        <div class="grid grid-cols-3 gap-1">
          <button id="tab-overview-<%= field_id %>"
                  class="tab-button active"
                  onclick="showFieldTab('<%= field_id %>', 'overview')">
            <%= t('fields.modal.tabs.overview', default: t('common.overview', default: 'Overview')) %>
          </button>
          <button id="tab-iot-equipment-<%= field_id %>"
                  class="tab-button"
                  onclick="showFieldTab('<%= field_id %>', 'iot-equipment')">
            <%= t('iot_equipment.title', default: 'IoT Equipment') %>
          </button>
          <button id="tab-analytics-<%= field_id %>"
                  class="tab-button"
                  onclick="showFieldTab('<%= field_id %>', 'analytics')">
            <%= t('navbar.analytics', default: 'Analytics') %>
          </button>
        </div>
      </div>
    </div>

    <!-- content -->
    <div class="px-5 pb-5">
      <div id="overview-<%= field_id %>" class="tab-content mt-5">
        <%= render partial: "fields/overviews/#{field.field_type}", locals: { field: field } %>
      </div>

      <div id="iot-equipment-<%= field_id %>" class="tab-content mt-5 hidden">
        <%= render partial: "fields/tabs/iot_equipment", locals: { field: field } %>
      </div>

      <div id="analytics-<%= field_id %>" class="tab-content mt-5 hidden">
        <%= render partial: "fields/tabs/analytics", locals: { field: field } %>
      </div>

      <!-- actions -->
      <div class="mt-6 flex flex-col gap-2 sm:flex-row sm:justify-end">
        <button class="btn-secondary"><%= t('fields.modal.actions.schedule_task', default: 'Schedule Task') %></button>
        <button class="btn-secondary"><%= t('fields.modal.actions.view_history', default: 'View History') %></button>
        <button class="btn-primary"><%= t('fields.modal.actions.generate_report', default: 'Generate Report') %></button>
      </div>

      <!-- danger zone -->
      <div class="mt-6">
        <%= button_to field_path(field),
              method: :delete,
              data: { turbo_confirm: t('fields.modal.delete.confirm', default: 'Are you sure you want to delete this field? This action cannot be undone.') },
              class: "inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-md bg-rose-600 px-4 py-2 font-medium text-white shadow hover:bg-rose-700" do %>
          <i class="lucide lucide-trash-2 w-4 h-4"></i> <%= t('fields.modal.delete.button', default: 'Delete Field') %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<style>
  .tab-button{
    width:100%;
    border-radius:.5rem;
    padding:.625rem .75rem;
    text-align:center;
    transition:all .15s ease;
    color:#334155; /* slate-700 */
    background:transparent;
  }
  .tab-button:hover{ color:#047857; } /* emerald-700 */
  .tab-button.active{
    background:#fff;
    box-shadow:0 1px 2px rgba(15,23,42,.06);
    color:#0f172a; /* slate-900 */
    font-weight:600;
  }
  .btn-primary{
    border-radius:.375rem;
    background:#059669; /* emerald-600 */
    padding:.5rem 1rem;
    color:#fff;
    font-weight:500;
    box-shadow:0 1px 2px rgba(15,23,42,.06);
  }
  .btn-primary:hover{ background:#047857; } /* emerald-700 */
  .btn-secondary{
    border-radius:.375rem;
    background:#0f172a; /* slate-900-ish */
    padding:.5rem 1rem;
    color:#fff;
    font-weight:500;
    box-shadow:0 1px 2px rgba(15,23,42,.06);
  }
  .btn-secondary:hover{ background:#111827; } /* slightly darker */
  [id^="viewDetailsModal-"] .mapboxgl-control-container,
  [id^="viewDetailsModal-"] .mapboxgl-canvas-container,
  [id^="viewDetailsModal-"] .mapboxgl-marker,
  }
</style>

<script>
  // Abre/fecha modal
  function closeFieldModal(id){
    const m = document.getElementById(`viewDetailsModal-${id}`);
    if (m) m.classList.add('hidden');
  }

  function openFieldModal(id){
    const m = document.getElementById(`viewDetailsModal-${id}`);
    if (!m) return;

    m.classList.remove('hidden');
    showFieldTab(id, 'overview'); // abre sempre na primeira tab

    // === IMPORTANTE: criar/redimensionar o mapa depois do modal ficar visível ===
    requestAnimationFrame(() => {
      if (window.ensureAgricultureMap) window.ensureAgricultureMap(id);
      if (window.resizeMapsInside) window.resizeMapsInside(m);
    });
  }

  // Tabs
  function showFieldTab(id, tab){
    const root = document.getElementById(`viewDetailsModal-${id}`);
    if (!root) return;

    // toggle contents
    root.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
    const current = root.querySelector(`#${tab}-${id}`);
    if (current) current.classList.remove('hidden');

    // toggle buttons
    root.querySelectorAll('.tab-button').forEach(btn => btn.classList.remove('active'));
    const btn = root.querySelector(`#tab-${tab}-${id}`);
    if (btn) btn.classList.add('active');

    // se houver mapas nesta tab agora visível, faz resize
    requestAnimationFrame(() => {
      if (window.resizeMapsInside) window.resizeMapsInside(current);
    });
  }

  // Fechar com ESC
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll('[id^="viewDetailsModal-"]').forEach(m => m.classList.add('hidden'));
    }
  });
</script>

<link href="https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.css" rel="stylesheet">
<script src="https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.js"></script>
