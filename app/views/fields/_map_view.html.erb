<!-- app/views/fields/_map_view.html.erb -->
<div class="bg-gray-50 p-4 rounded-lg shadow-md">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- Mapa -->
    <div class="lg:col-span-2 relative">
      <div id="fields-main-map" class="w-full h-[420px] lg:h-[600px] rounded-lg shadow"></div>

      <!-- Controles -->
      <div class="absolute top-4 left-4 flex flex-col space-y-2 z-10">
        <button onclick="setMapStyle('satellite-streets-v12')" class="bg-gray-800 text-white rounded px-3 py-1.5 shadow hover:bg-gray-900 transition">Satellite</button>
        <button onclick="setMapStyle('outdoors-v12')"          class="bg-white text-gray-800 rounded px-3 py-1.5 shadow hover:bg-gray-100 transition">Terrain</button>
        <button onclick="toggleSensors()"                      class="bg-white text-gray-800 rounded px-3 py-1.5 shadow hover:bg-gray-100 transition">Sensors</button>
        <button onclick="fitAll()"                             class="bg-white text-gray-800 rounded px-3 py-1.5 shadow hover:bg-gray-100 transition">Todos</button>
      </div>

      <!-- Legenda -->
      <div class="absolute bottom-4 left-4 bg-white p-3 rounded shadow-md text-sm z-10">
        <p class="font-semibold mb-2">Legenda</p>
        <ul class="space-y-1">
          <li><span class="inline-block w-3 h-3 bg-emerald-500 rounded-full"></span> Bom estado</li>
          <li><span class="inline-block w-3 h-3 bg-amber-400 rounded-full"></span> Atenção</li>
          <li><span class="inline-block w-3 h-3 bg-blue-500 rounded-full"></span> Sensor Humidade</li>
        </ul>
      </div>
    </div>

    <!-- Coluna de detalhes -->
    <div class="flex flex-col space-y-4">
      <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200">
        <h3 class="text-xl font-semibold text-gray-800 border-b pb-2 mb-4">Detalhes do Campo</h3>
        <div class="space-y-3 text-gray-700 text-sm">
          <p><span class="font-medium">Nome:</span> <span id="fieldName">—</span></p>
          <p><span class="font-medium">Cultura:</span> <span id="fieldCrop">—</span></p>
          <p><span class="font-medium">Área:</span> <span id="fieldArea">—</span> ha</p>
          <p><span class="font-medium">Latitude:</span> <span id="fieldLat">—</span></p>
          <p><span class="font-medium">Longitude:</span> <span id="fieldLng">—</span></p>
          <p><span class="font-medium">Última atualização:</span> <span id="fieldUpdated">—</span></p>
        </div>
      </div>

      <div class="bg-white p-4 rounded-lg shadow-md border border-gray-200 overflow-y-auto max-h-60">
        <div class="flex items-center justify-between gap-2 mb-3">
          <h3 class="text-lg font-semibold text-gray-800">Lista de Campos</h3>
          <button class="text-sm px-2 py-1 border rounded hover:bg-gray-50" onclick="fitAll()">Todos</button>
        </div>

        <div class="mb-3">
          <input id="fieldSearch" type="text" placeholder="Procurar por nome..." class="w-full border rounded px-3 py-2 text-sm" oninput="filterFieldsList(this.value)">
        </div>

        <ul id="fieldsList" class="divide-y divide-gray-200">
          <% @fields.each do |field| %>
            <li class="py-2 flex justify-between items-center" data-field-item="true" data-name="<%= field.name.to_s.downcase %>">
              <span class="text-gray-700 font-medium"><%= field.name %></span>
              <div class="flex items-center gap-2">
                <button class="text-sm text-blue-500 hover:text-blue-700 transition" onclick="focusFieldById(<%= field.id %>)">Ver no mapa</button>
                <button class="text-sm text-gray-600 hover:text-gray-800" onclick="toggleSensors(true)">Sensores</button>
              </div>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</div>

<style>
  @media (max-width: 640px) { #fields-main-map { height: 400px !important; } }
  .center-marker { width:16px; height:16px; border-radius:50%; background-color:#3b82f6; border:2px solid #fff; box-shadow:0 0 0 2px #3b82f6; z-index:10; position:relative; }
  .pulse-marker::after { content:''; position:absolute; width:100%; height:100%; border-radius:50%; background:rgba(59,130,246,.4); animation:pulse 1.5s ease-out infinite; z-index:5; }
  @keyframes pulse { 0%{transform:scale(1);opacity:.8} 70%{transform:scale(2.5);opacity:0} 100%{opacity:0} }
  .marker-highlight { box-shadow: 0 0 0 4px rgba(16,185,129,.6) !important; border-radius: 9999px; }
</style>

<script>
if (window.__FIELDS_MAP_INIT__) { /* já inicializado, não repetir */ }
else { window.__FIELDS_MAP_INIT__ = true;

  // ====== Dados ======
  window.fieldData = <%= raw @fields.to_json(only: [:id, :name, :field_type, :area, :latitude, :longitude, :updated_at], methods: [:polygon_coordinates]) %>;
  window.fieldData = (window.fieldData || []).map(f => ({
    ...f,
    id: Number(f.id),
    latitude: (f.latitude == null ? null : Number(f.latitude)),
    longitude:(f.longitude == null ? null : Number(f.longitude))
  }));

  // Globais idempotentes
  window.__fieldMarkers   ??= new Map();
  window.__polygonIds     ??= new Set();
  window.__sensorMarkers  ??= [];
  window.__sensorsVisible ??= false;
  window.__selectedFieldId??= null;

  // ====== Helpers ======
  window.whenMapReady ??= function(map, cb){
    if (!map || typeof cb !== 'function') return;
    if (map.loaded?.() && map.isStyleLoaded?.()) { cb(); return; }
    const once = () => { map.off('idle', once); cb(); };
    map.on('idle', once);
  };
  function getPolygonCenter(coords) {
    let lngSum = 0, latSum = 0;
    coords.forEach(c => { lngSum += c[0]; latSum += c[1]; });
    return [lngSum / coords.length, latSum / coords.length];
  }

  // ====== Init map ======
  function onAfterStyleLoad(map){
    addTerrainAndShading(map);
    renderFieldsOnMap(map);
    if (window.__sensorsVisible) toggleSensors(true);
    map.resize();
  }

  function initMainMapIfNeeded() {
    if (window.mainFieldsMap) return window.mainFieldsMap;

    mapboxgl.accessToken = 'pk.eyJ1Ijoicm9tYW9maWxpcGUiLCJhIjoiY204cmpmYzNnMHhkbDJqc2F2enFsZDRxYSJ9.lzMeVTGloDJlV1RHoitdjA';

    const map = new mapboxgl.Map({
      container: "fields-main-map",
      style: "mapbox://styles/mapbox/outdoors-v12",
      center: [-8.611, 41.145],
      zoom: 6,
      antialias: true
    });

    map.addControl(new mapboxgl.NavigationControl({ showCompass: true }), 'top-right');
    map.addControl(new mapboxgl.GeolocateControl({ positionOptions: { enableHighAccuracy: true }, showUserHeading: true }), 'top-right');

    map.on("style.load", () => onAfterStyleLoad(map));

    // Turbo: limpar antes de cache para evitar instâncias penduradas
    document.addEventListener('turbo:before-cache', () => {
      try { map.remove(); } catch(_) {}
      window.mainFieldsMap = null;
    });

    window.mainFieldsMap = map;
    return map;
  }
  window.initMainMapIfNeeded = initMainMapIfNeeded;
  window.initializeMapbox    = initMainMapIfNeeded;

  // ====== Terreno/Sombras ======
  function addTerrainAndShading(map) {
    if (!map.getSource("mapbox-dem")) {
      map.addSource("mapbox-dem", { type: "raster-dem", url: "mapbox://mapbox.terrain-rgb", tileSize: 512, maxzoom: 14 });
      map.setTerrain({ source: "mapbox-dem", exaggeration: 1.2 });
      if (!map.getLayer("hillshading")) map.addLayer({ id: "hillshading", source: "mapbox-dem", type: "hillshade" });
    }
  }

  // ====== Campos (marcador + polígono cor/outline) ======
  function renderFieldsOnMap(map) {
    // limpar anteriores
    window.__fieldMarkers.forEach(m => m.remove());
    window.__fieldMarkers.clear();
    window.__polygonIds.forEach(pid => {
      if (map.getLayer(pid + "-fill"))     map.removeLayer(pid + "-fill");
      if (map.getLayer(pid + "-outline"))  map.removeLayer(pid + "-outline");
      if (map.getSource(pid))              map.removeSource(pid);
    });
    window.__polygonIds.clear();

    let bounds = null;

    (window.fieldData || []).forEach(field => {
      // marcador
      if (typeof field.latitude === 'number' && typeof field.longitude === 'number') {
        const marker = new mapboxgl.Marker({ color: "#2563eb" })
          .setLngLat([field.longitude, field.latitude])
          .setPopup(new mapboxgl.Popup({ offset: 12 }).setText(field.name))
          .addTo(map);
        marker.getElement().addEventListener("click", () => showFieldDetails(field));
        window.__fieldMarkers.set(field.id, marker);

        if (!bounds) bounds = new mapboxgl.LngLatBounds([field.longitude, field.latitude], [field.longitude, field.latitude]);
        else bounds.extend([field.longitude, field.latitude]);
      }

      // polígono
      if (Array.isArray(field.polygon_coordinates) && field.polygon_coordinates.length >= 3) {
        const pid  = `field-poly-${field.id}`;
        const poly = { type:"Feature", geometry:{ type:"Polygon", coordinates:[[...field.polygon_coordinates, field.polygon_coordinates[0]]] } };

        map.addSource(pid, { type: "geojson", data: poly });
        map.addLayer({ id:`${pid}-fill`,    type:"fill", source:pid, paint:{ "fill-color":"#3b82f6", "fill-opacity":0.20 }});
        map.addLayer({ id:`${pid}-outline`, type:"line", source:pid, paint:{ "line-color":"#1e40af", "line-width":2 }});

        window.__polygonIds.add(pid);
      }
    });

    if (bounds) map.fitBounds(bounds, { padding: 32, duration: 700 });
  }

  // ====== Detalhes ======
  function showFieldDetails(field) {
    document.getElementById("fieldName").innerText    = field.name || '—';
    document.getElementById("fieldCrop").innerText    = (field.field_type || '—');
    document.getElementById("fieldArea").innerText    = (field.area || '—');
    document.getElementById("fieldLat").innerText     = (field.latitude ?? '—');
    document.getElementById("fieldLng").innerText     = (field.longitude ?? '—');
    document.getElementById("fieldUpdated").innerText = field.updated_at ? new Date(field.updated_at).toLocaleString() : '—';
  }

  // ====== Estilo ======
  function setMapStyle(styleId) {
    const map = initMainMapIfNeeded();
    map.setStyle(`mapbox://styles/mapbox/${styleId}`);
    map.once("style.load", () => onAfterStyleLoad(map));
  }
  window.setMapStyle = setMapStyle;

  // ====== Highlight ======
  function highlightFieldPolygon(map, field) {
    ["field-highlight-fill","field-highlight-outline"].forEach(id => { if (map.getLayer(id)) map.removeLayer(id); });
    if (map.getSource("field-highlight")) map.removeSource("field-highlight");

    if (Array.isArray(field.polygon_coordinates) && field.polygon_coordinates.length >= 3) {
      const poly = { type:"Feature", geometry:{ type:"Polygon", coordinates:[[...field.polygon_coordinates, field.polygon_coordinates[0]]] } };
      map.addSource("field-highlight", { type:"geojson", data: poly });
      map.addLayer({ id:"field-highlight-fill",    type:"fill", source:"field-highlight",  paint:{ "fill-color":"#10b981", "fill-opacity":0.40 }});
      map.addLayer({ id:"field-highlight-outline", type:"line", source:"field-highlight",  paint:{ "line-color":"#065f46", "line-width":2 }});
    }

    const m = window.__fieldMarkers.get(field.id);
    if (m?.getElement) {
      const el = m.getElement();
      el.classList.add("marker-highlight");
      setTimeout(() => el.classList.remove("marker-highlight"), 1200);
    }
  }

  // ====== Focus por ID (espera mapa pronto) ======
  window.focusFieldById = function(fieldId, opts = {}) {
    const map = initMainMapIfNeeded(); if (!map) return;

    const idNum = Number(fieldId);
    const f = (window.fieldData || []).find(x => Number(x.id) === idNum);
    if (!f) { console.warn("[focusFieldById] Campo não encontrado:", fieldId); return; }

    let center = null;
    if (typeof f.longitude === 'number' && typeof f.latitude === 'number') center = [f.longitude, f.latitude];
    else if (Array.isArray(f.polygon_coordinates) && f.polygon_coordinates.length >= 3) center = getPolygonCenter(f.polygon_coordinates);
    if (!center) { console.warn("[focusFieldById] Sem coordenadas:", f); return; }

    window.whenMapReady(map, () => {
      try { map.stop(); } catch(_) {}
      map.flyTo({ center, zoom: (opts.zoom ?? 15), essential: true });
      showFieldDetails(f);
      window.__selectedFieldId = idNum;
      highlightFieldPolygon(map, f);

      const url = new URL(location);
      url.searchParams.set('view', 'map');
      url.searchParams.set('field', String(idNum));
      history.replaceState({}, '', url);
    });
  };

  // ====== Fit a todos ======
  window.fitAll = function() {
    const map = initMainMapIfNeeded(); if (!map) return;
    let b = null;
    (window.fieldData || []).forEach(f => {
      if (typeof f.latitude === 'number' && typeof f.longitude === 'number') {
        if (!b) b = new mapboxgl.LngLatBounds([f.longitude, f.latitude], [f.longitude, f.latitude]);
        else b.extend([f.longitude, f.latitude]);
      }
    });
    if (!b) return;
    const apply = () => map.fitBounds(b, { padding: 32, duration: 700 });
    (map.loaded?.() && map.isStyleLoaded?.()) ? apply() : map.once('idle', apply);
  };

  // ====== Sensores (demo) ======
  function initializeSensors() {
    if (window.__sensorMarkers.length) return;
    (window.fieldData || []).forEach(f => {
      if (typeof f.latitude === 'number' && typeof f.longitude === 'number') {
        const el = document.createElement("div");
        el.className = "w-3.5 h-3.5 rounded-full";
        el.style.backgroundColor = "#22c55e";
        const m = new mapboxgl.Marker(el).setLngLat([f.longitude + 0.002, f.latitude + 0.002]);
        window.__sensorMarkers.push(m);
      }
    });
  }
  window.toggleSensors = function(forceOn) {
    const map = initMainMapIfNeeded();
    initializeSensors();
    const turnOn = forceOn === true ? true : !window.__sensorsVisible;
    if (turnOn) { window.__sensorMarkers.forEach(m => m.addTo(map)); window.__sensorsVisible = true; }
    else       { window.__sensorMarkers.forEach(m => m.remove());  window.__sensorsVisible = false; }
  };

  // ====== Pesquisa ======
  window.filterFieldsList = function(q){
    const query = (q || "").trim().toLowerCase();
    document.querySelectorAll('[data-field-item="true"]').forEach(li => {
      const name = li.dataset.name || "";
      li.style.display = (!query || name.includes(query)) ? "" : "none";
    });
  };

  // ====== Deep-link ======
  document.addEventListener("turbo:load", () => {
    const params = new URLSearchParams(location.search);
    if (params.get("view") === "map") {
      const map = initMainMapIfNeeded();
      setTimeout(() => { map?.resize?.(); }, 60);
      const fieldId = parseInt(params.get("field"), 10);
      if (!Number.isNaN(fieldId)) setTimeout(() => focusFieldById(fieldId, { zoom: 15 }), 150);
    }
  });

} // fim guard
</script>
