<!-- app/views/fields/_map_view.html.erb -->
<div class="bg-gray-50 p-4 rounded-lg shadow-md">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- Mapa -->
    <div class="lg:col-span-2 relative">
      <div id="fields-main-map" class="w-full h-[420px] lg:h-[600px] rounded-lg shadow"></div>

      <!-- Controles do mapa -->
      <div class="absolute top-4 left-4 flex flex-col space-y-2 z-10">
        <button onclick="setMapStyle('satellite-streets-v12')"
                class="bg-gray-800 text-white rounded px-3 py-1.5 shadow hover:bg-gray-900 transition">Satellite</button>
        <button onclick="setMapStyle('outdoors-v12')"
                class="bg-white text-gray-800 rounded px-3 py-1.5 shadow hover:bg-gray-100 transition">Terrain</button>

        <!-- Cluster ON/OFF -->
        <button onclick="toggleCluster()"
                class="bg-gray-800 text-white rounded px-3 py-1.5 shadow hover:bg-gray-900 transition">Cluster</button>

        <!-- Sensores (marcadores simples) -->
        <button onclick="toggleSensors()"
                class="bg-white text-gray-800 rounded px-3 py-1.5 shadow hover:bg-gray-100 transition">Sensors</button>

        <!-- Fit -->
        <button onclick="fitAll()"
                class="bg-white text-gray-800 rounded px-3 py-1.5 shadow hover:bg-gray-100 transition">Todos</button>
      </div>

      <!-- Painel de edição de polígono -->
      <div class="absolute bottom-4 right-4 bg-white/95 backdrop-blur p-3 rounded shadow-md text-sm z-10 flex items-center gap-2">
        <button onclick="startPolygonEdit()"
                class="px-3 py-1.5 rounded border hover:bg-gray-50">Editar polígono</button>
        <button onclick="savePolygonEdit()"
                class="px-3 py-1.5 rounded bg-emerald-600 text-white hover:bg-emerald-700">Guardar</button>
        <button onclick="cancelPolygonEdit()"
                class="px-3 py-1.5 rounded border hover:bg-gray-50">Cancelar</button>
      </div>

      <!-- Legenda -->
      <div class="absolute bottom-4 left-4 bg-white p-3 rounded shadow-md text-sm z-10">
        <p class="font-semibold mb-2">Legenda</p>
        <ul class="space-y-1">
          <li><span class="inline-block w-3 h-3 bg-emerald-500 rounded-full"></span> Bom estado</li>
          <li><span class="inline-block w-3 h-3 bg-amber-400 rounded-full"></span> Atenção</li>
          <li><span class="inline-block w-3 h-3 bg-blue-500 rounded-full"></span> Sensor Humidade</li>
        </ul>
      </div>
    </div>

    <!-- Coluna de detalhes -->
    <div class="flex flex-col space-y-4">

      <!-- Detalhes do campo -->
      <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200">
        <h3 class="text-xl font-semibold text-gray-800 border-b pb-2 mb-4">Detalhes do Campo</h3>
        <div class="space-y-3 text-gray-700 text-sm">
          <p><span class="font-medium">Nome:</span> <span id="fieldName">—</span></p>
          <p><span class="font-medium">Cultura:</span> <span id="fieldCrop">—</span></p>
          <p><span class="font-medium">Área:</span> <span id="fieldArea">—</span> ha</p>
          <p><span class="font-medium">Latitude:</span> <span id="fieldLat">—</span></p>
          <p><span class="font-medium">Longitude:</span> <span id="fieldLng">—</span></p>
          <p><span class="font-medium">Última atualização:</span> <span id="fieldUpdated">—</span></p>
        </div>
      </div>

      <!-- Lista de campos -->
      <div class="bg-white p-4 rounded-lg shadow-md border border-gray-200 overflow-y-auto max-h-60">
        <div class="flex items-center justify-between gap-2 mb-3">
          <h3 class="text-lg font-semibold text-gray-800">Lista de Campos</h3>
          <button class="text-sm px-2 py-1 border rounded hover:bg-gray-50" onclick="fitAll()">Todos</button>
        </div>

        <div class="mb-3">
          <input id="fieldSearch" type="text" placeholder="Procurar por nome..."
                 class="w-full border rounded px-3 py-2 text-sm"
                 oninput="filterFieldsList(this.value)">
        </div>

        <ul id="fieldsList" class="divide-y divide-gray-200">
          <% @fields.each do |field| %>
            <li class="py-2 flex justify-between items-center"
                data-field-item="true" data-name="<%= field.name.to_s.downcase %>">
              <span class="text-gray-700 font-medium"><%= field.name %></span>
              <div class="flex items-center gap-2">
                <button class="text-sm text-blue-500 hover:text-blue-700 transition"
                        onclick="focusFieldById(<%= field.id %>)">
                  Ver no mapa
                </button>
                <button class="text-sm text-gray-600 hover:text-gray-800"
                        onclick="toggleSensors(true)">Sensores</button>
              </div>
            </li>
          <% end %>
        </ul>
      </div>

    </div>
  </div>
</div>

<style>
  @media (max-width: 640px) { #fields-main-map { height: 400px !important; } }
  .center-marker { width:16px; height:16px; border-radius:50%; background-color:#3b82f6; border:2px solid #fff; box-shadow:0 0 0 2px #3b82f6; z-index:10; position:relative; }
  .pulse-marker::after { content:''; position:absolute; width:100%; height:100%; border-radius:50%; background:rgba(59,130,246,.4); animation:pulse 1.5s ease-out infinite; z-index:5; }
  @keyframes pulse { 0%{transform:scale(1);opacity:.8} 70%{transform:scale(2.5);opacity:0} 100%{opacity:0} }

  /* realce do marker selecionado */
  .marker-highlight { box-shadow: 0 0 0 4px rgba(16,185,129,.6) !important; border-radius: 9999px; }
</style>

<script>
  // ====== Dados e estado global ======
  window.fieldData = <%= raw @fields.to_json(only: [:id, :name, :field_type, :area, :latitude, :longitude, :updated_at], methods: [:polygon_coordinates]) %>;

  <% sensors_json = defined?(@sensors) && @sensors.present? ? @sensors.to_json(only: [:id,:name,:latitude,:longitude,:status,:field_id]) : '[]' %>
  window.sensorData = window.sensorData || <%= raw sensors_json %>;

  window.__fieldMarkers     = new Map();
  window.__polygonIds       = new Set();
  window.__sensorMarkers    = [];
  window.__sensorsVisible   = false;
  window.__selectedFieldId  = null;
  window.__clusterOn        = false;   // estado do cluster
  window.__draw             = null;    // Mapbox Draw
  window.__drawFeatureId    = null;    // feature atual em edição

  // ====== Util: carregar Mapbox Draw dinâmico (se não foi incluído no <head>) ======
  function ensureMapboxDrawLoaded(cb){
    if (window.MapboxDraw) return cb && cb();
    // injeta CSS + Script
    const css = document.createElement('link');
    css.rel = 'stylesheet';
    css.href = 'https://api.mapbox.com/mapbox-gl-js/plugins/mapbox-gl-draw/v1.5.0/mapbox-gl-draw.css';
    document.head.appendChild(css);

    const s = document.createElement('script');
    s.src = 'https://api.mapbox.com/mapbox-gl-js/plugins/mapbox-gl-draw/v1.5.0/mapbox-gl-draw.js';
    s.onload = () => cb && cb();
    document.head.appendChild(s);
  }

  // ====== Controlo nativo Mapbox e estado persistente ======
  const __attachNativeControls = (map) => {
    if (map.__controlsAttached) return;
    map.addControl(new mapboxgl.NavigationControl({ showCompass: true }), 'top-right');
    map.addControl(new mapboxgl.GeolocateControl({
      positionOptions: { enableHighAccuracy: true },
      trackUserLocation: false,
      showUserHeading: true
    }), 'top-right');
    map.__controlsAttached = true;
  };

  const MAP_STATE_KEY = "fields_main_map_state";
  function saveMapState(map){
    try{
      const c = map.getCenter();
      localStorage.setItem(MAP_STATE_KEY, JSON.stringify({ lng: c.lng, lat: c.lat, zoom: map.getZoom() }));
    } catch(e) {}
  }
  function restoreMapState(map){
    try{
      const raw = localStorage.getItem(MAP_STATE_KEY);
      if (!raw) return false;
      const s = JSON.parse(raw);
      if (s && typeof s.lng === 'number' && typeof s.lat === 'number' && typeof s.zoom === 'number') {
        map.jumpTo({ center: [s.lng, s.lat], zoom: s.zoom });
        return true;
      }
    } catch(e) {}
    return false;
  }

  // ====== Inicialização do mapa ======
  function onAfterStyleLoad(map){
    addTerrainAndShading(map);
    renderFieldsOnMap(map);
    if (window.__sensorsVisible) toggleSensors(true);
    if (window.__clusterOn) renderSensorsCluster(map);
    __attachNativeControls(map);
    map.resize();
  }

  function initMainMapIfNeeded() {
    if (window.mainFieldsMap) return window.mainFieldsMap;

    mapboxgl.accessToken = 'pk.eyJ1Ijoicm9tYW9maWxpcGUiLCJhIjoiY204cmpmYzNnMHhkbDJqc2F2enFsZDRxYSJ9.lzMeVTGloDJlV1RHoitdjA';

    const map = new mapboxgl.Map({
      container: "fields-main-map",
      style: "mapbox://styles/mapbox/satellite-streets-v12",
      center: [-8.611, 41.145],
      zoom: 6,
      pitch: 45,
      bearing: -20,
      antialias: true
    });

    map.on("style.load", () => onAfterStyleLoad(map));
    map.on("load", () => { restoreMapState(map); });
    map.on("moveend", () => saveMapState(map));

    window.mainFieldsMap = map;
    return map;
  }

  // ====== Terreno/sombras ======
  function addTerrainAndShading(map) {
    if (!map.getSource("mapbox-dem")) {
      map.addSource("mapbox-dem", {
        type: "raster-dem",
        url: "mapbox://mapbox.terrain-rgb",
        tileSize: 512,
        maxzoom: 14
      });
      map.setTerrain({ source: "mapbox-dem", exaggeration: 1.5 });
      if (!map.getLayer("hillshading")) {
        map.addLayer({ id: "hillshading", source: "mapbox-dem", type: "hillshade" });
      }
    }
  }

  // ====== Renderização dos campos ======
  function renderFieldsOnMap(map) {
    // Limpa marcadores anteriores
    window.__fieldMarkers.forEach(m => m.remove());
    window.__fieldMarkers.clear();

    // Remove polígonos anteriores
    window.__polygonIds.forEach(pid => {
      if (map.getLayer(pid + "-fill")) map.removeLayer(pid + "-fill");
      if (map.getSource(pid)) map.removeSource(pid);
    });
    window.__polygonIds.clear();

    // Adiciona marcadores e polígonos
    let bounds = null;

    (window.fieldData || []).forEach(field => {
      if (field.latitude && field.longitude) {
        const marker = new mapboxgl.Marker({ color: "#2563eb" })
          .setLngLat([field.longitude, field.latitude])
          .setPopup(new mapboxgl.Popup({ offset: 12 }).setText(field.name))
          .addTo(map);

        marker.getElement().addEventListener("click", () => showFieldDetails(field));
        window.__fieldMarkers.set(field.id, marker);

        if (!bounds) {
          bounds = new mapboxgl.LngLatBounds([field.longitude, field.latitude], [field.longitude, field.latitude]);
        } else {
          bounds.extend([field.longitude, field.latitude]);
        }
      }

      if (field.polygon_coordinates && field.polygon_coordinates.length >= 3) {
        const polygonId = `field-poly-${field.id}`;
        const polygonData = {
          type: "Feature",
          geometry: {
            type: "Polygon",
            coordinates: [[...field.polygon_coordinates, field.polygon_coordinates[0]]]
          }
        };

        map.addSource(polygonId, { type: "geojson", data: polygonData });
        map.addLayer({
          id: `${polygonId}-fill`,
          type: "fill",
          source: polygonId,
          paint: { "fill-color": "#f97316", "fill-opacity": 0.3 }
        });
        window.__polygonIds.add(polygonId);

        // Centro do polígono com efeito pulsante (se diferente do ponto principal)
        const c = getPolygonCenter(field.polygon_coordinates);
        const sameAsMain = Math.abs(c[0] - (field.longitude || 0)) < 0.00001 &&
                           Math.abs(c[1] - (field.latitude  || 0)) < 0.00001;
        if (!sameAsMain) {
          const centerEl = document.createElement("div");
          centerEl.className = "center-marker pulse-marker";
          new mapboxgl.Marker(centerEl).setLngLat(c).addTo(map);
        }
      }
    });

    if (bounds) map.fitBounds(bounds, { padding: 32, duration: 700 });
  }

  // ====== UI Detalhes ======
  function showFieldDetails(field) {
    document.getElementById("fieldName").innerText    = field.name || '—';
    document.getElementById("fieldCrop").innerText    = (field.field_type || '—');
    document.getElementById("fieldArea").innerText    = (field.area || '—');
    document.getElementById("fieldLat").innerText     = (field.latitude || '—');
    document.getElementById("fieldLng").innerText     = (field.longitude || '—');
    document.getElementById("fieldUpdated").innerText = field.updated_at ? new Date(field.updated_at).toLocaleString() : '—';
  }

  // ====== Estilo do mapa ======
  function setMapStyle(styleId) {
    const map = initMainMapIfNeeded();
    map.setStyle(`mapbox://styles/mapbox/${styleId}`);
    map.once("style.load", () => onAfterStyleLoad(map));
  }

  // ====== Helpers ======
  function getPolygonCenter(coords) {
    let lngSum = 0, latSum = 0;
    coords.forEach(c => { lngSum += c[0]; latSum += c[1]; });
    return [lngSum / coords.length, latSum / coords.length];
  }

  // ====== Foco/realce de campo por ID ======
  function highlightSelectionOnMap(field){
    const map = initMainMapIfNeeded();

    // contorno do polígono selecionado
    const HL_POLY_ID = "selected-poly-outline";
    if (map.getLayer(HL_POLY_ID))  map.removeLayer(HL_POLY_ID);
    if (map.getSource(HL_POLY_ID)) map.removeSource(HL_POLY_ID);

    if (field.polygon_coordinates?.length >= 3) {
      const poly = {
        type: "Feature",
        geometry: { type: "Polygon", coordinates: [[...field.polygon_coordinates, field.polygon_coordinates[0]]] }
      };
      map.addSource(HL_POLY_ID, { type: "geojson", data: poly });
      map.addLayer({
        id: HL_POLY_ID, type: "line", source: HL_POLY_ID,
        paint: { "line-color": "#10b981", "line-width": 3, "line-dasharray": [2, 2] }
      });
    }

    // brilho no marker
    const m = window.__fieldMarkers.get(field.id);
    if (m && m.getElement) {
      const el = m.getElement();
      el.classList.add("marker-highlight");
      setTimeout(() => el.classList.remove("marker-highlight"), 1200);
    }
  }

  function focusFieldById(fieldId, opts={}){
    const map = initMainMapIfNeeded();
    const f = (window.fieldData || []).find(x => x.id === fieldId);
    if (!f) return;

    let center = null;
    if (f.longitude && f.latitude) center = [f.longitude, f.latitude];
    else if (f.polygon_coordinates?.length >= 3) center = getPolygonCenter(f.polygon_coordinates);

    const zoom = opts.zoom || 15;
    if (center) map.flyTo({ center, zoom, essential: true });

    showFieldDetails(f);
    window.__selectedFieldId = fieldId;
    highlightSelectionOnMap(f);

    // sincroniza URL
    const url = new URL(location);
    url.searchParams.set('view', 'map');
    url.searchParams.set('field', fieldId);
    history.replaceState({}, '', url);
  }
  window.focusFieldById = focusFieldById;

  // ====== Pesquisa na lista ======
  function filterFieldsList(q){
    const query = (q || "").trim().toLowerCase();
    document.querySelectorAll('[data-field-item="true"]').forEach(li => {
      const name = li.dataset.name || "";
      li.style.display = (!query || name.includes(query)) ? "" : "none";
    });
  }
  window.filterFieldsList = filterFieldsList;

  // ====== Sensores (marcadores simples) ======
  function initializeSensors() {
    if (window.__sensorMarkers.length) return; // já criados

    const base = (window.sensorData && window.sensorData.length) ? window.sensorData : (window.fieldData || []).flatMap(f => {
      if (!f.latitude || !f.longitude) return [];
      return [
        { id:`fake-${f.id}-1`, latitude: f.latitude + 0.002, longitude: f.longitude + 0.001, name: `S-${f.id}-1`, status: 'ok', field_id: f.id },
        { id:`fake-${f.id}-2`, latitude: f.latitude - 0.0015, longitude: f.longitude - 0.002, name: `S-${f.id}-2`, status: 'ok', field_id: f.id }
      ];
    });

    base.slice(0, 200).forEach(s => {
      if (s.latitude && s.longitude) {
        const el = document.createElement("div");
        el.className = "w-3.5 h-3.5 rounded-full";
        el.style.backgroundColor = "#22c55e"; // good
        const m = new mapboxgl.Marker(el).setLngLat([s.longitude, s.latitude]);
        window.__sensorMarkers.push(m);
      }
    });
  }

  function toggleSensors(forceOn) {
    const map = initMainMapIfNeeded();
    initializeSensors();
    const turnOn = forceOn === true ? true : !window.__sensorsVisible;

    if (turnOn) {
      window.__sensorMarkers.forEach(m => m.addTo(map));
      window.__sensorsVisible = true;
      // se cluster ligado, desligamos para não sobrepor
      if (window.__clusterOn) { window.__clusterOn = false; removeSensorsCluster(map); }
    } else {
      window.__sensorMarkers.forEach(m => m.remove());
      window.__sensorsVisible = false;
    }
  }

  // ====== Cluster de sensores ======
  function sensorsToGeoJSON(){
    const base = (window.sensorData && window.sensorData.length) ? window.sensorData : [];
    return {
      type: "FeatureCollection",
      features: base.filter(s => s.latitude && s.longitude).map(s => ({
        type: "Feature",
        properties: { id: s.id, name: s.name || `Sensor ${s.id}`, status: s.status || 'ok' },
        geometry: { type: "Point", coordinates: [s.longitude, s.latitude] }
      }))
    };
  }

  function renderSensorsCluster(map){
    // remove antes para evitar duplicados
    removeSensorsCluster(map);

    const data = sensorsToGeoJSON();
    if (!data.features.length) return;

    map.addSource('sensors', {
      type: 'geojson',
      data,
      cluster: true,
      clusterMaxZoom: 14,
      clusterRadius: 50
    });

    map.addLayer({
      id: 'clusters',
      type: 'circle',
      source: 'sensors',
      filter: ['has', 'point_count'],
      paint: {
        'circle-color': ['step', ['get', 'point_count'], '#A7F3D0', 10, '#34D399', 30, '#059669'],
        'circle-radius': ['step', ['get', 'point_count'], 14, 10, 18, 30, 24]
      }
    });

    map.addLayer({
      id: 'cluster-count',
      type: 'symbol',
      source: 'sensors',
      filter: ['has', 'point_count'],
      layout: {
        'text-field': ['get', 'point_count_abbreviated'],
        'text-size': 12
      }
    });

    map.addLayer({
      id: 'unclustered-point',
      type: 'circle',
      source: 'sensors',
      filter: ['!', ['has', 'point_count']],
      paint: {
        'circle-color': '#1D4ED8',
        'circle-radius': 5,
        'circle-stroke-width': 1,
        'circle-stroke-color': '#fff'
      }
    });

    // desliga marcadores simples para não duplicar
    if (window.__sensorsVisible) toggleSensors(false);
  }

  function removeSensorsCluster(map){
    ['clusters','cluster-count','unclustered-point'].forEach(id => {
      if (map.getLayer(id)) map.removeLayer(id);
    });
    if (map.getSource('sensors')) map.removeSource('sensors');
  }

  function toggleCluster(){
    const map = initMainMapIfNeeded();
    window.__clusterOn = !window.__clusterOn;
    if (window.__clusterOn) {
      renderSensorsCluster(map);
    } else {
      removeSensorsCluster(map);
    }
  }
  window.toggleCluster = toggleCluster;

  // ====== Mapbox Draw: edição de polígonos ======
  function ensureDraw(map, cb){
    ensureMapboxDrawLoaded(() => {
      if (!window.__draw) {
        window.__draw = new MapboxDraw({
          displayControlsDefault: false,
          controls: { polygon: true, trash: true },
          defaultMode: 'draw_polygon',
          styles: [
            { id:'gl-draw-polygon-fill', type:'fill', filter:['all',['==','$type','Polygon'],['!=','mode','static']],
              paint:{ 'fill-color':'#10b981','fill-outline-color':'#10b981','fill-opacity':0.2 } },
            { id:'gl-draw-polygon-stroke-active', type:'line', filter:['all',['==','$type','Polygon'],['!=','mode','static']],
              paint:{ 'line-color':'#10b981','line-width':2 } }
          ]
        });
        map.addControl(window.__draw, 'top-left');
      }
      cb && cb();
    });
  }

  function loadFieldPolygonIntoDraw(field){
    if (!window.__draw) return;
    // limpar anterior
    try { window.__draw.deleteAll(); } catch(_) {}
    window.__drawFeatureId = null;

    if (field.polygon_coordinates && field.polygon_coordinates.length >= 3) {
      const feature = {
        type: 'Feature',
        properties: {},
        geometry: { type: 'Polygon', coordinates: [[...field.polygon_coordinates, field.polygon_coordinates[0]]] }
      };
      const ids = window.__draw.add(feature);
      window.__drawFeatureId = Array.isArray(ids) ? ids[0] : ids;
    }
  }

  function startPolygonEdit(){
    const map = initMainMapIfNeeded();
    const fid = window.__selectedFieldId;
    if (!fid) { alert('Seleciona primeiro um campo na lista.'); return; }
    const field = (window.fieldData || []).find(x => x.id === fid);
    ensureDraw(map, () => {
      loadFieldPolygonIntoDraw(field);
      map.resize();
    });
  }

  async function savePolygonEdit(){
    const fid = window.__selectedFieldId;
    if (!fid || !window.__draw) { alert('Nada para guardar.'); return; }

    const fc = window.__draw.getAll();
    let ring = null;
    if (fc.features.length) {
      const geom = fc.features[0].geometry;
      if (geom.type === 'Polygon' && geom.coordinates.length) {
        ring = geom.coordinates[0]; // [ [lng,lat], ... , first=last ]
      }
    }
    if (!ring || ring.length < 4) { alert('Desenha um polígono válido.'); return; }

    // remove o último ponto repetido (first==last)
    const clean = ring.slice(0, -1);

    // PATCH para Rails
    const token = document.querySelector('meta[name="csrf-token"]')?.content;
    const resp = await fetch(`/fields/${fid}/update_polygon`, {
      method: 'PATCH',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': token
      },
      body: JSON.stringify({ polygon_coordinates: clean })
    });

    if (resp.ok) {
      // atualiza no cliente
      const f = (window.fieldData || []).find(x => x.id === fid);
      if (f) f.polygon_coordinates = clean;

      // re-render no mapa
      const map = initMainMapIfNeeded();
      onAfterStyleLoad(map);
      focusFieldById(fid, { zoom: 16 });
      alert('Polígono guardado ✅');
    } else {
      const txt = await resp.text().catch(() => '');
      alert('Falha ao guardar polígono ❌ ' + txt);
    }
  }

  function cancelPolygonEdit(){
    if (window.__draw) {
      try { window.__draw.deleteAll(); } catch(_) {}
    }
  }

  window.startPolygonEdit  = startPolygonEdit;
  window.savePolygonEdit   = savePolygonEdit;
  window.cancelPolygonEdit = cancelPolygonEdit;

  // ====== Exportar helpers globais ======
  window.setMapStyle       = setMapStyle;
  window.toggleSensors     = toggleSensors;
  window.fitAll            = fitAll;
  window.initializeMapbox  = initMainMapIfNeeded;
  window.initMainMapIfNeeded = initMainMapIfNeeded;

  // ====== Deep-link: ?view=map&field=ID ======
  document.addEventListener("turbo:load", () => {
    const params = new URLSearchParams(location.search);
    const isMap = params.get("view") === "map";
    const fieldId = parseInt(params.get("field"), 10);

    if (isMap) {
      const map = initMainMapIfNeeded();
      setTimeout(() => { map?.resize?.(); }, 60);
      if (!isNaN(fieldId)) {
        setTimeout(() => focusFieldById(fieldId, { zoom: 15 }), 150);
      }
    }
  });
</script>
