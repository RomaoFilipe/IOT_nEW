<div id="mapViewContainer" class="hidden bg-gray-50 p-4 rounded-lg shadow-md">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Mapa ocupa 2 colunas em desktop, 1 em mobile -->
    <div class="lg:col-span-2 relative">
      <div id="map" class="w-full h-[400px] lg:h-[600px] rounded-lg shadow"></div>

      <!-- Controles do mapa -->
      <div class="absolute top-4 left-4 flex flex-col space-y-2 z-10">
        <button onclick="setMapStyle('satellite-streets-v12')" class="bg-gray-800 text-white rounded px-3 py-1.5 shadow hover:bg-gray-900 transition">Satellite</button>
        <button onclick="setMapStyle('outdoors-v12')" class="bg-white text-gray-800 rounded px-3 py-1.5 shadow hover:bg-gray-100 transition">Terrain</button>
        <button onclick="toggleSensors()" class="bg-gray-800 text-white rounded px-3 py-1.5 shadow hover:bg-gray-900 transition">Sensors</button>
      </div>

      <!-- Legenda -->
      <div class="absolute bottom-4 left-4 bg-white p-3 rounded shadow-md text-sm z-10">
        <p class="font-semibold mb-2">Legenda</p>
        <ul class="space-y-1">
          <li><span class="inline-block w-3 h-3 bg-green-500 rounded-full"></span> Bom estado</li>
          <li><span class="inline-block w-3 h-3 bg-yellow-400 rounded-full"></span> Atenção</li>
          <li><span class="inline-block w-3 h-3 bg-blue-500 rounded-full"></span> Sensor Humidade</li>
        </ul>
      </div>
    </div>

    <!-- Coluna de detalhes -->
    <div class="flex flex-col space-y-4">
      <!-- Detalhes do campo -->
      <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200">
        <h3 class="text-xl font-semibold text-gray-800 border-b pb-2 mb-4">Detalhes do Campo</h3>
        <div class="space-y-3 text-gray-700 text-sm">
          <p><span class="font-medium">Cultura:</span> <span id="fieldCrop">—</span></p>
          <p><span class="font-medium">Área:</span> <span id="fieldArea">—</span> ha</p>
          <p><span class="font-medium">Latitude:</span> <span id="fieldLat">—</span></p>
          <p><span class="font-medium">Longitude:</span> <span id="fieldLng">—</span></p>
          <p><span class="font-medium">Última atualização:</span> <span id="fieldUpdated">—</span></p>
        </div>
      </div>

      <!-- Lista de campos -->
      <div class="bg-white p-4 rounded-lg shadow-md border border-gray-200 overflow-y-auto max-h-60">
        <h3 class="text-lg font-semibold text-gray-800 border-b pb-2 mb-4">Lista de Campos</h3>
        <ul class="divide-y divide-gray-200">
          <% @fields.each do |field| %>
            <li class="py-2 flex justify-between items-center">
              <span class="text-gray-700 font-medium"><%= field.name %></span>
              <button class="text-sm text-blue-500 hover:text-blue-700 transition"
                      onclick="flyToField(<%= field.longitude %>, <%= field.latitude %>, <%= field.id %>)">
                Ver no Mapa
              </button>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</div>

<style>
  @media (max-width: 640px) {
    #map {
      height: 400px !important;
    }
  }

  .center-marker {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background-color: #3b82f6;
    border: 2px solid white;
    box-shadow: 0 0 0 2px #3b82f6;
    z-index: 10;
  }

  .pulse-marker::after {
    content: '';
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: rgba(59, 130, 246, 0.4);
    animation: pulse 1.5s ease-out infinite;
    z-index: 5;
  }

  @keyframes pulse {
    0% { transform: scale(1); opacity: 0.8; }
    70% { transform: scale(2.5); opacity: 0; }
    100% { opacity: 0; }
  }
</style>

<script>
  let fieldData = <%= raw @fields.to_json %>;
  let sensorsVisible = false;
  let sensorMarkers = [];

  function initializeMapbox() {
    mapboxgl.accessToken = 'pk.eyJ1Ijoicm9tYW9maWxpcGUiLCJhIjoiY204cmpmYzNnMHhkbDJqc2F2enFsZDRxYSJ9.lzMeVTGloDJlV1RHoitdjA';

    const map = new mapboxgl.Map({
      container: "map",
      style: "mapbox://styles/mapbox/satellite-streets-v11",
      center: [-8.611, 41.145],
      zoom: 6,
      pitch: 45,
      bearing: -20,
      antialias: true
    });

    map.on("style.load", () => {
      map.addSource("mapbox-dem", {
        type: "raster-dem",
        url: "mapbox://mapbox.terrain-rgb",
        tileSize: 512,
        maxzoom: 14
      });

      map.setTerrain({ source: "mapbox-dem", exaggeration: 1.5 });

      map.addLayer({
        id: "hillshading",
        source: "mapbox-dem",
        type: "hillshade"
      });

      initializeMapFeatures();
      renderFieldsOnMap(map);
    });

    window.mainMap = map;
  }

function renderFieldsOnMap(map) {
  fieldData.forEach(field => {
    if (field.latitude && field.longitude) {
      const marker = new mapboxgl.Marker({ color: "blue" })
        .setLngLat([field.longitude, field.latitude])
        .setPopup(new mapboxgl.Popup().setText(field.name))
        .addTo(map);

      marker.getElement().addEventListener("click", () => showFieldDetails(field));
    }

    if (field.polygon_coordinates && field.polygon_coordinates.length >= 3) {
      const polygonId = `polygon-${field.id}`;
      const polygonData = {
        type: "Feature",
        geometry: {
          type: "Polygon",
          coordinates: [[...field.polygon_coordinates, field.polygon_coordinates[0]]]
        }
      };

      if (!map.getSource(polygonId)) {
        map.addSource(polygonId, { type: "geojson", data: polygonData });
        map.addLayer({
          id: `${polygonId}-fill`,
          type: "fill",
          source: polygonId,
          layout: {},
          paint: {
            "fill-color": "#f97316",
            "fill-opacity": 0.3
          }
        });

        // Marcar o centro do polígono com efeito
        const center = getPolygonCenter(field.polygon_coordinates);
        const sameAsMain = Math.abs(center[0] - field.longitude) < 0.00001 &&
                           Math.abs(center[1] - field.latitude) < 0.00001;

        if (!sameAsMain) {
          const centerEl = document.createElement("div");
          centerEl.className = "center-marker pulse-marker";

          new mapboxgl.Marker(centerEl)
            .setLngLat(center)
            .addTo(map);
        }
      }
    }
  });
}




const center = getPolygonCenter(field.polygon_coordinates);

// Verifica se o centro já é o mesmo que o ponto principal
const sameAsMain = Math.abs(center[0] - field.longitude) < 0.00001 &&
                   Math.abs(center[1] - field.latitude) < 0.00001;

if (!sameAsMain) {
  const centerEl = document.createElement("div");
  centerEl.className = "center-marker pulse-marker";

  new mapboxgl.Marker(centerEl)
    .setLngLat(center)
    .addTo(map);
}

  function flyToField(lng, lat, fieldId) {
    document.getElementById("mapViewBtn").click();
    setTimeout(() => {
      if (window.mainMap) {
        window.mainMap.flyTo({ center: [lng, lat], zoom: 15, essential: true });
      }
      const field = fieldData.find(f => f.id === fieldId);
      if (field) showFieldDetails(field);
    }, 500);
  }

  function showFieldDetails(field) {
    document.getElementById("fieldCrop").innerText = field.field_type || '—';
    document.getElementById("fieldArea").innerText = field.area || '—';
    document.getElementById("fieldLat").innerText = field.latitude || '—';
    document.getElementById("fieldLng").innerText = field.longitude || '—';
    document.getElementById("fieldUpdated").innerText = new Date(field.updated_at).toLocaleString();
  }



  function setMapStyle(style) {
    window.mainMap.setStyle(`mapbox://styles/mapbox/${style}`);
    window.mainMap.once('style.load', () => {
      initializeMapFeatures();
      renderFieldsOnMap(window.mainMap);
    });
  }

  function initializeSensors() {
    const sensors = [
      { lng: -8.611, lat: 41.145, status: 'good' },
      { lng: -8.612, lat: 41.146, status: 'attention' },
      { lng: -8.613, lat: 41.147, status: 'moisture' }
    ];

    sensors.forEach(sensor => {
      const el = document.createElement('div');
      el.className = 'sensor-marker w-4 h-4 rounded-full';
      el.style.backgroundColor = sensor.status === 'good' ? '#22c55e' : sensor.status === 'attention' ? '#facc15' : '#3b82f6';
      const marker = new mapboxgl.Marker(el).setLngLat([sensor.lng, sensor.lat]);
      sensorMarkers.push(marker);
    });
  }

  function toggleSensors() {
    sensorsVisible = !sensorsVisible;
    sensorMarkers.forEach(marker => sensorsVisible ? marker.addTo(window.mainMap) : marker.remove());
  }

  function initializeFieldBoundary() {
    if (window.mainMap.getSource('field-boundary')) return;

    window.mainMap.addSource('field-boundary', {
      type: 'geojson',
      data: {
        type: 'Feature',
        geometry: {
          type: 'Polygon',
          coordinates: [[
            [-8.615, 41.148],
            [-8.615, 41.142],
            [-8.607, 41.142],
            [-8.607, 41.148],
            [-8.615, 41.148]
          ]]
        }
      }
    });

    window.mainMap.addLayer({
      id: 'field-boundary-layer',
      type: 'line',
      source: 'field-boundary',
      paint: {
        'line-color': '#f97316',
        'line-width': 3
      }
    });
  }

  function initializeMapFeatures() {
    initializeSensors();
    initializeFieldBoundary();
  }

  function getPolygonCenter(coords) {
    let lngSum = 0, latSum = 0;
    coords.forEach(coord => {
      lngSum += coord[0];
      latSum += coord[1];
    });
    return [lngSum / coords.length, latSum / coords.length];
  }
</script>
