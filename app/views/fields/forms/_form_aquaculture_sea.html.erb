<%= form_with model: field, local: true, class: "space-y-6" do |f| %>
  <!-- Campo: Nome -->
  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1">
      <i class="lucide lucide-type w-4 h-4 inline-block mr-1 text-blue-600"></i> Nome do Campo
    </label>
    <%= f.text_field :name, placeholder: "Ex: Viveiro Marinho Norte", class: "w-full rounded-lg border-gray-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 shadow-sm" %>
  </div>

  <!-- Área + Espécie -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Área Marinha (ha)</label>
      <%= f.number_field :area, step: :any, placeholder: "Ex: 1.5", class: "w-full rounded-lg border-gray-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 shadow-sm" %>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Espécie Cultivada</label>
      <%= f.text_field :species, placeholder: "Ex: Dourada", class: "w-full rounded-lg border-gray-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 shadow-sm" %>
    </div>
  </div>

  <!-- Densidade + Regime -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Densidade de Povoamento (kg/ha)</label>
      <%= f.number_field :stocking_density, step: :any, placeholder: "Ex: 12.5", class: "w-full rounded-lg border-gray-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 shadow-sm" %>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Regime Alimentar</label>
      <%= f.text_field :feeding_regime, placeholder: "Ex: 2x/dia, ração 2%", class: "w-full rounded-lg border-gray-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 shadow-sm" %>
    </div>
  </div>

  <!-- Datas -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Data de Introdução</label>
      <%= f.date_field :fish_placement_date, class: "w-full rounded-lg border-gray-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 shadow-sm" %>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Previsão de Colheita</label>
      <%= f.date_field :estimated_harvest_date, class: "w-full rounded-lg border-gray-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 shadow-sm" %>
    </div>
  </div>

  <!-- Coordenadas -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Latitude</label>
      <%= f.text_field :latitude, placeholder: "-37.123456", class: "w-full rounded-lg border-gray-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 shadow-sm" %>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Longitude</label>
      <%= f.text_field :longitude, placeholder: "9.123456", class: "w-full rounded-lg border-gray-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 shadow-sm" %>
    </div>
  </div>

  <!-- Notas -->
  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1">Notas / Observações</label>
    <%= f.text_area :notes, rows: 4, placeholder: "Observações sobre o campo, qualidade da água, etc...", class: "w-full rounded-lg border-gray-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 shadow-sm" %>
  </div>

  <!-- Botão Submeter -->
  <div class="text-right mt-6">
    <%= f.submit field.persisted? ? "Atualizar Campo" : "Criar Campo", class: "bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg font-semibold transition duration-200 shadow" %>
  </div>
<% end %>
