<%= form_with model: field, local: true, class: "space-y-6" do |f| %>
  <!-- Nome + Tipo de Plantação -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Nome do Campo</label>
      <%= f.text_field :name, placeholder: "Ex: Campo Norte", class: "w-full rounded-lg border-gray-300 shadow-sm focus:ring-2 focus:ring-green-300 focus:border-green-500" %>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Tipo de Plantação</label>
      <%= f.text_field :plantation_type, placeholder: "Ex: Milho, Trigo...", class: "w-full rounded-lg border-gray-300 shadow-sm focus:ring-2 focus:ring-green-300 focus:border-green-500" %>
    </div>
  </div>

  <!-- Área + Solo -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Área (ha)</label>
      <%= f.number_field :area, step: :any, placeholder: "Ex: 2.5", class: "w-full rounded-lg border-gray-300 shadow-sm focus:ring-2 focus:ring-green-300 focus:border-green-500" %>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Tipo de Solo</label>
      <%= f.text_field :soil_type, placeholder: "Argiloso, arenoso...", class: "w-full rounded-lg border-gray-300 shadow-sm focus:ring-2 focus:ring-green-300 focus:border-green-500" %>
    </div>
  </div>

  <!-- Latitude + Longitude -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Latitude</label>
      <%= f.text_field :latitude, placeholder: "-37.123456", class: "w-full rounded-lg border-gray-300 shadow-sm focus:ring-2 focus:ring-green-300 focus:border-green-500" %>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Longitude</label>
      <%= f.text_field :longitude, placeholder: "9.123456", class: "w-full rounded-lg border-gray-300 shadow-sm focus:ring-2 focus:ring-green-300 focus:border-green-500" %>
    </div>
  </div>

  <!-- Datas -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Data de Plantação</label>
      <%= f.date_field :planting_date, class: "w-full rounded-lg border-gray-300 shadow-sm focus:ring-2 focus:ring-green-300 focus:border-green-500" %>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Previsão de Colheita</label>
      <%= f.date_field :harvest_date, class: "w-full rounded-lg border-gray-300 shadow-sm focus:ring-2 focus:ring-green-300 focus:border-green-500" %>
    </div>
  </div>

  <!-- Irrigação + Solo -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Tipo de Irrigação</label>
      <%= f.text_field :irrigation_type, placeholder: "Gotejamento, aspersão...", class: "w-full rounded-lg border-gray-300 shadow-sm focus:ring-2 focus:ring-green-300 focus:border-green-500" %>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Qualidade do Solo</label>
      <%= f.text_field :soil_quality, placeholder: "Boa, Média, Fraca...", class: "w-full rounded-lg border-gray-300 shadow-sm focus:ring-2 focus:ring-green-300 focus:border-green-500" %>
    </div>
  </div>

  <!-- Notas -->
  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1">Notas</label>
    <%= f.text_area :notes, rows: 4, placeholder: "Ex: Informações adicionais sobre o campo...", class: "w-full rounded-lg border-gray-300 shadow-sm focus:ring-2 focus:ring-green-300 focus:border-green-500" %>
  </div>

  <!-- Botão -->
  <div class="text-right pt-4">
    <%= f.submit field.persisted? ? "Atualizar Campo" : "Criar Campo", class: "bg-green-600 hover:bg-green-700 text-white px-6 py-2 rounded-md font-semibold transition" %>
  </div>
<% end %>
