<%= form_with model: field, local: true, class: "space-y-6" do |f| %>
  <!-- Nome + Tipo de Plantação -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1"><%= t("fields.forms.agriculture.labels.name") %></label>
      <%= f.text_field :name, placeholder: t("fields.forms.agriculture.placeholders.name"), class: "w-full rounded-lg border-gray-300 shadow-sm focus:ring-2 focus:ring-green-300 focus:border-green-500" %>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1"><%= t("fields.forms.agriculture.labels.plantation_type") %></label>
      <%= f.text_field :plantation_type, placeholder: t("fields.forms.agriculture.placeholders.plantation_type"), class: "w-full rounded-lg border-gray-300 shadow-sm focus:ring-2 focus:ring-green-300 focus:border-green-500" %>
    </div>
  </div>

  <!-- Área + Solo -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1"><%= t("fields.forms.agriculture.labels.area") %></label>
      <%= f.number_field :area, step: :any, placeholder: t("fields.forms.agriculture.placeholders.area"), class: "w-full rounded-lg border-gray-300 shadow-sm focus:ring-2 focus:ring-green-300 focus:border-green-500" %>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1"><%= t("fields.forms.agriculture.labels.soil_type") %></label>
      <%= f.text_field :soil_type, placeholder: t("fields.forms.agriculture.placeholders.soil_type"), class: "w-full rounded-lg border-gray-300 shadow-sm focus:ring-2 focus:ring-green-300 focus:border-green-500" %>
    </div>
  </div>

  <!-- Latitude + Longitude -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1"><%= t("fields.forms.common.labels.latitude") %></label>
      <%= f.text_field :latitude, placeholder: t("fields.forms.common.placeholders.latitude"), class: "w-full rounded-lg border-gray-300 shadow-sm focus:ring-2 focus:ring-green-300 focus:border-green-500" %>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1"><%= t("fields.forms.common.labels.longitude") %></label>
      <%= f.text_field :longitude, placeholder: t("fields.forms.common.placeholders.longitude"), class: "w-full rounded-lg border-gray-300 shadow-sm focus:ring-2 focus:ring-green-300 focus:border-green-500" %>
    </div>
  </div>

  <!-- Datas -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1"><%= t("fields.forms.agriculture.labels.planting_date") %></label>
      <%= f.date_field :planting_date, class: "w-full rounded-lg border-gray-300 shadow-sm focus:ring-2 focus:ring-green-300 focus:border-green-500" %>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1"><%= t("fields.forms.agriculture.labels.harvest_date") %></label>
      <%= f.date_field :harvest_date, class: "w-full rounded-lg border-gray-300 shadow-sm focus:ring-2 focus:ring-green-300 focus:border-green-500" %>
    </div>
  </div>

  <!-- Irrigação + Qualidade do Solo -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1"><%= t("fields.forms.agriculture.labels.irrigation_type") %></label>
      <%= f.text_field :irrigation_type, placeholder: t("fields.forms.agriculture.placeholders.irrigation_type"), class: "w-full rounded-lg border-gray-300 shadow-sm focus:ring-2 focus:ring-green-300 focus:border-green-500" %>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1"><%= t("fields.forms.agriculture.labels.soil_quality") %></label>
      <%= f.text_field :soil_quality, placeholder: t("fields.forms.agriculture.placeholders.soil_quality"), class: "w-full rounded-lg border-gray-300 shadow-sm focus:ring-2 focus:ring-green-300 focus:border-green-500" %>
    </div>
  </div>

  <!-- Notas -->
  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1"><%= t("fields.forms.common.labels.notes") %></label>
    <%= f.text_area :notes, rows: 4, placeholder: t("fields.forms.agriculture.placeholders.notes"), class: "w-full rounded-lg border-gray-300 shadow-sm focus:ring-2 focus:ring-green-300 focus:border-green-500" %>
  </div>

  <!-- Botão -->
  <div class="text-right pt-4">
    <%= f.submit(field.persisted? ? t("fields.forms.common.buttons.update") : t("fields.forms.common.buttons.create"), class: "bg-green-600 hover:bg-green-700 text-white px-6 py-2 rounded-md font-semibold transition") %>
  </div>
<% end %>
