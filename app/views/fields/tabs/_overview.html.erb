<%= turbo_frame_tag "overview-#{field.id}" do %>
<div class="grid grid-cols-2 gap-6">
  <!-- Mapa com Mapbox -->
  <div class="bg-gray-100 rounded-lg h-64 relative shadow-md overflow-hidden">
    <div id="fieldMap-<%= field.id %>" class="w-full h-full rounded-lg"></div>
  </div>

  <!-- Planting Information -->
  <div>
    <h2 class="text-2xl font-bold mb-4 text-gray-800"><%= field.name %></h2>
    <p><strong>Tipo:</strong> <%= field.field_type %></p>
    <p><strong>Localização:</strong> <%= field.formatted_location %></p>
    <p><strong>Área:</strong> <%= field.area %> ha</p>

    <h3 class="font-semibold mt-4">Planting Information</h3>
    <ul class="text-gray-600 space-y-1 mt-2">
      <li><strong>Planting Date:</strong> 2023-03-15</li>
      <li><strong>Harvest Date:</strong> 2023-09-25</li>
      <li><strong>Expected Yield:</strong> <span class="font-bold text-green-600">8.2 tons/ha</span></li>
      <li><strong>Pest Control:</strong> Minimal intervention</li>
      <li><strong>Irrigation:</strong> Every 3 days, 2 hours</li>
      <li><strong>Fertilization:</strong> 2023-05-10</li>
    </ul>

    <h3 class="font-semibold mt-4">Notes</h3>
    <p class="text-sm text-gray-500">Plants are developing well, ahead of schedule. Last inspection showed no signs of pests or diseases.</p>
  </div>
</div>

<!-- Basic Information -->
<div class="mt-6 p-4 bg-gray-50 rounded-lg shadow-sm">
  <h3 class="font-semibold mb-2">Basic Information</h3>
  <p><strong>Crop:</strong> <%= field.field_type %></p>
  <p><strong>Area:</strong> <%= field.area %> ha</p>
  <p><strong>Soil Quality:</strong> <span class="text-green-600 font-semibold">Excellent</span></p>
  <p><strong>Active Sensors:</strong> <%= field.sensors.count %></p>
  <p><strong>Last Updated:</strong> 10 minutes ago</p>
</div>

<!-- Current Conditions -->
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-4">
  <div class="bg-white p-4 rounded-lg shadow text-center">
    <span class="block text-blue-500 text-2xl">💧</span>
    <p class="text-gray-600">Moisture</p>
    <p class="font-bold text-lg">
      <%= field.sensors.average(:moisture)&.round(1) || "-" %>%
    </p>
  </div>

  <div class="bg-white p-4 rounded-lg shadow text-center">
    <span class="block text-orange-500 text-2xl">🌡</span>
    <p class="text-gray-600">Temperature</p>
    <p class="font-bold text-lg">
      <%= field.sensors.average(:temperature)&.round(1) || "-" %>°C
    </p>
  </div>

  <div class="bg-white p-4 rounded-lg shadow text-center">
    <span class="block text-green-500 text-2xl">🌱</span>
    <p class="text-gray-600">Crop Health</p>
    <p class="font-bold text-lg">Good</p>
  </div>

  <div class="bg-white p-4 rounded-lg shadow text-center">
    <span class="block text-blue-500 text-2xl">💦</span>
    <p class="text-gray-600">Irrigation</p>
    <p class="font-bold text-lg">Active</p>
  </div>
</div>

<!-- ✅ JS correto sem misturar mini-mapas -->
<script>
let mapInstance<%= field.id %>;

function initFieldMap<%= field.id %>() {
  if (typeof mapboxgl === 'undefined') return;
  if (mapInstance<%= field.id %>) return;

  mapboxgl.accessToken = 'pk.eyJ1Ijoicm9tYW9maWxpcGUiLCJhIjoiY204cmpmYzNnMHhkbDJqc2F2enFsZDRxYSJ9.lzMeVTGloDJlV1RHoitdjA';

  mapInstance<%= field.id %> = new mapboxgl.Map({
    container: 'fieldMap-<%= field.id %>',
    style: 'mapbox://styles/mapbox/streets-v11',
    center: [<%= field.longitude %>, <%= field.latitude %>],
    zoom: 13
  });

  mapInstance<%= field.id %>.on('load', () => {
    new mapboxgl.Marker({ color: "blue" })
      .setLngLat([<%= field.longitude %>, <%= field.latitude %>])
      .addTo(mapInstance<%= field.id %>);
  });
}

// Inicializa ao mudar para tab Overview
document.addEventListener('click', function(e) {
  if (e.target.matches('.tab-button[data-tab="overview"]')) {
    setTimeout(() => {
      if (mapInstance<%= field.id %>) {
        mapInstance<%= field.id %>.resize();
      } else {
        initFieldMap<%= field.id %>();
      }
    }, 300);
  }
});

// Inicializa logo ao carregar caso overview esteja visível
setTimeout(() => {
  initFieldMap<%= field.id %>();
}, 300);
</script>
<% end %>
