<%= turbo_frame_tag "overview-#{field.id}" do %>
  <div class="grid grid-cols-2 gap-6">
    <!-- Mapa (placeholder) -->
    <div class="bg-gray-100 rounded-lg h-40 flex items-center justify-center">
      <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z"/>
        <path d="M15 5.764v15"/>
        <path d="M9 3.236v15"/>
      </svg>
    </div>

    <!-- Planting Information -->
    <div>
      <h3 class="font-semibold mb-2"><%= t("fields.overview.planting_info") %></h3>
      <p><strong><%= t("fields.overview.planting_date") %>:</strong> 2023-03-15</p>
      <p><strong><%= t("fields.overview.harvest_date") %>:</strong> 2023-09-25</p>
      <p>
        <strong><%= t("fields.overview.expected_yield") %>:</strong>
        <span class="font-bold">8.2 tons/ha</span>
      </p>

      <h3 class="font-semibold mt-4"><%= t("fields.overview.maintenance") %></h3>
      <p><strong><%= t("fields.overview.pest_control") %>:</strong> Minimal intervention needed</p>
      <p><strong><%= t("fields.overview.irrigation") %>:</strong> Every 3 days, 2 hours</p>
      <p><strong><%= t("fields.overview.fertilization") %>:</strong> Applied on 2023-05-10</p>

      <h3 class="font-semibold mt-4"><%= t("fields.overview.notes") %></h3>
      <p class="text-sm text-gray-600"><%= t("fields.overview.notes_example") %></p>
    </div>
  </div>

  <!-- Basic Information -->
  <div class="mt-6">
    <h3 class="font-semibold mb-2"><%= t("fields.overview.basic_info") %></h3>
    <p>
      <strong><%= t("fields.overview.crop") %>:</strong>
      <%= t("field_types.#{field.field_type}") %>
    </p>
    <p><strong><%= t("fields.overview.area") %>:</strong> <%= field.area %> ha</p>
    <p>
      <strong><%= t("fields.overview.soil_quality") %>:</strong>
      <span class="text-green-600 font-semibold"><%= t("fields.overview.good") %></span>
    </p>
    <p><strong><%= t("fields.overview.active_sensors") %>:</strong> <%= field.sensors.count %></p>
    <p><strong><%= t("fields.overview.last_updated") %>:</strong> 10 minutes ago</p>
  </div>

  <!-- Current Conditions -->
  <div class="mt-4">
    <h3 class="font-semibold mb-2"><%= t("fields.overview.current_conditions") %></h3>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <!-- Moisture -->
      <div class="bg-gray-100 p-4 rounded-lg text-center">
        <span class="block text-blue-500 text-2xl">💧</span>
        <p class="text-gray-600"><%= t("fields.overview.moisture") %></p>
        <p class="font-bold text-lg">
          <%= field.sensors.average(:moisture)&.round(1) || "-" %><%= t("units.percent") %>
        </p>
      </div>

      <!-- Temperature -->
      <div class="bg-gray-100 p-4 rounded-lg text-center">
        <span class="block text-orange-500 text-2xl">🌡</span>
        <p class="text-gray-600"><%= t("fields.overview.temperature") %></p>
        <p class="font-bold text-lg">
          <%= field.sensors.average(:temperature)&.round(1) || "-" %><%= t("units.celsius") %>
        </p>
      </div>

      <!-- Crop Health (estático) -->
      <div class="bg-gray-100 p-4 rounded-lg text-center">
        <span class="block text-green-500 text-2xl">🌱</span>
        <p class="text-gray-600"><%= t("fields.overview.crop_health") %></p>
        <p class="font-bold text-lg"><%= t("fields.overview.good") %></p>
      </div>

      <% if irrigation_sensor = field.sensors.find_by(sensor_type: "irrigation") %>
        <div class="bg-gray-100 p-4 rounded-lg text-center" id="<%= dom_id(irrigation_sensor, :irrigation_status_block) %>">
          <span class="block text-blue-500 text-2xl">💦</span>
          <p class="text-gray-600"><%= t("fields.overview.irrigation") %></p>

          <%= render partial: "sensors/irrigation_status_block", locals: { sensor: irrigation_sensor } %>
        </div>

        <script>
          document.addEventListener("DOMContentLoaded", () => {
            const sensorId = "<%= irrigation_sensor.id %>";

            if (!window.App || !window.App.cable) return;

            window.App.cable.subscriptions.create(
              { channel: "IrrigationChannel", sensor_id: sensorId },
              {
                connected() {
                  console.log(`🔌 Canal de irrigação conectado: sensor ${sensorId}`);
                },
                disconnected() {
                  console.log(`⛔ Canal de irrigação desconectado: sensor ${sensorId}`);
                },
                received() {
                  // ✅ Atualiza sempre que receber dados
                  fetch(`/sensors/${sensorId}/status_info`)
                    .then(res => res.text())
                    .then(html => {
                      const container = document.getElementById(`sensor_${sensorId}_irrigation_status_block`);
                      if (container) container.innerHTML = html;
                    });
                }
              }
            );
          });
        </script>
      <% end %>
    </div>
  </div>
<% end %>
