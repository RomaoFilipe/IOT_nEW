<%# app/views/fields/tabs/_analytics.html.erb %>
<% fld = local_assigns[:field] || @field %>
<% an  = local_assigns[:analytics] %>

<% if fld.blank? || !fld.persisted? %>
  <div class="text-sm text-slate-600">Guarde o campo para ver Analytics.</div>
  <%# não faças 'return' aqui se queres ver a moldura/controles do tab %>
<% end %>

<div data-controller="field-analytics"
     data-field-analytics-url-value="<%= analytics_field_path(fld) %>">
  <!-- botões/inputs -->
  <div class="flex items-center gap-2">
    <button class="btn" data-action="click->field-analytics#reload">Atualizar</button>
    <%= link_to "Exportar", export_analytics_path(format: :csv), class: "btn-outline" rescue nil %>
  </div>

  <!-- KPIs (usa an/series se já veio no render do controller) -->
  <div class="grid grid-cols-4 gap-3 mt-4">
    <div id="kpi-soil"><%= (an&.dig(:series, :soil_moisture)&.last || "—") %></div>
    <div id="kpi-temp"><%= (an&.dig(:max_temp) || "—") %></div>
    <div id="kpi-hum"><%= (an&.dig(:avg_humidity) || "—") %></div>
    <div id="kpi-last"><%= (an&.dig(:series, :times)&.last&.in_time_zone("Europe/Lisbon") || "—") %></div>
  </div>

  <!-- Área do gráfico -->
  <div id="analytics-chart" class="mt-6 h-64"></div>
</div>
