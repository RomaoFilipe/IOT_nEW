<%# locals: title:, value:, hint: %>
<div class="rounded-xl border p-4 bg-white shadow-sm flex flex-col gap-1">
  <div class="text-xs text-slate-500"><%= title %></div>
  <div class="text-2xl font-semibold tracking-tight"><%= value %></div>
  <% if hint.present? %><div class="text-[11px] text-slate-400"><%= hint %></div><% end %>
</div>
