<div class="space-y-8">

  <!-- Cabeçalho -->
  <div class="flex justify-between items-center">
    <h3 class="text-xl font-bold text-gray-800 flex items-center gap-2">
      <i class="fa-solid fa-microchip text-green-600"></i>
      Equipamentos IoT Associados
    </h3>
    <button onclick="toggleSensorModal()" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg shadow-sm flex items-center gap-2">
      <i class="fa-solid fa-plus-circle"></i> Adicionar Equipamento
    </button>
  </div>


  <!-- Formulário de adição -->
  <%= render partial: "sensors/form", locals: { field: field } %>

  <!-- Contadores -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="bg-white rounded-xl border p-4 shadow-sm flex items-center gap-4">
      <div class="text-green-600 text-3xl"><i class="lucide lucide-wifi"></i></div>
      <div>
        <p class="text-2xl font-bold text-gray-800"><% sensores_ativos = field.sensors.where(status: ["Active", "parado"]) %></p>
        <p class="text-sm text-gray-500">Sensores Ativos</p>
      </div>
    </div>
    <div class="bg-white rounded-xl border p-4 shadow-sm flex items-center gap-4">
      <div class="text-red-600 text-3xl"><i class="lucide lucide-wifi-off"></i></div>
      <div>
        <p class="text-2xl font-bold text-gray-800"><% sensores_inativos = field.sensors.where(status: "Inactive") %></p>
        <p class="text-sm text-gray-500">Sensores Inativos</p>
      </div>
    </div>
  </div>

  <!-- Tabela de sensores -->
  <% if field.sensors.any? %>
    <div class="overflow-x-auto rounded-xl shadow border border-gray-200 bg-white mt-6">
      <table class="min-w-full divide-y divide-gray-100 text-sm text-gray-800">
        <thead class="bg-gray-50 text-gray-600 uppercase text-xs font-semibold">
          <tr>
            <th class="px-4 py-3 text-left">Nome</th>
            <th class="px-4 py-3 text-left">Tipo</th>
            <th class="px-4 py-3 text-left">Estado</th>
            <th class="px-4 py-3 text-left">Bateria</th>
            <th class="px-4 py-3 text-left">Sinal</th>
            <th class="px-4 py-3 text-left">Última Leitura</th>
            <th class="px-4 py-3 text-center">Ações</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <%= render partial: "sensors/row", collection: field.sensors, as: :sensor %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-gray-500 italic mt-6">Nenhum sensor atribuído a este campo ainda.</p>
  <% end %>

  <!-- Sensores Inativos Detalhados -->
  <% inactive_sensors = field.sensors.where(status: "Inactive") %>
  <% if inactive_sensors.any? %>
    <h4 class="mt-10 mb-2 text-red-600 font-semibold flex items-center gap-2">
      <i class="fa-solid fa-triangle-exclamation"></i>
      Sensores que Requerem Atenção
    </h4>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <% inactive_sensors.each do |sensor| %>
        <div class="bg-red-50 border border-red-200 rounded-lg p-4 space-y-2 shadow-sm">
          <div class="flex items-center gap-2 text-red-600 font-bold text-lg">
            <% case sensor.sensor_type.downcase %>
              <% when "temperatura" %>
                <i class="fa-solid fa-temperature-three-quarters"></i>
              <% when "humidade" %>
                <i class="fa-solid fa-droplet"></i>
              <% when "ph" %>
                <i class="fa-solid fa-vial"></i>
              <% else %>
                <i class="fa-solid fa-microchip"></i>
            <% end %>
            <%= sensor.name %>
          </div>

          <div class="text-sm text-gray-700">
            <p><strong>Tipo:</strong> <%= sensor.sensor_type.capitalize %></p>

            <p>
              <strong>Bateria:</strong>
              <% if sensor.battery.to_i < 20 %>
                <span class="text-red-600 font-semibold"><%= sensor.battery %>% (Baixa!)</span>
              <% else %>
                <%= sensor.battery %>%
              <% end %>
            </p>

            <p>
              <strong>Sinal:</strong>
              <% if sensor.signal.to_i == 0 %>
                <span class="text-red-600 font-semibold">Sem sinal</span>
              <% else %>
                <%= sensor.signal %>%
              <% end %>
            </p>

            <p title="Sensor inativo desde <%= sensor.last_reading&.strftime('%d/%m/%Y às %H:%M') || '—' %>">
              <strong>Última leitura:</strong>
              <%= sensor.last_reading&.strftime("%Y-%m-%d %H:%M") || "—" %>
            </p>
          </div>

          <div class="mt-3 text-right">
            <%= button_to toggle_status_api_sensor_path(sensor), method: :post,
                form: { data: { turbo_stream: true } },
                class: "px-3 py-1 bg-red-600 text-white rounded hover:bg-red-700 text-sm" do %>
              Verificar Sensor
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <!-- Sensores não atribuídos (se existirem) -->
  <%= render partial: "sensors/unassigned_sensors", locals: { field: field } %>

</div>

<!-- JS para modal e device_id -->
<script>
  function toggleSensorModal() {
    document.getElementById('sensorModal')?.classList.toggle('hidden');
  }

  function checkDeviceId() {
    const input = document.getElementById("deviceIdInput");
    const result = document.getElementById("deviceCheckResult");

    if (!input.value) {
      result.innerText = "⚠️ Introduz um device_id.";
      result.className = "text-red-600 text-sm mt-2";
      return;
    }

    result.innerText = "🔍 A verificar...";
    result.className = "text-gray-600 text-sm mt-2";

    fetch(`/api/sensors/identify?device_id=${encodeURIComponent(input.value)}`)
      .then(r => r.json())
      .then(data => {
        if (data.id) {
          result.innerText = `✅ Sensor encontrado: ${data.name} (ID: ${data.id})`;
          result.className = "text-green-600 text-sm mt-2";
        } else {
          result.innerText = "❌ Sensor não encontrado.";
          result.className = "text-red-600 text-sm mt-2";
        }
      }).catch(() => {
        result.innerText = "❌ Erro ao contactar o servidor.";
        result.className = "text-red-600 text-sm mt-2";
      });
  }
</script>
<script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
