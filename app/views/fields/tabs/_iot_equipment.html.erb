<h3 class="text-xl font-bold text-gray-800 mb-6">📡 Equipamentos IoT Associados</h3>

<!-- Botão de adicionar sensor -->
<div class="flex justify-end mb-6">
  <button onclick="toggleSensorModal()" class="bg-green-700 text-white px-4 py-2 rounded-md flex items-center gap-2 hover:bg-green-800 transition">
    <i class="fa-solid fa-plus-circle"></i>
    <span>Adicionar Equipamento</span>
  </button>
</div>

<!-- Modal de Adição -->
<%= render partial: "sensors/form", locals: { field: field } %>

<!-- Tabela de sensores atribuídos -->
<% if field.sensors.any? %>
  <div class="overflow-x-auto rounded-xl shadow border border-gray-200">
    <table class="min-w-full divide-y divide-gray-200 bg-white text-sm">
      <thead class="bg-gray-100 text-gray-700 font-medium">
        <tr>
          <th class="px-4 py-3">Nome</th>
          <th class="px-4 py-3">Tipo</th>
          <th class="px-4 py-3">Estado</th>
          <th class="px-4 py-3">Bateria</th>
          <th class="px-4 py-3">Sinal</th>
          <th class="px-4 py-3">Última Leitura</th>
          <th class="px-4 py-3 text-center">Ações</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <%= render partial: "sensors/row", collection: field.sensors, as: :sensor %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="text-gray-500 italic mt-6">Nenhum sensor atribuído a este campo ainda.</p>
<% end %>

<!-- Sensores não atribuídos -->
<div class="mt-8">
  <%= render partial: "sensors/unassigned_sensors", locals: { field: field } %>
</div>

<!-- Scripts -->
<script>
  function toggleSensorModal() {
    document.getElementById('sensorModal')?.classList.toggle('hidden');
  }

  function checkDeviceId() {
    const deviceId = document.getElementById("deviceIdInput").value;
    const result = document.getElementById("deviceCheckResult");

    if (!deviceId) {
      result.innerText = "⚠️ Introduz um device_id.";
      result.className = "text-red-600 text-sm mt-2";
      return;
    }

    result.innerText = "🔍 A verificar...";
    result.className = "text-gray-600 text-sm mt-2";

    fetch(`/api/sensors/identify?device_id=${encodeURIComponent(deviceId)}`)
      .then(response => response.json())
      .then(data => {
        if (data.id) {
          result.innerText = `✅ Sensor encontrado ou criado: ${data.name} (ID: ${data.id})`;
          result.className = "text-green-600 text-sm mt-2";
        } else {
          result.innerText = "❌ Sensor não encontrado.";
          result.className = "text-red-600 text-sm mt-2";
        }
      })
      .catch(err => {
        result.innerText = "❌ Erro ao contactar o servidor.";
        result.className = "text-red-600 text-sm mt-2";
      });
  }
</script>
