<h3 class="text-lg font-semibold mb-4">📡 Equipamentos IoT Associados</h3>

<!-- Botão Adicionar Equipamento -->
<div class="flex justify-end mb-4">
  <button onclick="openAddSensorModal()" class="bg-green-700 text-white px-4 py-2 rounded-md flex items-center gap-2 hover:bg-green-800 transition">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <circle cx="12" cy="12" r="10" />
      <path d="M8 12h8" />
      <path d="M12 8v8" />
    </svg>
    <span>Adicionar Equipamento</span>
  </button>
</div>

<!-- Tabela de sensores -->
<% if field.sensors.any? %>
  <div class="overflow-x-auto rounded-lg border border-gray-200 shadow-sm bg-white">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50 text-xs uppercase font-semibold text-gray-600">
        <tr>
          <th class="px-4 py-3 text-left">Nome</th>
          <th class="px-4 py-3 text-left">Tipo</th>
          <th class="px-4 py-3 text-left">Estado</th>
          <th class="px-4 py-3 text-left">Bateria</th>
          <th class="px-4 py-3 text-left">Sinal</th>
          <th class="px-4 py-3 text-left">Última Leitura</th>
          <th class="px-4 py-3 text-center">Agendamento</th>
          <th class="px-4 py-3 text-center">Toggle</th>
          <th class="px-4 py-3 text-center">Ações</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <%= render partial: "sensors/row", collection: field.sensors, as: :sensor %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="text-center text-gray-500 italic mt-4">Nenhum sensor atribuído a este campo ainda.</div>
<% end %>

<%= render partial: "sensors/unassigned_sensors", locals: { field: field } %>

<!-- Modal de Adicionar Equipamento -->
<div id="addSensorModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50">
  <div class="bg-white p-6 rounded-lg w-full max-w-lg shadow-lg relative">
    <button onclick="closeAddSensorModal()" class="absolute top-2 right-2 text-gray-500 hover:text-black">X</button>
    <h3 class="text-xl font-semibold mb-4">Adicionar Novo Sensor</h3>
    <%= render partial: 'sensors/form', locals: { field: field } %>
  </div>
</div>

<script>
  function openAddSensorModal() {
    document.getElementById("addSensorModal").classList.remove("hidden");
  }

  function closeAddSensorModal() {
    document.getElementById("addSensorModal").classList.add("hidden");
  }

   function toggleAddSensorForm() {
    const form = document.getElementById("addSensorForm");
    form?.classList.toggle("hidden");
  }

  function checkDeviceId() {
    const deviceId = document.getElementById("deviceIdInput").value;
    const result = document.getElementById("deviceCheckResult");

    if (!deviceId) {
      result.innerText = "⚠️ Introduz um device_id.";
      result.className = "text-red-600 text-sm mt-2";
      return;
    }

    result.innerText = "🔍 A verificar...";
    result.className = "text-gray-600 text-sm mt-2";

    fetch(`/api/sensors/identify?device_id=${encodeURIComponent(deviceId)}`)
      .then(response => response.json())
      .then(data => {
        if (data.id) {
          result.innerText = `✅ Sensor encontrado ou criado: ${data.name} (ID: ${data.id})`;
          result.className = "text-green-600 text-sm mt-2";
        } else {
          result.innerText = "❌ Sensor não encontrado.";
          result.className = "text-red-600 text-sm mt-2";
        }
      })
      .catch(err => {
        result.innerText = "❌ Erro ao contactar o servidor.";
        result.className = "text-red-600 text-sm mt-2";
      });
  }
</script>
