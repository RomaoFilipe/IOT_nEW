<%= turbo_frame_tag "overview-#{field.id}" do %>
  <!-- Cabeçalho com botão Editar -->
  <div class="flex justify-between items-center mb-4">
    <h2 class="text-xl font-bold text-gray-800 flex items-center gap-2">
      <i class="lucide lucide-info w-5 h-5 text-blue-600"></i>
      Detalhes do Tanque
    </h2>

    <%= link_to edit_field_path(field), class: "inline-flex items-center gap-2 px-4 py-2 bg-yellow-400 hover:bg-yellow-500 text-gray-900 font-semibold rounded-lg shadow transition" do %>
      <i class="lucide lucide-pencil w-4 h-4"></i>
      Editar
    <% end %>
  </div>

  <!-- Informações do Tanque -->
  <div class="grid grid-cols-2 gap-6">
    <!-- Mapa/Ilustração -->
    <div class="bg-blue-50 rounded-lg h-40 flex items-center justify-center">
      <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z"/>
        <path d="M15 5.764v15"/>
        <path d="M9 3.236v15"/>
      </svg>
    </div>

    <!-- Dados do tanque -->
    <div>
      <h3 class="font-semibold mb-2">Aquaculture Tank Info</h3>
      <p><strong>Species:</strong> <%= field.species || "-" %></p>
      <p><strong>Tank Volume:</strong> <%= field.tank_volume || "-" %> m³</p>
      <p><strong>Stocking Density:</strong> <%= field.stocking_density || "-" %> kg/m³</p>
      <p><strong>Feeding Regime:</strong> <%= field.feeding_regime || "-" %></p>
      <p><strong>Date of Fish Placement:</strong> <%= field.fish_placement_date&.strftime("%Y-%m-%d") || "-" %></p>
      <p><strong>Estimated Harvest:</strong> <%= field.estimated_harvest_date&.strftime("%Y-%m-%d") || "-" %></p>

      <h3 class="font-semibold mt-4">Notes</h3>
      <p class="text-sm text-gray-600"><%= field.notes || "No notes yet." %></p>
    </div>
  </div>

  <!-- Leituras dos Sensores -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-6">
    <!-- pH -->
    <div class="bg-blue-100 p-4 rounded-lg text-center">
      <span class="block text-blue-500 text-2xl">🧪</span>
      <p class="text-gray-600">pH</p>
      <p class="font-bold text-lg">
        <%= field.sensors.average(:ph)&.round(2) || '-' %>
      </p>
    </div>

    <!-- Salinidade -->
    <div class="bg-blue-100 p-4 rounded-lg text-center">
      <span class="block text-indigo-500 text-2xl">🧂</span>
      <p class="text-gray-600">Salinity</p>
      <p class="font-bold text-lg">
        <%= field.sensors.average(:salinity)&.round(1) || '-' %> ppt
      </p>
    </div>

    <!-- Oxigénio -->
    <div class="bg-blue-100 p-4 rounded-lg text-center">
      <span class="block text-cyan-500 text-2xl">🫧</span>
      <p class="text-gray-600">Oxygen</p>
      <p class="font-bold text-lg">
        <%= field.sensors.average(:oxygen)&.round(1) || '-' %> mg/L
      </p>
    </div>

    <!-- Temperatura da água -->
    <div class="bg-blue-100 p-4 rounded-lg text-center">
      <span class="block text-red-500 text-2xl">🌡</span>
      <p class="text-gray-600">Water Temp</p>
      <p class="font-bold text-lg">
        <%= field.sensors.average(:water_temperature)&.round(1) || '-' %>°C
      </p>
    </div>
  </div>
<% end %>
