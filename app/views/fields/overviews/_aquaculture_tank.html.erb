<%= turbo_frame_tag "overview-#{field.id}" do %>
<div class="space-y-6 animate-fade-in" x-data="{ showNotes: false }">

  <!-- 🌍 Mapa -->
  <div class="relative rounded-xl shadow border overflow-hidden">
    <div id="map-tank-<%= field.id %>" class="w-full h-60"></div>

    <% unless field.latitude.present? && field.longitude.present? %>
      <div class="absolute inset-0 grid place-items-center bg-white/70">
        <span class="text-sm text-slate-600"><%= t("fields.overviews.aquaculture_tank.no_coords") %></span>
      </div>
    <% end %>
  </div>

  <!-- Cabeçalho + Botão Editar -->
  <div class="flex justify-between items-center">
    <h2 class="text-2xl font-bold text-gray-800 flex items-center gap-2">
      <i class="lucide lucide-fish w-5 h-5 text-blue-600"></i>
      <%= "#{t('fields.overviews.aquaculture_tank.header_title')}: #{field.name}" %>
    </h2>

    <%= link_to edit_field_path(field, locale: I18n.locale),
        class: "inline-flex items-center gap-2 px-4 py-2 bg-yellow-400 hover:bg-yellow-500 text-gray-900 font-semibold rounded-lg shadow transition hover:scale-105 duration-200" do %>
      <i class="lucide lucide-pencil w-4 h-4"></i> <%= t("actions.edit") %>
    <% end %>
  </div>

  <!-- Cartões: Dados + Localização -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <!-- Dados do Tanque -->
    <div class="bg-white border rounded-xl p-5 shadow-sm">
      <h3 class="text-lg font-semibold text-gray-700 flex items-center gap-2">
        <i class="lucide lucide-settings w-4 h-4 text-blue-500"></i> <%= t("fields.overviews.aquaculture_tank.tank_data") %>
      </h3>
      <div class="mt-3 space-y-1 text-sm">
        <p><strong><%= t("fields.overviews.aquaculture_tank.species") %>:</strong> <%= field.species.presence || '—' %></p>
        <p>
          <strong><%= t("fields.overviews.aquaculture_tank.volume") %>:</strong>
          <%= field.tank_volume.presence || '—' %> <%= t("fields.overviews.aquaculture_tank.units.volume_m3") %>
        </p>
        <p>
          <strong><%= t("fields.overviews.aquaculture_tank.density") %>:</strong>
          <%= field.stocking_density.presence || '—' %> <%= t("fields.overviews.aquaculture_tank.units.density") %>
        </p>
        <p><strong><%= t("fields.overviews.aquaculture_tank.feeding_regime") %>:</strong> <%= field.feeding_regime.presence || '—' %></p>
      </div>
    </div>

    <!-- Datas e Localização -->
    <div class="bg-white border rounded-xl p-5 shadow-sm">
      <h3 class="text-lg font-semibold text-gray-700 flex items-center gap-2">
        <i class="lucide lucide-map-pin w-4 h-4 text-blue-500"></i> <%= t("fields.overviews.aquaculture_tank.dates_location") %>
      </h3>
      <div class="mt-3 space-y-1 text-sm">
        <p><strong><%= t("fields.overviews.aquaculture_tank.placement_date") %>:</strong> <%= field.fish_placement_date&.strftime(I18n.t("date.formats.default")) || '—' %></p>
        <p><strong><%= t("fields.overviews.aquaculture_tank.harvest_date") %>:</strong> <%= field.estimated_harvest_date&.strftime(I18n.t("date.formats.default")) || '—' %></p>
        <p><strong><%= t("fields.edit.location.latitude") %>:</strong> <%= field.latitude.presence || '—' %></p>
        <p><strong><%= t("fields.edit.location.longitude") %>:</strong> <%= field.longitude.presence || '—' %></p>
      </div>
    </div>
  </div>

  <!-- 📡 Monitorização -->
  <h3 class="text-lg font-semibold text-gray-700 mt-2">📡 <%= t("fields.overviews.aquaculture_tank.monitoring_title") %></h3>

  <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
    <% sensores = {
      t("fields.overviews.aquaculture_tank.metrics.ph")               => { attr: :ph,                icon: "🧪", unidade: t("fields.overviews.aquaculture_tank.units.ph") },
      t("fields.overviews.aquaculture_tank.metrics.salinity")         => { attr: :salinity,          icon: "🧂", unidade: t("fields.overviews.aquaculture_tank.units.salinity_ppt") },
      t("fields.overviews.aquaculture_tank.metrics.oxygen")           => { attr: :oxygen,            icon: "🫧", unidade: t("fields.overviews.aquaculture_tank.units.oxygen_mg_l") },
      t("fields.overviews.aquaculture_tank.metrics.water_temperature")=> { attr: :water_temperature, icon: "🌡", unidade: t("fields.overviews.aquaculture_tank.units.temp_c") }
    } %>

    <% sensores.each do |label, meta| %>
      <% valor  = field.sensors.average(meta[:attr])&.to_f %>
      <% status =
          if valor.nil?
            t("sensors.unassigned.no_data")
          else
            t(valor.between?((6.5 if meta[:attr]==:ph) || (30 if meta[:attr]==:salinity) || (5 if meta[:attr]==:oxygen) || (15 if meta[:attr]==:water_temperature),
                              (8.5 if meta[:attr]==:ph) || (38 if meta[:attr]==:salinity) || (12 if meta[:attr]==:oxygen) || (28 if meta[:attr]==:water_temperature)) ? "common.normal" : "common.attention")
          end %>
      <% badge_class =
          case status
          when t("common.normal")   then "bg-blue-100 text-blue-700"
          when t("common.attention") then "bg-red-100 text-red-600"
          else                           "bg-gray-100 text-gray-600"
          end %>

      <div class="bg-white border rounded-xl p-4 text-center shadow-sm transition hover:shadow-md">
        <div class="text-2xl"><%= meta[:icon] %></div>
        <div class="text-gray-500 text-sm mt-1"><%= label %></div>
        <div class="text-2xl font-bold text-gray-800 mt-1">
          <%= valor ? valor.round(1) : '—' %>
          <span class="text-sm text-gray-500"><%= meta[:unidade] %></span>
        </div>
        <span class="inline-block mt-2 px-2 py-0.5 text-xs rounded-full <%= badge_class %> font-medium">
          <%= status %>
        </span>
      </div>
    <% end %>
  </div>

  <!-- 📝 Notas -->
  <div class="mt-6">
    <button
      @click="showNotes = !showNotes"
      class="px-4 py-2 bg-gray-100 text-sm text-blue-600 font-medium rounded-lg hover:bg-gray-200 transition">
      <%= t("fields.overviews.aquaculture_tank.toggle_notes") %>
    </button>

    <div x-show="showNotes" x-transition class="mt-3 bg-white border rounded-xl p-4 text-sm text-gray-600">
      <%= field.notes.presence || t("fields.overviews.aquaculture_tank.no_notes") %>
    </div>
  </div>

</div>

<!-- Mapbox -->
<script>
  function initTankMap_<%= field.id %>() {
    const hasCoords = <%= (field.latitude.present? && field.longitude.present?).to_s %>;
    if (!hasCoords) return;
    if (!(window.mapboxgl && mapboxgl.Map)) return;

    mapboxgl.accessToken = 'pk.eyJ1Ijoicm9tYW9maWxpcGUiLCJhIjoiY204cmpmYzNnMHhkbDJqc2F2enFsZDRxYSJ9.lzMeVTGloDJlV1RHoitdjA';

    const map = new mapboxgl.Map({
      container: 'map-tank-<%= field.id %>',
      style: 'mapbox://styles/mapbox/outdoors-v12',
      center: [<%= field.longitude || 0 %>, <%= field.latitude || 0 %>],
      zoom: 12,
      attributionControl: false
    });

    map.on('load', () => {
      new mapboxgl.Marker({ color: '#2563eb' })
        .setLngLat([<%= field.longitude || 0 %>, <%= field.latitude || 0 %>])
        .addTo(map);

      setTimeout(() => map.resize(), 120);
    });
  }

  document.addEventListener('turbo:load', initTankMap_<%= field.id %>);
  document.addEventListener('DOMContentLoaded', initTankMap_<%= field.id %>);
</script>
<% end %>

<!-- Se estes assets já estiverem no teu layout, remove estas linhas -->
<script src='https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.js'></script>
<link href='https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.css' rel='stylesheet' />
<script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
