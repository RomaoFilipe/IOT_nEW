<%= turbo_frame_tag "overview-#{field.id}" do %>
<div x-data="{ showNotes: false }" x-init="$el.classList.add('animate-fade-in')" class="space-y-6 animate-fade-in">

  <!-- Cabeçalho -->
  <div class="flex justify-between items-center flex-wrap gap-2">
    <div>
      <h2 class="text-2xl font-bold text-gray-800 flex items-center gap-2">
        <i class="lucide lucide-info w-5 h-5 text-blue-600"></i>
        Tanque: <%= field.name %>
      </h2>
      <span class="text-sm text-blue-700 bg-blue-100 px-2 py-1 rounded mt-1 inline-block transition-all duration-300">
        Aquacultura em Tanque
      </span>
    </div>

    <%= link_to edit_field_path(field), class: "inline-flex items-center gap-2 px-4 py-2 bg-yellow-400 hover:bg-yellow-500 text-gray-900 font-semibold rounded-lg shadow transition-all duration-300 hover:scale-105" do %>
      <i class="lucide lucide-pencil w-4 h-4"></i> Editar
    <% end %>
  </div>

  <!-- Blocos Informativos -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 -translate-y-2" x-transition:enter-end="opacity-100 translate-y-0">
    <div class="bg-white border rounded-lg p-4 shadow-sm space-y-2">
      <h3 class="font-semibold text-gray-700 mb-2">📊 Dados do Tanque</h3>
      <p><strong>Espécie:</strong> <%= field.species || "-" %></p>
      <p><strong>Volume:</strong> <%= field.tank_volume || "-" %> m³</p>
      <p><strong>Densidade:</strong> <%= field.stocking_density || "-" %> kg/m³</p>
      <p><strong>Regime Alimentar:</strong> <%= field.feeding_regime || "-" %></p>
    </div>

    <div class="bg-white border rounded-lg p-4 shadow-sm space-y-2">
      <h3 class="font-semibold text-gray-700 mb-2">📅 Datas & Localização</h3>
      <p><strong>Colocação:</strong> <%= field.fish_placement_date&.strftime("%d/%m/%Y") || "-" %></p>
      <p><strong>Colheita:</strong> <%= field.estimated_harvest_date&.strftime("%d/%m/%Y") || "-" %></p>
      <p><strong>Latitude:</strong> <%= field.latitude || "-" %></p>
      <p><strong>Longitude:</strong> <%= field.longitude || "-" %></p>
    </div>
  </div>

  <!-- Leituras de Sensores -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-6">
    <% sensores = {
      "pH" => [:ph, "🧪", "text-blue-500", "pH"],
      "Salinidade" => [:salinity, "🧂", "text-indigo-500", "ppt"],
      "Oxigénio" => [:oxygen, "🫧", "text-cyan-500", "mg/L"],
      "Temp. Água" => [:water_temperature, "🌡", "text-red-500", "°C"]
    } %>

    <% sensores.each do |label, (atributo, icon, cor, unidade)| %>
      <div class="bg-blue-50 p-4 rounded-lg text-center shadow-sm transform transition duration-300 hover:scale-105"
           x-data="{ tooltip: false }"
           @mouseover="tooltip = true" @mouseleave="tooltip = false">
        <span class="block <%= cor %> text-2xl"><%= icon %></span>
        <p class="text-gray-600" x-show="!tooltip"><%= label %></p>
        <p class="text-xs text-gray-400" x-show="tooltip">Sensor: <%= atributo %></p>
        <p class="font-bold text-lg">
          <%= field.sensors.average(atributo)&.round(2) || '-' %> <%= unidade %>
        </p>
      </div>
    <% end %>
  </div>

  <!-- Notas -->
  <div class="mt-6">
    <button @click="showNotes = !showNotes" class="text-blue-600 hover:underline text-sm font-medium mb-2 transition">
      <i class="lucide lucide-sticky-note w-4 h-4 inline-block mr-1"></i> Ver/Esconder Notas
    </button>

    <div x-show="showNotes" x-transition class="bg-gray-50 border-l-4 border-blue-400 p-4 rounded-lg shadow-sm">
      <h3 class="font-semibold text-gray-700 mb-1">📝 Observações</h3>
      <p class="text-sm text-gray-600"><%= field.notes.presence || "Sem observações no momento." %></p>
    </div>
  </div>
</div>
<% end %>

