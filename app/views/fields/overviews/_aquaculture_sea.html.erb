<%= turbo_frame_tag "overview-#{field.id}" do %>
<div x-data="{ showNotes: false }" x-init="$el.classList.add('animate-fade-in')" class="space-y-6 animate-fade-in">

  <!-- Cabeçalho -->
  <div class="flex justify-between items-center flex-wrap gap-2">
    <div>
      <h2 class="text-2xl font-bold text-gray-800 flex items-center gap-2">
        <i class="lucide lucide-wave-square w-5 h-5 text-blue-600"></i>
        <%= field.name %>
      </h2>
      <span class="text-sm text-blue-700 bg-blue-100 px-2 py-1 rounded mt-1 inline-block">
        Aquacultura Marinha
      </span>
    </div>

    <%= link_to edit_field_path(field), class: "inline-flex items-center gap-2 px-4 py-2 bg-yellow-400 hover:bg-yellow-500 text-gray-900 font-semibold rounded-lg shadow transition hover:scale-105 duration-200" do %>
      <i class="lucide lucide-pencil w-4 h-4"></i> Editar
    <% end %>
  </div>

  <!-- Blocos de Informação -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Mapa/Ilustração -->
    <div class="bg-blue-50 rounded-lg h-40 flex items-center justify-center shadow-sm">
      <i class="lucide lucide-map-pin w-12 h-12 text-blue-500"></i>
    </div>

    <!-- Dados -->
    <div class="space-y-2">
      <h3 class="font-semibold text-gray-700 mb-1">🌊 Detalhes do Campo</h3>
      <p><strong>Espécie:</strong> <%= field.species || "-" %></p>
      <p><strong>Área:</strong> <%= field.area || "-" %> ha</p>
      <p><strong>Densidade:</strong> <%= field.stocking_density || "-" %> kg/ha</p>
      <p><strong>Data de Introdução:</strong> <%= field.fish_placement_date&.strftime("%d/%m/%Y") || "-" %></p>
      <p><strong>Previsão de Colheita:</strong> <%= field.estimated_harvest_date&.strftime("%d/%m/%Y") || "-" %></p>
    </div>
  </div>

  <!-- Leituras de Sensores -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-6">
    <% sensores = {
      "Salinidade" => [:salinity, "🧂", "text-indigo-500", "ppt"],
      "Oxigénio" => [:oxygen, "🫧", "text-cyan-500", "mg/L"],
      "Temperatura" => [:water_temperature, "🌡", "text-red-500", "°C"],
      "Corrente" => [:current_speed, "🌊", "text-blue-400", "m/s"]
    } %>

    <% sensores.each do |label, (atributo, icon, cor, unidade)| %>
      <div class="bg-blue-100 p-4 rounded-lg text-center shadow-sm transform transition duration-300 hover:scale-105"
           x-data="{ tooltip: false }"
           @mouseover="tooltip = true" @mouseleave="tooltip = false">
        <span class="block <%= cor %> text-2xl"><%= icon %></span>
        <p class="text-gray-600" x-show="!tooltip"><%= label %></p>
        <p class="text-xs text-gray-400" x-show="tooltip">Sensor: <%= atributo %></p>
        <p class="font-bold text-lg">
          <%= field.sensors.average(atributo)&.round(2) || '-' %> <%= unidade %>
        </p>
      </div>
    <% end %>
  </div>

  <!-- Notas -->
  <div class="mt-6">
    <button @click="showNotes = !showNotes" class="text-blue-600 hover:underline text-sm font-medium mb-2 transition">
      <i class="lucide lucide-sticky-note w-4 h-4 inline-block mr-1"></i> Ver/Esconder Notas
    </button>

    <div x-show="showNotes" x-transition class="bg-gray-50 border-l-4 border-blue-400 p-4 rounded-lg shadow-sm">
      <h3 class="font-semibold text-gray-700 mb-1">📝 Observações</h3>
      <p class="text-sm text-gray-600"><%= field.notes.presence || "Sem observações no momento." %></p>
    </div>
  </div>

</div>
<% end %>
