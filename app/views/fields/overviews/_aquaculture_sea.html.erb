<%= turbo_frame_tag "overview-#{field.id}" do %>
<div x-data="{ showNotes: false }" class="space-y-6 animate-fade-in">

  <div class="relative rounded-lg shadow-md overflow-hidden">
    <div id="map-sea-<%= field.id %>" class="h-64 w-full rounded-lg"></div>

   
    <% unless field.latitude.present? && field.longitude.present? %>
      <div class="absolute inset-0 grid place-items-center bg-white/70">
        <span class="text-sm text-slate-600"><%= t("fields.overviews.aquaculture_sea.no_coords") %></span>
      </div>
    <% end %>

    <%= link_to edit_field_path(field, locale: I18n.locale),
          class: "absolute top-3 right-3 bg-yellow-400 hover:bg-yellow-500 text-gray-900 font-semibold px-4 py-2 text-sm rounded-lg shadow transition" do %>
      <i class="lucide lucide-pencil w-4 h-4 inline-block mr-1"></i> <%= t("actions.edit") %>
    <% end %>
  </div>

  <!-- 📦 Dados do Tanque e Localização -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

    <!-- 🔧 Dados do Tanque -->
    <div class="bg-white border rounded-lg p-5 shadow-sm">
      <h3 class="text-blue-700 font-bold text-lg flex items-center gap-2 mb-3">
        <i class="lucide lucide-settings w-5 h-5"></i> <%= t("fields.overviews.aquaculture_sea.tank_data") %>
      </h3>
      <div class="grid grid-cols-2 gap-y-2 text-sm text-gray-700">
        <p><strong><%= t("fields.overviews.aquaculture_sea.species") %>:</strong></p>          <p><%= field.species.presence || "-" %></p>
        <p><strong><%= t("fields.overviews.aquaculture_sea.volume") %>:</strong></p>           <p><%= field.tank_volume.presence || "-" %> <%= t("fields.overviews.aquaculture_sea.units.volume_m3") %></p>
        <p><strong><%= t("fields.overviews.aquaculture_sea.density") %>:</strong></p>          <p><%= field.stocking_density.presence || "-" %> <%= t("fields.overviews.aquaculture_sea.units.density") %></p>
        <p><strong><%= t("fields.overviews.aquaculture_sea.feeding_regime") %>:</strong></p>   <p><%= field.feeding_regime.presence || "-" %></p>
      </div>
    </div>

    <!-- 📍 Localização e Datas -->
    <div class="bg-white border rounded-lg p-5 shadow-sm">
      <h3 class="text-blue-700 font-bold text-lg flex items-center gap-2 mb-3">
        <i class="lucide lucide-map-pin w-5 h-5"></i> <%= t("fields.overviews.aquaculture_sea.dates_location") %>
      </h3>
      <div class="grid grid-cols-2 gap-y-2 text-sm text-gray-700">
        <p><strong><%= t("fields.overviews.aquaculture_sea.placement_date") %>:</strong></p>  <p><%= field.fish_placement_date&.strftime(I18n.t("date.formats.default")) || "-" %></p>
        <p><strong><%= t("fields.overviews.aquaculture_sea.harvest_date") %>:</strong></p>    <p><%= field.estimated_harvest_date&.strftime(I18n.t("date.formats.default")) || "-" %></p>
        <p><strong><%= t("fields.edit.location.latitude") %>:</strong></p>                    <p><%= field.latitude.presence || "-" %></p>
        <p><strong><%= t("fields.edit.location.longitude") %>:</strong></p>                   <p><%= field.longitude.presence || "-" %></p>
      </div>
    </div>
  </div>

  <!-- 📊 Monitorização em Tempo Real -->
  <div class="space-y-2">
    <h3 class="text-gray-800 font-semibold text-lg"><%= t("fields.overviews.aquaculture_sea.monitoring_title") %></h3>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <% sensores = {
        t("fields.overviews.aquaculture_sea.metrics.ph")                => [:ph,                "🧪", "text-blue-500",   t("fields.overviews.aquaculture_sea.units.ph")],
        t("fields.overviews.aquaculture_sea.metrics.salinity")          => [:salinity,          "🧂", "text-indigo-500", t("fields.overviews.aquaculture_sea.units.salinity_ppt")],
        t("fields.overviews.aquaculture_sea.metrics.oxygen")            => [:oxygen,            "🫧", "text-cyan-500",   t("fields.overviews.aquaculture_sea.units.oxygen_mg_l")],
        t("fields.overviews.aquaculture_sea.metrics.water_temperature") => [:water_temperature, "🌡", "text-red-500",    t("fields.overviews.aquaculture_sea.units.temp_c")]
      } %>

      <% sensores.each do |label, (atributo, icon, cor, unidade)| %>
        <div class="bg-blue-50 p-4 rounded-lg text-center shadow-sm transform transition duration-300 hover:scale-105">
          <span class="block <%= cor %> text-2xl"><%= icon %></span>
          <p class="text-gray-600 text-sm"><%= label %></p>
          <p class="font-bold text-xl">
            <%= field.sensors.average(atributo)&.to_f&.round(2) || "-" %> <%= unidade %>
          </p>
        </div>
      <% end %>
    </div>
  </div>

  <!-- 📝 Notas -->
  <div class="mt-6">
    <button @click="showNotes = !showNotes" class="text-blue-700 hover:underline text-sm font-medium mb-2 transition">
      <i class="lucide lucide-sticky-note w-4 h-4 inline-block mr-1"></i> <%= t("fields.overviews.aquaculture_sea.toggle_notes") %>
    </button>

    <div x-show="showNotes" x-transition class="bg-gray-50 border-l-4 border-blue-400 p-4 rounded-lg shadow-sm">
      <h3 class="font-semibold text-gray-700 mb-1">📝 <%= t("fields.overviews.aquaculture_sea.notes_title") %></h3>
      <p class="text-sm text-gray-600"><%= field.notes.presence || t("fields.overviews.aquaculture_sea.no_notes") %></p>
    </div>
  </div>

</div>

<script>
  // Inicializa o mapa quando a página (Turbo) carrega
  document.addEventListener("turbo:load", function () {
    const hasCoords = <%= (field.latitude.present? && field.longitude.present?).to_s %>;
    if (!hasCoords) return;
    if (!(window.mapboxgl && mapboxgl.Map)) return;

    mapboxgl.accessToken = 'pk.eyJ1Ijoicm9tYW9maWxpcGUiLCJhIjoiY204cmpmYzNnMHhkbDJqc2F2enFsZDRxYSJ9.lzMeVTGloDJlV1RHoitdjA';

    const map = new mapboxgl.Map({
      container: 'map-sea-<%= field.id %>',
      style: 'mapbox://styles/mapbox/outdoors-v12',
      center: [<%= field.longitude || 0 %>, <%= field.latitude || 0 %>],
      zoom: 13,
      attributionControl: false
    });

    map.on('load', () => {
      new mapboxgl.Marker({ color: '#2563eb' })
        .setLngLat([<%= field.longitude || 0 %>, <%= field.latitude || 0 %>])
        .addTo(map);
      setTimeout(() => map.resize(), 120);
    });
  });
</script>
<% end %>

<!-- Se estes assets já estiverem no layout, remove as 2 linhas seguintes -->
<script src="https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.js"></script>
<link href="https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
