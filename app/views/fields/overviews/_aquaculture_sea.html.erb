<%= turbo_frame_tag "overview-#{field.id}" do %>
<div x-data="{ showNotes: false }" class="space-y-6 animate-fade-in">

  <!-- 🌍 Mapa -->
  <div class="relative rounded-lg shadow-md overflow-hidden">
    <div id="map-sea-<%= field.id %>" class="h-64 w-full rounded-lg"></div>

    <% unless field.latitude.present? && field.longitude.present? %>
      <div class="absolute inset-0 grid place-items-center bg-white/70">
        <span class="text-sm text-slate-600">Sem coordenadas para este local</span>
      </div>
    <% end %>

    <%= link_to edit_field_path(field, locale: I18n.locale),
          class: "absolute top-3 right-3 bg-yellow-400 hover:bg-yellow-500 text-gray-900 font-semibold px-4 py-2 text-sm rounded-lg shadow transition" do %>
      <i class="lucide lucide-pencil w-4 h-4 inline-block mr-1"></i> Editar
    <% end %>
  </div>

  <!-- 📦 Dados -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

    <!-- 🔧 Dados do Tanque -->
    <div class="bg-white border rounded-lg p-5 shadow-sm">
      <h3 class="text-blue-700 font-bold text-lg flex items-center gap-2 mb-3">
        <i class="lucide lucide-settings w-5 h-5"></i> Dados do Tanque
      </h3>
      <div class="grid grid-cols-2 gap-y-2 text-sm text-gray-700">
        <p><strong>Espécie:</strong></p>             <p><%= field.species || '-' %></p>
        <p><strong>Volume:</strong></p>              <p><%= field.tank_volume || '-' %> m³</p>
        <p><strong>Densidade:</strong></p>           <p><%= field.stocking_density || '-' %> peixes/m³</p>
        <p><strong>Regime Alimentar:</strong></p>    <p><%= field.feeding_regime || '-' %></p>
      </div>
    </div>

    <!-- 📍 Localização e Datas -->
    <div class="bg-white border rounded-lg p-5 shadow-sm">
      <h3 class="text-blue-700 font-bold text-lg flex items-center gap-2 mb-3">
        <i class="lucide lucide-map-pin w-5 h-5"></i> Datas & Localização
      </h3>
      <div class="grid grid-cols-2 gap-y-2 text-sm text-gray-700">
        <p><strong>Colocação:</strong></p>  <p><%= field.fish_placement_date&.strftime("%d/%m/%Y") || '-' %></p>
        <p><strong>Colheita:</strong></p>   <p><%= field.estimated_harvest_date&.strftime("%d/%m/%Y") || '-' %></p>
        <p><strong>Latitude:</strong></p>   <p><%= field.latitude || '-' %></p>
        <p><strong>Longitude:</strong></p>  <p><%= field.longitude || '-' %></p>
      </div>
    </div>
  </div>

  <!-- 📊 Monitoramento -->
  <div class="space-y-2">
    <h3 class="text-gray-800 font-semibold text-lg">Monitoramento em Tempo Real</h3>

    <% readings = AquacultureReading.where(field_id: field.id, measured_at: 24.hours.ago..Time.current) %>
    <% avg_ph       = readings.average(:ph)&.round(2) %>
    <% avg_salinity = readings.average(:salinity)&.round(2) %>
    <% avg_oxygen   = readings.average(:oxygen_level)&.round(2) %>
    <% avg_temp     = readings.average(:temperature)&.round(2) %>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-blue-50 p-4 rounded-lg text-center shadow-sm hover:scale-105 transition">
        <span class="block text-blue-500 text-2xl">🧪</span>
        <p class="text-gray-600 text-sm">pH</p>
        <p class="font-bold text-xl"><%= avg_ph || '-' %></p>
      </div>
      <div class="bg-blue-50 p-4 rounded-lg text-center shadow-sm hover:scale-105 transition">
        <span class="block text-indigo-500 text-2xl">🧂</span>
        <p class="text-gray-600 text-sm">Salinidade</p>
        <p class="font-bold text-xl"><%= avg_salinity || '-' %> ppt</p>
      </div>
      <div class="bg-blue-50 p-4 rounded-lg text-center shadow-sm hover:scale-105 transition">
        <span class="block text-cyan-500 text-2xl">🫧</span>
        <p class="text-gray-600 text-sm">Oxigénio</p>
        <p class="font-bold text-xl"><%= avg_oxygen || '-' %> mg/L</p>
      </div>
      <div class="bg-blue-50 p-4 rounded-lg text-center shadow-sm hover:scale-105 transition">
        <span class="block text-red-500 text-2xl">🌡</span>
        <p class="text-gray-600 text-sm">Temp. Água</p>
        <p class="font-bold text-xl"><%= avg_temp || '-' %> °C</p>
      </div>
    </div>
  </div>

  <!-- 📝 Notas -->
  <div class="mt-6">
    <button @click="showNotes = !showNotes" class="text-blue-700 hover:underline text-sm font-medium mb-2 transition">
      <i class="lucide lucide-sticky-note w-4 h-4 inline-block mr-1"></i> Ver/Esconder Notas
    </button>

    <div x-show="showNotes" x-transition class="bg-gray-50 border-l-4 border-blue-400 p-4 rounded-lg shadow-sm">
      <h3 class="font-semibold text-gray-700 mb-1">📝 Observações</h3>
      <p class="text-sm text-gray-600"><%= field.notes.presence || "Sem observações no momento." %></p>
    </div>
  </div>
</div>

<script>
document.addEventListener("turbo:load", function () {
  const hasCoords = <%= (field.latitude.present? && field.longitude.present?).to_s %>;
  if (!hasCoords) return;
  if (!(window.mapboxgl && mapboxgl.Map)) return;

  mapboxgl.accessToken = 'pk.eyJ1Ijoicm9tYW9maWxpcGUiLCJhIjoiY204cmpmYzNnMHhkbDJqc2F2enFsZDRxYSJ9.lzMeVTGloDJlV1RHoitdjA';

  const map = new mapboxgl.Map({
    container: 'map-sea-<%= field.id %>',
    style: 'mapbox://styles/mapbox/outdoors-v12',
    center: [<%= field.longitude %>, <%= field.latitude %>],
    zoom: 13,
    attributionControl: false
  });

  map.on('load', () => {
    new mapboxgl.Marker({ color: '#2563eb' })
      .setLngLat([<%= field.longitude %>, <%= field.latitude %>])
      .addTo(map);
    setTimeout(() => map.resize(), 120);
  });
});
</script>
<% end %>
