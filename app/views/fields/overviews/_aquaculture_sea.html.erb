<%= turbo_frame_tag "overview-#{field.id}" do %>
  <div x-data="{ showNotes: false }" class="space-y-6">

    <!-- Mapa do Campo (Mar) -->
    <div class="relative">
      <div id="map-sea-<%= field.id %>" class="w-full h-60 rounded-xl shadow border overflow-hidden"></div>
      <% unless field.latitude.present? && field.longitude.present? %>
        <div class="absolute inset-0 flex items-center justify-center bg-white/70">
          <span class="text-sm text-slate-600"><%= t("fields.overviews.aquaculture_sea.no_coords", default: "Sem coordenadas para este campo") %></span>
        </div>
      <% end %>
    </div>

    <!-- Cabeçalho + Botão Editar -->
    <div class="flex justify-between items-center">
      <h2 class="text-2xl font-bold text-gray-800 flex items-center gap-2">
        <i class="lucide lucide-anchor w-5 h-5 text-blue-600" aria-hidden="true"></i>
        <%= "#{t('fields.overviews.aquaculture_sea.header_title', default: 'Aquacultura (Mar)')}: #{field.name}" %>
      </h2>
      <%= link_to edit_field_path(field, locale: I18n.locale),
                  class: "inline-flex items-center gap-2 px-4 py-2 bg-yellow-400 hover:bg-yellow-500 text-gray-900 font-semibold rounded-lg shadow transition hover:scale-105 duration-200" do %>
        <i class="lucide lucide-pencil w-4 h-4" aria-hidden="true"></i> <%= t("actions.edit") %>
      <% end %>
    </div>

    <!-- Blocos de Informação -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <!-- Dados do Viveiro/Gaiola -->
      <div class="bg-white border rounded-xl p-5 shadow-sm">
        <h3 class="text-lg font-semibold text-gray-700 flex items-center gap-2">
          <i class="lucide lucide-fish w-4 h-4 text-blue-600" aria-hidden="true"></i>
          <%= t("fields.overviews.aquaculture_sea.tank_data", default: "Dados da Gaiola/Tanque") %>
        </h3>
        <div class="mt-3 space-y-1 text-sm">
          <p><strong><%= t("fields.overviews.aquaculture_sea.species", default: "Espécie") %>:</strong> <%= field.species.presence || "-" %></p>
          <p><strong><%= t("fields.overviews.aquaculture_sea.volume", default: "Volume") %>:</strong> <%= field.tank_volume.presence || "-" %> <%= t("fields.overviews.aquaculture_sea.units.volume_m3", default: "m³") %></p>
          <p><strong><%= t("fields.overviews.aquaculture_sea.density", default: "Densidade de povoamento") %>:</strong> <%= field.stocking_density.presence || "-" %> <%= t("fields.overviews.aquaculture_sea.units.density", default: "kg/m³") %></p>
          <p><strong><%= t("fields.overviews.aquaculture_sea.feeding_regime", default: "Regime alimentar") %>:</strong> <%= field.feeding_regime.presence || "-" %></p>
        </div>
      </div>

      <!-- Localização e Datas -->
      <div class="bg-white border rounded-xl p-5 shadow-sm">
        <h3 class="text-lg font-semibold text-gray-700 flex items-center gap-2">
          <i class="lucide lucide-map-pin w-4 h-4 text-blue-600" aria-hidden="true"></i>
          <%= t("fields.overviews.aquaculture_sea.dates_location", default: "Localização e Datas") %>
        </h3>
        <div class="mt-3 space-y-1 text-sm">
          <p><strong><%= t("fields.overviews.aquaculture_sea.placement_date", default: "Data de povoamento") %>:</strong> <%= field.fish_placement_date&.strftime(I18n.t("date.formats.default")) || "-" %></p>
          <p><strong><%= t("fields.overviews.aquaculture_sea.harvest_date", default: "Data estimada de colheita") %>:</strong> <%= field.estimated_harvest_date&.strftime(I18n.t("date.formats.default")) || "-" %></p>
          <p><strong><%= t("fields.edit.location.latitude", default: "Latitude") %>:</strong> <%= field.latitude.presence || "-" %></p>
          <p><strong><%= t("fields.edit.location.longitude", default: "Longitude") %>:</strong> <%= field.longitude.presence || "-" %></p>
        </div>
      </div>
    </div>

    <!-- Monitorização (médias últimas 24h) -->
    <% begin
         range_24h = 24.hours.ago..Time.current
         scope = field.sensors.joins(:sensor_readings).where(sensor_readings: { read_at: range_24h })

         # nomes de colunas esperadas em sensor_readings (ajusta conforme o teu schema)
         avg_ph        = scope.average(:ph)&.to_f&.round(2)
         avg_salinity  = scope.average(:salinity)&.to_f&.round(2)          # ppt
         avg_oxygen    = scope.average(:dissolved_oxygen)&.to_f&.round(2)  # mg/L
         avg_wtemp     = scope.average(:water_temp_c)&.to_f&.round(1)      # °C
       rescue
         avg_ph = avg_salinity = avg_oxygen = avg_wtemp = nil
       end %>

    <h3 class="text-lg font-semibold text-gray-700 mt-4">📡 <%= t("fields.overviews.aquaculture_sea.monitoring_title", default: "Monitorização (últimas 24h)") %></h3>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-2">
      <!-- pH -->
      <div class="bg-white border rounded-lg p-4 text-center shadow-sm hover:shadow-md transition-transform duration-200 transform hover:scale-105">
        <span class="block text-blue-600 text-2xl">🧪</span>
        <p class="text-gray-600 text-sm"><%= t("fields.overviews.aquaculture_sea.metrics.ph", default: "pH") %></p>
        <p class="font-bold text-lg text-gray-800 mt-2">
          <%= avg_ph || "-" %>
        </p>
        <% ph_ok = avg_ph && (7.5..8.4).cover?(avg_ph) %>
        <span class="inline-block mt-2 px-2 py-0.5 text-xs rounded-full <%= ph_ok ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-600' %> font-medium">
          <%= ph_ok ? t("common.normal", default: "Normal") : t("common.attention", default: "Atenção") %>
        </span>
      </div>

      <!-- Salinidade -->
      <div class="bg-white border rounded-lg p-4 text-center shadow-sm hover:shadow-md transition-transform duration-200 transform hover:scale-105">
        <span class="block text-indigo-600 text-2xl">🧂</span>
        <p class="text-gray-600 text-sm"><%= t("fields.overviews.aquaculture_sea.metrics.salinity", default: "Salinidade") %></p>
        <p class="font-bold text-lg text-gray-800 mt-2">
          <%= avg_salinity || "-" %> <span class="text-sm text-gray-500"><%= t("fields.overviews.aquaculture_sea.units.salinity_ppt", default: "ppt") %></span>
        </p>
        <% sal_ok = avg_salinity && (30..38).cover?(avg_salinity) %>
        <span class="inline-block mt-2 px-2 py-0.5 text-xs rounded-full <%= sal_ok ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-600' %> font-medium">
          <%= sal_ok ? t("common.normal", default: "Normal") : t("common.attention", default: "Atenção") %>
        </span>
      </div>

      <!-- Oxigénio dissolvido -->
      <div class="bg-white border rounded-lg p-4 text-center shadow-sm hover:shadow-md transition-transform duration-200 transform hover:scale-105">
        <span class="block text-cyan-600 text-2xl">🫧</span>
        <p class="text-gray-600 text-sm"><%= t("fields.overviews.aquaculture_sea.metrics.oxygen", default: "Oxigénio dissolvido") %></p>
        <p class="font-bold text-lg text-gray-800 mt-2">
          <%= avg_oxygen || "-" %> <span class="text-sm text-gray-500"><%= t("fields.overviews.aquaculture_sea.units.oxygen_mg_l", default: "mg/L") %></span>
        </p>
        <% oxy_ok = avg_oxygen && avg_oxygen >= 5.0 %>
        <span class="inline-block mt-2 px-2 py-0.5 text-xs rounded-full <%= oxy_ok ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-600' %> font-medium">
          <%= oxy_ok ? t("common.normal", default: "Normal") : t("common.attention", default: "Atenção") %>
        </span>
      </div>

      <!-- Temperatura da água -->
      <div class="bg-white border rounded-lg p-4 text-center shadow-sm hover:shadow-md transition-transform duration-200 transform hover:scale-105">
        <span class="block text-red-500 text-2xl">🌡️</span>
        <p class="text-gray-600 text-sm"><%= t("fields.overviews.aquaculture_sea.metrics.water_temperature", default: "Temperatura da água") %></p>
        <p class="font-bold text-lg text-gray-800 mt-2">
          <%= avg_wtemp || "-" %> <span class="text-sm text-gray-500"><%= t("fields.overviews.aquaculture_sea.units.temp_c", default: "°C") %></span>
        </p>
        <% wtemp_ok = avg_wtemp && (10..28).cover?(avg_wtemp) %>
        <span class="inline-block mt-2 px-2 py-0.5 text-xs rounded-full <%= wtemp_ok ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-600' %> font-medium">
          <%= wtemp_ok ? t("common.normal", default: "Normal") : t("common.attention", default: "Atenção") %>
        </span>
      </div>
    </div>

    <!-- Notas -->
    <div class="mt-6">
      <button @click="showNotes = !showNotes" class="text-blue-700 hover:underline text-sm font-medium mb-2 transition">
        <i class="lucide lucide-sticky-note w-4 h-4 inline-block mr-1" aria-hidden="true"></i>
        <%= t("fields.overviews.aquaculture_sea.toggle_notes", default: "Mostrar/ocultar notas") %>
      </button>
      <div x-show="showNotes" x-transition class="bg-gray-50 border-l-4 border-blue-400 p-4 rounded-lg shadow-sm">
        <h3 class="font-semibold text-gray-700 mb-1">📝 <%= t("fields.overviews.aquaculture_sea.notes_title", default: "Notas") %></h3>
        <p class="text-sm text-gray-600"><%= field.notes.presence || t("fields.overviews.aquaculture_sea.no_notes", default: "Sem notas adicionadas") %></p>
      </div>
    </div>

  </div>

  <script>
  (function () {
    const containerId = "map-sea-<%= field.id %>";
    const lng = <%= field.longitude || -8.611 %>;
    const lat = <%= field.latitude  || 41.145 %>;
    const hasCoords = <%= (field.latitude.present? && field.longitude.present?).to_s %>;

    if (!hasCoords) return;

    let inited = false;
    let map;

    function visible(el) {
      return el && el.offsetWidth > 0 && el.offsetHeight > 0;
    }

    function reallyInit() {
      if (inited) return true;

      const el = document.getElementById(containerId);
      if (!el || !visible(el)) return false;
      if (!(window.mapboxgl && mapboxgl.Map)) return false;

      mapboxgl.accessToken = window.MAPBOX_ACCESS_TOKEN || 'pk.eyJ1Ijoicm9tYW9maWxpcGUiLCJhIjoiY204cmpmYzNnMHhkbDJqc2F2enFsZDRxYSJ9.lzMeVTGloDJlV1RHoitdjA';

      map = new mapboxgl.Map({
        container: containerId,
        style: 'mapbox://styles/mapbox/outdoors-v12',
        center: [lng, lat],
        zoom: 13,
        attributionControl: false
      });

      map.on('load', () => {
        new mapboxgl.Marker({ color: '#2563eb' }).setLngLat([lng, lat]).addTo(map);
        map.resize();
      });

      document.addEventListener("turbo:before-cache", () => {
        try { map && map.remove(); } catch(_) {}
        inited = false;
      }, { once: true });

      inited = true;
      return true;
    }

    function initWhenVisible() {
      const el = document.getElementById(containerId);
      if (!el) return;

      if (reallyInit()) return;

      const ro = new ResizeObserver(() => {
        if (reallyInit()) ro.disconnect();
      });
      ro.observe(el);

      let tries = 0;
      const iv = setInterval(() => {
        if (reallyInit() || ++tries > 15) clearInterval(iv);
      }, 150);
    }

    const handler = () => initWhenVisible();
    ["turbo:load", "turbo:render", "turbo:frame-load"].forEach(evt =>
      document.addEventListener(evt, handler)
    );

    handler();
  })();
  </script>
<% end %>

<!-- Se estes assets já estiverem no layout, remove as 2 linhas seguintes -->
<script src="https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.js"></script>
<link   href="https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
