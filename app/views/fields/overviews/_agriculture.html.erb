<%= turbo_frame_tag "overview-#{field.id}" do %>
  <div x-data="{ showNotes: false }" class="space-y-6">

    <!-- Mapa do Campo -->
    <div class="relative">
      <div
        id="field-map-<%= field.id %>"
        class="w-full h-60 md:h-64 rounded-xl shadow border overflow-hidden"
        data-field-id="<%= field.id %>"
        data-lat="<%= field.latitude %>"
        data-lng="<%= field.longitude %>"></div>

      <% unless field.latitude.present? && field.longitude.present? %>
        <div class="absolute inset-0 flex items-center justify-center bg-white/70">
          <span class="text-sm text-slate-600"><%= t("fields.overviews.agriculture.no_coords") %></span>
        </div>
      <% end %>
    </div>

    <!-- Cabeçalho + Botão Editar -->
    <div class="flex justify-between items-center">
      <h2 class="text-2xl font-bold text-gray-800 flex items-center gap-2">
        <i class="lucide lucide-wheat w-5 h-5 text-green-600" aria-hidden="true"></i>
        <%= "#{t('fields.overviews.agriculture.header_title')}: #{field.name}" %>
      </h2>
      <%= link_to edit_field_path(field, locale: I18n.locale),
                  class: "inline-flex items-center gap-2 px-4 py-2 bg-yellow-400 hover:bg-yellow-500 text-gray-900 font-semibold rounded-lg shadow transition hover:scale-105 duration-200" do %>
        <i class="lucide lucide-pencil w-4 h-4" aria-hidden="true"></i> <%= t("actions.edit") %>
      <% end %>
    </div>

    <!-- Blocos de Informação -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <!-- Detalhes da Cultura -->
      <div class="bg-white border rounded-xl p-5 shadow-sm">
        <h3 class="text-lg font-semibold text-gray-700 flex items-center gap-2">
          <i class="lucide lucide-sprout w-4 h-4 text-green-500" aria-hidden="true"></i>
          <%= t("fields.overviews.agriculture.crop_details") %>
        </h3>
        <div class="mt-3 space-y-1 text-sm">
          <p><strong><%= t("fields.overviews.agriculture.plantation_type") %>:</strong> <%= field.plantation_type.presence || "-" %></p>
          <p><strong><%= t("fields.overviews.agriculture.area") %>:</strong> <%= field.area.presence || "-" %> ha</p>
          <p><strong><%= t("fields.overviews.agriculture.planting_date") %>:</strong> <%= field.planting_date&.strftime(I18n.t("date.formats.default")) || "-" %></p>
          <p><strong><%= t("fields.overviews.agriculture.harvest_date") %>:</strong> <%= field.harvest_date&.strftime(I18n.t("date.formats.default")) || "-" %></p>
          <p><strong><%= t("fields.overviews.agriculture.irrigation_type") %>:</strong> <%= field.irrigation_type.presence || "-" %></p>
        </div>
      </div>

      <!-- Solo e Localização -->
      <div class="bg-white border rounded-xl p-5 shadow-sm">
        <h3 class="text-lg font-semibold text-gray-700 flex items-center gap-2">
          <i class="lucide lucide-land-plot w-4 h-4 text-green-500" aria-hidden="true"></i>
          <%= t("fields.overviews.agriculture.soil_location") %>
        </h3>
        <div class="mt-3 space-y-1 text-sm">
          <p><strong><%= t("fields.edit.basic_info.soil_quality", default: t('fields.overviews.agriculture.soil_quality')) %>:</strong> <%= field.soil_quality.presence || t("common.unknown") %></p>
          <p><strong><%= t("fields.overviews.agriculture.soil_type") %>:</strong> <%= field.soil_type.presence || "-" %></p>
          <p><strong><%= t("fields.edit.location.latitude") %>:</strong> <%= field.latitude.presence || "-" %></p>
          <p><strong><%= t("fields.edit.location.longitude") %>:</strong> <%= field.longitude.presence || "-" %></p>
        </div>
      </div>
    </div>

    <!-- Monitorização (médias últimas 24h) -->
    <% begin
         range_24h = 24.hours.ago..Time.current
         scope = field.sensors.joins(:sensor_readings).where(sensor_readings: { read_at: range_24h })
         avg_temp     = scope.average(:temperature)&.to_f&.round(1)
         avg_moist    = scope.average(:moisture)&.to_f&.round(1)
         avg_hum_air  = scope.average(:air_humidity)&.to_f&.round(0)
         avg_lux      = scope.average(:light_intensity)&.to_f&.round(0)
       rescue
         avg_temp = avg_moist = avg_hum_air = avg_lux = nil
       end %>

    <h3 class="text-lg font-semibold text-gray-700 mt-4">📡 <%= t("fields.overviews.agriculture.realtime_monitoring") %></h3>

    <% if field.sensors.exists? %>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-2">
        <!-- Humidade do solo -->
        <div class="bg-white border rounded-lg p-4 text-center shadow-sm hover:shadow-md transition-transform duration-200 transform hover:scale-105">
          <span class="block text-blue-500 text-2xl">💧</span>
          <p class="text-gray-600 text-sm"><%= t("fields.overviews.agriculture.metrics.moisture") %></p>
          <p class="font-bold text-lg text-gray-800 mt-2">
            <%= avg_moist || "-" %> <span class="text-sm text-gray-500"><%= t("units.percent") %></span>
          </p>
          <% moist_ok = avg_moist && (40..80).cover?(avg_moist) %>
          <span class="inline-block mt-2 px-2 py-0.5 text-xs rounded-full <%= moist_ok ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-600' %> font-medium">
            <%= moist_ok ? t("common.normal") : t("common.attention") %>
          </span>
        </div>

        <!-- Temperatura -->
        <div class="bg-white border rounded-lg p-4 text-center shadow-sm hover:shadow-md transition-transform duration-200 transform hover:scale-105">
          <span class="block text-orange-500 text-2xl">🌡️</span>
          <p class="text-gray-600 text-sm"><%= t("fields.overviews.agriculture.metrics.temperature") %></p>
          <p class="font-bold text-lg text-gray-800 mt-2">
            <%= avg_temp || "-" %> <span class="text-sm text-gray-500"><%= t("units.celsius") %></span>
          </p>
          <% temp_ok = avg_temp && (10..40).cover?(avg_temp) %>
          <span class="inline-block mt-2 px-2 py-0.5 text-xs rounded-full <%= temp_ok ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-600' %> font-medium">
            <%= temp_ok ? t("common.normal") : t("common.attention") %>
          </span>
        </div>

        <!-- Humidade do ar -->
        <div class="bg-white border rounded-lg p-4 text-center shadow-sm hover:shadow-md transition-transform duration-200 transform hover:scale-105">
          <span class="block text-cyan-600 text-2xl">🌬️</span>
          <p class="text-gray-600 text-sm"><%= t("fields.overviews.agriculture.metrics.air_humidity") %></p>
          <p class="font-bold text-lg text-gray-800 mt-2">
            <%= avg_hum_air || "-" %> <span class="text-sm text-gray-500"><%= t("units.percent") %></span>
          </p>
        </div>

        <!-- Intensidade da luz -->
        <div class="bg-white border rounded-lg p-4 text-center shadow-sm hover:shadow-md transition-transform duration-200 transform hover:scale-105">
          <span class="block text-amber-500 text-2xl">🔆</span>
          <p class="text-gray-600 text-sm"><%= t("fields.overviews.agriculture.metrics.light") %></p>
          <p class="font-bold text-lg text-gray-800 mt-2">
            <%= avg_lux || "-" %> <span class="text-sm text-gray-500"><%= t("units.lux") %></span>
          </p>
        </div>

        <!-- Bloco de Irrigação em tempo real (se existir) -->
        <% if (irrigation_sensor = field.sensors.find_by(sensor_type: "irrigation")) %>
          <div class="bg-white border rounded-lg p-4 text-center shadow-sm hover:shadow-md transition md:col-span-2" id="<%= dom_id(irrigation_sensor, :irrigation_status_block) %>">
            <span class="block text-blue-600 text-2xl">💦</span>
            <p class="text-gray-600 text-sm"><%= t("fields.overviews.agriculture.metrics.irrigation") %></p>
            <%= render partial: "sensors/irrigation_status_block", locals: { sensor: irrigation_sensor } %>
          </div>

          <script>
            // Atualização em tempo real do bloco de irrigação (ActionCable)
            document.addEventListener("turbo:load", () => {
              const sensorId = "<%= irrigation_sensor.id %>";
              const containerId = "<%= dom_id(irrigation_sensor, :irrigation_status_block) %>";
              const consumer = window.App?.cable || window.actionCable || (window.ActionCable && window.ActionCable.createConsumer && window.ActionCable.createConsumer());
              if (!consumer || !consumer.subscriptions) return;

              const subscription = consumer.subscriptions.create(
                { channel: "IrrigationChannel", sensor_id: sensorId },
                {
                  received() {
                    fetch(`/sensors/${sensorId}/status_info`, { headers: { "Turbo-Frame": "" } })
                      .then(r => r.text())
                      .then(html => {
                        const container = document.getElementById(containerId);
                        if (container) container.innerHTML = html;
                      })
                      .catch(() => {});
                  }
                }
              );

              document.addEventListener("turbo:before-cache", () => {
                try { subscription && consumer.subscriptions.remove(subscription); } catch(_) {}
              }, { once: true });
            });
          </script>
        <% end %>
      </div>
    <% else %>
      <!-- Empty state quando não há sensores -->
      <div class="mt-3 p-6 bg-white border rounded-xl text-center text-gray-600">
        <p class="mb-2"><%= t("fields.overviews.agriculture.no_sensors") %></p>
      </div>
    <% end %>

    <!-- Notas -->
    <div class="mt-6">
      <button @click="showNotes = !showNotes" class="text-green-700 hover:underline text-sm font-medium mb-2 transition">
        <i class="lucide lucide-sticky-note w-4 h-4 inline-block mr-1" aria-hidden="true"></i>
        <%= t("fields.overviews.agriculture.toggle_notes") %>
      </button>
      <div x-show="showNotes" x-transition class="bg-gray-50 border-l-4 border-green-400 p-4 rounded-lg shadow-sm">
        <h3 class="font-semibold text-gray-700 mb-1">📝 <%= t("fields.overviews.agriculture.notes_title") %></h3>
        <p class="text-sm text-gray-600"><%= field.notes.presence || t("fields.overviews.agriculture.no_notes") %></p>
      </div>
    </div>

  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      if (!(<%= field.latitude.present?.to_s %> && <%= field.longitude.present?.to_s %>)) return;

      mapboxgl.accessToken = 'pk.eyJ1Ijoicm9tYW9maWxpcGUiLCJhIjoiY204cmpmYzNnMHhkbDJqc2F2enFsZDRxYSJ9.lzMeVTGloDJlV1RHoitdjA';

      const map = new mapboxgl.Map({
        container: 'map-agriculture-<%= field.id %>',
        style: 'mapbox://styles/mapbox/outdoors-v12',
        center: [<%= field.longitude %>, <%= field.latitude %>],
        zoom: 13
      });

      new mapboxgl.Marker()
        .setLngLat([<%= field.longitude %>, <%= field.latitude %>])
        .addTo(map);
    });
  </script>
<% end %>

<%#
  Dependências no layout (se ainda não estiverem incluídas):
  <script src="https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.js"></script>
  <link   href="https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.css" rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
%>
