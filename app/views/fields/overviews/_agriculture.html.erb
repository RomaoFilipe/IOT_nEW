<%= turbo_frame_tag "overview-#{field.id}" do %>
  <div x-data="{ showNotes: false }" class="space-y-6">
    <div class="relative">
      <div id="map-agriculture-<%= field.id %>" class="w-full h-60 rounded-xl shadow border overflow-hidden"></div>
      <% unless field.latitude.present? && field.longitude.present? %>
        <div class="absolute inset-0 flex items-center justify-center bg-white/70">
          <span class="text-sm text-slate-600"><%= t("fields.no_coords", default: "Sem coordenadas para este campo") %></span>
        </div>
      <% end %>
    </div>

    <div class="flex justify-between items-center">
      <h2 class="text-2xl font-bold text-gray-800 flex items-center gap-2">
        <i class="lucide lucide-wheat w-5 h-5 text-green-600"></i>
        <%= t("fields.agriculture_title", default: "Agricultura") %>: <%= field.name %>
      </h2>
      <%= link_to edit_field_path(field, locale: I18n.locale),
                  class: "inline-flex items-center gap-2 px-4 py-2 bg-yellow-400 hover:bg-yellow-500 text-gray-900 font-semibold rounded-lg shadow transition hover:scale-105 duration-200" do %>
        <i class="lucide lucide-pencil w-4 h-4"></i> <%= t("actions.edit", default: "Editar") %>
      <% end %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="bg-white border rounded-xl p-5 shadow-sm">
        <h3 class="text-lg font-semibold text-gray-700 flex items-center gap-2">
          <i class="lucide lucide-sprout w-4 h-4 text-green-500"></i>
          <%= t("fields.crop_details", default: "Detalhes da Cultura") %>
        </h3>
        <div class="mt-3 space-y-1 text-sm">
          <p><strong><%= t("fields.plantation_type", default: "Tipo de Plantação") %>:</strong> <%= field.plantation_type.presence || '-' %></p>
          <p><strong><%= t("fields.area", default: "Área") %>:</strong> <%= field.area.presence || '-' %> ha</p>
          <p><strong><%= t("fields.planting_date", default: "Data de Plantação") %>:</strong> <%= field.planting_date&.strftime('%d/%m/%Y') || '-' %></p>
          <p><strong><%= t("fields.harvest_date", default: "Data de Colheita") %>:</strong> <%= field.harvest_date&.strftime('%d/%m/%Y') || '-' %></p>
          <p><strong><%= t("fields.irrigation_type", default: "Irrigação") %>:</strong> <%= field.irrigation_type.presence || '-' %></p>
        </div>
      </div>

      <div class="bg-white border rounded-xl p-5 shadow-sm">
        <h3 class="text-lg font-semibold text-gray-700 flex items-center gap-2">
          <i class="lucide lucide-land-plot w-4 h-4 text-green-500"></i>
          <%= t("fields.soil_location", default: "Solo & Localização") %>
        </h3>
        <div class="mt-3 space-y-1 text-sm">
          <p><strong><%= t("fields.soil_type", default: "Tipo de Solo") %>:</strong> <%= field.soil_type.presence || '-' %></p>
          <p><strong><%= t("fields.soil_quality", default: "Qualidade do Solo") %>:</strong> <%= field.soil_quality.presence || t("fields.undefined", default: "Indefinido") %></p>
          <p><strong>Latitude:</strong> <%= field.latitude.presence || '-' %></p>
          <p><strong>Longitude:</strong> <%= field.longitude.presence || '-' %></p>
        </div>
      </div>
    </div>

    <h3 class="text-lg font-semibold text-gray-700 mt-4">📡 <%= t("fields.realtime_monitoring", default: "Monitorização em Tempo Real") %></h3>

    <%= turbo_stream_from [field, :metrics] %>
    <%= turbo_frame_tag dom_id(field, :metrics) do %>
      <%= render partial: "fields/metrics", locals: { field: field } %>
    <% end %>

    <% if field.sensors.exists? %>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-2">
        <div class="bg-white border rounded-lg p-4 text-center shadow-sm hover:shadow-md transition-transform duration-200 transform hover:scale-105">
          <span class="block text-blue-500 text-2xl">💧</span>
          <p class="text-gray-600 text-sm"><%= t("metrics.moisture", default: "Humidade do Solo") %></p>
          <p class="font-bold text-lg text-gray-800 mt-2">
            <%= avg_moist || '-' %> <span class="text-sm text-gray-500">%</span>
          </p>
          <% moist_status = (avg_moist && (40..80).cover?(avg_moist)) ? t("metrics.normal", default: "Normal") : t("metrics.attention", default: "Atenção") %>
          <span class="inline-block mt-2 px-2 py-0.5 text-xs rounded-full <%= moist_status == t('metrics.normal', default: 'Normal') ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-600' %> font-medium">
            <%= moist_status %>
          </span>
        </div>

        <div class="bg-white border rounded-lg p-4 text-center shadow-sm hover:shadow-md transition-transform duration-200 transform hover:scale-105">
          <span class="block text-orange-500 text-2xl">🌡️</span>
          <p class="text-gray-600 text-sm"><%= t("metrics.temperature", default: "Temperatura") %></p>
          <p class="font-bold text-lg text-gray-800 mt-2">
            <%= avg_temp || '-' %> <span class="text-sm text-gray-500">°C</span>
          </p>
          <% temp_status = (avg_temp && (10..40).cover?(avg_temp)) ? t("metrics.normal", default: "Normal") : t("metrics.attention", default: "Atenção") %>
          <span class="inline-block mt-2 px-2 py-0.5 text-xs rounded-full <%= temp_status == t('metrics.normal', default: 'Normal') ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-600' %> font-medium">
            <%= temp_status %>
          </span>
        </div>

        <div class="bg-white border rounded-lg p-4 text-center shadow-sm hover:shadow-md transition-transform duration-200 transform hover:scale-105">
          <span class="block text-cyan-600 text-2xl">🌬️</span>
          <p class="text-gray-600 text-sm"><%= t("metrics.air_humidity", default: "Humidade do Ar") %></p>
          <p class="font-bold text-lg text-gray-800 mt-2">
            <%= avg_hum_air || '-' %> <span class="text-sm text-gray-500">%</span>
          </p>
        </div>

        <div class="bg-white border rounded-lg p-4 text-center shadow-sm hover:shadow-md transition-transform duration-200 transform hover:scale-105">
          <span class="block text-amber-500 text-2xl">🔆</span>
          <p class="text-gray-600 text-sm"><%= t("metrics.light", default: "Intensidade da Luz") %></p>
          <p class="font-bold text-lg text-gray-800 mt-2">
            <%= avg_lux || '-' %> <span class="text-sm text-gray-500">lux</span>
          </p>
        </div>

        <% if (irrigation_sensor = field.sensors.find_by(sensor_type: "irrigation")) %>
          <div class="bg-white border rounded-lg p-4 text-center shadow-sm hover:shadow-md transition md:col-span-2" id="<%= dom_id(irrigation_sensor, :irrigation_status_block) %>">
            <span class="block text-blue-600 text-2xl">💦</span>
            <p class="text-gray-600 text-sm"><%= t("metrics.irrigation", default: "Irrigação") %></p>
            <%= render partial: "sensors/irrigation_status_block", locals: { sensor: irrigation_sensor } %>
          </div>

          <script>
            document.addEventListener("turbo:load", () => {
              const sensorId = "<%= irrigation_sensor.id %>";
              const containerId = "<%= dom_id(irrigation_sensor, :irrigation_status_block) %>";
              const consumer = window.App?.cable || window.actionCable || (window.ActionCable && window.ActionCable.createConsumer && window.ActionCable.createConsumer());
              if (!consumer || !consumer.subscriptions) return;
              const subscription = consumer.subscriptions.create(
                { channel: "IrrigationChannel", sensor_id: sensorId },
                {
                  received() {
                    fetch(`/sensors/${sensorId}/status_info`, { headers: { "Turbo-Frame": "" } })
                      .then(r => r.text())
                      .then(html => {
                        const container = document.getElementById(containerId);
                        if (container) container.innerHTML = html;
                      })
                      .catch(() => {});
                  }
                }
              );
              document.addEventListener("turbo:before-cache", () => {
                try { subscription && consumer.subscriptions.remove(subscription); } catch(_) {}
              }, { once: true });
            });
          </script>
        <% end %>
      </div>
    <% else %>
      <div class="mt-3 p-6 bg-white border rounded-xl text-center text-gray-600">
        <p class="mb-2"><%= t("fields.no_sensors", default: "Ainda não existem sensores associados a este campo.") %></p>
        <%= link_to t("sensors.add", default: "Adicionar Sensor"),
                    new_sensor_path(field_id: field.id, locale: I18n.locale),
                    class: "inline-flex items-center gap-2 px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold rounded-lg shadow transition" %>
      </div>
    <% end %>

    <div class="mt-6">
      <button @click="showNotes = !showNotes" class="text-green-700 hover:underline text-sm font-medium mb-2 transition">
        <i class="lucide lucide-sticky-note w-4 h-4 inline-block mr-1"></i>
        <%= t("fields.toggle_notes", default: "Ver/Esconder Notas") %>
      </button>
      <div x-show="showNotes" x-transition class="bg-gray-50 border-l-4 border-green-400 p-4 rounded-lg shadow-sm">
        <h3 class="font-semibold text-gray-700 mb-1">📝 <%= t("fields.observations", default: "Observações") %></h3>
        <p class="text-sm text-gray-600"><%= field.notes.presence || t("fields.no_notes", default: "Sem observações.") %></p>
      </div>
    </div>
  </div>

  <script>
    (function() {
      const init = () => {
        const hasCoords = <%= (field.latitude.present? && field.longitude.present?).to_s %>;
        if (!hasCoords) return;
        if (!(window.mapboxgl && mapboxgl.Map)) return;
        const containerId = "map-agriculture-<%= field.id %>";
        const container   = document.getElementById(containerId);
        if (!container || container.dataset.initialized === "true") return;
        container.dataset.initialized = "true";
        if (!container.style.minHeight) container.style.minHeight = '240px';
        mapboxgl.accessToken = window.MAPBOX_ACCESS_TOKEN || 'pk.eyJ1Ijoicm9tYW9maWxpcGUiLCJhIjoiY204cmpmYzNnMHhkbDJqc2F2enFsZDRxYSJ9.lzMeVTGloDJlV1RHoitdjA';
        const lng = <%= field.longitude || -8.611 %>;
        const lat = <%= field.latitude  || 41.145 %>;
        const map = new mapboxgl.Map({
          container: containerId,
          style: 'mapbox://styles/mapbox/outdoors-v12',
          center: [lng, lat],
          zoom: 13,
          attributionControl: false
        });
        map.on('load', () => {
          new mapboxgl.Marker({ color: '#059669' }).setLngLat([lng, lat]).addTo(map);
          setTimeout(() => map.resize(), 80);
        });
        document.addEventListener("turbo:before-cache", () => {
          try { map.remove(); } catch(_) {}
          if (container) container.dataset.initialized = "false";
        }, { once: true });
      };
      document.addEventListener("turbo:load", init);
      document.addEventListener("turbo:frame-load", (e) => {
        const tf = e.target;
        if (tf && tf.id === "overview-<%= field.id %>") init();
        else init();
      });
    })();
  </script>
<% end %>
