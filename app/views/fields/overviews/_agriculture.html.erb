<%= turbo_frame_tag "overview-#{field.id}" do %>
  <!-- Cabeçalho com botão Editar -->
  <div class="flex justify-between items-center mb-4">
    <h2 class="text-xl font-bold text-gray-800 flex items-center gap-2">
      <i class="lucide lucide-wheat w-5 h-5 text-green-600"></i>
      Detalhes da Agricultura
    </h2>

    <%= link_to edit_field_path(field), class: "inline-flex items-center gap-2 px-4 py-2 bg-yellow-400 hover:bg-yellow-500 text-gray-900 font-semibold rounded-lg shadow transition" do %>
      <i class="lucide lucide-pencil w-4 h-4"></i>
      Editar
    <% end %>
  </div>

  <!-- Informações da Cultura -->
  <div class="grid grid-cols-2 gap-6">
    <!-- Mapa -->
    <div class="bg-green-50 rounded-lg h-40 flex items-center justify-center">
      <i class="lucide lucide-map w-12 h-12 text-green-500"></i>
    </div>

    <!-- Dados principais -->
    <div>
      <h3 class="font-semibold mb-2">Informação da Cultura</h3>
      <p><strong>Data de Plantação:</strong> <%= field.planting_date&.strftime("%Y-%m-%d") || "-" %></p>
      <p><strong>Data de Colheita:</strong> <%= field.harvest_date&.strftime("%Y-%m-%d") || "-" %></p>
      <p><strong>Área:</strong> <%= field.area %> ha</p>
      <p><strong>Tipo de Cultura:</strong> <%= field.field_type.humanize %></p>
      <p><strong>Qualidade do Solo:</strong> <%= field.soil_quality || "-" %></p>
      <p><strong>Tipo de Solo:</strong> <%= field.soil_type || "-" %></p>
      <p><strong>Tipo de Irrigação:</strong> <%= field.irrigation_type || "-" %></p>

      <h3 class="font-semibold mt-4">Notas</h3>
      <p class="text-sm text-gray-600"><%= field.notes || "Sem observações." %></p>
    </div>
  </div>

  <!-- Leituras Atuais -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-6">
    <!-- Humidade -->
    <div class="bg-green-100 p-4 rounded-lg text-center">
      <span class="block text-blue-500 text-2xl">💧</span>
      <p class="text-gray-600">Humidade</p>
      <p class="font-bold text-lg">
        <%= field.sensors.average(:moisture)&.round(1) || '-' %>%
      </p>
    </div>

    <!-- Temperatura -->
    <div class="bg-green-100 p-4 rounded-lg text-center">
      <span class="block text-orange-500 text-2xl">🌡</span>
      <p class="text-gray-600">Temperatura</p>
      <p class="font-bold text-lg">
        <%= field.sensors.average(:temperature)&.round(1) || "-" %>°C
      </p>
    </div>

    <!-- Estado da Colheita -->
    <div class="bg-green-100 p-4 rounded-lg text-center">
      <span class="block text-green-600 text-2xl">🌱</span>
      <p class="text-gray-600">Estado da Cultura</p>
      <p class="font-bold text-lg">Saudável</p>
    </div>

    <% if irrigation_sensor = field.sensors.find_by(sensor_type: "irrigation") %>
      <div class="bg-green-100 p-4 rounded-lg text-center" id="<%= dom_id(irrigation_sensor, :irrigation_status_block) %>">
        <span class="block text-blue-600 text-2xl">💦</span>
        <p class="text-gray-600">Irrigação</p>

        <%= render partial: "sensors/irrigation_status_block", locals: { sensor: irrigation_sensor } %>
      </div>
    <% end %>
  </div>
<% end %>
