  <!-- Cabeçalho + Botão Editar -->
  <div class="flex justify-between items-center">
    <h2 class="text-2xl font-bold text-gray-800 flex items-center gap-2">
      <i class="lucide lucide-wheat w-5 h-5 text-green-600"></i>
      Agricultura: <%= field.name %>
    </h2>
    <%= link_to edit_field_path(field, locale: I18n.locale), class: "inline-flex items-center gap-2 px-4 py-2 bg-yellow-400 hover:bg-yellow-500 text-gray-900 font-semibold rounded-lg shadow transition hover:scale-105 duration-200" do %>
      <i class="lucide lucide-pencil w-4 h-4"></i> Editar
    <% end %>
  </div>

  <!-- Blocos de Informação -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <!-- Detalhes da Cultura -->
    <div class="bg-white border rounded-xl p-5 shadow-sm">
      <h3 class="text-lg font-semibold text-gray-700 flex items-center gap-2">
        <i class="lucide lucide-sprout w-4 h-4 text-green-500"></i> Detalhes da Cultura
      </h3>
      <div class="mt-3 space-y-1 text-sm">
        <p><strong>Tipo de Plantação:</strong> <%= field.plantation_type || '-' %></p>
        <p><strong>Área:</strong> <%= field.area || '-' %> ha</p>
        <p><strong>Data de Plantação:</strong> <%= field.planting_date&.strftime('%d/%m/%Y') || '-' %></p>
        <p><strong>Data de Colheita:</strong> <%= field.harvest_date&.strftime('%d/%m/%Y') || '-' %></p>
        <p><strong>Irrigação:</strong> <%= field.irrigation_type || '-' %></p>
      </div>
    </div>

    <!-- Solo e Localização -->
    <div class="bg-white border rounded-xl p-5 shadow-sm">
      <h3 class="text-lg font-semibold text-gray-700 flex items-center gap-2">
        <i class="lucide lucide-land-plot w-4 h-4 text-green-500"></i> Solo & Localização
      </h3>
      <div class="mt-3 space-y-1 text-sm">
        <p><strong>Tipo de Solo:</strong> <%= field.soil_type || '-' %></p>
        <p><strong>Qualidade do Solo:</strong> <%= field.soil_quality || 'Indefinido' %></p>
        <p><strong>Latitude:</strong> <%= field.latitude || '-' %></p>
        <p><strong>Longitude:</strong> <%= field.longitude || '-' %></p>
      </div>
    </div>
  </div>

  <!-- Monitoramento -->
  <h3 class="text-lg font-semibold text-gray-700 mt-4">📡 Monitoramento em Tempo Real</h3>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-2">
    <% sensores = {
      "Humidade" => [:moisture, "💧", "text-blue-500", "%", 40..80],
      "Temperatura" => [:temperature, "🌡", "text-orange-500", "°C", 10..40],
      "Estado da Cultura" => [:crop_health, "🌱", "text-green-600", "", nil]
    } %>

    <% sensores.each do |label, (attr, icon, cor, unidade, range)| %>
      <% valor = attr == :crop_health ? nil : field.sensors.average(attr)&.to_f&.round(1) %>
      <% status = if attr == :crop_health
        "Saudável"
      else
        valor && range&.cover?(valor) ? "Normal" : "Atenção"
      end %>
      <% badge_class = status == "Normal" ? "bg-green-100 text-green-700" : "bg-red-100 text-red-600" %>

      <div class="bg-white border rounded-lg p-4 text-center shadow-sm hover:shadow-md transition-transform duration-200 transform hover:scale-105">
        <span class="block <%= cor %> text-2xl"><%= icon %></span>
        <p class="text-gray-600 text-sm"><%= label %></p>
        <p class="font-bold text-lg text-gray-800 mt-2">
          <% if attr == :crop_health %>
            Saudável
          <% else %>
            <%= valor || '-' %> <span class="text-sm text-gray-500"><%= unidade %></span>
          <% end %>
        </p>
        <% unless attr == :crop_health %>
          <span class="inline-block mt-2 px-2 py-0.5 text-xs rounded-full <%= badge_class %> font-medium">
            <%= status %>
          </span>
        <% end %>
      </div>
    <% end %>

    <% if (irrigation_sensor = field.sensors.find_by(sensor_type: "irrigation")) %>
      <div class="bg-white border rounded-lg p-4 text-center shadow-sm hover:shadow-md transition" id="<%= dom_id(irrigation_sensor, :irrigation_status_block) %>">
        <span class="block text-blue-600 text-2xl">💦</span>
        <p class="text-gray-600 text-sm">Irrigação</p>
        <%= render partial: "sensors/irrigation_status_block", locals: { sensor: irrigation_sensor } %>
      </div>

      <script>
        // Atualização em tempo real do bloco de irrigação (ActionCable)
        document.addEventListener("turbo:load", () => {
          const sensorId = "<%= irrigation_sensor.id %>";
          if (!window.App || !window.App.cable) return;

          window.App.cable.subscriptions.create(
            { channel: "IrrigationChannel", sensor_id: sensorId },
            {
              received() {
                fetch(`/sensors/${sensorId}/status_info`, { headers: { "Turbo-Frame": "" } })
                  .then(r => r.text())
                  .then(html => {
                    const container = document.getElementById(`sensor_${sensorId}_irrigation_status_block`);
                    if (container) container.innerHTML = html;
                  });
              }
            }
          );
        });
      </script>
    <% end %>
  </div>

  <!-- Notas -->
  <div class="mt-6">
    <button @click="showNotes = !showNotes" class="text-green-700 hover:underline text-sm font-medium mb-2 transition">
      <i class="lucide lucide-sticky-note w-4 h-4 inline-block mr-1"></i> Ver/Esconder Notas
    </button>
    <div x-show="showNotes" x-transition class="bg-gray-50 border-l-4 border-green-400 p-4 rounded-lg shadow-sm">
      <h3 class="font-semibold text-gray-700 mb-1">📝 Observações</h3>
      <p class="text-sm text-gray-600"><%= field.notes.presence || "Sem observações." %></p>
    </div>
  </div>

</div>

<script>
  // Inicialização do Mapbox (compatível com Turbo)
  document.addEventListener("turbo:load", function () {
    const hasCoords = <%= (field.latitude.present? && field.longitude.present?).to_s %>;
    if (!hasCoords) return;
    if (!(window.mapboxgl && mapboxgl.Map)) return;

    mapboxgl.accessToken = 'pk.eyJ1Ijoicm9tYW9maWxpcGUiLCJhIjoiY204cmpmYzNnMHhkbDJqc2F2enFsZDRxYSJ9.lzMeVTGloDJlV1RHoitdjA';

    const map = new mapboxgl.Map({
      container: 'map-agriculture-<%= field.id %>',
      style: 'mapbox://styles/mapbox/outdoors-v12',
      center: [<%= field.longitude || -8.611 %>, <%= field.latitude || 41.145 %>],
      zoom: 13,
      attributionControl: false
    });

    map.on('load', () => {
      new mapboxgl.Marker({ color: '#059669' })
        .setLngLat([<%= field.longitude || -8.611 %>, <%= field.latitude || 41.145 %>])
        .addTo(map);
      setTimeout(() => map.resize(), 120);
    });
  });
</script>
<% end %>

