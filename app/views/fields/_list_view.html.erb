<div id="listViewContainer">
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @fields.each do |field| %>
      <% avg_moist = field.sensors.average(:moisture)&.round %>
      <% avg_temp  = field.sensors.average(:temperature)&.round(1) %>
      <% location_text =
           if field.respond_to?(:formatted_location) && field.formatted_location.present?
             field.formatted_location
           elsif field.latitude.present? && field.longitude.present?
             "#{format('%.5f', field.latitude)}, #{format('%.5f', field.longitude)}"
           else
             t("fields.location.none", default: "Sem localização")
           end %>
      <% status_label = field.status.presence || t("fields.status.unknown", default: "Desconhecido") %>
      <% status_class =
           case field.status.to_s.downcase
           when "active", "ativo" then "bg-emerald-50 text-emerald-700 ring-1 ring-emerald-200"
           when "paused", "inativo", "inactive" then "bg-amber-50 text-amber-700 ring-1 ring-amber-200"
           else "bg-slate-100 text-slate-700 ring-1 ring-slate-200"
           end %>

      <article class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden flex flex-col">
        <!-- MINI MAPA -->
        <div class="relative mini-map-container">
          <% if field.latitude.present? && field.longitude.present? %>
            <div
              id="mini-map-<%= field.id %>"
              data-mini-map="true"
              data-lat="<%= field.latitude %>"
              data-lng="<%= field.longitude %>"
              class="w-full h-full rounded-xl"
            ></div>

            <button
              type="button"
              class="mini-map-button inline-flex items-center gap-1"
              onclick="flyToField(<%= field.longitude %>, <%= field.latitude %>, <%= field.id %>)">
              <i class="lucide lucide-map w-3.5 h-3.5"></i>
              <span class="text-xs font-medium">Ver no mapa</span>
            </button>
          <% else %>
            <div class="flex items-center justify-center h-36 text-slate-400">
              <i class="lucide lucide-map-pin w-8 h-8"></i>
            </div>
          <% end %>
        </div>

        <!-- INFO -->
        <div class="p-4 flex-1 flex flex-col gap-3">
          <header class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <h2 class="font-semibold text-slate-900 truncate"><%= field.name %></h2>
              <p class="text-sm text-slate-600 truncate"><%= field.field_type.to_s.humanize %></p>
            </div>
            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium <%= status_class %>">
              <span class="text-[10px]">●</span> <%= status_label %>
            </span>
          </header>

          <div class="grid grid-cols-2 gap-3 text-sm">
            <p class="text-slate-600"><span class="font-medium">📍</span> <%= location_text %></p>
            <p class="text-slate-600"><span class="font-medium">📏</span> <%= field.area || '—' %> ha</p>
            <p class="text-slate-600">
              <span class="font-medium">💧</span>
              <%= avg_moist ? "#{avg_moist}%" : '—' %>
            </p>
            <p class="text-slate-600">
              <span class="font-medium">🌡</span>
              <%= avg_temp ? "#{avg_temp}°C" : '—' %>
            </p>
          </div>

          <p class="text-xs text-slate-500">
            <%= t("common.last_updated", default: "Atualizado há") %> <%= time_ago_in_words(field.updated_at) %>
          </p>

          <div class="mt-1">
            <button
              type="button"
              onclick="toggleViewDetails(<%= field.id %>)"
              class="w-full text-center px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-800 rounded-md text-sm font-medium transition">
              <i class="lucide lucide-eye w-4 h-4 inline-block -mt-0.5 mr-1"></i>
              <%= t("fields.actions.view_details", default: "Ver detalhes") %>
            </button>
          </div>
        </div>
      </article>
    <% end %>
  </div>
</div>

<!-- CSS Mini Mapa -->
<style>
  .mini-map-container{position:relative;width:100%;height:160px}
  .mini-map-button{
    position:absolute;bottom:.5rem;right:.5rem;background:#fff;color:#374151;
    border:1px solid #d1d5db;padding:.25rem .5rem;border-radius:.375rem;
    box-shadow:0 1px 2px rgba(0,0,0,.08)
  }
  .mini-map-container .mapboxgl-ctrl-logo,
  .mini-map-container .mapboxgl-ctrl-attrib{display:none!important}
</style>

<script>
  // Chama o inicializador global definido no index (idêntico ao que já te dei).
  document.addEventListener("DOMContentLoaded", () => {
    if (typeof initializeMiniMaps === "function") {
      // pequeno atraso para garantir que os nós já estão no DOM
      setTimeout(() => initializeMiniMaps(), 150);
    }
  });

  // Helper: abre o separador "Mapa", inicializa (se preciso) e faz flyTo.
  // Nota: no _map_view, ao criares o mapa principal, faz:
  //   window.mainFieldsMap = map;
  window.flyToField = function(lng, lat, id){
    try {
      // muda para o separador Mapa
      const mapTabBtn = document.querySelector('[aria-label="View switch"] button:last-child');
      if (mapTabBtn) mapTabBtn.click();
      if (typeof updateQuery === "function") updateQuery("map");
      if (typeof initMainMapIfNeeded === "function") initMainMapIfNeeded();

      // espera o mapa principal ficar pronto
      const seek = () => {
        const m = window.mainFieldsMap || window.__fieldsMainMap;
        if (m && typeof m.flyTo === "function") {
          m.flyTo({ center: [lng, lat], zoom: 13, essential: true });
          const container = document.getElementById("fields-main-map");
          if (container) container.scrollIntoView({ behavior: "smooth", block: "start" });
        } else {
          setTimeout(seek, 200);
        }
      };
      seek();
    } catch (e) {
      console.error("flyToField error:", e);
    }
  };
</script>
