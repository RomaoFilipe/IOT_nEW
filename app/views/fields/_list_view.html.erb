<div id="listViewContainer">
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 justify-center">
    <% @fields.each do |field| %>
      <div class="bg-white rounded-lg shadow overflow-hidden flex flex-col">
        <!-- MINI MAPA -->
        <div class="bg-gray-100 h-36 relative">
          <% if field.latitude.present? && field.longitude.present? %>
            <div class="mini-map-container">
              <div id="mini-map-<%= field.id %>" class="w-full h-full rounded-md"></div>
              <button class="mini-map-button" onclick="flyToField(<%= field.longitude %>, <%= field.latitude %>, <%= field.id %>)">
                <%= t("fields.list_view.view_on_map") %>
              </button>
            </div>
          <% else %>
            <div class="flex items-center justify-center h-full">
              <svg xmlns="http://www.w3.org/2000/svg" class="text-gray-400" width="48" height="48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z" />
                <path d="M15 5.764v15" />
                <path d="M9 3.236v15" />
              </svg>
            </div>
          <% end %>
        </div>

        <!-- INFO DO CAMPO -->
        <div class="p-4 flex-1 flex flex-col justify-between">
          <div>
            <h2 class="font-bold text-lg text-gray-800 mb-1"><%= field.name %></h2>
            <p><strong><%= t("fields.list_view.crop") %>:</strong> <%= field.field_type %></p>
            <p><strong><%= t("fields.list_view.location") %>:</strong> <%= field.formatted_location %></p>
            <p><strong><%= t("fields.list_view.area") %>:</strong> <%= field.area %> ha</p>

            <div class="flex justify-between mt-2 text-sm text-gray-600">
              <span>💧 <%= rand(40..80) %>%</span>
              <span>🌡 <%= rand(20..30) %>°C</span>
            </div>

            <p class="text-xs text-gray-500 mt-2">
              <%= t("fields.list_view.last_updated") %>: <%= time_ago_in_words(field.updated_at) %> <%= t("time.ago") %>
            </p>
          </div>

          <div class="mt-4">
            <button
              onclick="toggleViewDetails(<%= field.id %>)"
              class="w-full text-center px-4 py-2 bg-blue-100 hover:bg-blue-200 text-blue-800 rounded-md text-sm font-medium transition"
            >
              <%= t("fields.list_view.view_details") %>
            </button>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>

<!-- CSS Mini Mapa -->
<style>
  .mini-map-container {
    position: relative;
    width: 100%;
    height: 144px !important;
  }

  .mini-map-container > div {
    width: 100%;
    height: 100%;
    border-radius: 0.5rem;
  }

  .mini-map-button {
    position: absolute;
    bottom: 0.5rem;
    right: 0.5rem;
    font-size: 0.75rem;
    background: white;
    color: #4B5563;
    border: 1px solid #D1D5DB;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
  }

  .mini-map-container .mapboxgl-ctrl-logo,
  .mini-map-container .mapboxgl-ctrl-attrib {
    display: none !important;
  }
</style>

<!-- JS Mini Mapa -->
<script>
  function initializeMiniMaps() {
    if (typeof mapboxgl === 'undefined') return;

    mapboxgl.accessToken = 'pk.eyJ1Ijoicm9tYW9maWxpcGUiLCJhIjoiY204cmpmYzNnMHhkbDJqc2F2enFsZDRxYSJ9.lzMeVTGloDJlV1RHoitdjA';

    const fields = <%= raw @fields.to_json %>;

    fields.forEach(field => {
      const miniMapDiv = document.getElementById(`mini-map-${field.id}`);
      if (miniMapDiv && field.latitude && field.longitude) {
        if (miniMapDiv.dataset.mapInitialized === "true") return;

        const style = window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "mapbox://styles/mapbox/dark-v10"
          : "mapbox://styles/mapbox/streets-v11";

        const miniMap = new mapboxgl.Map({
          container: miniMapDiv,
          style: style,
          center: [field.longitude, field.latitude],
          zoom: 13,
          interactive: false,
          attributionControl: false
        });

        miniMap.on('load', () => {
          new mapboxgl.Marker({ color: "blue" })
            .setLngLat([field.longitude, field.latitude])
            .addTo(miniMap);

          setTimeout(() => miniMap.resize(), 200);
          miniMapDiv.dataset.mapInitialized = "true";
        });
      }
    });
  }

  document.addEventListener("DOMContentLoaded", () => {
    setTimeout(() => initializeMiniMaps(), 200);
  });
</script>
