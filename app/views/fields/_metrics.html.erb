<%
  now = Time.current
  range_short = 10.minutes.ago..now

  scope = SensorReading
            .joins(:sensor)
            .where(sensors: { field_id: field.id })
            .where("COALESCE(sensor_readings.read_at, sensor_readings.measured_at) BETWEEN ? AND ?", range_short.begin, range_short.end)

  last_reading = SensorReading
                   .joins(:sensor)
                   .where(sensors: { field_id: field.id })
                   .order(Arel.sql("COALESCE(sensor_readings.read_at, sensor_readings.measured_at) DESC"))
                   .first

  avg_temp    = scope.average(:temperature)&.to_f&.round(1)
  avg_moist   = scope.average(:moisture)&.to_f&.round(1)
  avg_hum_air = scope.average(:air_humidity)&.to_f&.round(1)
  avg_lux     = scope.average(:light_intensity)&.to_f&.round(0)

  temp_value  = avg_temp    || last_reading&.temperature&.to_f&.round(1)
  moist_value = avg_moist   || last_reading&.moisture&.to_f&.round(1)
  hum_value   = avg_hum_air || last_reading&.air_humidity&.to_f&.round(1)
  lux_value   = avg_lux     || last_reading&.light_intensity&.to_f&.round(0)
%>

<% if field.sensors.exists? %>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-2">

    <!-- Soil moisture -->
    <div class="bg-white border rounded-lg p-4 text-center shadow-sm hover:shadow-md transition-transform duration-200 transform hover:scale-105" id="soil-card">
      <span class="block text-blue-500 text-2xl">💧</span>
      <p class="text-gray-600 text-sm"><%= t("fields.metrics.soil_moisture") %></p>
      <p class="font-bold text-lg text-gray-800 mt-2">
        <% if moist_value.present? %>
          <%= moist_value %> <span class="text-sm text-gray-500"><%= t("units.percent") %></span>
        <% else %>
          <%= t("common.unknown", default: "—") %>
        <% end %>
      </p>
      <% moist_ok = moist_value && (40..80).cover?(moist_value) %>
      <span class="inline-block mt-2 px-2 py-0.5 text-xs rounded-full <%= moist_ok ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-600' %> font-medium">
        <%= moist_ok ? t("common.normal") : t("common.attention") %>
      </span>
    </div>

    <!-- Air temperature -->
    <div class="bg-white border rounded-lg p-4 text-center shadow-sm hover:shadow-md transition-transform duration-200 transform hover:scale-105" id="temp-card">
      <span class="block text-orange-500 text-2xl">🌡️</span>
      <p class="text-gray-600 text-sm"><%= t("fields.metrics.temperature") %></p>
      <p class="font-bold text-lg text-gray-800 mt-2">
        <% if temp_value.present? %>
          <%= temp_value %> <span class="text-sm text-gray-500"><%= t("units.celsius") %></span>
        <% else %>
          <%= t("common.unknown", default: "—") %>
        <% end %>
      </p>
      <% temp_ok = temp_value && (10..40).cover?(temp_value) %>
      <span class="inline-block mt-2 px-2 py-0.5 text-xs rounded-full <%= temp_ok ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-600' %> font-medium">
        <%= temp_ok ? t("common.normal") : t("common.attention") %>
      </span>
    </div>

    <!-- Air humidity -->
    <div class="bg-white border rounded-lg p-4 text-center shadow-sm hover:shadow-md transition-transform duration-200 transform hover:scale-105" id="hum-card">
      <span class="block text-cyan-600 text-2xl">🌬️</span>
      <p class="text-gray-600 text-sm"><%= t("fields.metrics.air_humidity") %></p>
      <p class="font-bold text-lg text-gray-800 mt-2">
        <% if hum_value.present? %>
          <%= hum_value %> <span class="text-sm text-gray-500"><%= t("units.percent") %></span>
        <% else %>
          <%= t("common.unknown", default: "—") %>
        <% end %>
      </p>
    </div>

    <!-- Light -->
    <div class="bg-white border rounded-lg p-4 text-center shadow-sm hover:shadow-md transition-transform duration-200 transform hover:scale-105" id="lux-card">
      <span class="block text-amber-500 text-2xl">🔆</span>
      <p class="text-gray-600 text-sm"><%= t("fields.metrics.light") %></p>
      <p class="font-bold text-lg text-gray-800 mt-2">
        <% if lux_value.present? %>
          <%= lux_value %> <span class="text-sm text-gray-500"><%= t("units.lux") %></span>
        <% else %>
          <%= t("common.unknown", default: "—") %>
        <% end %>
      </p>
    </div>

  </div>
<% else %>
  <div class="mt-3 p-6 bg-white border rounded-xl text-center text-gray-600">
    <p class="mb-2"><%= t("fields.metrics.no_sensors") %></p>
    <%= link_to t("sensors.add"),
                new_sensor_path(field_id: field.id, locale: I18n.locale),
                class: "inline-flex items-center gap-2 px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold rounded-lg shadow transition" %>
  </div>
<% end %>
