
<% range_short = 10.minutes.ago..Time.current %>
<% scope = field.sensors.joins(:sensor_readings).where(sensor_readings: { read_at: range_short }) %>

<%
  last_reading = field.sensors.joins(:sensor_readings)
                     .order("sensor_readings.read_at DESC")
                     .first

  avg_temp    = scope.average(:temperature)&.to_f&.round(1)
  avg_moist   = scope.average(:moisture)&.to_f&.round(1)
  avg_hum_air = scope.average(:air_humidity)&.to_f&.round(1)
  avg_lux     = scope.average(:light_intensity)&.to_f&.round(0)

  temp_value  = avg_temp    || last_reading&.temperature&.to_f&.round(1)
  moist_value = avg_moist   || last_reading&.moisture&.to_f&.round(1)
  hum_value   = avg_hum_air || last_reading&.air_humidity&.to_f&.round(1)
  lux_value   = avg_lux     || last_reading&.light_intensity&.to_f&.round(0)
%>

<% if field.sensors.exists? %>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-2">
    <!-- Humidade do solo -->
    <div class="bg-white border rounded-lg p-4 text-center shadow-sm hover:shadow-md transition-transform duration-200 transform hover:scale-105">
      <span class="block text-blue-500 text-2xl">💧</span>
      <p class="text-gray-600 text-sm"><%= t("metrics.moisture", default: "Humidade do Solo") %></p>
      <p class="font-bold text-lg text-gray-800 mt-2">
        <%= moist_value || '-' %> <span class="text-sm text-gray-500">%</span>
      </p>
      <% moist_ok = moist_value && (40..80).cover?(moist_value) %>
      <span class="inline-block mt-2 px-2 py-0.5 text-xs rounded-full <%= moist_ok ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-600' %> font-medium">
        <%= moist_ok ? t("metrics.normal", default: "Normal") : t("metrics.attention", default: "Atenção") %>
      </span>
    </div>

    <!-- Temperatura -->
    <div class="bg-white border rounded-lg p-4 text-center shadow-sm hover:shadow-md transition-transform duration-200 transform hover:scale-105">
      <span class="block text-orange-500 text-2xl">🌡️</span>
      <p class="text-gray-600 text-sm"><%= t("metrics.temperature", default: "Temperatura") %></p>
      <p class="font-bold text-lg text-gray-800 mt-2">
        <%= temp_value || '-' %> <span class="text-sm text-gray-500">°C</span>
      </p>
      <% temp_ok = temp_value && (10..40).cover?(temp_value) %>
      <span class="inline-block mt-2 px-2 py-0.5 text-xs rounded-full <%= temp_ok ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-600' %> font-medium">
        <%= temp_ok ? t("metrics.normal", default: "Normal") : t("metrics.attention", default: "Atenção") %>
      </span>
    </div>

    <!-- Humidade do ar -->
    <div class="bg-white border rounded-lg p-4 text-center shadow-sm hover:shadow-md transition-transform duration-200 transform hover:scale-105">
      <span class="block text-cyan-600 text-2xl">🌬️</span>
      <p class="text-gray-600 text-sm"><%= t("metrics.air_humidity", default: "Humidade do Ar") %></p>
      <p class="font-bold text-lg text-gray-800 mt-2">
        <%= hum_value || '-' %> <span class="text-sm text-gray-500">%</span>
      </p>
    </div>

    <!-- Luz -->
    <div class="bg-white border rounded-lg p-4 text-center shadow-sm hover:shadow-md transition-transform duration-200 transform hover:scale-105">
      <span class="block text-amber-500 text-2xl">🔆</span>
      <p class="text-gray-600 text-sm"><%= t("metrics.light", default: "Intensidade da Luz") %></p>
      <p class="font-bold text-lg text-gray-800 mt-2">
        <%= lux_value || '-' %> <span class="text-sm text-gray-500">lux</span>
      </p>
    </div>
  </div>
<% else %>
  <!-- Caso não haja sensores -->
  <div class="mt-3 p-6 bg-white border rounded-xl text-center text-gray-600">
    <p class="mb-2">Ainda não existem sensores associados a este campo.</p>
    <%= link_to t("sensors.add", default: "Adicionar Sensor"),
                new_sensor_path(field_id: field.id, locale: I18n.locale),
                class: "inline-flex items-center gap-2 px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold rounded-lg shadow transition" %>
  </div>
<% end %>
