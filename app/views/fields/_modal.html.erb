<!-- app/views/fields/_modal.html.erb -->
<div id="addFieldModal"
     class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50 <%= (@field&.errors&.any? ? '' : 'hidden') %>">
  <div class="bg-white p-6 rounded-lg shadow-lg w-full max-w-md transform transition-all scale-95">
    <!-- Header -->
    <div class="flex justify-between items-center border-b pb-3 mb-4">
      <h2 class="text-xl font-semibold text-gray-800">
        <%= t("fields.new_modal.title", default: "Add New Field") %>
      </h2>
      <button type="button"
              onclick="toggleAddFieldModal(false)"
              class="text-gray-500 hover:text-red-600 text-2xl leading-none"
              aria-label="<%= t('actions.cancel', default: 'Cancel') %>">&times;</button>
    </div>

    <p class="text-gray-500 text-sm mb-4">
      <%= t("fields.new_modal.description", default: "Fill in the required data to create a new field.") %>
    </p>

    <!-- Errors -->
    <% if @field&.errors&.any? %>
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
        <p class="font-semibold text-sm mb-1">
          <%= t("fields.new_modal.errors_title", default: "There were errors creating the field:") %>
        </p>
        <ul class="list-disc pl-5 text-sm">
          <% @field.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Form -->
    <%= form_with model: @field, url: fields_path, local: true do |f| %>
      <div>
        <%= f.label :name, t("fields.new_modal.form.name", default: "Field Name"), class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_field :name, required: true, class: "mt-1 block w-full p-2 border border-gray-300 rounded-md shadow-sm focus:ring-green-500 focus:border-green-500" %>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">
          <%= t("fields.new_modal.form.type_label", default: "Field Type") %>
        </label>
        <input type="text"
               value="<%= current_user.account.farm_type.humanize.capitalize %>"
               readonly
               class="w-full p-2 bg-gray-100 text-gray-600 border border-gray-300 rounded-md cursor-not-allowed text-sm" />
      </div>

      <div>
        <%= f.label :area, t("fields.new_modal.form.area", default: "Area (ha)"), class: "block text-sm font-medium text-gray-700" %>
        <%= f.number_field :area, step: 0.1, required: true, class: "mt-1 block w-full p-2 border border-gray-300 rounded-md shadow-sm focus:ring-green-500 focus:border-green-500" %>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :latitude, t("fields.new_modal.form.latitude", default: "Latitude"), class: "block text-sm font-medium text-gray-700" %>
          <%= f.text_field :latitude, required: true, class: "mt-1 block w-full p-2 border border-gray-300 rounded-md shadow-sm focus:ring-green-500 focus:border-green-500" %>
        </div>
        <div>
          <%= f.label :longitude, t("fields.new_modal.form.longitude", default: "Longitude"), class: "block text-sm font-medium text-gray-700" %>
          <%= f.text_field :longitude, required: true, class: "mt-1 block w-full p-2 border border-gray-300 rounded-md shadow-sm focus:ring-green-500 focus:border-green-500" %>
        </div>
      </div>

      <div class="mt-4">
        <label class="block text-sm font-medium text-gray-700 mb-1">
          <%= t("fields.new_modal.form.boundary_label", default: "Set Boundary") %>
        </label>
        <button type="button" onclick="openBoundaryModal()"
                class="w-full border border-gray-300 px-4 py-2 rounded-md flex items-center justify-center space-x-2 hover:bg-gray-50">
          <svg class="h-5 w-5 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 3l18 18M9.75 9.75L14.25 14.25"/>
          </svg>
          <span><%= t("fields.new_modal.form.boundary_button", default: "Define Boundary") %></span>
        </button>
      </div>

      <!-- polygon payload -->
      <%= f.hidden_field :polygon_coordinates, id: "polygonCoordinates" %>

      <div>
        <%= f.label :notes, t("fields.new_modal.form.notes", default: "Notes"), class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_area :notes, rows: 3, class: "mt-1 block w-full p-2 border border-gray-300 rounded-md shadow-sm focus:ring-green-500 focus:border-green-500" %>
      </div>

      <div class="flex justify-end space-x-2 pt-4">
        <button type="button" onclick="toggleAddFieldModal(false)"
                class="px-4 py-2 border border-gray-300 text-gray-700 rounded-md hover:bg-gray-100">
          <%= t("actions.cancel", default: "Cancel") %>
        </button>
        <%= f.submit t("fields.overview.modal.submit", default: t("fields.new_modal.form.submit", default: "Create Field")),
                     class: "px-4 py-2 bg-green-600 text-white rounded-md hover:bg-green-700" %>
      </div>
    <% end %>
  </div>

  <!-- Boundary modal partial (uses IDs referenced below) -->
  <%= render "fields/boundary_modal" %>
</div>

<script>
(function () {
  /* ========== MODAL addFieldModal ========== */
  function modal() { return document.getElementById("addFieldModal"); }
  function isOpen() { var m = modal(); return m && !m.classList.contains("hidden"); }
  function open()  { var m = modal(); if (m) m.classList.remove("hidden"); }
  function close() { var m = modal(); if (m) m.classList.add("hidden"); }

  // Expor para botões/links: toggleModal(), toggleModal(true|false)
  window.toggleModal = function (force) {
    if (typeof force === "boolean") { force ? open() : close(); }
    else { isOpen() ? close() : open(); }
  };

  // Fechar no backdrop ou em qualquer [data-close-modal] (inclui o X e "Cancelar")
  document.addEventListener("click", function (e) {
    var m = modal(); if (!m || m.classList.contains("hidden")) return;
    if (e.target === m || e.target.closest("[data-close-modal]")) {
      e.preventDefault();
      close();
    }
  });

  // Fechar com ESC
  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape" && isOpen()) close();
  });

  // Stub opcional para abrir o modal de limites se não existir outra definição
  if (!window.openBoundaryModal) {
    window.openBoundaryModal = function () {
      var bm = document.getElementById("boundaryModal");
      if (bm) bm.classList.remove("hidden");
    };
  }

  /* ========== MAPBOX: POLÍGONO ========== */
  var polygonMap, polygonPoints = [], polygonLine = null, polygonMarkers = [];

  function coordsInputEl() {
    return document.getElementById("polygonCoordinates") ||
           document.getElementById("polygonCoordinatesInput");
  }

  // Expor para botão "Definir Limites" se usares togglePolygonMap()
  window.togglePolygonMap = function () {
    var container = document.getElementById("polygonMapContainer");
    if (!container) return;

    container.classList.toggle("hidden");

    if (!polygonMap) {
      if (typeof mapboxgl === "undefined") {
        console.warn("Mapbox GL JS não encontrado.");
        return;
      }
      mapboxgl.accessToken = "pk.eyJ1Ijoicm9tYW9maWxpcGUiLCJhIjoiY204cmpmYzNnMHhkbDJqc2F2enFsZDRxYSJ9.lzMeVTGloDJlV1RHoitdjA";
      polygonMap = new mapboxgl.Map({
        container: "polygonMap",
        style: "mapbox://styles/mapbox/streets-v11",
        center: [-8.611, 41.145],
        zoom: 13
      });

      polygonMap.on("click", function (e) {
        if (polygonPoints.length >= 8) return;
        var point = [e.lngLat.lng, e.lngLat.lat];
        polygonPoints.push(point);

        var marker = new mapboxgl.Marker({ color: "orange" })
          .setLngLat(point).addTo(polygonMap);
        polygonMarkers.push(marker);

        updatePolygon();
      });
    }

    // ao mostrar, força o resize para render correto
    if (!container.classList.contains("hidden") && polygonMap) {
      polygonMap.resize();
    }
  };

  function updatePolygon() {
    var status = document.getElementById("polygonStatus");
    if (status) status.textContent = (polygonPoints.length + "/8 pontos");

    // limpar camada anterior se existir
    if (polygonMap) {
      if (polygonMap.getLayer("polygon-line"))   polygonMap.removeLayer("polygon-line");
      if (polygonMap.getSource("polygon-line"))  polygonMap.removeSource("polygon-line");
    }
    polygonLine = null;

    // desenhar nova
    if (polygonPoints.length > 1 && polygonMap) {
      polygonMap.addSource("polygon-line", {
        type: "geojson",
        data: {
          type: "Feature",
          geometry: {
            type: "Polygon",
            coordinates: [[].concat(polygonPoints, [polygonPoints[0]])]
          }
        }
      });
      polygonMap.addLayer({
        id: "polygon-line",
        type: "line",
        source: "polygon-line",
        paint: { "line-color": "#f97316", "line-width": 3 }
      });
      polygonLine = true;
    }
  }

  // Expor resets e save
  window.resetPolygon = function () {
    polygonPoints = [];
    polygonMarkers.forEach(function (m) { m.remove(); });
    polygonMarkers = [];

    if (polygonMap) {
      if (polygonMap.getLayer("polygon-line"))  polygonMap.removeLayer("polygon-line");
      if (polygonMap.getSource("polygon-line")) polygonMap.removeSource("polygon-line");
    }
    polygonLine = null;

    var status = document.getElementById("polygonStatus");
    if (status) status.textContent = "0/8 pontos";

    var input = coordsInputEl();
    if (input) input.value = "";
  };

  window.savePolygon = function () {
    if (polygonPoints.length < 3) {
      alert("O polígono precisa de pelo menos 3 pontos.");
      return;
    }
    var closed = polygonPoints.slice();
    closed.push(polygonPoints[0]);

    var input = coordsInputEl();
    if (input) input.value = JSON.stringify(closed);

    alert("Área guardada com sucesso!");
  };
})();
</script>
