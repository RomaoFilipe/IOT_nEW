<div class="max-w-5xl mx-auto p-6 space-y-6">
  <h1 class="text-3xl font-bold text-gray-800 mb-4">⚙️ <%= t("settings.title") %></h1>

  <!-- Painel Configuração Notificações -->
  <div class="bg-white rounded-lg shadow p-6 mt-8">
    <h2 class="text-xl font-semibold text-gray-700 mb-4">⚙️ <%= t("settings.notifications.customize") %></h2>
    <%= form_with url: update_notifications_settings_path, method: :patch, data: { turbo_frame: "notifications" }, class: "space-y-4" do |f| %>
      <div class="flex items-center justify-between">
        <label for="notif_email" class="text-sm font-medium text-gray-700 flex items-center gap-2">📧 <%= t("settings.notifications.email") %></label>
        <%= f.check_box :notif_email, { checked: current_user.notif_email, class: "toggle-switch" }, true, false %>
      </div>
      <div class="flex items-center justify-between">
        <label for="notif_sms" class="text-sm font-medium text-gray-700 flex items-center gap-2">📱 <%= t("settings.notifications.sms") %></label>
        <%= f.check_box :notif_sms, { checked: current_user.notif_sms, class: "toggle-switch" }, true, false %>
      </div>
    <% end %>
  </div>

  <turbo-frame id="notifications">
    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-xl font-semibold text-gray-700 mb-4">📢 <%= t("settings.notifications.summary") %></h2>
      <ul class="space-y-2 text-sm text-gray-700">
        <li>
          <span class="font-medium"><%= t("settings.notifications.email_label") %>:</span>
          <% if current_user.notif_email %>
            <span class="text-green-600"><%= t("settings.active") %></span>
          <% else %>
            <span class="text-red-600"><%= t("settings.inactive") %></span>
          <% end %>
        </li>
        <li>
          <span class="font-medium"><%= t("settings.notifications.sms_label") %>:</span>
          <% if current_user.notif_sms %>
            <span class="text-green-600"><%= t("settings.active") %></span>
          <% else %>
            <span class="text-red-600"><%= t("settings.inactive") %></span>
          <% end %>
        </li>
      </ul>
    </div>
  </turbo-frame>

  <!-- Painel Segurança -->
  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-xl font-semibold text-gray-700 mb-4">🔒 <%= t("settings.security.title") %></h2>
    <div class="flex justify-end mb-4">
      <%= link_to t("settings.security.change_password"), edit_user_registration_path, class: "bg-green-600 text-white px-4 py-2 rounded-md hover:bg-green-700 text-sm" %>
    </div>

    <% if current_user.updated_at < 90.days.ago %>
      <div class="bg-red-100 text-red-700 p-3 rounded mb-4">
        ⚠️ <%= t("settings.security.password_warning") %>
      </div>
    <% end %>

    <ul class="space-y-2 text-sm text-gray-700">
      <li>
        <span class="font-medium"><%= t("settings.security.password_label") %>:</span>
        <span class="text-green-600"><%= t("settings.security.updated_ago", time: time_ago_in_words(current_user.updated_at)) %></span>
      </li>
      <li>
        <span class="font-medium"><%= t("settings.security.2fa") %>:</span>
        <span class="text-red-600"><%= t("settings.inactive") %></span>
      </li>
      <li>
        <span class="font-medium"><%= t("settings.security.last_login") %>:</span>
        <%= current_user.last_sign_in_at ? time_ago_in_words(current_user.last_sign_in_at) : t("settings.unknown") %>
      </li>
      <li>
        <span class="font-medium"><%= t("settings.security.current_ip") %>:</span>
        <%= current_user.current_sign_in_ip || t("settings.unknown") %>
      </li>
      <li>
        <span class="font-medium"><%= t("settings.security.last_ip") %>:</span>
        <%= current_user.last_sign_in_ip || t("settings.unknown") %>
      </li>
      <li>
        <span class="font-medium"><%= t("settings.security.total_logins") %>:</span>
        <%= current_user.sign_in_count %>
      </li>
    </ul>
  </div>
</div>


  <!-- Secção: Perfil do Utilizador -->
  <!-- (resto do conteúdo existente aqui sem alterações) -->
</div>

<!-- Extra Style Opcional -->
<style>
  .toggle-switch {
    appearance: none;
    -webkit-appearance: none;
    position: relative;
    width: 42px;
    height: 24px;
    background: #d1d5db;
    border-radius: 9999px;
    outline: none;
    cursor: pointer;
    transition: background 0.3s;
  }
  .toggle-switch:checked {
    background: #22c55e;
  }
  .toggle-switch:before {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 20px;
    height: 20px;
    background: white;
    border-radius: 9999px;
    transition: transform 0.3s;
  }
  .toggle-switch:checked:before {
    transform: translateX(18px);
  }
  input:focus, select:focus, textarea:focus, button:focus {
    outline: none;
    box-shadow: 0 0 0 2px rgba(34, 197, 94, 0.5);
  }
</style>
