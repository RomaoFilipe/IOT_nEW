<div class="max-w-5xl mx-auto p-6 space-y-6">
  <h1 class="text-3xl font-bold text-gray-800 mb-4">⚙️ Configurações do Sistema</h1>

  <!-- Painel Resumo Notificações -->

  <!-- Painel Configuração Notificações -->
  <div class="bg-white rounded-lg shadow p-6 mt-8">
    <h2 class="text-xl font-semibold text-gray-700 mb-4">⚙️ Personalizar Notificações</h2>
    <%= form_with url: update_notifications_settings_path, method: :patch, data: { turbo_frame: "notifications" }, class: "space-y-4" do |f| %>
      <div class="flex items-center justify-between">
        <label for="notif_email" class="text-sm font-medium text-gray-700 flex items-center gap-2">📧 Notificações por Email</label>
        <%= f.check_box :notif_email, { checked: current_user.notif_email, class: "toggle-switch" }, true, false %>
      </div>
      <div class="flex items-center justify-between">
        <label for="notif_sms" class="text-sm font-medium text-gray-700 flex items-center gap-2">📱 Notificações por SMS</label>
        <%= f.check_box :notif_sms, { checked: current_user.notif_sms, class: "toggle-switch" }, true, false %>
      </div>
      
    <% end %>
  </div>
  <turbo-frame id="notifications">
  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-xl font-semibold text-gray-700 mb-4">📢 Resumo das Notificações</h2>
    <ul class="space-y-2 text-sm text-gray-700">
      <li>
        <span class="font-medium">Email:</span>
        <% if current_user.notif_email %>
          <span class="text-green-600">Ativo ✅</span>
        <% else %>
          <span class="text-red-600">Desativado ❌</span>
        <% end %>
      </li>
      <li>
        <span class="font-medium">SMS:</span>
        <% if current_user.notif_sms %>
          <span class="text-green-600">Ativo ✅</span>
        <% else %>
          <span class="text-red-600">Desativado ❌</span>
        <% end %>
      </li>
    </ul>
  </div>
</turbo-frame>

  <!-- Painel Resumo Segurança -->
  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-xl font-semibold text-gray-700 mb-4">🔒 Resumo de Segurança</h2>
    <div class="flex justify-end mb-4">
      <%= link_to "Alterar Password", edit_user_registration_path, class: "bg-green-600 text-white px-4 py-2 rounded-md hover:bg-green-700 text-sm" %>
    </div>
    <% if current_user.updated_at < 90.days.ago %>
      <div class="bg-red-100 text-red-700 p-3 rounded mb-4">
        ⚠️ A tua password não foi atualizada há mais de 90 dias. Recomenda-se alterar imediatamente.
      </div>
    <% end %>
    <ul class="space-y-2 text-sm text-gray-700">
      <li>
        <span class="font-medium">Password:</span>
        <span class="text-green-600">Atualizada há <%= time_ago_in_words(current_user.updated_at) %></span>
      </li>
      <li>
        <span class="font-medium">Autenticação de Dois Fatores:</span>
        <span class="text-red-600">Desativada ❌</span>
      </li>
      <li>
        <span class="font-medium">Último Acesso:</span>
        <%= current_user.last_sign_in_at ? time_ago_in_words(current_user.last_sign_in_at) : 'Nunca' %>
      </li>
      <li>
        <span class="font-medium">IP Atual:</span>
        <%= current_user.current_sign_in_ip || 'Desconhecido' %>
      </li>
      <li>
        <span class="font-medium">IP Último Acesso:</span>
        <%= current_user.last_sign_in_ip || 'Desconhecido' %>
      </li>
      <li>
        <span class="font-medium">Total de Logins:</span>
        <%= current_user.sign_in_count %>
      </li>
    </ul>
  </div>

  <!-- Secção: Perfil do Utilizador -->
  <!-- (resto do conteúdo existente aqui sem alterações) -->
</div>

<!-- Extra Style Opcional -->
<style>
  .toggle-switch {
    appearance: none;
    -webkit-appearance: none;
    position: relative;
    width: 42px;
    height: 24px;
    background: #d1d5db;
    border-radius: 9999px;
    outline: none;
    cursor: pointer;
    transition: background 0.3s;
  }
  .toggle-switch:checked {
    background: #22c55e;
  }
  .toggle-switch:before {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 20px;
    height: 20px;
    background: white;
    border-radius: 9999px;
    transition: transform 0.3s;
  }
  .toggle-switch:checked:before {
    transform: translateX(18px);
  }
  input:focus, select:focus, textarea:focus, button:focus {
    outline: none;
    box-shadow: 0 0 0 2px rgba(34, 197, 94, 0.5);
  }
</style>
