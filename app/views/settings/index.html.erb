<div class="max-w-5xl mx-auto p-6 space-y-6">
  <h1 class="text-3xl font-bold text-gray-800">⚙️ Configurações do Sistema</h1>

  <% if flash[:notice].present? || flash[:alert].present? %>
    <div class="rounded-md border px-4 py-3 text-sm <%= flash[:alert] ? 'bg-red-50 border-red-200 text-red-700' : 'bg-emerald-50 border-emerald-200 text-emerald-700' %>">
      <%= flash[:alert] || flash[:notice] %>
    </div>
  <% end %>

  <!-- Notificações: configuração -->
  <div class="bg-white rounded-xl shadow p-6">
    <h2 class="text-xl font-semibold text-gray-800 mb-1">📣 Notificações</h2>
    <p class="text-sm text-gray-500 mb-5">Ativa ou desativa os canais. As alterações são guardadas automaticamente.</p>

    <%= form_with scope: :user,
                  url: update_notifications_settings_path,
                  method: :patch,
                  data: { turbo_frame: "notifications" },
                  html: { id: "notifications-form", class: "space-y-4" } do |f| %>

      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="text-lg">📧</span>
          <label for="user_notif_email" class="text-sm font-medium text-gray-800">Notificações por Email</label>
        </div>
        <%= f.check_box :notif_email,
              { class: "toggle-switch js-autosubmit", checked: current_user.notif_email },
              true, false %>
      </div>

      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="text-lg">📱</span>
          <label for="user_notif_sms" class="text-sm font-medium text-gray-800">Notificações por SMS</label>
        </div>
        <%= f.check_box :notif_sms,
              { class: "toggle-switch js-autosubmit", checked: current_user.notif_sms },
              true, false %>
      </div>
    <% end %>
  </div>

  <!-- Resumo (atualizado via Turbo Frame) -->
  <turbo-frame id="notifications">
    <div class="bg-white rounded-xl shadow p-6">
      <h2 class="text-xl font-semibold text-gray-800 mb-4">📋 Resumo das Notificações</h2>
      <ul class="space-y-2 text-sm text-gray-700">
        <li class="flex items-center justify-between">
          <span class="font-medium">Email</span>
          <% if current_user.notif_email %>
            <span class="inline-flex items-center gap-1 text-emerald-700"><span>●</span> Ativo</span>
          <% else %>
            <span class="inline-flex items-center gap-1 text-rose-700"><span>●</span> Desativado</span>
          <% end %>
        </li>
        <li class="flex items-center justify-between">
          <span class="font-medium">SMS</span>
          <% if current_user.notif_sms %>
            <span class="inline-flex items-center gap-1 text-emerald-700"><span>●</span> Ativo</span>
          <% else %>
            <span class="inline-flex items-center gap-1 text-rose-700"><span>●</span> Desativado</span>
          <% end %>
        </li>
      </ul>
    </div>
  </turbo-frame>

  <!-- Segurança -->
  <div class="bg-white rounded-xl shadow p-6">
    <div class="flex items-center justify-between">
      <h2 class="text-xl font-semibold text-gray-800">🔒 Resumo de Segurança</h2>
      <%= link_to "Alterar Password", edit_user_registration_path,
          class: "bg-green-600 text-white px-4 py-2 rounded-md hover:bg-green-700 text-sm" %>
    </div>

    <% if current_user.updated_at < 90.days.ago %>
      <div class="mt-4 rounded-md bg-amber-50 border border-amber-200 text-amber-800 px-4 py-3 text-sm">
        ⚠️ A tua password não foi atualizada há mais de 90 dias. Recomenda-se alterar imediatamente.
      </div>
    <% end %>

    <ul class="mt-4 space-y-2 text-sm text-gray-700">
      <li class="flex items-center justify-between">
        <span class="font-medium">Password</span>
        <span class="text-gray-600">Atualizada há <%= time_ago_in_words(current_user.updated_at) %></span>
      </li>
      <li class="flex items-center justify-between">
        <span class="font-medium">Autenticação de Dois Fatores</span>
        <span class="text-rose-700">Desativada</span>
      </li>
      <li class="flex items-center justify-between">
        <span class="font-medium">Último Acesso</span>
        <span><%= current_user.last_sign_in_at ? time_ago_in_words(current_user.last_sign_in_at) : 'Nunca' %></span>
      </li>
      <li class="flex items-center justify-between">
        <span class="font-medium">IP Atual</span>
        <span><%= current_user.current_sign_in_ip || 'Desconhecido' %></span>
      </li>
      <li class="flex items-center justify-between">
        <span class="font-medium">IP Último Acesso</span>
        <span><%= current_user.last_sign_in_ip || 'Desconhecido' %></span>
      </li>
      <li class="flex items-center justify-between">
        <span class="font-medium">Total de Logins</span>
        <span><%= current_user.sign_in_count %></span>
      </li>
    </ul>
  </div>
</div>

<!-- Autosave das toggles -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("notifications-form");
    document.querySelectorAll(".js-autosubmit").forEach(cb => {
      cb.addEventListener("change", () => form?.requestSubmit());
    });
  });
</script>

<style>
  .toggle-switch {
    appearance: none;
    -webkit-appearance: none;
    position: relative;
    width: 44px; height: 26px;
    background: #e5e7eb;
    border-radius: 9999px;
    outline: none; cursor: pointer;
    transition: background .2s ease;
    border: 1px solid #d1d5db;
  }
  .toggle-switch:checked { background: #22c55e; border-color: #16a34a; }
  .toggle-switch::before {
    content: '';
    position: absolute; top: 2px; left: 2px;
    width: 20px; height: 20px; background: #fff; border-radius: 9999px;
    transition: transform .2s ease; box-shadow: 0 1px 2px rgba(0,0,0,.15);
  }
  .toggle-switch:checked::before { transform: translateX(18px); }
  input:focus, select:focus, textarea:focus, button:focus {
    outline: none;
    box-shadow: 0 0 0 3px rgba(34,197,94,.35);
  }
</style>
