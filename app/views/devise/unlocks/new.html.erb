<div class="min-h-[60vh] flex items-center justify-center bg-gray-50 py-10 px-4">
  <div class="w-full max-w-md">
    <!-- Card -->
    <div class="bg-white border border-gray-200 shadow-xl rounded-2xl p-6 md:p-8">

      <!-- Header -->
      <div class="flex items-center gap-3 mb-2">
        <i class="lucide lucide-mail-warning w-6 h-6 text-amber-600"></i>
        <h1 class="text-2xl font-extrabold text-gray-900">
          <%= t("devise.unlocks.new.title", default: "Resend unlock instructions") %>
        </h1>
      </div>
      <p class="text-sm text-gray-600 mb-6">
        <%= t("devise.unlocks.new.subtitle",
              default: "If your account is locked due to multiple attempts, enter your email and we'll send you unlock instructions.") %>
      </p>

      <!-- Form -->
      <%= form_for(resource,
                   as: resource_name,
                   url: unlock_path(resource_name),
                   html: { method: :post, class: "space-y-5" }) do |f| %>

        <%= render "devise/shared/error_messages", resource: resource %>

        <!-- Email -->
        <div>
          <label for="<%= "#{resource_name}_email" %>" class="block text-sm font-medium text-gray-700">
            <%= t("devise.shared.email", default: "Email") %>
          </label>
          <%= f.email_field :email,
                autofocus: true,
                autocomplete: "email",
                required: true,
                class: "mt-1 block w-full rounded-lg border-gray-300 focus:border-emerald-600 focus:ring-emerald-600 shadow-sm px-3 py-2" %>
        </div>

        <!-- Submit -->
        <div>
          <%= f.submit t("devise.unlocks.new.cta", default: "Send unlock instructions"),
                class: "w-full inline-flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold rounded-lg px-4 py-2.5 transition" %>
        </div>
      <% end %>

      <!-- Links secundários -->
      <div class="mt-6 space-y-2">
        <%= render "devise/shared/links" %>

        <div class="text-center">
          <%= link_to t("devise.sessions.new.sign_in", default: "Back to login"),
                      new_session_path(resource_name),
                      class: "inline-flex items-center gap-1 text-sm font-medium text-gray-600 hover:text-gray-900 hover:underline" %>
        </div>
      </div>
    </div>

    <!-- Marca / rodapé pequeno -->
    <div class="text-center text-xs text-gray-500 mt-4">
      <span>AgriloT Synergy</span>
    </div>
  </div>
</div>
