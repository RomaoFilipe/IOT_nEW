<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="UTF-8">
  <title><%= t("devise.registrations.new.title", default: "Criar conta") %> | AgriloT Synergy</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: { brand: { 600: '#059669', 700: '#047857', 800: '#065f46' } },
          boxShadow: {
            soft: '0 8px 30px rgba(4,120,87,.10)',
            inner: 'inset 0 1px 2px rgba(0,0,0,.04)'
          }
        }
      }
    }
  </script>
</head>
<body class="min-h-screen bg-gradient-to-br from-emerald-50 via-emerald-100/40 to-white text-gray-800">

  <!-- background decorativo -->
  <div aria-hidden="true" class="pointer-events-none fixed inset-0 overflow-hidden">
    <div class="absolute -top-24 -right-32 h-96 w-96 rounded-full blur-3xl opacity-30"
         style="background: radial-gradient(60% 60% at 50% 50%, rgba(16,185,129,.35) 0%, rgba(16,185,129,0) 70%);"></div>
    <div class="absolute -bottom-24 -left-32 h-[28rem] w-[28rem] rounded-full blur-3xl opacity-25"
         style="background: radial-gradient(60% 60% at 50% 50%, rgba(5,150,105,.35) 0%, rgba(5,150,105,0) 70%);"></div>
  </div>

  <!-- barra topo -->
  <header class="relative z-10">
    <div class="mx-auto max-w-7xl px-4 py-4 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <%= link_to root_path, class: "flex items-center gap-2" do %>
          <%= image_tag "logo_agrilot.png", class: "h-7 w-auto", alt: "AgriloT Synergy" %>
          <span class="sr-only">AgriloT Synergy</span>
        <% end %>
      </div>
      <!-- seletor idioma compacto -->
      <nav class="flex items-center gap-1 bg-white/70 backdrop-blur-sm border border-gray-200 rounded-full px-1.5 py-1 shadow-soft">
        <% { "pt" => "Português", "en" => "English", "es" => "Español" }.each do |loc, label| %>
          <%= link_to label,
                      url_for(locale: loc),
                      class: "text-[11px] px-2 py-1 rounded-full transition #{I18n.locale.to_s == loc ? 'bg-emerald-100 text-emerald-800 font-semibold' : 'text-gray-600 hover:bg-gray-100'}" %>
        <% end %>
      </nav>
    </div>
  </header>

  <main class="relative z-10">
    <div class="mx-auto max-w-7xl px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">

        <!-- texto lateral (desktop) -->
        <div class="hidden lg:block pl-2">
          <h1 class="text-3xl font-extrabold text-emerald-900 leading-tight">
            <%= t("devise.registrations.new.title", default: "Criar conta") %>
          </h1>
          <p class="mt-2 text-gray-600">
            <%= t("devise.registrations.new.subtitle", default: "Introduza os seus dados para começar") %>
          </p>
          <ul class="mt-6 space-y-2 text-sm text-gray-700">
            <li class="flex items-center gap-2">
              <span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-600"></span>
              <span><%= t("login.points.kpis", default: "KPIs e operações em tempo real") %></span>
            </li>
            <li class="flex items-center gap-2">
              <span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-600"></span>
              <span><%= t("login.points.irrigation", default: "Automação de rega e alertas") %></span>
            </li>
            <li class="flex items-center gap-2">
              <span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-600"></span>
              <span><%= t("login.points.iot", default: "Integração direta com MQTT/IoT") %></span>
            </li>
          </ul>
        </div>

        <!-- cartão de registo -->
        <div class="w-full max-w-md mx-auto">
          <div class="bg-white/95 backdrop-blur-sm border border-gray-100 shadow-soft rounded-2xl p-6 md:p-8">

            <!-- flashes -->
            <% if flash[:notice].present? %>
              <div class="mb-4 flex items-start gap-3 px-4 py-3 rounded-md bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm">
                <svg class="w-5 h-5 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M12 22C6.477 22 2 17.523 2 12S6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/>
                </svg>
                <span><%= flash[:notice] %></span>
              </div>
            <% end %>

            <% if flash[:alert].present? %>
              <div id="reg-alert" class="mb-4 flex items-start gap-3 px-4 py-3 rounded-md bg-red-50 border border-red-200 text-red-800 text-sm">
                <svg class="w-5 h-5 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M12 2a10 10 0 110 20 10 10 0 010-20z"/>
                </svg>
                <span><%= flash[:alert] %></span>
              </div>
            <% end %>

            <div class="text-center mb-6">
              <h2 class="text-xl font-semibold text-gray-900">
                <%= t("devise.registrations.new.title", default: "Criar conta") %>
              </h2>
              <p class="text-sm text-gray-500">
                <%= t("devise.registrations.new.subtitle", default: "Introduza as suas informações para criar a conta") %>
              </p>
            </div>

            <%= form_for(resource,
                         as: resource_name,
                         url: registration_path(resource_name),
                         html: { multipart: true, class: "space-y-5" }) do |f| %>

              <%= render "devise/shared/error_messages", resource: resource %>

              <!-- Nome -->
              <div>
                <%= f.label :name, t("users.name", default: "Nome completo"),
                            class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= f.text_field :name,
                      placeholder: t("users.full_name_placeholder", default: "Ex.: João Silva"),
                      class: "w-full border border-gray-300 rounded-lg shadow-inner px-3 py-2 text-sm focus:ring-emerald-600 focus:border-emerald-600" %>
              </div>

              <!-- NIF Empresa -->
              <div>
                <%= f.label :company_nif, t("company.nif", default: "NIF da Empresa"),
                            class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= f.text_field :company_nif,
                      placeholder: "501234567",
                      inputmode: "numeric",
                      class: "w-full border border-gray-300 rounded-lg shadow-inner px-3 py-2 text-sm focus:ring-emerald-600 focus:border-emerald-600" %>
                <p class="text-xs text-gray-500 mt-1">
                  <%= t("company.nif_hint", default: "Obrigatório para perfis Administrador/Gestor") %>
                </p>
              </div>

              <!-- Email -->
              <div>
                <%= f.label :email, t("devise.shared.email", default: "Email"),
                            class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= f.email_field :email,
                      placeholder: "nome@exemplo.com",
                      autocomplete: "email",
                      class: "w-full border border-gray-300 rounded-lg shadow-inner px-3 py-2 text-sm focus:ring-emerald-600 focus:border-emerald-600" %>
              </div>

              <!-- Password -->
              <div>
                <%= f.label :password, t("devise.shared.password", default: "Palavra‑passe"),
                            class: "block text-sm font-medium text-gray-700 mb-1" %>
                <div class="relative">
                  <%= f.password_field :password,
                        id: "password",
                        placeholder: t("devise.shared.password", default: "Palavra‑passe"),
                        autocomplete: "new-password",
                        class: "w-full border border-gray-300 rounded-lg shadow-inner pl-3 pr-10 py-2 text-sm focus:ring-emerald-600 focus:border-emerald-600" %>
                  <button type="button"
                          onclick="togglePassword('password')"
                          class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600"
                          aria-label="<%= t('actions.show_password', default: 'Mostrar palavra‑passe') %>">
                    <svg id="eye-password" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5.25 12 5.25c4.478 0 8.268-2.693 9.542 6.75-1.274 4.057-5.064 6.75-9.542 6.75-4.477 0-8.268-2.693-9.542-6.75z"/>
                    </svg>
                  </button>
                </div>
                <p class="mt-1 text-xs text-gray-500">
                  <%= t("auth.password_rules", default: "Mínimo de #{resource_class.password_length.min} caracteres.") %>
                </p>
              </div>

              <!-- Confirm Password -->
              <div>
                <%= f.label :password_confirmation, t("devise.shared.password_confirmation", default: "Confirmar palavra‑passe"),
                            class: "block text-sm font-medium text-gray-700 mb-1" %>
                <div class="relative">
                  <%= f.password_field :password_confirmation,
                        id: "password_confirmation",
                        placeholder: t("devise.shared.password_confirmation", default: "Confirmar palavra‑passe"),
                        autocomplete: "new-password",
                        class: "w-full border border-gray-300 rounded-lg shadow-inner pl-3 pr-10 py-2 text-sm focus:ring-emerald-600 focus:border-emerald-600" %>
                  <button type="button"
                          onclick="togglePassword('password_confirmation')"
                          class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600"
                          aria-label="<%= t('actions.show_password', default: 'Mostrar palavra‑passe') %>">
                    <svg id="eye-password_confirmation" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5.25 12 5.25c4.478 0 8.268-2.693 9.542 6.75-1.274 4.057-5.064 6.75-9.542 6.75-4.477 0-8.268-2.693-9.542-6.75z"/>
                    </svg>
                  </button>
                </div>
              </div>

              <!-- Foto (opcional) -->
              <div>
                <%= f.label :photo, t("users.photo", default: "Fotografia de perfil (opcional)"),
                            class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= f.file_field :photo,
                      accept: "image/png,image/jpeg,image/jpg,image/webp",
                      class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm bg-white
                              file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0
                              file:text-sm file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100" %>
              </div>

              <!-- Termos -->
              <div class="flex items-start">
                <input id="terms" name="terms" type="checkbox" class="mt-1 h-4 w-4 text-emerald-600 border-gray-300 rounded" required>
                <label for="terms" class="ml-2 text-sm text-gray-600">
                  <%= t("legal.agree", default: "Aceito os") %>
                  <a href="#" class="text-emerald-700 hover:underline"><%= t("legal.tos", default: "Termos de Serviço") %></a>
                  <%= t("legal.and", default: "e a") %>
                  <a href="#" class="text-emerald-700 hover:underline"><%= t("legal.privacy", default: "Política de Privacidade") %></a>.
                </label>
              </div>

              <!-- Submit -->
              <%= f.submit t("devise.registrations.new.submit", default: "Criar conta"),
                    class: "w-full py-2.5 px-4 text-white bg-emerald-600 hover:bg-emerald-700 rounded-lg text-sm font-semibold transition" %>

              <!-- Link para login -->
              <p class="text-center text-sm text-gray-600">
                <%= t("devise.shared.already_have_account", default: "Já tem conta?") %>
                <%= link_to t("devise.shared.sign_in", default: "Entrar"),
                            new_session_path(resource_name),
                            class: "text-emerald-700 hover:underline font-medium" %>
              </p>
            <% end %>
          </div>

          <p class="mt-6 text-center text-xs text-gray-400">
            © <%= Time.current.year %> AgriloT Synergy · <%= t("landing.footer.rights", default: "Todos os direitos reservados.") %>
          </p>
        </div>
      </div>
    </div>
  </main>

  <script>
    function togglePassword(id) {
      const input = document.getElementById(id);
      const icon = document.getElementById('eye-' + id);
      const hidden = input.type === 'password';
      input.type = hidden ? 'text' : 'password';
      icon && icon.setAttribute('opacity', hidden ? '0.85' : '1');
    }
    // esconder alertas automaticamente
    document.addEventListener("DOMContentLoaded", function () {
      const box = document.getElementById("reg-alert");
      if (box) {
        setTimeout(() => {
          box.classList.add("opacity-0", "translate-y-2", "transition");
          setTimeout(() => box.remove(), 300);
        }, 4000);
      }
    });
  </script>

</body>
</html>
