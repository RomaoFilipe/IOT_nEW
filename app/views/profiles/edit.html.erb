<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= t("profiles.edit.title", default: "Edit Profile") %> · AgriloT Synergy</title>

  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 py-10">
  <div class="mx-auto max-w-3xl bg-white shadow-sm rounded-xl ring-1 ring-gray-200 p-8">
    <h2 class="text-2xl font-bold text-gray-800 mb-6"><%= t("profiles.edit.title", default: "Edit Profile") %></h2>

    <%= form_with model: @user, url: profile_path(@user, locale: I18n.locale), method: :patch,
                  html: { multipart: true, class: "space-y-6" } do |f| %>

      <div>
        <%= f.label :name, t("profiles.labels.name", default: "Name"), class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_field :name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-emerald-500 focus:border-emerald-500" %>
      </div>

      <div>
        <%= f.label :email, t("profiles.labels.email", default: "Email"), class: "block text-sm font-medium text-gray-700" %>
        <%= f.email_field :email, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-emerald-500 focus:border-emerald-500" %>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <%= f.label :password, t("profiles.labels.password", default: "New Password"), class: "block text-sm font-medium text-gray-700" %>
          <%= f.password_field :password, autocomplete: "new-password", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-emerald-500 focus:border-emerald-500" %>
        </div>
        <div>
          <%= f.label :password_confirmation, t("profiles.labels.password_confirmation", default: "Password Confirmation"), class: "block text-sm font-medium text-gray-700" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-emerald-500 focus:border-emerald-500" %>
        </div>
      </div>

      <div>
        <%= f.label :photo, t("profiles.labels.photo", default: "Profile Photo"), class: "block text-sm font-medium text-gray-700" %>
        <%= f.file_field :photo, class: "mt-1 block w-full text-sm file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:text-sm file:font-semibold file:bg-emerald-100 file:text-emerald-700 hover:file:bg-emerald-200" %>

        <% if @user.photo.present? %>
          <div class="mt-3">
            <%= image_tag @user.photo.url, class: "w-20 h-20 rounded-full border object-cover" %>
          </div>
        <% end %>
      </div>

      <div class="flex items-center gap-3">
        <%= link_to t("actions.cancel", default: "Cancel"), profile_path(@user, locale: I18n.locale),
                    class: "inline-flex items-center gap-2 rounded-md border border-gray-300 px-4 py-2 text-gray-700 hover:bg-gray-50" %>
        <%= f.submit t("profiles.actions.update_profile", default: "Update Profile"),
                     class: "bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded-md font-semibold transition" %>
      </div>
    <% end %>
  </div>
</body>
</html>
