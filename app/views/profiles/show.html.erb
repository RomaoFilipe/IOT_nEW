<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t("users.manage.title") %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 font-sans">
  <div class="container mx-auto mt-10">
    <h1 class="text-3xl font-bold text-green-600 text-center mb-8"><%= t("users.manage.heading") %></h1>

    <!-- Perfil do Utilizador -->
    <div class="bg-white shadow-md rounded-lg p-6 mb-8">
      <div class="flex items-center gap-6">
        <div>
          <img src="<%= @user.photo.url %>" alt="<%= t("users.manage.profile_photo_alt") %>" class="rounded-full w-24 h-24 object-cover">
        </div>
        <div>
          <h2 class="text-2xl font-bold text-gray-800"><%= @user.name %></h2>
          <p class="text-gray-600 text-sm"><%= t("users.manage.email") %>: <%= @user.email %></p>
          <p class="text-gray-600 text-sm"><%= t("users.manage.created_at") %>: <%= @user.created_at.strftime("%d/%m/%Y") %></p>
          <%= link_to t("users.manage.edit_profile"), edit_profile_path(@user), class: "mt-4 inline-block bg-blue-500 text-white px-4 py-2 rounded-lg hover:bg-blue-600 transition" %>
        </div>
      </div>
    </div>

    <!-- Lista de Utilizadores -->
    <div class="bg-white shadow-md rounded-lg p-6">
      <h2 class="text-xl font-semibold text-gray-800 mb-4"><%= t("users.manage.user_list") %></h2>
      <table class="min-w-full bg-white border border-gray-200">
        <thead>
          <tr>
            <th class="py-2 px-4 border-b"><%= t("users.manage.name") %></th>
            <th class="py-2 px-4 border-b"><%= t("users.manage.email") %></th>
            <th class="py-2 px-4 border-b"><%= t("users.manage.creation_date") %></th>
            <th class="py-2 px-4 border-b"><%= t("users.manage.actions") %></th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td class="py-2 px-4 border-b text-gray-700"><%= user.name %></td>
              <td class="py-2 px-4 border-b text-gray-700"><%= user.email %></td>
              <td class="py-2 px-4 border-b text-gray-700"><%= user.created_at.strftime("%d/%m/%Y") %></td>
              <td class="py-2 px-4 border-b">
                <%= link_to t("actions.edit"), edit_user_path(user), class: "text-blue-500 hover:underline" %>
                |
                <%= link_to t("actions.delete"), user_path(user), method: :delete, data: { confirm: t("users.manage.confirm_delete") }, class: "text-red-500 hover:underline" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- Botão de adicionar novo utilizador -->
    <div class="mt-6 text-center">
      <%= link_to t("users.manage.add_new"), new_user_path, class: "inline-block bg-green-500 text-white px-6 py-2 rounded-lg hover:bg-green-600 transition" %>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
