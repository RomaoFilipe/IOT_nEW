<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= t("profiles.title", default: "Manage Users") %> · AgriloT Synergy</title>

  <!-- Tailwind -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: { brand: { 600: '#059669', 700: '#047857' } },
          boxShadow: { soft: '0 8px 30px rgba(4,120,87,.10)' }
        }
      }
    }
  </script>
  <!-- Lucide Icons -->
  <script defer src="https://unpkg.com/lucide@latest"></script>
</head>

<body class="bg-gray-50 text-gray-800 antialiased">
  <div class="mx-auto max-w-6xl px-4 py-8 space-y-8">

    <!-- Título -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <div>
        <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight text-emerald-900">
          <i data-lucide="users" class="inline h-6 w-6 text-emerald-700"></i>
          <span><%= t("profiles.title", default: "Manage Users") %></span>
        </h1>
        <p class="text-gray-600 text-sm"><%= t("profiles.subtitle", default: "Profile info and team management.") %></p>
      </div>
      <%= link_to new_user_path(locale: I18n.locale),
          class: "inline-flex items-center gap-2 rounded-lg bg-emerald-600 px-4 py-2 text-white font-semibold shadow-soft hover:bg-emerald-700 transition" do %>
        <i data-lucide="user-plus" class="h-4 w-4"></i>
        <%= t("profiles.actions.add_user", default: "Add New User") %>
      <% end %>
    </div>

    <!-- Perfil do utilizador atual -->
    <section class="rounded-xl bg-white shadow-sm ring-1 ring-gray-200 p-6">
      <div class="flex items-start gap-6">
        <div class="shrink-0">
          <% photo_url = @user&.photo&.url.presence %>
          <%= image_tag(photo_url || "https://ui-avatars.com/api/?name=#{ERB::Util.url_encode(@user.name)}&background=10b981&color=ffffff",
                        alt: t("profiles.photo_alt", default: "User photo"),
                        class: "rounded-full w-24 h-24 object-cover ring-2 ring-emerald-100") %>
        </div>
        <div class="min-w-0">
          <h2 class="text-2xl font-bold text-gray-800 truncate"><%= @user.name %></h2>
          <p class="text-gray-600 text-sm truncate">
            <span class="font-medium"><%= t("profiles.labels.email", default: "Email") %>:</span>
            <%= @user.email %>
          </p>
          <p class="text-gray-600 text-sm">
            <span class="font-medium"><%= t("profiles.labels.created_at", default: "Account created") %>:</span>
            <%= l(@user.created_at, format: :default) %>
          </p>

          <%= link_to edit_profile_path(@user, locale: I18n.locale),
              class: "mt-4 inline-flex items-center gap-2 rounded-lg bg-yellow-400 px-4 py-2 text-gray-900 font-semibold shadow hover:bg-yellow-500 transition" do %>
            <i data-lucide="pencil" class="h-4 w-4"></i>
            <%= t("profiles.actions.edit_profile", default: "Edit Profile") %>
          <% end %>
        </div>
      </div>
    </section>

    <!-- Lista de utilizadores -->
    <section class="rounded-xl bg-white shadow-sm ring-1 ring-gray-200 p-6">
      <div class="mb-4 flex items-center justify-between">
        <h3 class="text-xl font-semibold text-gray-800">
          <%= t("profiles.list.title", default: "Users List") %>
        </h3>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50 text-sm text-gray-600">
            <tr>
              <th class="py-2 px-4 text-left font-semibold"><%= t("profiles.list.headers.name", default: "Name") %></th>
              <th class="py-2 px-4 text-left font-semibold"><%= t("profiles.list.headers.email", default: "Email") %></th>
              <th class="py-2 px-4 text-left font-semibold"><%= t("profiles.list.headers.created_at", default: "Created") %></th>
              <th class="py-2 px-4 text-right font-semibold"><%= t("profiles.list.headers.actions", default: "Actions") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 bg-white">
            <% (@users || []).each do |user| %>
              <tr>
                <td class="py-2 px-4 text-gray-700"><%= user.name %></td>
                <td class="py-2 px-4 text-gray-700"><%= user.email %></td>
                <td class="py-2 px-4 text-gray-700"><%= l(user.created_at, format: :default) %></td>
                <td class="py-2 px-4 text-right">
                  <div class="inline-flex gap-3 text-sm">
                    <%= link_to t("profiles.actions.edit", default: "Edit"),
                                edit_user_path(user, locale: I18n.locale),
                                class: "text-blue-600 hover:underline" %>

                    <%= link_to t("profiles.actions.delete", default: "Delete"),
                                user_path(user, locale: I18n.locale),
                                method: :delete,
                                data: { turbo_confirm: t("profiles.confirm_delete", default: "Are you sure you want to delete this user?") },
                                class: "text-red-600 hover:underline" %>
                  </div>
                </td>
              </tr>
            <% end %>
            <% if (@users || []).empty? %>
              <tr>
                <td colspan="4" class="py-6 px-4 text-center text-sm text-gray-500">
                  <%= t("profiles.list.empty", default: "No users yet.") %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>

  </div>

  <script>document.addEventListener("DOMContentLoaded", () => { window.lucide && lucide.createIcons(); });</script>
</body>
</html>
