<% widget_id = local_assigns[:widget_id] || "wx-#{SecureRandom.hex(4)}" %>
<% fields = Array(@fields).compact %>
<% first_with_coords = fields.find { |f| f.latitude.present? && f.longitude.present? } %>

<div id="<%= widget_id %>"
     class="rounded-2xl bg-white/70 ring-1 ring-gray-200 backdrop-blur-xs p-6 shadow-soft space-y-6 text-gray-800">

  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <h3 class="text-lg font-semibold flex items-center gap-2">
      <i data-lucide="cloud-sun" class="h-5 w-5 text-emerald-700"></i>
      <%= t("dashboard.weather.title", default: "Weather Conditions") %>
    </h3>

    <% if fields.present? %>
      <div class="flex items-center gap-2 text-sm">
        <label for="<%= "#{widget_id}-select" %>" class="font-medium text-gray-600">
          <%= t("dashboard.weather.select_field", default: "Field") %>:
        </label>
        <select id="<%= "#{widget_id}-select" %>"
                name="field_id"
                class="rounded-lg border-gray-200 bg-white/80 shadow-sm px-3 py-2 focus:ring-emerald-500 focus:border-emerald-500">
          <% fields.each do |field| %>
            <% lat = field.latitude.presence %>
            <% lon = field.longitude.presence %>
            <option
              value="<%= field.id %>"
              data-lat="<%= lat %>"
              data-lon="<%= lon %>"
              <%= "selected" if (params[:field_id].to_s == field.id.to_s) %>>
              <%= field.name %><%= " • (#{t('dashboard.weather.missing_coords_short', default: 'no coords')})" unless lat && lon %>
            </option>
          <% end %>
        </select>
      </div>
    <% end %>
  </div>

  <div class="flex flex-wrap items-center justify-between gap-6">
    <div>
      <p id="<%= "#{widget_id}-current-temp" %>" class="text-5xl font-extrabold tracking-tight text-emerald-900">--°C</p>
      <p id="<%= "#{widget_id}-current-desc" %>" class="text-sm text-gray-500">
        <%= t("dashboard.weather.loading", default: "Loading...") %>
      </p>
    </div>

    <div class="grid grid-cols-2 gap-x-8 gap-y-1 text-sm">
      <p class="text-gray-600">
        <span class="font-semibold">💨 <%= t("dashboard.weather.wind", default: "Wind") %>:</span>
        <span id="<%= "#{widget_id}-wind" %>">--</span>
      </p>
      <p class="text-gray-600">
        <span class="font-semibold">🌧️ <%= t("dashboard.weather.precip", default: "Precipitation") %>:</span>
        <span id="<%= "#{widget_id}-precip" %>">-- mm</span>
      </p>
    </div>
  </div>

  <div>
    <h4 class="text-sm font-semibold text-gray-700 mb-2">
      <%= t("dashboard.weather.next_days", default: "Next Days") %>
    </h4>
    <div id="<%= "#{widget_id}-daily" %>"
         class="flex gap-2 overflow-x-auto pb-2 scroll-smooth">
      <% 5.times do %>
        <div class="w-16 h-20 rounded bg-gray-100 animate-pulse"></div>
      <% end %>
    </div>
  </div>

  <hr class="border-gray-200">

  <div>
    <h4 class="text-sm font-semibold text-gray-700 mb-2">
      <%= t("dashboard.weather.next_24h", default: "Next 24 Hours") %>
    </h4>
    <div id="<%= "#{widget_id}-hourly" %>"
         class="flex gap-2 overflow-x-auto pb-1 text-center text-sm scroll-smooth">
      <% 8.times do %>
        <div class="min-w-[3.5rem] h-16 rounded bg-gray-100 animate-pulse"></div>
      <% end %>
    </div>
  </div>

  <p id="<%= "#{widget_id}-msg" %>" class="hidden text-xs text-red-600"></p>
</div>

<script>
(() => {
  const WID = "<%= widget_id %>";
  const $id = (suf) => document.getElementById(`${WID}-${suf}`);
  const root = document.getElementById(WID);
  if (!root) return;

  const els = {
    select: document.getElementById(`${WID}-select`),
    temp:   $id("current-temp"),
    desc:   $id("current-desc"),
    wind:   $id("wind"),
    precip: $id("precip"),
    daily:  $id("daily"),
    hourly: $id("hourly"),
    msg:    $id("msg"),
  };

  function weatherIcon(code) {
    const map = {0:"☀️",1:"🌤",2:"⛅",3:"☁️",45:"🌫",48:"🌫",51:"🌦",53:"🌦",55:"🌧",61:"🌧",63:"🌧",65:"🌧",66:"❄️",67:"❄️",71:"❄️",73:"❄️",75:"❄️",95:"⛈",96:"⛈",99:"⛈"};
    return map[code] || "❓";
  }
  function weatherText(code) {
    const map = {
      0:"<%= j t('dashboard.weather.code.0',  default: 'Clear sky') %>",
      1:"<%= j t('dashboard.weather.code.1',  default: 'Mostly clear') %>",
      2:"<%= j t('dashboard.weather.code.2',  default: 'Partly cloudy') %>",
      3:"<%= j t('dashboard.weather.code.3',  default: 'Overcast') %>",
      45:"<%= j t('dashboard.weather.code.45', default: 'Fog') %>",
      48:"<%= j t('dashboard.weather.code.48', default: 'Depositing rime fog') %>",
      51:"<%= j t('dashboard.weather.code.51', default: 'Light drizzle') %>",
      53:"<%= j t('dashboard.weather.code.53', default: 'Moderate drizzle') %>",
      55:"<%= j t('dashboard.weather.code.55', default: 'Dense drizzle') %>",
      61:"<%= j t('dashboard.weather.code.61', default: 'Slight rain') %>",
      63:"<%= j t('dashboard.weather.code.63', default: 'Rain') %>",
      65:"<%= j t('dashboard.weather.code.65', default: 'Heavy rain') %>",
      66:"<%= j t('dashboard.weather.code.66', default: 'Freezing rain') %>",
      67:"<%= j t('dashboard.weather.code.67', default: 'Heavy freezing rain') %>",
      71:"<%= j t('dashboard.weather.code.71', default: 'Slight snow') %>",
      73:"<%= j t('dashboard.weather.code.73', default: 'Snow') %>",
      75:"<%= j t('dashboard.weather.code.75', default: 'Heavy snow') %>",
      95:"<%= j t('dashboard.weather.code.95', default: 'Thunderstorm') %>",
      96:"<%= j t('dashboard.weather.code.96', default: 'Thunderstorm with hail') %>",
      99:"<%= j t('dashboard.weather.code.99', default: 'Severe thunderstorm') %>"
    };
    return map[code] || "<%= j t('dashboard.weather.unknown', default: 'Unknown') %>";
  }

  async function fetchWeather(lat, lon) {
    const url = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current_weather=true&hourly=temperature_2m,weathercode,precipitation,wind_speed_10m,wind_direction_10m&daily=temperature_2m_max,temperature_2m_min,weathercode&timezone=auto`;
    const res = await fetch(url);
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    return res.json();
  }

  function render(data) {
    const cur = data.current_weather;
    if (els.temp)  els.temp.textContent  = `${Math.round(cur.temperature)}°C`;
    if (els.desc)  els.desc.textContent  = weatherText(cur.weathercode);
    if (els.wind)  els.wind.textContent  = `${cur.winddirection}° · ${cur.windspeed} km/h`;

    const today = new Date().toISOString().slice(0,10);
    const idxs = data.hourly.time.map((t,i)=> t.startsWith(today) ? i : -1).filter(i=> i>=0);
    const precip = idxs.reduce((a,i)=> a + (data.hourly.precipitation[i] || 0), 0);
    if (els.precip) els.precip.textContent = `${precip.toFixed(1)} mm`;

    if (els.hourly) {
      els.hourly.innerHTML = "";
      for (let i = 0; i < 24 && i < data.hourly.time.length; i++) {
        const ts   = new Date(data.hourly.time[i]);
        const lbl  = ts.toLocaleTimeString("<%= I18n.locale %>", { hour: '2-digit', minute: '2-digit' });
        const icon = weatherIcon(data.hourly.weathercode[i]);
        const t    = Math.round(data.hourly.temperature_2m[i]);
        els.hourly.insertAdjacentHTML("beforeend", `
          <div class="bg-blue-50 rounded p-1 shadow-sm min-w-[3.5rem] text-center">
            <p class="font-semibold text-[10px]">${lbl}</p>
            <p class="text-lg">${icon}</p>
            <p class="text-gray-700 text-xs">${t}°C</p>
          </div>`);
      }
    }

    if (els.daily) {
      els.daily.innerHTML = "";
      for (let i = 0; i < data.daily.time.length; i++) {
        const d    = new Date(data.daily.time[i]);
        const day  = d.toLocaleDateString("<%= I18n.locale %>", { weekday: 'short' });
        const max  = Math.round(data.daily.temperature_2m_max[i]);
        const min  = Math.round(data.daily.temperature_2m_min[i]);
        const icon = weatherIcon(data.daily.weathercode[i]);
        els.daily.insertAdjacentHTML("beforeend", `
          <div class="bg-white rounded p-2 shadow text-center min-w-[3.5rem]">
            <p class="font-bold text-[11px] uppercase">${day}</p>
            <p class="text-xl">${icon}</p>
            <p class="text-[11px] text-gray-700">${max}° / ${min}°</p>
          </div>`);
      }
    }
  }

  async function loadFor(lat, lon) {
    if (!lat || !lon) {
      if (els.msg) {
        els.msg.textContent = "<%= j t('dashboard.weather.missing_coords', default: 'Field without coordinates. Choose another.') %>";
        els.msg.classList.remove("hidden");
      }
      return;
    } else {
      els.msg && els.msg.classList.add("hidden");
    }
    try {
      if (els.desc) els.desc.textContent = "<%= j t('dashboard.weather.loading', default: 'Loading...') %>";
      const data = await fetchWeather(lat, lon);
      render(data);
    } catch (e) {
      if (els.msg) {
        els.msg.textContent = "<%= j t('dashboard.weather.error', default: 'Error fetching weather.') %>";
        els.msg.classList.remove("hidden");
      }
      console.error(e);
    }
  }

  const initialOption =
    els.select?.selectedOptions?.[0] ||
    (els.select?.options?.length ? els.select.options[0] : null);

  let initLat = initialOption?.dataset?.lat || "<%= first_with_coords&.latitude %>";
  let initLon = initialOption?.dataset?.lon || "<%= first_with_coords&.longitude %>";

  if (initLat && initLon) loadFor(initLat, initLon);

  if (els.select) {
    els.select.addEventListener("change", () => {
      const opt = els.select.selectedOptions[0];
      loadFor(opt.dataset.lat, opt.dataset.lon);
    });
  }

  if (window.lucide && typeof window.lucide.createIcons === "function") {
    window.lucide.createIcons();
  }
})();
</script>
