<div class="rounded-2xl bg-white/70 ring-1 ring-gray-200 backdrop-blur-xs p-6 shadow-soft space-y-6 text-gray-800">

  <!-- Cabeçalho -->
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <h3 class="text-lg font-semibold flex items-center gap-2">
      <i data-lucide="cloud-sun" class="h-5 w-5 text-emerald-700"></i>
      <%= t("dashboard.weather.title", default: "Weather Conditions") %>
    </h3>

    <% if @fields.present? %>
      <div class="flex items-center gap-2 text-sm">
        <label for="fieldSelect" class="font-medium text-gray-600">
          <%= t("dashboard.weather.select_field", default: "Field") %>:
        </label>
        <select
          id="fieldSelect"
          name="field_id"
          class="rounded-lg border-gray-200 bg-white/80 shadow-sm px-3 py-2 focus:ring-emerald-500 focus:border-emerald-500"
        >
          <% @fields.each do |field| %>
            <option
              value="<%= field.id %>"
              data-lat="<%= field.latitude %>"
              data-lon="<%= field.longitude %>"
              <%= "selected" if params[:field_id].to_s == field.id.to_s %>>
              <%= field.name %>
            </option>
          <% end %>
        </select>
      </div>
    <% end %>
  </div>

  <!-- Now / resumo -->
  <div class="flex flex-wrap items-center justify-between gap-6">
    <div>
      <p id="current-temp" class="text-5xl font-extrabold tracking-tight text-emerald-900">--°C</p>
      <p id="current-description" class="text-sm text-gray-500">
        <%= t("dashboard.weather.loading", default: "Loading...") %>
      </p>
    </div>

    <div class="grid grid-cols-2 gap-x-8 gap-y-1 text-sm">
      <p class="text-gray-600">
        <span class="font-semibold">💨 <%= t("dashboard.weather.wind", default: "Wind") %>:</span>
        <span id="wind-info">--</span>
      </p>
      <p class="text-gray-600">
        <span class="font-semibold">🌧️ <%= t("dashboard.weather.precip", default: "Precipitation") %>:</span>
        <span id="precip-info">-- mm</span>
      </p>
    </div>
  </div>

  <!-- Previsão diária -->
  <div>
    <h4 class="text-sm font-semibold text-gray-700 mb-2">
      <%= t("dashboard.weather.next_days", default: "Next Days") %>
    </h4>
    <div id="daily-forecast"
         class="flex gap-2 overflow-x-auto pb-2 scroll-smooth">
      <!-- JS preenche -->
    </div>
  </div>

  <hr class="border-gray-200">

  <!-- Previsão horária -->
  <div>
    <h4 class="text-sm font-semibold text-gray-700 mb-2">
      <%= t("dashboard.weather.next_24h", default: "Next 24 Hours") %>
    </h4>
    <div id="hourly-forecast"
         class="flex gap-2 overflow-x-auto pb-1 text-center text-sm scroll-smooth">
      <!-- JS preenche -->
    </div>
  </div>
</div>
