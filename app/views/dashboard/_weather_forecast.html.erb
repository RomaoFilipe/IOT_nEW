<div class="bg-white p-6 rounded-xl shadow-md space-y-6 text-gray-800">
  <!-- Cabeçalho -->
  <div class="flex items-center justify-between">
    <h3 class="text-lg font-semibold flex items-center gap-2">
      🌤 Weather Conditions
    </h3>
    <!-- Campo -->
    <div class="flex items-center gap-2 text-sm">
      <label for="fieldSelect" class="font-medium text-gray-600">Field:</label>
      <select id="fieldSelect" name="field_id"
              class="rounded-md border-gray-300 shadow-sm px-3 py-1 focus:ring-blue-500 focus:border-blue-500">
        <% @fields.each do |field| %>
          <option 
            value="<%= field.id %>" 
            data-lat="<%= field.latitude %>" 
            data-lon="<%= field.longitude %>"
            <%= 'selected' if params[:field_id].to_s == field.id.to_s %>>
            <%= field.name %>
          </option>
        <% end %>
      </select>
    </div>
  </div>

  <!-- Temperatura Atual -->
  <div class="flex items-center justify-between flex-wrap gap-4">
    <div>
      <p id="current-temp" class="text-4xl font-bold text-blue-700">--°C</p>
      <p id="current-description" class="text-sm text-gray-500">Loading...</p>
    </div>
    <div class="text-sm text-gray-600 space-y-1">
      <p><span class="font-semibold">💨 Wind:</span> <span id="wind-info">--</span></p>
      <p><span class="font-semibold">🌧️ Precipitation:</span> <span id="precip-info">-- mm</span></p>
    </div>
  </div>

  <!-- Previsão Diária -->
  <div>
    <h4 class="text-sm font-semibold text-gray-700 mb-2">Next Days</h4>
    <div id="daily-forecast" class="flex gap-2 overflow-x-auto pb-2 scroll-smooth">
      <!-- JS insere aqui -->
      <!-- Ex: cada dia com bg-white rounded-md text-center w-24 -->
    </div>
  </div>

  <hr class="border-gray-200">

  <!-- Previsão Horária -->
  <div>
    <h4 class="text-sm font-semibold text-gray-700 mb-2">Next 24 Hours</h4>
<div id="hourly-forecast"
     class="flex gap-2 overflow-x-auto pb-1 text-center text-sm scroll-smooth">
</div>
  </div>
</div>

<script>
const container = document.getElementById("hourly-forecast");
container.innerHTML = "";
for (let i = 0; i < 24; i++) {
  const hourLabel = new Date(data.hourly.time[i]).toLocaleTimeString("pt-PT", { hour: '2-digit', minute: '2-digit' });
  const icon = weatherIcon(data.hourly.weathercode[i]);
  const temp = Math.round(data.hourly.temperature_2m[i]);

  container.innerHTML += `
    <div class="min-w-[60px] bg-blue-50 rounded-md p-2 shadow-sm flex flex-col items-center space-y-1">
      <p class="font-semibold text-xs">${hourLabel}</p>
      <p class="text-xl">${icon}</p>
      <p class="text-sm text-gray-800">${temp}°C</p>
    </div>
  `;
}


</script>