<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-6">
  <div class="bg-white p-4 rounded-lg shadow-md text-center">
    <h3 class="text-lg font-semibold"><%= t("dashboard.quick_actions.analytics.title", default: "View Analytics") %></h3>
    <p class="text-gray-500 text-sm"><%= t("dashboard.quick_actions.analytics.description", default: "Detailed charts") %></p>
    <button class="mt-3 px-4 py-2 bg-green-700 text-white rounded-md"><%= t("dashboard.quick_actions.analytics.button", default: "Open") %></button>
  </div>
  <div class="bg-white p-4 rounded-lg shadow-md text-center">
    <h3 class="text-lg font-semibold"><%= t("dashboard.quick_actions.fields.title", default: "Manage Fields") %></h3>
    <p class="text-gray-500 text-sm"><%= t("dashboard.quick_actions.fields.description", default: "View & edit") %></p>
    <button class="mt-3 px-4 py-2 bg-green-700 text-white rounded-md"><%= t("dashboard.quick_actions.fields.button", default: "Open") %></button>
  </div>
  <div class="bg-white p-4 rounded-lg shadow-md text-center">
    <h3 class="text-lg font-semibold"><%= t("dashboard.quick_actions.settings.title", default: "Settings") %></h3>
    <p class="text-gray-500 text-sm"><%= t("dashboard.quick_actions.settings.description", default: "System preferences") %></p>
    <button class="mt-3 px-4 py-2 bg-green-700 text-white rounded-md"><%= t("dashboard.quick_actions.settings.button", default: "Open") %></button>
  </div>
</div>
