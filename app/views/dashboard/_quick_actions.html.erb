<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-6">

  <!-- Analytics / Dashboard -->
  <%= link_to (safe_path(:dashboard_path, :root_path)),
              class: "group block bg-white p-4 rounded-lg shadow-md text-center border border-transparent hover:border-emerald-300 hover:shadow-lg transition",
              aria: { label: t("dashboard.quick_actions.analytics.aria", default: "Abrir Analytics") } do %>
    <h3 class="text-lg font-semibold">
      <%= t("dashboard.quick_actions.analytics.title", default: "View Analytics") %>
    </h3>
    <p class="text-gray-500 text-sm">
      <%= t("dashboard.quick_actions.analytics.description", default: "Detailed charts") %>
    </p>
    <span class="mt-3 inline-flex items-center justify-center px-4 py-2 bg-green-700 text-white rounded-md group-hover:bg-green-800">
      <%= t("dashboard.quick_actions.analytics.button", default: "Open") %>
    </span>
  <% end %>

  <!-- Manage Fields (abre já no separador Mapa) -->
  <%= link_to fields_map_path,
              class: "group block bg-white p-4 rounded-lg shadow-md text-center border border-transparent hover:border-emerald-300 hover:shadow-lg transition",
              aria: { label: t("dashboard.quick_actions.fields.aria", default: "Gerir Campos") } do %>
    <h3 class="text-lg font-semibold">
      <%= t("dashboard.quick_actions.fields.title", default: "Manage Fields") %>
    </h3>
    <p class="text-gray-500 text-sm">
      <%= t("dashboard.quick_actions.fields.description", default: "View & edit") %>
    </p>
    <span class="mt-3 inline-flex items-center justify-center px-4 py-2 bg-green-700 text-white rounded-md group-hover:bg-green-800">
      <%= t("dashboard.quick_actions.fields.button", default: "Open") %>
    </span>
  <% end %>

  <!-- Settings (cai para edição de perfil/conta se não houver /settings) -->
  <%= link_to safe_path(:settings_path, :edit_user_registration_path, :account_path, :root_path),
              class: "group block bg-white p-4 rounded-lg shadow-md text-center border border-transparent hover:border-emerald-300 hover:shadow-lg transition",
              aria: { label: t("dashboard.quick_actions.settings.aria", default: "Abrir Definições") } do %>
    <h3 class="text-lg font-semibold">
      <%= t("dashboard.quick_actions.settings.title", default: "Settings") %>
    </h3>
    <p class="text-gray-500 text-sm">
      <%= t("dashboard.quick_actions.settings.description", default: "System preferences") %>
    </p>
    <span class="mt-3 inline-flex items-center justify-center px-4 py-2 bg-green-700 text-white rounded-md group-hover:bg-green-800">
      <%= t("dashboard.quick_actions.settings.button", default: "Open") %>
    </span>
  <% end %>

</div>
