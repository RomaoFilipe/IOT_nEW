<%# locals: reading %>
<% r  = reading; s = r.sensor; f = s&.field %>
<% ts = r.measured_at || r.read_at || r.created_at %>

<% moist = r.try(:soil_pct) || r.try(:moisture) %>
<% temp  = r.try(:temp_c)   || r.try(:air_temperature) %>
<% hum   = r.try(:hum_air)  || r.try(:air_humidity) %>
<% lux   = r.try(:lux)      || r.try(:light_intensity) %>
<% batt  = s&.battery %>

<article class="rounded-xl border border-gray-200 bg-white/80 backdrop-blur-sm shadow-sm hover:shadow-md transition p-3">
  <div class="flex items-start justify-between gap-3">
    <div class="flex items-center gap-2">
      <div class="h-8 w-8 rounded-full bg-emerald-50 flex items-center justify-center">
        <i data-lucide="activity" class="h-4 w-4 text-emerald-700"></i>
      </div>
      <div>
        <p class="text-sm font-semibold text-gray-800">
          <%= s&.name || s&.device_id || t("dashboard.activity.sensor", default: "Sensor") %>
        </p>
        <% if f %>
          <span class="inline-flex items-center gap-1 text-[11px] px-1.5 py-0.5 rounded-full bg-pink-50 text-pink-700 ring-1 ring-pink-200">
            <i data-lucide="map-pin" class="h-3 w-3"></i><%= f.name %>
          </span>
        <% end %>
      </div>
    </div>

    <div class="text-[11px] text-gray-500 text-right whitespace-nowrap">
      <%= l(ts, format: "%d/%m %H:%M") %><br>
      <span class="text-gray-400"><%= time_ago_in_words(ts) %> <%= t("ago", default: "ago") %></span>
    </div>
  </div>

  <div class="mt-3 flex flex-wrap items-center gap-2">
    <% if moist.present? %>
      <span class="inline-flex items-center gap-1 text-[11px] px-2 py-1 rounded-full bg-sky-50 text-sky-700 ring-1 ring-sky-200">💧 <%= number_with_precision(moist, precision: 1) %>%</span>
    <% end %>
    <% if temp.present? %>
      <span class="inline-flex items-center gap-1 text-[11px] px-2 py-1 rounded-full bg-orange-50 text-orange-700 ring-1 ring-orange-200">🌡️ <%= number_with_precision(temp, precision: 1) %> °C</span>
    <% end %>
    <% if hum.present? %>
      <span class="inline-flex items-center gap-1 text-[11px] px-2 py-1 rounded-full bg-cyan-50 text-cyan-700 ring-1 ring-cyan-200">🌬️ <%= hum.to_i %>%</span>
    <% end %>
    <% if lux.present? %>
      <span class="inline-flex items-center gap-1 text-[11px] px-2 py-1 rounded-full bg-amber-50 text-amber-700 ring-1 ring-amber-200">🔆 <%= lux.to_i %> lux</span>
    <% end %>
    <% if batt.present? %>
      <span class="ml-auto inline-flex items-center gap-1 text-[11px] px-2 py-1 rounded-full bg-emerald-50 text-emerald-700 ring-1 ring-emerald-200">🔋 <%= batt.to_i %>%</span>
    <% end %>
  </div>
</article>
