<%= turbo_stream_from "irrigation_#{sensor.id}" %>

<div class="bg-white p-6 rounded-lg shadow-md">
  <h3 class="text-lg font-semibold text-gray-800 mb-4">Status dos Sensores por Campo</h3>

  <div id="sensorCarousel" class="relative overflow-hidden">
    <div class="whitespace-nowrap transition-transform duration-500" id="slidesContainer">
      <div class="inline-block align-top w-full px-2" style="width: 100%;" data-slide="<%= index %>">
        <div class="border p-4 rounded-xl shadow bg-gray-50">
          <h4 class="text-md font-semibold text-gray-700 mb-3">📍 <%= field.name %></h4>

          <div class="irrigation-status">
            <span class="irrigation-status-text">Estado da Irrigação: <%= sensor.status.capitalize %></span>
            <div class="progress-bar-container">
              <div class="progress-bar irrigation-progress-bar" style="width: <%= sensor.status == 'irrigando' ? "#{(sensor.remaining_time * 100 / sensor.last_duration.to_f).round}%" : '0%' %>;">
              </div>
            </div>
            <span class="irrigation-progress-text">Faltam: <%= format_time(sensor.remaining_time) %></span>
          </div>

          <div class="w-full bg-gray-200 rounded-full h-2 mt-1">
            <div class="h-2 rounded-full transition-all duration-300 <%= sensor.status == 'irrigando' ? 'bg-green-500' : 'bg-gray-400' %>"
              style="width: <%= sensor.status == 'irrigando' ? "#{(sensor.remaining_time * 100 / sensor.last_duration.to_f).round}%" : '0%' %>;">
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <% temp_sensor = field.sensors.find { |s| s.sensor_type == "temperature" } %>
  <% sensores = [
    { icone: "💧", nome: "Humidade do Solo", valor: temp_sensor&.moisture || "N/A", unidade: "%" },
    { icone: "🌡️", nome: "Temperatura", valor: temp_sensor&.temperature || "N/A", unidade: "°C" },
    { icone: "🔋", nome: "Bateria", valor: temp_sensor&.battery || 0, unidade: "%" }
  ] %>

  <% sensores.each do |sensor| %>
    <div class="mt-2">
      <div class="flex justify-between items-center">
        <div class="flex items-center space-x-2">
          <span><%= sensor[:icone] %></span>
          <p class="text-sm font-medium text-gray-600"><%= sensor[:nome] %></p>
        </div>
        <span class="text-blue-600 text-sm font-medium">
          <%= sensor[:valor] %> <%= sensor[:unidade] %>
        </span>
      </div>
      <div class="w-full bg-gray-200 rounded-full h-2 mt-1">
        <div class="bg-blue-600 h-2 rounded-full" style="width: <%= sensor[:valor].to_i %>%"></div>
      </div>
    </div>
  <% end %>
</div>

<div class="flex justify-between items-center mt-4">
  <button id="prevSlide" class="text-gray-600 hover:text-gray-900">&laquo; Anterior</button>
  <button id="nextSlide" class="text-gray-600 hover:text-gray-900">Próximo &raquo;</button>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const progressBar = document.querySelector('.irrigation-progress-bar');
  const progressText = document.querySelector('.irrigation-progress-text');

  let remainingTime = 0;
  let totalTime = 60;
  let timerInterval = null;

  function formatTime(seconds) {
    const minutes = Math.floor(seconds / 60);
    const hours = Math.floor(minutes / 60);
    const remainingMinutes = minutes % 60;
    const remainingSeconds = seconds % 60;
    return `${hours}h ${remainingMinutes}m ${remainingSeconds}s`;
  }

  function updateUI() {
    if (!progressBar || !progressText) return;
    const percentage = (remainingTime / totalTime) * 100;
    progressBar.style.width = `${percentage}%`;
    progressText.textContent = `Faltam: ${formatTime(remainingTime)}`;

    if (remainingTime > 0) {
      progressBar.classList.add("bg-green-500");
      progressBar.classList.remove("bg-gray-400");
    } else {
      progressBar.classList.remove("bg-green-500");
      progressBar.classList.add("bg-gray-400");
      clearInterval(timerInterval);
      timerInterval = null;
    }
  }

  App.cable.subscriptions.create("IrrigationChannel", {
    connected() {
      console.log("Conectado ao IrrigationChannel");
    },
    disconnected() {
      console.log("Desconectado do IrrigationChannel");
      if(timerInterval) clearInterval(timerInterval);
    },
    received(data) {
      console.log("Recebido via WebSocket:", data);

      remainingTime = data.remaining_time;
      totalTime = data.total_time;

      updateUI();

      if (timerInterval) clearInterval(timerInterval);

      timerInterval = setInterval(() => {
        if (remainingTime > 0) {
          remainingTime--;
          updateUI();
        } else {
          clearInterval(timerInterval);
          timerInterval = null;
        }
      }, 1000);
    }
  });
});
</script>
