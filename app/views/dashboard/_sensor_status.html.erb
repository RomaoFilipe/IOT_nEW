<div class="bg-white p-6 rounded-lg shadow-md">
  <h3 class="text-lg font-semibold text-gray-800 mb-4">Status dos Sensores por Campo</h3>

  <!-- Contêiner do slideshow -->
  <div id="sensorCarousel" class="relative overflow-hidden">
    <div class="whitespace-nowrap transition-transform duration-500" id="slidesContainer">
      <% @fields.each_with_index do |field, index| %>
        <div class="inline-block align-top w-full px-2" style="width: 100%;" data-slide="<%= index %>">
          <div class="border p-4 rounded-xl shadow bg-gray-50">
            <h4 class="text-md font-semibold text-gray-700 mb-3">📍 <%= field.name %></h4>

            <% sensores = [
              { icone: "💧", nome: "Humidade do Solo", valor: field.sensors.first&.moisture || "N/A", unidade: "%" },
              { icone: "🌡️", nome: "Temperatura", valor: field.sensors.first&.temperature || "N/A", unidade: "°C" },
              { icone: "🚿", nome: "Estado da Irrigação", valor: field.sensors.find_by(sensor_type: "irrigation")&.status || "N/A" },
              { icone: "🔋", nome: "Bateria", valor: field.sensors.first&.battery || 0, unidade: "%" }
            ] %>

            <% sensores.each do |sensor| %>
              <div class="mt-2">
                <div class="flex justify-between items-center">
                  <div class="flex items-center space-x-2">
                    <span><%= sensor[:icone] %></span>
                    <p class="text-sm font-medium text-gray-600"><%= sensor[:nome] %></p>
                  </div>
                  <span class="text-blue-600 text-sm font-medium">
                    <%= sensor[:valor] %> <%= sensor[:unidade] %>
                  </span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2 mt-1">
                  <div class="bg-blue-600 h-2 rounded-full" style="width: <%= sensor[:valor].to_i %>%"></div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Controles -->
    <div class="flex justify-between items-center mt-4">
      <button id="prevSlide" class="text-gray-600 hover:text-gray-900">&laquo; Anterior</button>
      <button id="nextSlide" class="text-gray-600 hover:text-gray-900">Próximo &raquo;</button>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const container = document.getElementById("slidesContainer");
    const slides = container.children.length;
    let index = 0;

    document.getElementById("prevSlide").addEventListener("click", () => {
      index = (index - 1 + slides) % slides;
      container.style.transform = `translateX(-${index * 100}%)`;
    });

    document.getElementById("nextSlide").addEventListener("click", () => {
      index = (index + 1) % slides;
      container.style.transform = `translateX(-${index * 100}%)`;
    });
  });
</script>
