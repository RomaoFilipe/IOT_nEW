<%= tag.meta name: "sensor-id", content: sensor.id %>

<div class="border p-4 rounded-xl shadow bg-gray-50">
  <h4 class="text-md font-semibold text-gray-700 mb-3">📍 <%= field.name %></h4>

  <!-- Estado da Irrigação + Barra -->
  <div class="irrigation-status mb-2">
    <div class="flex justify-between items-center text-sm font-medium text-gray-600 mb-1">
      <span>💦 <%= t("dashboard.sensor_status.irrigation_status", default: "Irrigation Status") %>: <%= sensor.status.to_s.capitalize %></span>
      <span class="irrigation-progress-text text-gray-700"><%= t("dashboard.sensor_status.remaining", default: "Remaining:") %> 0h 0m 0s</span>
    </div>

    <div class="w-full bg-gray-200 rounded-full h-2 overflow-hidden">
      <div class="irrigation-progress-bar bg-green-500 h-full transition-all duration-500 ease-linear"
           style="width: 0%;"></div>
    </div>
  </div>

  <% temp_sensor = field.sensors.find { |s| s.sensor_type == "temperature" } %>
  <% sensor_id = sensor.id %>

  <!-- Humidade -->
  <div class="mt-3">
    <div class="flex justify-between items-center">
      <div class="flex items-center space-x-2">
        <span>💧</span>
        <p class="text-sm font-medium text-gray-600"><%= t("dashboard.sensor_status.soil_moisture", default: "Soil Moisture") %></p>
      </div>
      <span class="text-blue-600 text-sm font-medium">
        <span id="moisture-<%= sensor_id %>"><%= temp_sensor&.moisture || "N/A" %></span> %
      </span>
    </div>
    <div class="w-full bg-gray-200 rounded-full h-2 mt-1">
      <div class="bg-blue-600 h-2 rounded-full" style="width: <%= temp_sensor&.moisture.to_i %>%"></div>
    </div>
  </div>

  <!-- Temperatura -->
  <div class="mt-3">
    <div class="flex justify-between items-center">
      <div class="flex items-center space-x-2">
        <span>🌡️</span>
        <p class="text-sm font-medium text-gray-600"><%= t("dashboard.sensor_status.temperature", default: "Temperature") %></p>
      </div>
      <span class="text-blue-600 text-sm font-medium">
        <span id="temperature-<%= sensor_id %>"><%= temp_sensor&.temperature || "N/A" %></span> °C
      </span>
    </div>
    <div class="w-full bg-gray-200 rounded-full h-2 mt-1">
      <div class="bg-blue-600 h-2 rounded-full" style="width: <%= temp_sensor&.temperature.to_i %>%"></div>
    </div>
  </div>

  <!-- Bateria -->
  <div class="mt-3">
    <div class="flex justify-between items-center">
      <div class="flex items-center space-x-2">
        <span>🔋</span>
        <p class="text-sm font-medium text-gray-600"><%= t("dashboard.sensor_status.battery", default: "Battery") %></p>
      </div>
      <span class="text-blue-600 text-sm font-medium">
        <span id="battery-<%= sensor_id %>"><%= temp_sensor&.battery || 0 %></span> %
      </span>
    </div>
    <div class="w-full bg-gray-200 rounded-full h-2 mt-1">
      <div class="bg-blue-600 h-2 rounded-full" style="width: <%= temp_sensor&.battery.to_i %>%"></div>
    </div>
  </div>
</div>

<!-- Botões de navegação entre sensores -->
<div class="flex justify-between items-center mt-4">
  <button id="prevSlide" class="text-gray-600 hover:text-gray-900"><%= t("dashboard.sensor_status.previous", default: "« Previous") %></button>
  <button id="nextSlide" class="text-gray-600 hover:text-gray-900"><%= t("dashboard.sensor_status.next", default: "Next »") %></button>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const sensorId = document.querySelector("meta[name='sensor-id']")?.content;
    if (!sensorId) return;

    let remainingTime = 0;
    let totalTime = 0;

    const progressBar = document.querySelector(".irrigation-progress-bar");
    const progressText = document.querySelector(".irrigation-progress-text");

    function formatTime(seconds) {
      const m = Math.floor(seconds / 60);
      const h = Math.floor(m / 60);
      const min = m % 60;
      const s = seconds % 60;
      return `${h}h ${min}m ${s}s`;
    }

    function updateUI() {
      const percent = totalTime > 0 ? (remainingTime / totalTime) * 100 : 0;
      progressBar.style.width = `${percent}%`;
      progressText.textContent = "<%= j t('dashboard.sensor_status.remaining', default: 'Remaining:') %> " + formatTime(remainingTime);
    }

    async function checkStatus() {
      try {
        const response = await fetch(`/sensors/${sensorId}/irrigation_status`);
        const data = await response.json();
        remainingTime = data.remaining_time;
        totalTime = data.total_time;

        if (remainingTime > 0) {
          updateUI();
        } else {
          progressBar.style.width = `0%`;
          progressText.textContent = "<%= j t('dashboard.sensor_status.done', default: 'Irrigation completed') %>";
        }
      } catch (e) {
        console.error("Status fetch error:", e);
      }
    }

    setInterval(() => {
      if (remainingTime > 0) remainingTime--;
      updateUI();
    }, 1000);

    setInterval(checkStatus, 5000);
    checkStatus();
  });
</script>
