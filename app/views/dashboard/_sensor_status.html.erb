<%# == Sensor Irrigation Status Card
    locals: sensor, field
%>
<% temp_sensor = field.sensors.find { |s| s.sensor_type == "temperature" } %>

<div id="irr-card-<%= sensor.id %>"
     class="rounded-xl border border-slate-200 bg-white shadow-sm p-4 space-y-3"
     data-sensor-id="<%= sensor.id %>">

  <div class="flex items-center justify-between">
    <h4 class="text-sm sm:text-base font-semibold text-slate-800 flex items-center gap-2">
      📍 <%= field.name %>
    </h4>

    <span class="inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full
                 <%= sensor.status.to_s == 'active' ? 'bg-emerald-50 text-emerald-700 ring-1 ring-emerald-200'
                                                     : 'bg-slate-50 text-slate-600 ring-1 ring-slate-200' %>">
      💦 <span class="irr-status"><%= sensor.status.to_s.capitalize %></span>
    </span>
  </div>

  <!-- Barra de progresso -->
  <div class="space-y-1">
    <div class="flex items-center justify-between text-xs font-medium text-slate-600">
      <span>Progresso da irrigação</span>
      <span class="irr-remaining text-slate-700">Faltam: —</span>
    </div>
    <div class="w-full bg-slate-200/70 rounded-full h-2 overflow-hidden">
      <div class="irr-bar h-2 w-0 transition-[width] duration-500 ease-linear
                  <%= sensor.status.to_s == 'active' ? 'bg-emerald-500' : 'bg-slate-400' %>">
      </div>
    </div>
  </div>

  <!-- Métricas rápidas -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1">
    <!-- Humidade -->
    <div>
      <div class="flex items-center justify-between">
        <p class="text-sm text-slate-600 flex items-center gap-1">💧 Humidade</p>
        <span class="text-sm font-semibold text-slate-800">
          <span id="moisture-<%= sensor.id %>"><%= temp_sensor&.moisture || "N/A" %></span> %
        </span>
      </div>
      <div class="w-full bg-slate-200 rounded-full h-2 mt-1">
        <div class="bg-sky-600 h-2 rounded-full"
             style="width: <%= [temp_sensor&.moisture.to_i, 0].max.clamp(0,100) %>%"></div>
      </div>
    </div>

    <!-- Temperatura -->
    <div>
      <div class="flex items-center justify-between">
        <p class="text-sm text-slate-600 flex items-center gap-1">🌡️ Temperatura</p>
        <span class="text-sm font-semibold text-slate-800">
          <span id="temperature-<%= sensor.id %>"><%= temp_sensor&.temperature || "N/A" %></span> °C
        </span>
      </div>
      <div class="w-full bg-slate-200 rounded-full h-2 mt-1">
        <div class="bg-orange-500 h-2 rounded-full"
             style="width: <%= [temp_sensor&.temperature.to_i, 0].max.clamp(0,100) %>%"></div>
      </div>
    </div>

    <!-- Bateria -->
    <div>
      <div class="flex items-center justify-between">
        <p class="text-sm text-slate-600 flex items-center gap-1">🔋 Bateria</p>
        <span class="text-sm font-semibold text-slate-800">
          <span id="battery-<%= sensor.id %>"><%= temp_sensor&.battery || 0 %></span> %
        </span>
      </div>
      <div class="w-full bg-slate-200 rounded-full h-2 mt-1">
        <div class="bg-violet-500 h-2 rounded-full"
             style="width: <%= [temp_sensor&.battery.to_i, 0].max.clamp(0,100) %>%"></div>
      </div>
    </div>
  </div>
</div>

<script>
(function setupIrrCard() {
  const root = document.getElementById("irr-card-<%= sensor.id %>");
  if (!root) return;

  const sensorId = root.dataset.sensorId;
  const bar       = root.querySelector(".irr-bar");
  const remainEl  = root.querySelector(".irr-remaining");
  const statusEl  = root.querySelector(".irr-status");

  let total = 0;
  let remaining = 0;
  let tickTimer, pollTimer;

  const fmt = (sec) => {
    sec = Math.max(0, Math.floor(sec || 0));
    const h = Math.floor(sec / 3600);
    const m = Math.floor((sec % 3600) / 60);
    const s = sec % 60;
    return `${h}h ${m}m ${s}s`;
  };

  const paint = () => {
    const donePct = total > 0 ? ((total - remaining) / total) * 100 : 0;
    bar.style.width = `${Math.max(0, Math.min(100, donePct))}%`;
    remainEl.textContent = remaining > 0 ? `Faltam: ${fmt(remaining)}` : "Concluída";
  };

  const setStateColor = (status) => {
    bar.classList.remove("bg-emerald-500", "bg-slate-400", "bg-rose-500");
    if (status === "active")      bar.classList.add("bg-emerald-500");
    else if (status === "paused") bar.classList.add("bg-rose-500");
    else                          bar.classList.add("bg-slate-400");
  };

  const poll = async () => {
    try {
      const res = await fetch(`/sensors/${sensorId}/irrigation_status`, {
        credentials: "same-origin",
        headers: { "Accept": "application/json" }
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();

      // Espera-se { remaining_time, total_time, status, moisture, temperature, battery }
      total     = Number(data.total_time   || 0);
      remaining = Number(data.remaining_time || 0);

      if (data.status) {
        statusEl.textContent = String(data.status).charAt(0).toUpperCase() + String(data.status).slice(1);
        setStateColor(String(data.status));
      }

      if (data.moisture != null) {
        const el = document.getElementById(`moisture-${sensorId}`);
        if (el) el.textContent = Math.round(Number(data.moisture));
      }
      if (data.temperature != null) {
        const el = document.getElementById(`temperature-${sensorId}`);
        if (el) el.textContent = Number(data.temperature).toFixed(1);
      }
      if (data.battery != null) {
        const el = document.getElementById(`battery-${sensorId}`);
        if (el) el.textContent = Math.round(Number(data.battery));
      }

      paint();
    } catch (e) {
      console.error("Erro ao obter estado de irrigação:", e);
    }
  };

  const start = () => {
    // decrementa 1s localmente para suavidade
    tickTimer = setInterval(() => {
      if (remaining > 0) { remaining--; paint(); }
    }, 1000);

    // atualiza do servidor
    poll();
    pollTimer = setInterval(poll, 5000);
  };

  const stop = () => {
    clearInterval(tickTimer);
    clearInterval(pollTimer);
  };

  document.addEventListener("turbo:before-cache", stop, { once: true });
  start();
})();
</script>
