<%# locals: readings, page, per, total, pages %>

<% def day_label(ts)
     d = ts.to_date
     return t("today", default: "Today")     if d == Time.zone.today
     return t("yesterday", default: "Yesterday") if d == Time.zone.yesterday
     l(d, format: "%d/%m/%Y")
   end %>

<% grouped = readings.group_by { |r| (r.measured_at || r.read_at || r.created_at).to_date } %>

<div class="space-y-5">
  <% grouped.sort_by { |d,_| d }.reverse.each do |date, items| %>
    <div>
      <h3 class="text-sm font-semibold text-gray-700 mb-2 flex items-center gap-2">
        <span class="inline-block w-1.5 h-4 rounded bg-gradient-to-b from-emerald-400 via-sky-400 to-cyan-400"></span>
        <%= day_label(items.first.measured_at || items.first.read_at || items.first.created_at) %>
      </h3>

      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3">
        <% items.each do |r| %>
          <%= render "dashboard/activity_card", reading: r %>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="flex items-center justify-between pt-2">
    <div class="text-xs text-gray-500">
      <%= t("pagination.page", default: "Page") %> <%= page %>/<%= pages %> · <%= total %> <%= t("records", default: "records") %>
    </div>

    <div class="flex items-center gap-2">
      <% prev_path = page > 1 ? dashboard_activity_path(page: page - 1, per: per) : nil %>
      <% next_path = page < pages ? dashboard_activity_path(page: page + 1, per: per) : nil %>

      <%= link_to "‹ "+t("pagination.prev", default: "Prev"),
                  prev_path || "#",
                  data: { turbo_frame: "activity-feed" },
                  class: "text-sm px-3 py-1.5 rounded border " +
                         (prev_path ? "text-gray-700 hover:bg-gray-50" : "text-gray-400 pointer-events-none opacity-50") %>

      <%= link_to t("pagination.next", default: "Next")+" ›",
                  next_path || "#",
                  data: { turbo_frame: "activity-feed" },
                  class: "text-sm px-3 py-1.5 rounded border " +
                         (next_path ? "text-gray-700 hover:bg-gray-50" : "text-gray-400 pointer-events-none opacity-50") %>
    </div>
  </div>
</div>
