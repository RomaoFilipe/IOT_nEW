<h3 class="text-lg font-semibold text-gray-800 mb-4 flex items-center gap-2">
  🗓️ Eventos Planeados
</h3>

<turbo-frame id="planned-events-list">
  <% if @events.any? %>
    <ul class="space-y-3">
      <%= render partial: "dashboard/event", collection: @events, as: :event %>
    </ul>
  <% else %>
    <p class="text-sm text-gray-500 italic">Nenhum evento planeado para hoje.</p>
  <% end %>
</turbo-frame>
