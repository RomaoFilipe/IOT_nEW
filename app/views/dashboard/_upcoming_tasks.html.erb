<h3 class="text-lg font-semibold text-gray-800 mb-4 flex items-center gap-2">
  <%= t("dashboard.upcoming_tasks.title") %>
</h3>

<ul id="planned-events-list" class="space-y-3">
  <% if @events.any? %>
    <% @events.each do |event| %>
      <li id="<%= dom_id(event[:type] == :task ? PlannedTask.new(id: event[:id]) : IrrigationSchedule.new(id: event[:id])) %>"
          class="border rounded-lg px-4 py-3 bg-white hover:shadow-sm transition">
        <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-3">
          <div class="flex items-start gap-3">
            <div class="mt-1 shrink-0">
              <% if event[:type] == :task %>
                <div class="w-5 h-5 rounded-full border-2 border-gray-400 flex items-center justify-center text-xs text-gray-400">✓</div>
              <% else %>
                <div class="w-5 h-5 rounded-full bg-blue-100 flex items-center justify-center text-xs text-blue-600">🚿</div>
              <% end %>
            </div>
            <div class="flex-1 min-w-0">
              <p class="font-semibold text-sm text-gray-800 break-words"><%= event[:title] %></p>
              <div class="flex flex-wrap items-center gap-2 mt-1 text-xs text-gray-500">
                <span class="flex items-center gap-1"><%= t("dashboard.upcoming_tasks.time") %> <%= l(event[:time], format: "%d/%m/%Y %H:%M") %></span>
                <% if event[:type] == :task && event[:priority].present? %>
                  <% priority_color = case event[:priority].downcase
                    when "high" then "text-red-600"
                    when "medium" then "text-yellow-600"
                    else "text-green-600"
                  end %>
                  <span class="<%= priority_color %> font-semibold capitalize"><%= event[:priority] %></span>
                <% end %>
                <span><%= event[:field] %></span>
              </div>
            </div>
          </div>
          <div class="sm:mt-1 sm:ml-2">
            <% if event[:type] == :task %>
              <%= button_to "✖", planned_task_path(event[:id]), method: :delete, form_class: "inline", class: "text-red-500 text-sm hover:underline", data: { turbo_confirm: t("dashboard.upcoming_tasks.cancel_task") }, role: "button", title: t("dashboard.upcoming_tasks.cancel_task") %>
            <% else %>
              <%= button_to "✖", field_irrigation_schedule_path(event[:field_id], event[:id]), method: :delete, form_class: "inline", class: "text-red-500 text-sm hover:underline", data: { turbo_confirm: t("dashboard.upcoming_tasks.cancel_irrigation") }, role: "button", title: t("dashboard.upcoming_tasks.cancel_irrigation") %>
            <% end %>
          </div>
        </div>
      </li>
    <% end %>
  <% else %>
    <p id="no-events-msg" class="text-sm text-gray-500 italic"><%= t("dashboard.upcoming_tasks.none") %></p>
  <% end %>
</ul>

<script>
  document.addEventListener("turbo:load", () => {
    function renderEvent(event) {
      const li = document.createElement("li");
      const domId = event.type === 'task'
        ? `planned_task_${event.id}`
        : `irrigation_schedule_${event.id}`;
      li.id = domId;
      li.className = "border rounded-lg px-4 py-3 bg-white hover:shadow-sm transition";

      li.innerHTML = `
        <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-3">
          <div class="flex items-start gap-3">
            <div class="mt-1 shrink-0">
              ${event.type === 'task'
                ? '<div class="w-5 h-5 rounded-full border-2 border-gray-400 flex items-center justify-center text-xs text-gray-400">✓</div>'
                : '<div class="w-5 h-5 rounded-full bg-blue-100 flex items-center justify-center text-xs text-blue-600">🚿</div>'}
            </div>
            <div class="flex-1 min-w-0">
              <p class="font-semibold text-sm text-gray-800 break-words">${event.title}</p>
              <div class="flex flex-wrap items-center gap-2 mt-1 text-xs text-gray-500">
                <span class="flex items-center gap-1">🕒 ${new Date(event.time).toLocaleString('pt-PT', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit' })}</span>
                ${event.priority ? `<span class="font-semibold capitalize">${event.priority}</span>` : ''}
                <span>${event.field}</span>
              </div>
            </div>
          </div>
          <div class="sm:mt-1 sm:ml-2"></div>
        </div>
      `;
      return li;
    }

    function updateEvents(events) {
      const ul = document.getElementById("planned-events-list");
      if (!ul) return;

      const noEventsMsg = document.getElementById("no-events-msg");
      if (noEventsMsg) noEventsMsg.remove();

      const existingIds = new Set();
      ul.querySelectorAll("li").forEach(li => existingIds.add(li.id));

      events.forEach(event => {
        const domId = event.type === 'task'
          ? `planned_task_${event.id}`
          : `irrigation_schedule_${event.id}`;

        if (!existingIds.has(domId)) {
          const li = renderEvent(event);
          ul.prepend(li);
        }
      });
    }

    function pollEvents() {
      fetch('/events/upcoming.json', { credentials: "same-origin" })
        .then(response => response.json())
        .then(data => {
          updateEvents(data.events);
        })
        .catch(error => {
          console.error("Erro ao buscar eventos:", error);
        });
    }

    setInterval(pollEvents, 20000);
    pollEvents();
  });
</script>
