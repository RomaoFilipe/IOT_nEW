<%# app/views/dashboard/_recent_activity.html.erb %>
<%# locals opcionais:
  - sensor_readings: coleção já filtrada (se vier do controller)
  - title: string para o cabeçalho (ex.: "Atividade Recente")
%>

<%
readings =
  if local_assigns[:sensor_readings].present?
    local_assigns[:sensor_readings]
  elsif instance_variable_defined?(:@sensor_readings) && @sensor_readings.present?
    @sensor_readings
  else
    base = SensorReading
      .includes(sensor: :field)
      .joins(sensor: :field)
      .where(fields: { account_id: current_user.account_id })

    base = base.where(sensor_id: params[:sensor_id]) if params[:sensor_id].present?
    base = base.where(fields: { id: params[:field_id] }) if params[:field_id].present?

    if params[:from].present?
      from_date = Time.zone.parse("#{params[:from]} 00:00")
      base = base.where("COALESCE(sensor_readings.measured_at, sensor_readings.read_at, sensor_readings.created_at) >= ?", from_date)
    end

    if params[:to].present?
      to_date = Time.zone.parse("#{params[:to]} 23:59:59")
      base = base.where("COALESCE(sensor_readings.measured_at, sensor_readings.read_at, sensor_readings.created_at) <= ?", to_date)
    end

    base
      .order(Arel.sql("COALESCE(sensor_readings.measured_at, sensor_readings.read_at, sensor_readings.created_at) DESC"))
      .limit(50)
  end
%>

<%
day_label = ->(ts) do
  d = ts.to_date
  if d == Time.zone.today
    t(".today", default: "Hoje")
  elsif d == Time.zone.yesterday
    t(".yesterday", default: "Ontem")
  else
    l(d, format: "%d/%m/%Y")
  end
end
%>

<div class="mb-4 rounded-xl border bg-white p-3">
  <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
    <div class="flex items-center gap-2">
      <span class="inline-block h-4 w-1.5 rounded bg-gradient-to-b from-emerald-400 via-sky-400 to-cyan-400"></span>
      <h2 class="text-base font-semibold text-slate-800">
        <%= local_assigns[:title].presence || t(".header", default: "Atividade Recente") %>
      </h2>
    </div>

    <div class="w-full md:w-auto">
      <%= form_with url: dashboard_path, method: :get, local: true, class: "flex flex-col gap-2 md:flex-row md:items-center" do |f| %>
        <%# ⚠️ Corrigido: filtrar sensores via field.account_id %>
        <% sensors = Sensor.joins(:field)
                           .where(fields: { account_id: current_user.account_id })
                           .distinct
                           .order(:name)
                           .pluck(:name, :id) %>

        <% fields  = Field.where(account_id: current_user.account_id)
                          .order(:name)
                          .pluck(:name, :id) %>

        <%= f.select :sensor_id,
              options_for_select([["Todos os sensores", nil]] + sensors, params[:sensor_id]),
              {},
              class: "rounded-md border-slate-300 text-sm md:min-w-[14rem]" %>

        <%= f.select :field_id,
              options_for_select([["Todos os campos", nil]] + fields, params[:field_id]),
              {},
              class: "rounded-md border-slate-300 text-sm md:min-w-[14rem]" %>

        <div class="flex items-center gap-2">
          <label class="text-xs text-slate-600">De</label>
          <%= f.date_field :from, value: params[:from], class: "rounded-md border-slate-300 text-sm" %>
        </div>

        <div class="flex items-center gap-2">
          <label class="text-xs text-slate-600">Até</label>
          <%= f.date_field :to, value: params[:to], class: "rounded-md border-slate-300 text-sm" %>
        </div>

        <div class="flex items-center gap-2">
          <%= f.submit t(".filter", default: "Filtrar"),
                class: "rounded-md bg-emerald-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-emerald-700" %>

          <% if params[:sensor_id].present? || params[:field_id].present? || params[:from].present? || params[:to].present? %>
            <%= link_to t(".clear", default: "Limpar"),
                  dashboard_path,
                  class: "rounded-md border border-slate-300 px-3 py-1.5 text-sm text-slate-700 hover:bg-slate-50" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<% if readings.any? %>
  <div class="space-y-5">
    <% readings
         .group_by { |r| (r.measured_at || r.read_at || r.created_at).to_date }
         .sort_by { |d,_| d }
         .reverse_each do |_, items| %>

      <% ts = (items.first.measured_at || items.first.read_at || items.first.created_at) %>
      <div>
        <h3 class="mb-2 flex items-center gap-2 text-sm font-semibold text-slate-700">
          <span class="inline-block h-4 w-1.5 rounded bg-gradient-to-b from-emerald-400 via-sky-400 to-cyan-400"></span>
          <%= day_label.call(ts) %>
        </h3>

        <div class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-3">
          <% items.each do |r| %>
            <%= render "dashboard/activity_card", reading: r %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="rounded-xl border bg-white p-6 text-center">
    <p class="text-sm italic text-slate-500">
      <%= t(".empty", default: "Sem atividade recente para os filtros selecionados.") %>
    </p>
  </div>
<% end %>
