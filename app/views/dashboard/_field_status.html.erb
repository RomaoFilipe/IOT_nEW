<h3 class="text-md font-semibold text-gray-800 mb-3 flex items-center justify-between">
  <%= t("dashboard.field_status.title") %>
  <a href="#" class="text-sm text-blue-500 hover:underline font-medium"><%= t("dashboard.field_status.see_all") %></a>
</h3>

<% if @fields.any? %>
  <div
    x-data="{
      active: <%= @fields.first.id %>,
      fields: <%= raw @fields.map(&:id).to_json %>,
      index: 0,
      startRotation() {
        if (this.fields.length <= 1) return;
        setInterval(() => {
          this.index = (this.index + 1) % this.fields.length;
          this.active = this.fields[this.index];
        }, 6000);
      },
      openDetails(id) {
        const modal = document.getElementById(`viewDetailsModal-${id}`);
        if (modal) {
          modal.classList.remove('hidden');
        }
      }
    }"
    x-init="startRotation()"
    class="space-y-4"
  >
    <!-- Botões de seleção de campo -->
    <div class="flex flex-wrap gap-2 justify-start">
      <% @fields.each do |field| %>
        <button
          :class="active === <%= field.id %> ? 'bg-blue-100 text-blue-700 font-semibold' : 'bg-gray-100 text-gray-600 hover:text-gray-800'"
          @click="active = <%= field.id %>; index = fields.indexOf(<%= field.id %>)"
          class="px-3 py-1 text-xs rounded-lg transition"
        >
          <%= field.name %>
        </button>
      <% end %>
    </div>

    <!-- Cartão de estado do campo -->
    <div class="bg-white rounded-xl border shadow p-4 max-w-xl mx-auto min-h-auto space-y-4">
      <% @fields.each do |field| %>
        <div
          id="field-card-<%= field.id %>"
          x-show="active === <%= field.id %>"
          x-cloak
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0"
          x-transition:enter-end="opacity-100"
          x-transition:leave="transition ease-in duration-200"
          x-transition:leave-start="opacity-100"
          x-transition:leave-end="opacity-0"
          class="space-y-4"
        >
          <!-- Nome e cultura -->
          <div class="flex justify-between items-center flex-nowrap gap-2">
            <div>
              <p class="text-sm font-semibold text-blue-700"><%= field.name %></p>
              <p class="text-base text-gray-800 font-semibold"><%= field.field_type %></p>
              <p class="text-sm text-gray-500"><%= field.area %> ha</p>
            </div>
            <span class="<%= field.status == 'Ativo' ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %> text-xs font-medium px-3 py-1 rounded-full whitespace-nowrap">
              <%= field.status.presence || t("dashboard.field_status.unknown") %>
            </span>
          </div>

          <!-- Progresso de sensores -->
          <div class="space-y-2 text-sm text-gray-700">
            <div>
              <div class="flex justify-between">
                <span class="flex items-center gap-1"><%= t("dashboard.field_status.sensors_active") %></span>
                <span class="font-medium"><%= field.sensors.where(status: 'Active').count %></span>
              </div>
              <div class="w-full h-2 bg-gray-200 rounded-full">
                <div class="h-2 bg-blue-600 rounded-full transition-all" style="width: <%= [field.sensors.where(status: 'Active').count * 20, 100].min %>%"></div>
              </div>
            </div>
          </div>

          <!-- Dados diversos -->
          <div class="grid grid-cols-2 gap-4 text-sm text-gray-700">
            <div class="flex items-center gap-1">
              <%= t("dashboard.field_status.soil_type") %> <span><%= field.soil_type.presence || 'N/A' %></span>
            </div>
            <div class="flex items-center gap-1">
              <%= t("dashboard.field_status.last_irrigation") %> <span><%= field.irrigation_schedules.order(created_at: :desc).first&.created_at&.strftime('%d/%m/%Y') || t("dashboard.field_status.unknown") %></span>
            </div>
            <div class="flex items-center gap-1 col-span-2">
              <%= t("dashboard.field_status.coordinates") %> <span><%= field.latitude %>, <%= field.longitude %></span>
            </div>
          </div>

          <!-- Colheita e botão -->
          <div class="flex justify-between items-center pt-2 border-t mt-2 text-sm">
            <div>
              <p class="text-gray-500"><%= t("dashboard.field_status.harvest_prediction") %></p>
              <p class="font-semibold text-gray-800">30/08/2023</p>
            </div>
            <button @click="openDetails(<%= field.id %>)" class="text-sm px-4 py-1.5 rounded-md border border-gray-300 hover:bg-gray-100 transition">
              <%= t("dashboard.field_status.details") %>
            </button>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <% @fields.each do |field| %>
    <%= render partial: "fields/view_details", locals: { field: field } %>
  <% end %>
<% else %>
  <div class="p-4 bg-yellow-100 text-yellow-800 rounded-md">
    <%= t("dashboard.field_status.no_fields") %>
  </div>
<% end %>

<style>
  .max-w-xl.mx-auto {
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
  .min-h-auto {
    min-height: auto !important;
  }
  .space-y-4 {
    gap: 1rem !important;
  }
  .flex.justify-between.items-center.flex-nowrap.gap-2 {
    flex-wrap: nowrap !important;
    gap: 0.5rem !important;
  }
  @media (min-width: 640px) {
    .max-w-xl.mx-auto {
      max-width: 700px;
    }
  }
</style>
