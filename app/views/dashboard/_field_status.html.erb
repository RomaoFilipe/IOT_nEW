<h3 class="text-lg font-semibold text-gray-800 mb-4">🧭 Estado dos Campos</h3>

<% if @fields.any? %>
  <div 
    x-data="{
      active: <%= @fields.first.id %>,
      fields: <%= raw @fields.map(&:id).to_json %>,
      index: 0,
      startRotation() {
        if (this.fields.length <= 1) return;
        setInterval(() => {
          this.index = (this.index + 1) % this.fields.length;
          this.active = this.fields[this.index];
        }, 6000);
      }
    }"
    x-init="startRotation()"
    class="space-y-4"
  >
    <!-- Tabs dinâmicas -->
    <div class="flex flex-wrap gap-2 overflow-x-auto">
      <% @fields.each do |field| %>
        <button
          :class="active === <%= field.id %> ? 'bg-white shadow text-blue-600' : 'bg-gray-100 text-gray-700'"
          @click="active = <%= field.id %>; index = fields.indexOf(<%= field.id %>)"
          class="tab-button px-4 py-2 rounded-md text-sm font-medium transition border">
          <%= field.name %>
        </button>
      <% end %>
    </div>

    <!-- Conteúdo por campo -->
    <div class="relative h-[200px] overflow-hidden bg-gray-50 rounded-md p-4 shadow-inner">
      <% @fields.each do |field| %>
        <div 
          x-show="active === <%= field.id %>" 
          x-cloak
          x-transition.opacity.duration.500ms
          class="absolute inset-0 space-y-2"
        >
          <p><strong>🌿 Cultura:</strong> <%= field.field_type %></p>
          <p><strong>📐 Área:</strong> <%= field.area %> ha</p>
          <p><strong>💧 Última Irrigação:</strong>
            <%= field.irrigation_schedules.order(created_at: :desc).first&.created_at&.strftime('%d/%m/%Y') || 'Sem registo' %>
          </p>
          <p><strong>🧪 Qualidade do Solo:</strong> <%= field.soil_quality.presence || 'N/A' %></p>
          <p><strong>📡 Sensores Ativos:</strong> <%= field.sensors.where(status: 'Active').count %></p>
          <p><strong>🗺️ Coordenadas:</strong> <%= field.latitude %>, <%= field.longitude %></p>
          <p>
            <strong>🔘 Estado:</strong>
            <span class="<%= field.status == 'Ativo' ? 'text-green-600' : 'text-red-600' %>">
              <%= field.status.presence || 'Desconhecido' %>
            </span>
          </p>
        </div>
      <% end %>
    </div>
  </div>
<% else %>
  <div class="p-4 bg-yellow-100 text-yellow-800 rounded-md">
    🚨 Nenhum campo registado ainda. Por favor adicione um campo para visualizar o estado.
  </div>
<% end %>