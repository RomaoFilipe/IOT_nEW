<h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center gap-2">🧭 Estado dos Campos</h3>

<% if @fields.any? %>
  <div 
    x-data="{
      active: <%= @fields.first.id %>,
      fields: <%= raw @fields.map(&:id).to_json %>,
      index: 0,
      startRotation() {
        if (this.fields.length <= 1) return;
        setInterval(() => {
          this.index = (this.index + 1) % this.fields.length;
          this.active = this.fields[this.index];
        }, 6000);
      }
    }"
    x-init="startRotation()"
    class="space-y-6"
  >
    <!-- Tabs dos campos -->
    <div class="flex flex-wrap gap-2">
      <% @fields.each do |field| %>
        <button
          :class="active === <%= field.id %> ? 'bg-blue-100 text-blue-700 ring-2 ring-blue-400' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'"
          @click="active = <%= field.id %>; index = fields.indexOf(<%= field.id %>)"
          class="px-4 py-1 rounded-lg text-sm font-medium transition"
        >
          <%= field.name %>
        </button>
      <% end %>
    </div>

    <!-- Conteúdo por campo -->
    <div class="relative min-h-[220px] bg-white rounded-xl shadow p-5 border">
      <% @fields.each do |field| %>
        <div 
          x-show="active === <%= field.id %>" 
          x-cloak
          x-transition.opacity.duration.400ms
          class="space-y-2"
        >
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 text-sm text-gray-700">
            <div><strong>🌿 Cultura:</strong> <%= field.field_type %></div>
            <div><strong>📐 Área:</strong> <%= field.area %> ha</div>
            <div><strong>💧 Última Irrigação:</strong> <%= field.irrigation_schedules.order(created_at: :desc).first&.created_at&.strftime('%d/%m/%Y') || 'Sem registo' %></div>
            <div><strong>🧪 Solo:</strong> <%= field.soil_type.presence || 'N/A' %></div>
            <div><strong>📡 Sensores Ativos:</strong> <%= field.sensors.where(status: 'Active').count %></div>
            <div><strong>🗺️ Coordenadas:</strong> <%= field.latitude %>, <%= field.longitude %></div>
            <div class="col-span-2"><strong>🔘 Estado:</strong>
              <span class="<%= field.status == 'Ativo' ? 'text-green-600' : 'text-red-600' %>">
                <%= field.status.presence || 'Desconhecido' %>
              </span>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% else %>
  <div class="p-4 bg-yellow-100 text-yellow-800 rounded-md">
    🚨 Nenhum campo registado ainda. Por favor adicione um campo para visualizar o estado.
  </div>
<% end %>
