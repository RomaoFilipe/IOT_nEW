

<h3 class="text-base sm:text-lg font-semibold text-slate-800 mb-4 flex items-center justify-between">
  <span>🗺️ Estado dos Campos</span>
  <%= link_to "Ver todos", fields_path, class: "text-sm text-blue-600 hover:text-blue-700 hover:underline font-medium" %>
</h3>

<% if @fields.any? %>
  <div
    x-data="{
      ids: <%= raw @fields.map(&:id).to_json %>,
      index: 0,
      get activeId() { return this.ids[this.index] },
      timer: null,
      start() {
        if (this.ids.length <= 1 || this.timer) return;
        this.timer = setInterval(() => { this.index = (this.index + 1) % this.ids.length }, 6000);
      },
      stop() { if (this.timer) { clearInterval(this.timer); this.timer = null } },
      go(id) { const i = this.ids.indexOf(id); if (i >= 0) this.index = i; },
    }"
    x-init="start()"
    class="space-y-4"
  >
    <!-- Selector de campos -->
    <div class="flex gap-2 overflow-x-auto pb-1">
      <% @fields.each do |field| %>
        <button
          @click="go(<%= field.id %>); stop(); start();"
          :class="activeId === <%= field.id %>
                  ? 'bg-emerald-600 text-white'
                  : 'bg-slate-100 text-slate-700 hover:bg-slate-200'"
          class="px-3 py-1.5 rounded-full text-xs font-medium transition whitespace-nowrap border border-transparent"
          title="<%= field.name %>"
        >
          <%= field.name %>
        </button>
      <% end %>
    </div>

    <!-- Cartões -->
    <div class="relative">
      <% @fields.each do |field| %>
        <%# --- métricas por campo --- %>
        <% total      = field.sensors.count
           active     = field.sensors.where(status: 'Active').count
           pct_active = total.positive? ? ((active.to_f / total) * 100).round : 0
           avg_moist  = field.sensors.average(:moisture)&.round
           avg_temp   = field.sensors.average(:temperature)&.round(1)
           avg_batt   = field.sensors.average(:battery)&.round
           last_irrig = field.irrigation_schedules.order(created_at: :desc).limit(1).first&.created_at
           status_class = %w[ativo active].include?(field.status.to_s.downcase) ?
                           'bg-emerald-50 text-emerald-700 ring-1 ring-emerald-200' :
                           'bg-rose-50 text-rose-700 ring-1 ring-rose-200'
        %>

        <section
          x-show="activeId === <%= field.id %>"
          x-cloak
          @mouseenter="stop()" @mouseleave="start()"
          class="rounded-xl border border-slate-200 bg-white shadow-sm p-4 sm:p-5 space-y-4">
          <!-- Header -->
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="text-sm text-emerald-700 font-semibold truncate"><%= field.name %></p>
              <p class="text-base font-semibold text-slate-900 truncate"><%= field.field_type.to_s.humanize %></p>
              <p class="text-xs text-slate-500">Área: <%= field.area %> ha</p>
            </div>

            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium <%= status_class %>">
              <span class="text-[10px]">●</span>
              <%= field.status.presence || 'Desconhecido' %>
            </span>
          </div>

          <!-- Métricas -->
          <div class="grid sm:grid-cols-3 gap-3">
            <!-- Sensores ativos -->
            <div class="col-span-1">
              <div class="flex items-center justify-between text-xs text-slate-600">
                <span>📡 Sensores ativos</span>
                <span class="font-semibold text-slate-800"><%= active %>/<%= total %></span>
              </div>
              <div class="w-full h-2 bg-slate-200 rounded-full mt-1 overflow-hidden">
                <div class="h-2 bg-emerald-500 rounded-full transition-[width] duration-500" style="width:<%= pct_active %>%"></div>
              </div>
            </div>

            <!-- Humidade média -->
            <div class="col-span-1">
              <div class="flex items-center justify-between text-xs text-slate-600">
                <span>💧 Humidade média</span>
                <span class="font-semibold text-slate-800"><%= avg_moist || '—' %><%= avg_moist ? '%' : '' %></span>
              </div>
              <div class="w-full h-2 bg-slate-200 rounded-full mt-1 overflow-hidden">
                <div class="h-2 bg-sky-600 rounded-full transition-[width] duration-500" style="width:<%= (avg_moist || 0).clamp(0,100) %>%"></div>
              </div>
            </div>

            <!-- Bateria média -->
            <div class="col-span-1">
              <div class="flex items-center justify-between text-xs text-slate-600">
                <span>🔋 Bateria média</span>
                <span class="font-semibold text-slate-800"><%= avg_batt || '—' %><%= avg_batt ? '%' : '' %></span>
              </div>
              <div class="w-full h-2 bg-slate-200 rounded-full mt-1 overflow-hidden">
                <div class="h-2 bg-violet-500 rounded-full transition-[width] duration-500" style="width:<%= (avg_batt || 0).clamp(0,100) %>%"></div>
              </div>
            </div>
          </div>

          <!-- Linha inferior -->
          <div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-slate-100">
            <div class="text-xs text-slate-500 flex flex-wrap items-center gap-x-4 gap-y-1">
              <span>🗓️ Última irrigação: <%= last_irrig ? l(last_irrig, format: '%d/%m/%Y %H:%M') : 'Sem registo' %></span>
              <span>📍 <%= field.latitude %>, <%= field.longitude %></span>
              <% if avg_temp %><span>🌡️ <%= avg_temp %> °C</span><% end %>
            </div>

            <button
              type="button"
              @click="document.getElementById('viewDetailsModal-<%= field.id %>')?.classList.remove('hidden')"
              class="inline-flex items-center gap-2 text-sm px-3 py-1.5 rounded-md border border-slate-300 text-slate-700 hover:bg-slate-50 transition"
            >
              <i class="lucide lucide-eye w-4 h-4"></i> Detalhes
            </button>
          </div>
        </section>
      <% end %>
    </div>
  </div>

  <% @fields.each do |field| %>
    <%= render partial: "fields/view_details", locals: { field: field } %>
  <% end %>
<% else %>
  <div class="p-4 rounded-lg bg-amber-50 text-amber-800 border border-amber-200">
    🚨 Nenhum campo registado ainda. Adicione um campo para visualizar o estado.
  </div>
<% end %>
