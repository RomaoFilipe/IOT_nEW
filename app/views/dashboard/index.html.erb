<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Farm Operations Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">

    <!-- Container Principal -->
    <div class="max-w-7xl mx-auto p-6">
        
        <!-- Título -->
        <h1 class="text-2xl font-bold text-gray-900">Farm Operations Dashboard</h1>

        <!-- Painel Principal -->
        <div class="bg-white p-6 rounded-lg shadow-md mt-4">

            <!-- Cabeçalho -->
            <div class="flex justify-between items-center">
                <h2 class="text-xl font-semibold text-gray-800">Farm Dashboard</h2>
                <p class="text-green-600 text-sm flex items-center">
                    <span class="w-2 h-2 bg-green-600 rounded-full mr-2"></span> All systems operational
                </p>
            </div>

            <!-- Seções do Dashboard -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-6">

                <!-- Weather Conditions -->
                <div class="bg-gray-50 p-4 rounded-lg shadow-md md:col-span-2">
                    <h3 class="text-lg font-semibold flex items-center">
                        🌥 Weather Conditions
                    </h3>
                    <p class="text-3xl font-bold mt-2">24°C</p>
                    <p class="text-gray-500">Partly Cloudy</p>
                    <div class="flex space-x-4 mt-4 text-gray-600">
                        <p>🌤 Today 24°</p>
                        <p>🌥 Thu 26°</p>
                        <p>☁️ Fri 25°</p>
                        <p>🌦 Sat 23°</p>
                        <p>🌧 Sun 22°</p>
                    </div>
                </div>

                <!-- Sensor Overview -->
<div class="bg-white p-6 rounded-lg shadow-md">
    <h3 class="text-lg font-semibold text-gray-800">Sensor Overview</h3>
    <p class="text-gray-500 text-sm">Status of all active sensors</p>

    <!-- Soil Moisture -->
    <div class="mt-4">
        <div class="flex justify-between items-center">
            <div class="flex items-center space-x-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-600">
                    <path d="M7 16.3c2.2 0 4-1.83 4-4.05 0-1.16-.57-2.26-1.71-3.19S7.29 6.75 7 5.3c-.29 1.45-1.14 2.84-2.29 3.76S3 11.1 3 12.25c0 2.22 1.8 4.05 4 4.05z"/>
                    <path d="M12.56 6.6A10.97 10.97 0 0 0 14 3.02c.5 2.5 2 4.9 4 6.5s3 3.5 3 5.5a6.98 6.98 0 0 1-11.91 4.97"/>
                </svg>
                <p class="text-sm font-medium text-gray-600">Soil Moisture</p>
            </div>
            <span class="text-blue-600 text-sm font-medium">Good</span>
        </div>
        <div class="w-full bg-gray-200 rounded-full h-2 mt-1">
            <div class="bg-blue-600 h-2 rounded-full" style="width: 68%;"></div>
        </div>
        <div class="flex justify-between text-xs text-gray-500 mt-1">
            <span>0%</span> <span>68%</span> <span>100%</span>
        </div>
    </div>

    <!-- Temperature -->
    <div class="mt-4">
        <div class="flex justify-between items-center">
            <div class="flex items-center space-x-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-red-600">
                    <path d="M14 4v10.54a4 4 0 1 1-4 0V4a2 2 0 0 1 4 0Z"/>
                </svg>
                <p class="text-sm font-medium text-gray-600">Temperature</p>
            </div>
            <span class="text-red-600 text-sm font-medium">Poor</span>
        </div>
        <div class="w-full bg-gray-200 rounded-full h-2 mt-1">
            <div class="bg-red-600 h-2 rounded-full" style="width: 24%;"></div>
        </div>
        <div class="flex justify-between text-xs text-gray-500 mt-1">
            <span>0%</span> <span>24%</span> <span>100%</span>
        </div>
    </div>

    <!-- Connectivity -->
    <div class="mt-4">
        <div class="flex justify-between items-center">
            <div class="flex items-center space-x-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-600">
                    <path d="M12 20h.01"/><path d="M2 8.82a15 15 0 0 1 20 0"/><path d="M5 12.859a10 10 0 0 1 14 0"/><path d="M8.5 16.429a5 5 0 0 1 7 0"/>
                </svg>
                <p class="text-sm font-medium text-gray-600">Connectivity</p>
            </div>
            <span class="text-green-600 text-sm font-medium">Excellent</span>
        </div>
        <div class="w-full bg-gray-200 rounded-full h-2 mt-1">
            <div class="bg-green-600 h-2 rounded-full" style="width: 92%;"></div>
        </div>
        <div class="flex justify-between text-xs text-gray-500 mt-1">
            <span>0%</span> <span>92%</span> <span>100%</span>
        </div>
    </div>

    <!-- Link para ver todos os sensores -->
    <a href="#" class="text-blue-500 text-sm block mt-4">View all sensors</a>
</div>


<!-- Field Status -->
            <div class="bg-gray-50 p-4 rounded-lg shadow-md mt-6">
                <h3 class="text-lg font-semibold">Field Status</h3>

                <!-- Tabs para Seleção do Campo -->
                <div class="grid grid-cols-3 bg-gray-100 rounded-md p-1 mt-2">
                    <button class="tab-button px-4 py-2 text-sm font-medium rounded-md bg-white shadow" data-tab="north">North Field</button>
                    <button class="tab-button px-4 py-2 text-sm font-medium rounded-md" data-tab="south">South Field</button>
                    <button class="tab-button px-4 py-2 text-sm font-medium rounded-md" data-tab="east">East Field</button>
                </div>

                <!-- Informação do Campo -->
                <div class="mt-4">
                    <div class="tab-content" id="north">
                        <div class="flex justify-between items-center">
                            <p class="text-xl font-semibold text-gray-800">Corn</p>
                            <span class="text-xs font-semibold px-2 py-1 rounded-full bg-green-100 text-green-700">Good</span>
                        </div>
                        <div class="grid grid-cols-2 gap-4 mt-3">
                            <div>
                                <p class="text-xs text-gray-500">Area</p>
                                <p class="text-sm font-semibold">12.5 ha</p>
                            </div>
                            <div>
                                <p class="text-xs text-gray-500">Moisture Level</p>
                                <p class="text-sm font-semibold">72%</p>
                            </div>
                            <div>
                                <p class="text-xs text-gray-500">Planting Date</p>
                                <p class="text-sm font-semibold">15/04/2023</p>
                            </div>
                            <div>
                                <p class="text-xs text-gray-500">Expected Harvest</p>
                                <p class="text-sm font-semibold">30/08/2023</p>
                            </div>
                        </div>
                        <hr class="my-3">
                        <p class="text-xs text-gray-500">Last Irrigation</p>
                        <p class="text-sm font-semibold">10/07/2023</p>
                    </div>

                    <div class="tab-content hidden" id="south">
                        <div class="flex justify-between items-center">
                            <p class="text-xl font-semibold text-gray-800">Wheat</p>
                            <span class="text-xs font-semibold px-2 py-1 rounded-full bg-yellow-100 text-yellow-700">Medium</span>
                        </div>
                        <div class="grid grid-cols-2 gap-4 mt-3">
                            <div>
                                <p class="text-xs text-gray-500">Area</p>
                                <p class="text-sm font-semibold">20 ha</p>
                            </div>
                            <div>
                                <p class="text-xs text-gray-500">Moisture Level</p>
                                <p class="text-sm font-semibold">65%</p>
                            </div>
                            <div>
                                <p class="text-xs text-gray-500">Planting Date</p>
                                <p class="text-sm font-semibold">10/03/2023</p>
                            </div>
                            <div>
                                <p class="text-xs text-gray-500">Expected Harvest</p>
                                <p class="text-sm font-semibold">25/08/2023</p>
                            </div>
                        </div>
                        <hr class="my-3">
                        <p class="text-xs text-gray-500">Last Irrigation</p>
                        <p class="text-sm font-semibold">08/07/2023</p>
                    </div>

                    <div class="tab-content hidden" id="east">
                        <div class="flex justify-between items-center">
                            <p class="text-xl font-semibold text-gray-800">Soybeans</p>
                            <span class="text-xs font-semibold px-2 py-1 rounded-full bg-red-100 text-red-700">Poor</span>
                        </div>
                        <div class="grid grid-cols-2 gap-4 mt-3">
                            <div>
                                <p class="text-xs text-gray-500">Area</p>
                                <p class="text-sm font-semibold">15 ha</p>
                            </div>
                            <div>
                                <p class="text-xs text-gray-500">Moisture Level</p>
                                <p class="text-sm font-semibold">78%</p>
                            </div>
                            <div>
                                <p class="text-xs text-gray-500">Planting Date</p>
                                <p class="text-sm font-semibold">05/04/2023</p>
                            </div>
                            <div>
                                <p class="text-xs text-gray-500">Expected Harvest</p>
                                <p class="text-sm font-semibold">20/08/2023</p>
                            </div>
                        </div>
                        <hr class="my-3">
                        <p class="text-xs text-gray-500">Last Irrigation</p>
                        <p class="text-sm font-semibold">12/07/2023</p>
                    </div>
                </div>
            </div>
        
    
                <!-- Upcoming Tasks -->
                <div class="bg-gray-50 p-4 rounded-lg shadow-md md:col-span-2">
                    <h3 class="text-lg font-semibold">Upcoming Tasks</h3>
                    <ul class="mt-3 space-y-3">
                        <li class="bg-white p-3 rounded-md shadow flex justify-between">
                            <div>
                                <p class="font-medium">Irrigate South Field</p>
                                <p class="text-sm text-gray-500">15/07/2023 <span class="text-red-600 font-medium">High</span> - South Field</p>
                            </div>
                        </li>
                        <li class="bg-white p-3 rounded-md shadow flex justify-between">
                            <div>
                                <p class="font-medium">Apply Fertilizer</p>
                                <p class="text-sm text-gray-500">18/07/2023 <span class="text-yellow-600 font-medium">Medium</span> - North Field</p>
                            </div>
                        </li>
                        <li class="bg-white p-3 rounded-md shadow flex justify-between">
                            <div>
                                <p class="font-medium">Maintenance Check on Sensors</p>
                                <p class="text-sm text-gray-500">20/07/2023 <span class="text-green-600 font-medium">Low</span> - All Fields</p>
                            </div>
                        </li>
                        <li class="bg-white p-3 rounded-md shadow flex justify-between">
                            <div>
                                <p class="font-medium">Harvest Planning Meeting</p>
                                <p class="text-sm text-gray-500">25/07/2023 <span class="text-yellow-600 font-medium">Medium</span> - Office</p>
                            </div>
                        </li>
                    </ul>
                </div>

            </div>
        </div>
         <!-- Seção com Botões de Acesso Rápido -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-6">
            <div class="bg-white p-4 rounded-lg shadow-md text-center">
                <h3 class="text-lg font-semibold">View Analytics</h3>
                <p class="text-gray-500 text-sm mt-1">Access detailed charts and analytics for deeper insights.</p>
                <button class="mt-3 px-4 py-2 bg-green-700 text-white rounded-md">View Analytics</button>
            </div>
            <div class="bg-white p-4 rounded-lg shadow-md text-center">
                <h3 class="text-lg font-semibold">Manage Fields</h3>
                <p class="text-gray-500 text-sm mt-1">View and manage all your farm fields and operations.</p>
                <button class="mt-3 px-4 py-2 bg-green-700 text-white rounded-md">Manage Fields</button>
            </div>
            <div class="bg-white p-4 rounded-lg shadow-md text-center">
                <h3 class="text-lg font-semibold">Settings</h3>
                <p class="text-gray-500 text-sm mt-1">Configure your account and system preferences.</p>
                <button class="mt-3 px-4 py-2 bg-green-700 text-white rounded-md">Settings</button>
            </div>
        </div>
    </div>

    <script>
        document.querySelectorAll(".tab-button").forEach(button => {
            button.addEventListener("click", () => {
                document.querySelectorAll(".tab-button").forEach(btn => btn.classList.remove("bg-white", "shadow"));
                document.querySelectorAll(".tab-content").forEach(content => content.classList.add("hidden"));

                button.classList.add("bg-white", "shadow");
                document.getElementById(button.dataset.tab).classList.remove("hidden");
            });
        });
    </script>

</body>
</html>
