<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= t("dashboard.title", default: "Dashboard") %> · AgriloT Synergy</title>

  <!-- Tailwind -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: { brand: { 600: '#059669', 700: '#047857' } },
          boxShadow: {
            soft: '0 8px 30px rgba(4,120,87,.10)',
            ring:  '0 0 0 8px rgba(16,185,129,.08)'
          },
          backdropBlur: { xs: '2px' }
        }
      }
    }
  </script>

  <!-- Alpine (interações simples) -->
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

  <!-- Lucide Icons -->
  <script defer src="https://unpkg.com/lucide@latest"></script>
</head>

<body class="bg-gradient-to-b from-white via-emerald-50/30 to-white text-gray-800 antialiased selection:bg-emerald-200 selection:text-emerald-900">

<div class="mx-auto max-w-7xl px-4 py-6 space-y-6">

  <!-- Cabeçalho -->
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight text-emerald-900">
        <i data-lucide="layout-dashboard" class="inline h-6 w-6 text-emerald-700"></i>
        <%= t("dashboard.heading", default: "Farm Dashboard") %>
      </h1>
      <p class="text-gray-600 text-sm">
        <%= t("dashboard.subtitle", default: "Overview de operações, sensores e tarefas.") %>
      </p>
    </div>
    <div class="inline-flex items-center gap-2 rounded-full bg-white/70 backdrop-blur-xs px-3 py-1 text-emerald-700 shadow-soft ring-1 ring-emerald-100">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
      </span>
      <span class="text-xs font-semibold"><%= t("dashboard.system_ok", default: "Todos os sistemas operacionais") %></span>
    </div>
  </div>

  <% kpis = (@kpis || {}).with_indifferent_access %>

  <!-- KPIs -->
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">

    <!-- Campos -->
    <%= render "kpi_card",
      title:    t("dashboard.kpis.fields",   default: "Campos"),
      icon:     "map-pin",
      value:    kpis[:fields].to_i,
      subtitle: t("dashboard.kpis.total",    default: "Total") %>

    <!-- Sensores -->
    <div class="group rounded-2xl bg-white/70 ring-1 ring-gray-200 backdrop-blur-xs p-5 shadow-soft hover:shadow-lg transition">
      <div class="flex items-center justify-between">
        <span class="text-gray-600 text-sm font-medium"><%= t("dashboard.kpis.sensors", default: "Sensores") %></span>
        <i data-lucide="radar" class="h-5 w-5 text-emerald-700"></i>
      </div>
      <div class="mt-2 flex items-end justify-between">
        <p class="text-3xl font-extrabold text-emerald-900"><%= kpis[:sensors_total].to_i %></p>
        <span class="text-xs text-gray-500">
          <%= t("dashboard.kpis.online", default: "Online") %>:
          <span class="font-semibold text-emerald-700"><%= kpis[:sensors_online].to_i %></span>
        </span>
      </div>
    </div>

    <!-- Rega Hoje -->
    <%= render "kpi_card",
      title:    t("dashboard.kpis.irrigation", default: "Rega hoje"),
      icon:     "droplets",
      value:    kpis[:irrigations_today].to_i,
      subtitle: t("dashboard.kpis.scheduled", default: "Agendadas") %>

    <!-- Alertas -->
    <div class="group rounded-2xl bg-white/70 ring-1 ring-gray-200 backdrop-blur-xs p-5 shadow-soft hover:shadow-lg transition">
      <div class="flex items-center justify-between">
        <span class="text-gray-600 text-sm font-medium"><%= t("dashboard.kpis.alerts", default: "Alertas") %></span>
        <i data-lucide="bell-ring" class="h-5 w-5 text-emerald-700"></i>
      </div>
      <div class="mt-2 flex items-end justify-between">
        <% alerts_open = kpis[:alerts_open].to_i %>
        <p class="text-3xl font-extrabold <%= alerts_open > 0 ? 'text-red-600' : 'text-emerald-900' %>"><%= alerts_open %></p>
        <span class="text-xs text-gray-500"><%= t("dashboard.kpis.open", default: "Abertos") %></span>
      </div>
    </div>

  </div>

  <!-- Meteo + Estado de Irrigação -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

    <!-- Meteo -->
    <div class="relative overflow-hidden rounded-2xl bg-white ring-1 ring-gray-200 p-4 shadow-soft">
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
          <i data-lucide="cloud-sun" class="h-5 w-5 text-emerald-700"></i>
          <%= t("dashboard.weather.title", default: "Previsão Meteorológica") %>
        </h2>

        <% if Array(@fields).any? %>
          <div class="hidden sm:block">
            <label for="fieldSelect" class="sr-only"><%= t("dashboard.weather.select_field", default: "Selecionar campo") %></label>
            <select id="fieldSelect" class="text-sm rounded-lg border-gray-200 focus:ring-emerald-500 focus:border-emerald-500">
              <% @fields.each do |f| %>
                <option value="<%= f.id %>" data-lat="<%= f.try(:latitude) %>" data-lon="<%= f.try(:longitude) %>">
                  <%= f.name %>
                </option>
              <% end %>
            </select>
          </div>
        <% end %>
      </div>

      <%= render "dashboard/weather_forecast" %>
    </div>

    <!-- Irrigação -->
    <div class="relative overflow-hidden rounded-2xl bg-white ring-1 ring-gray-200 p-4 shadow-soft">
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
          <i data-lucide="activity" class="h-5 w-5 text-emerald-700"></i>
          <%= t("dashboard.irrigation.title", default: "Estado de Irrigação") %>
        </h2>
      </div>

      <div class="space-y-3 max-h-[28rem] overflow-y-auto pr-1">
        <% fields = Array(@fields) %>
        <% if fields.any? %>
          <% fields.each_with_index do |field, index| %>
            <% irrigation_sensor = field.sensors.find { |s| s.sensor_type.to_s == "irrigation" } %>
            <% next unless irrigation_sensor %>
            <div class="rounded-xl ring-1 ring-gray-200 p-3 bg-white/70 hover:shadow-md transition">
              <%= render partial: "dashboard/sensor_status",
                         locals:  { sensor: irrigation_sensor, field: field, index: index } %>
            </div>
          <% end %>

          <% if fields.none? { |f| f&.sensors&.any? { |s| s.sensor_type.to_s == "irrigation" } } %>
            <p class="text-sm text-gray-500"><%= t("dashboard.irrigation.empty", default: "Sem sensores de irrigação associados aos campos.") %></p>
          <% end %>
        <% else %>
          <p class="text-sm text-gray-500"><%= t("dashboard.fields.empty", default: "Sem campos associados à sua conta.") %></p>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Estado dos Campos + Tarefas -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

    <div class="overflow-hidden rounded-2xl bg-white ring-1 ring-gray-200 p-4 shadow-soft">
      <h2 class="text-lg font-semibold text-gray-900 flex items-center gap-2 mb-3">
        <i data-lucide="leaf" class="h-5 w-5 text-emerald-700"></i>
        <%= t("dashboard.fields.title", default: "Estado dos Campos") %>
      </h2>
      <%= render "dashboard/field_status" %>
    </div>

    <div class="overflow-hidden rounded-2xl bg-white ring-1 ring-gray-200 p-4 shadow-soft">
      <h2 class="text-lg font-semibold text-gray-900 flex items-center gap-2 mb-3">
        <i data-lucide="calendar-check" class="h-5 w-5 text-emerald-700"></i>
        <%= t("dashboard.tasks.title", default: "Próximas Tarefas") %>
      </h2>
      <%= render "dashboard/upcoming_tasks" %>
    </div>
  </div>

  <!-- Ações rápidas -->
  <div class="overflow-hidden rounded-2xl bg-white ring-1 ring-gray-200 p-4 shadow-soft">
    <h2 class="text-lg font-semibold text-gray-900 flex items-center gap-2 mb-3">
      <i data-lucide="zap" class="h-5 w-5 text-emerald-700"></i>
      <%= t("dashboard.actions.title", default: "Ações Rápidas") %>
    </h2>
    <%= render "dashboard/quick_actions" %>
  </div>

  <!-- Feed de atividade (opcional) -->
  <% if defined?(SensorReading) %>
    <% sensor_readings = SensorReading
      .joins(sensor: :field)
      .where(fields: { account_id: current_user.account_id })
      .order(created_at: :desc)
      .limit(10) %>

    <div class="overflow-hidden rounded-2xl bg-white ring-1 ring-gray-200 p-4 shadow-soft">
      <h2 class="text-lg font-semibold text-gray-900 flex items-center gap-2 mb-3">
        <i data-lucide="timeline" class="h-5 w-5 text-emerald-700"></i>
        <%= t("dashboard.activity.title", default: "Atividade Recente") %>
      </h2>

      <% if sensor_readings.any? %>
        <ul class="divide-y divide-gray-100">
          <% sensor_readings.each do |r| %>
            <li class="py-2 flex items-center justify-between">
              <div class="flex items-center gap-3">
                <i data-lucide="dot" class="h-4 w-4 text-emerald-600"></i>
                <div class="text-sm">
                  <span class="font-medium text-gray-800"><%= r.sensor&.name || r.sensor&.device_id || "Sensor" %></span>
                  <span class="text-gray-500">· <%= I18n.l(r.created_at, format: "%d/%m %H:%M") rescue r.created_at.strftime("%d/%m %H:%M") %></span>
                </div>
              </div>
              <div class="text-xs text-gray-600">
                <%= r.payload&.slice("temperature","moisture","ph","oxygen")&.map { |k,v| "#{k}: #{v}" }&.join(" · ") rescue nil %>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-gray-500"><%= t("dashboard.activity.empty", default: "Sem atividade recente.") %></p>
      <% end %>
    </div>
  <% end %>

</div>

<!-- Scripts -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    // Inicializar ícones
    if (window.lucide?.createIcons) { lucide.createIcons(); }

    // Meteo inicial
    const select = document.getElementById("fieldSelect");
    const opt = select?.selectedOptions?.[0];
    const lat = opt?.dataset?.lat, lon = opt?.dataset?.lon;

    if (lat && lon) { fetchWeatherForField(lat, lon); }
    select?.addEventListener("change", () => {
      const s = select.selectedOptions[0];
      const la = s?.dataset?.lat, lo = s?.dataset?.lon;
      if (la && lo) fetchWeatherForField(la, lo);
    });
  });

  async function fetchWeatherForField(lat, lon) {
    try {
      const url = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current_weather=true&hourly=temperature_2m,weathercode,precipitation,wind_speed_10m,wind_direction_10m&daily=temperature_2m_max,temperature_2m_min,weathercode&timezone=auto`;
      const res = await fetch(url);
      if (!res.ok) throw new Error("HTTP " + res.status);
      const data = await res.json();

      const $ = (id) => document.getElementById(id);
      const current = data.current_weather || {};

      $("current-temp")        && ( $("current-temp").textContent        = Number.isFinite(current.temperature) ? `${Math.round(current.temperature)}°C` : "—" );
      $("current-description") && ( $("current-description").textContent = weatherText(current.weathercode) );
      $("wind-info")           && ( $("wind-info").textContent           = (current.winddirection != null && current.windspeed != null) ? `${current.winddirection}° · ${current.windspeed} km/h` : "—" );

      // precipitação de hoje
      if ($("precip-info") && data.hourly?.time?.length) {
        const today = new Date().toISOString().slice(0,10);
        let sum = 0;
        data.hourly.time.forEach((t, i) => { if (t.startsWith(today)) sum += Number(data.hourly.precipitation?.[i] || 0); });
        $("precip-info").textContent = `${sum.toFixed(1)} mm`;
      }

      // 24 horas
      if ($("hourly-forecast") && data.hourly?.time?.length) {
        const c = $("hourly-forecast");
        c.innerHTML = "";
        const total = Math.min(24, data.hourly.time.length);
        for (let i = 0; i < total; i++) {
          const label = new Date(data.hourly.time[i]).toLocaleTimeString("<%= I18n.locale %>", { hour: '2-digit', minute: '2-digit' });
          c.insertAdjacentHTML("beforeend", `
            <div class="bg-blue-50 rounded p-1 shadow-sm min-w-[3.5rem] text-center">
              <p class="font-semibold text-[10px]">${label}</p>
              <p class="text-lg">${weatherIcon(data.hourly.weathercode?.[i])}</p>
              <p class="text-gray-700 text-xs">${Math.round(data.hourly.temperature_2m?.[i] ?? 0)}°C</p>
            </div>
          `);
        }
      }

      // Próximos dias
      if ($("daily-forecast") && data.daily?.time?.length) {
        const d = $("daily-forecast");
        d.innerHTML = "";
        for (let i = 0; i < data.daily.time.length; i++) {
          const dia = new Date(data.daily.time[i]).toLocaleDateString("<%= I18n.locale %>", { weekday: 'short' });
          const max = Math.round(data.daily.temperature_2m_max?.[i] ?? 0);
          const min = Math.round(data.daily.temperature_2m_min?.[i] ?? 0);
          const icon = weatherIcon(data.daily.weathercode?.[i]);
          d.insertAdjacentHTML("beforeend", `
            <div class="bg-white rounded p-2 shadow text-center min-w-[3.5rem]">
              <p class="font-bold text-[11px] uppercase">${dia}</p>
              <p class="text-xl">${icon}</p>
              <p class="text-[11px] text-gray-700">${max}° / ${min}°</p>
            </div>
          `);
        }
      }
    } catch (err) {
      console.error("Erro ao obter meteo:", err);
    }
  }

  function weatherIcon(code) {
    const map = {0:"☀️",1:"🌤",2:"⛅",3:"☁️",45:"🌫",48:"🌫",51:"🌦",53:"🌦",55:"🌧",61:"🌧",63:"🌧",65:"🌧",66:"❄️",67:"❄️",71:"❄️",73:"❄️",75:"❄️",95:"⛈",96:"⛈",99:"⛈"};
    return map[code] || "❓";
  }
  function weatherText(code) {
    const map = {
      0:"Céu limpo",1:"Poucas nuvens",2:"Nuvens dispersas",3:"Céu nublado",45:"Nevoeiro",48:"Nevoeiro com geada",
      51:"Chuviscos",53:"Chuviscos",55:"Chuviscos",61:"Chuva fraca",63:"Chuva",65:"Chuva forte",
      66:"Chuva gelada",67:"Chuva gelada forte",71:"Neve leve",73:"Neve",75:"Neve intensa",
      95:"Trovoada",96:"Trovoada com granizo",99:"Tempestade severa"
    };
    return map[code] || "—";
  }
</script>

</body>
</html>
