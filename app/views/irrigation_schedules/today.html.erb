<h2 class="text-lg font-bold mb-3">📅 Próximas Irrigações Hoje</h2>

<% if @schedules.any? %>
  <ul class="space-y-2">
    <% @schedules.each do |schedule| %>
      <li class="bg-green-100 px-4 py-2 rounded shadow-sm">
        <strong><%= format('%02d:%02d', schedule.hour, schedule.minute) %></strong>
        — <%= schedule.duration %>s · Sensor: <%= schedule.sensor.name %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="text-gray-600">Nenhuma irrigação agendada para o restante do dia.</p>
<% end %>
