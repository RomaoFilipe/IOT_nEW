<% id = local_assigns[:chart_id] || "chart_#{SecureRandom.hex(6)}" %>
<% labels = (@daily_air_temperature || {}).keys
   data   = (@daily_air_temperature || {}).values %>
<div class="bg-white rounded-2xl border border-gray-200 shadow p-4">
  <h3 class="text-sm font-semibold text-gray-700 mb-2">🌤️ Temperatura do Ar (média/hora)</h3>
  <canvas id="<%= id %>" data-chart="true" style="height:260px"></canvas>
</div>
<script>
  window["renderChart_<%= id %>"] = function() {
    const el = document.getElementById("<%= id %>"); if (!el) return;
    new Chart(el.getContext("2d"), {
      type: 'line',
      data: {
        labels: <%= raw(labels.to_a.to_json) %>,
        datasets: [{ label: "°C", data: <%= raw(data.to_a.to_json) %>, fill: false }]
      },
      options: { responsive: true, maintainAspectRatio: false }
    });
  };
  setTimeout(() => window["renderChart_<%= id %>"]?.(), 30);
</script>
