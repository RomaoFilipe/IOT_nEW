<%# fallback se não vier chart_id nos locals %>
<% chart_dom_id = local_assigns[:chart_id] || "chart_#{SecureRandom.hex(6)}" %>

<div class="bg-white rounded-2xl border border-gray-200 shadow p-4">
  <h3 class="text-sm font-semibold text-gray-700 mb-2">📈 Produção acumulada</h3>
  <canvas id="<%= chart_dom_id %>" data-chart="true" style="height:260px"></canvas>
</div>
<script>
  window["renderChart_<%= chart_dom_id %>"] = function() {
    const el = document.getElementById("<%= chart_dom_id %>");
    if (!el) return;
    const ctx = el.getContext("2d");
    new Chart(ctx, {
      type: 'line',
      data: {
        labels: <%= raw((@cumulative_production_by_month || {}).keys.to_a.to_json) %>,
        datasets: [{
          label: "Acumulado (t)",
          data: <%= raw((@cumulative_production_by_month || {}).values.to_a.to_json) %>,
          fill: false
        }]
      },
      options: { responsive: true, maintainAspectRatio: false }
    });
  };
  setTimeout(() => window["renderChart_<%= chart_dom_id %>"]?.(), 30);
</script>
