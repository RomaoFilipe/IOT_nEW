<div class="bg-white rounded-2xl border border-gray-200 shadow p-4">
  <h3 class="text-sm font-semibold text-gray-700 mb-2">💰 Rentabilidade por cultura (estimativa)</h3>
  <canvas id="<%= chart_id %>" data-chart="true" style="height:260px"></canvas>
</div>
<script>
  window["renderChart_<%= chart_id %>"] = function() {
    const el = document.getElementById("<%= chart_id %>");
    if (!el) return;
    const ctx = el.getContext("2d");
    new Chart(ctx, {
      type: 'bar',
      data: {
        labels: <%= raw((@profit_by_crop_type || {}).keys.to_a.to_json) %>,
        datasets: [{
          label: "Lucro (€)",
          data: <%= raw((@profit_by_crop_type || {}).values.to_a.to_json) %>
        }]
      },
      options: { responsive: true, maintainAspectRatio: false }
    });
  };
  setTimeout(() => window["renderChart_<%= chart_id %>"]?.(), 30);
</script>
