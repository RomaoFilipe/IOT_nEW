<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Farm Analytics</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="bg-gray-100 min-h-screen">


  <div class="max-w-7xl mx-auto px-4 py-6">
  <h1 class="text-2xl font-bold text-gray-800 mb-6">Farm Analytics</h1>

<!-- Filtros -->
  <div class="flex flex-wrap items-center gap-4 mb-6">
    <div>
      <label for="fieldFilter" class="text-sm font-medium text-gray-700">Campo:</label>
      <select id="fieldFilter" name="field_id" onchange="applyFieldFilter()" class="ml-2 border-gray-300 rounded-md px-2 py-1 text-sm">
        <% @fields.each do |field| %>
          <option value="<%= field.id %>" <%= 'selected' if params[:field_id].to_s == field.id.to_s %>>
            <%= field.name %>
          </option>
        <% end %>
      </select>
    </div>

    <div>
      <label for="dateFilter" class="text-sm font-medium text-gray-700">Data:</label>
      <input type="month" id="dateFilter" class="ml-2 border-gray-300 rounded-md px-2 py-1 text-sm" />
    </div>
  </div>

      <!-- Tabs -->
  <div class="flex space-x-2 mb-6 overflow-x-auto">
    <% tabs = { "overview" => "Overview", "yield" => "Crop Yield", "resources" => "Resource Allocation", "soil" => "Soil Conditions", "profit" => "Profitability" } %>
    <% tabs.each do |id, label| %>
      <button data-tabs-target="<%= id %>" data-action="click->tabs#switch"
              class="tab-btn px-4 py-2 rounded-md text-sm font-medium border border-gray-300 bg-white hover:bg-gray-100 transition">
        <%= label %>
      </button>
    <% end %>
  </div>
<div class="flex justify-end mb-6">
  <button onclick="toggleYieldForm()" class="bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700">
    + Adicionar Produção
  </button>
</div>
<div id="yieldFormModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 hidden">
  <div class="bg-white p-6 rounded-lg w-full max-w-xl shadow-xl relative">
    <button onclick="toggleYieldForm()" class="absolute top-2 right-3 text-gray-500 hover:text-gray-700 text-xl">&times;</button>
    <h3 class="text-xl font-semibold mb-4 text-gray-800">Registar Produção Agrícola</h3>

    <%= form_with url: crop_yields_path, method: :post, local: true do |f| %>
      <div class="mb-4">
        <label class="text-sm font-medium text-gray-700">Campo</label>
        <%= select_tag "crop_yield[field_id]", options_from_collection_for_select(@fields, :id, :name), class: "w-full mt-1 border-gray-300 rounded-md shadow-sm" %>
      </div>

      <div id="cropInputs" class="space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label class="text-sm font-medium text-gray-700">Cultura</label>
            <input type="text" name="crop_yield[crop_type][]" placeholder="Ex: Milho, Trigo" class="w-full rounded-md border-gray-300 shadow-sm mt-1"/>
          </div>
          <div>
            <label class="text-sm font-medium text-gray-700">Produção (ton)</label>
            <input type="number" name="crop_yield[amount][]" step="0.1" class="w-full rounded-md border-gray-300 shadow-sm mt-1"/>
          </div>
          <div>
            <label class="text-sm font-medium text-gray-700">Mês</label>
            <select name="crop_yield[month][]" class="w-full rounded-md border-gray-300 shadow-sm mt-1">
              <option value="">Selecionar</option>
              <% %w[Jan Fev Mar Abr Mai Jun Jul Ago Set Out Nov Dez].each do |mes| %>
                <option value="<%= mes %>"><%= mes %></option>
              <% end %>
            </select>
          </div>
        </div>
      </div>

      <div class="flex justify-between items-center mt-6">
        <button type="button" onclick="addCropInput()" class="text-sm text-blue-600 hover:underline">+ Adicionar Cultura</button>
        <%= f.submit "Guardar", class: "bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700" %>
      </div>
    <% end %>
  </div>
</div>
<!-- Conteúdo das tabs -->
  <div>
    <div data-tabs-content="overview">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <%= render partial: 'analytics/overview/crop_yield', locals: { chart_id: 'yieldChart_overview' } %>
        <%= render partial: 'analytics/overview/resource_allocation', locals: { chart_id: 'resourceChart_overview' } %>
        <%= render partial: 'analytics/overview/soil_conditions', locals: { chart_id: 'soilChart_overview' } %>
        <%= render partial: 'analytics/overview/profitability', locals: { chart_id: 'financialChart_overview' } %>
      </div>
    </div>

    <div data-tabs-content="yield" class="hidden">
      <%= render partial: 'analytics/overview/crop_yield', locals: { chart_id: 'yieldChart' } %>
    </div>
    <div data-tabs-content="resources" class="hidden">
      <%= render partial: 'analytics/overview/resource_allocation', locals: { chart_id: 'resourceChart' } %>
    </div>
    <div data-tabs-content="soil" class="hidden">
      <%= render partial: 'analytics/overview/soil_conditions', locals: { chart_id: 'soilChart' } %>
    </div>
    <div data-tabs-content="profit" class="hidden">
      <%= render partial: 'analytics/overview/profitability', locals: { chart_id: 'financialChart' } %>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const tabButtons = document.querySelectorAll("[data-tabs-target]")
    const tabContents = document.querySelectorAll("[data-tabs-content]")

    function switchTab(target) {
      tabContents.forEach(content => {
        content.classList.toggle("hidden", content.dataset.tabsContent !== target)
      })

      tabButtons.forEach(button => {
        const isActive = button.dataset.tabsTarget === target
        button.classList.toggle("bg-green-600", isActive)
        button.classList.toggle("text-white", isActive)
        button.classList.toggle("shadow", isActive)
        button.classList.toggle("bg-white", !isActive)
        button.classList.toggle("text-gray-700", !isActive)
      })

      // Redesenha os gráficos da tab atual após 100ms
      setTimeout(() => {
        document.querySelectorAll(`[data-tabs-content="${target}"] canvas`).forEach(canvas => {
          if (canvas.dataset.chart === "true") {
            const chartId = canvas.id
            const chartFn = window[`renderChart_${chartId}`]
            if (typeof chartFn === "function") chartFn()
          }
        })
      }, 100)
    }

    tabButtons.forEach(button => {
      button.addEventListener("click", () => switchTab(button.dataset.tabsTarget))
    })

    // Ativar tab inicial (ex: "overview")
    switchTab("overview")
  })

  function downloadChart(canvasId) {
    const canvas = document.getElementById(canvasId)
    const link = document.createElement("a")
    link.href = canvas.toDataURL("image/png")
    link.download = `${canvasId}.png`
    link.click()
  }

  function applyFieldFilter() {
    const fieldId = document.getElementById("fieldFilter").value;
    const baseUrl = window.location.pathname;
    const url = new URL(baseUrl, window.location.origin);
    if (fieldId) url.searchParams.append("field_id", fieldId);
    window.location.href = url.toString();
  }
  function toggleYieldForm() {
    document.getElementById('yieldFormModal').classList.toggle('hidden');
  }

  function addCropInput() {
    const container = document.getElementById("cropInputs");
    const html = `
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <input type="text" name="crop_yield[crop_type][]" placeholder="Cultura" class="w-full rounded-md border-gray-300 shadow-sm mt-1" />
        </div>
        <div>
          <input type="number" name="crop_yield[amount][]" step="0.1" class="w-full rounded-md border-gray-300 shadow-sm mt-1" />
        </div>
        <div>
          <select name="crop_yield[month][]" class="w-full rounded-md border-gray-300 shadow-sm mt-1">
            <option value="">Selecionar</option>
            ${["Jan","Fev","Mar","Abr","Mai","Jun","Jul","Ago","Set","Out","Nov","Dez"]
              .map(m => `<option value="${m}">${m}</option>`).join("")}
          </select>
        </div>
      </div>
    `;
    container.insertAdjacentHTML("beforeend", html);
  }
</script>

</body>
</html>
