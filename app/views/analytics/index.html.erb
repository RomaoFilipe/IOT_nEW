<!-- app/views/analytics/index.html.erb -->

<!-- ApexCharts (CDN) -->
<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>

<div x-data="analyticsAjax()" x-init="start()" class="space-y-6">

  <!-- Topbar -->
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-3">
      <h1 class="text-2xl font-bold text-gray-900">Analytics Dashboard</h1>
      <span class="text-xs text-gray-500">Última atualização: <span x-text="lastUpdate"></span></span>
      <span class="ml-2 inline-flex items-center rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700">
        Em tempo real
      </span>
    </div>

    <div class="flex items-center gap-2">
      <!-- Período: aqui só UI; os filtros “reais” são tratados pelo controller via params -->
      <select @change="setPeriod($event.target.value)"
              class="rounded-lg border-gray-300 text-sm px-3 py-2 focus:ring-emerald-500 focus:border-emerald-500">
        <option value="">Últimos 30 dias</option>
        <option value="7d">Últimos 7 dias</option>
        <option value="quarter">Trimestre</option>
        <option value="year">Ano</option>
      </select>

      <!-- Auto-refresh -->
      <button @click="toggleAuto()"
              :class="auto ? 'bg-emerald-600 text-white' : 'bg-white text-gray-700'"
              class="px-3 py-2 rounded-lg border text-sm">
        Auto-refresh
      </button>

      <!-- Export -->
      <div class="relative">
        <button @click="openExport = !openExport" class="px-3 py-2 rounded-lg border bg-white text-sm">Exportar</button>
        <div x-show="openExport" @click.outside="openExport=false"
             class="absolute right-0 mt-2 w-36 rounded-lg border bg-white shadow">
          <a :href="exportUrl('csv')" class="block px-3 py-2 text-sm hover:bg-gray-50">CSV</a>
          <a :href="exportUrl('pdf')" class="block px-3 py-2 text-sm hover:bg-gray-50">PDF</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Tabs por domínio -->
  <div class="flex items-center justify-between">
    <div class="bg-white border rounded-xl p-1 flex gap-1 shadow-sm">
      <%= link_to analytics_path(request.query_parameters.merge(production_kind: "agriculture")),
            class: "px-4 py-2 rounded-lg font-medium #{ @effective_kind=='agriculture' ? 'bg-emerald-600 text-white' : 'text-gray-700 hover:bg-gray-50' }" do %>
        🌾 Agricultura
      <% end %>
      <%= link_to analytics_path(request.query_parameters.merge(production_kind: "aquaculture_sea")),
            class: "px-4 py-2 rounded-lg font-medium #{ @effective_kind=='aquaculture_sea' ? 'bg-blue-600 text-white' : 'text-gray-700 hover:bg-gray-50' }" do %>
        🌊 Sea
      <% end %>
      <%= link_to analytics_path(request.query_parameters.merge(production_kind: "aquaculture_tank")),
            class: "px-4 py-2 rounded-lg font-medium #{ @effective_kind=='aquaculture_tank' ? 'bg-cyan-600 text-white' : 'text-gray-700 hover:bg-gray-50' }" do %>
        🐟 Tank
      <% end %>
    </div>

    <div class="text-sm text-gray-500">
      <% case @effective_kind
         when "agriculture" %>Vista: Agricultura
      <% when "aquaculture_sea" %>Vista: Zona Marítima
      <% else %>Vista: Tanque
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- Coluna principal -->
    <div class="lg:col-span-9 space-y-6">
      <!-- KPIs -->
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4">
        <%= render partial: "kpi_card", locals: {
          icon: "📦", title: (@effective_kind=='agriculture' ? "Produção Total" : "Captura Total"),
          value: "<span id='kpi-total'>—</span>".html_safe, badge: nil, badge_value: nil,
          color: (@effective_kind=='aquaculture_tank' ? "cyan" : @effective_kind=='aquaculture_sea' ? "blue" : "emerald")
        } %>

        <%= render partial: "kpi_card", locals: {
          icon: "⚡", title: "Eficiência",
          value: "<span id='kpi-eff'>—</span>".html_safe, badge: nil, badge_value: nil, color: "emerald"
        } %>

        <%= render partial: "kpi_card", locals: {
          icon: "💶", title: "Custos Operacionais",
          value: "<span id='kpi-costs'>—</span>".html_safe, badge: nil, badge_value: nil, color: "slate"
        } %>

        <%= render partial: "kpi_card", locals: {
          icon: "💧", title: "Qualidade da Água",
          value: "<span id='kpi-quality'>—</span>".html_safe, badge: nil, badge_value: nil, color: "indigo"
        } %>
      </div>

      <!-- Gráficos topo -->
      <div class="grid grid-cols-1 xl:grid-cols-2 gap-4">
        <div class="bg-white rounded-xl border shadow-sm p-4">
          <h3 class="font-semibold text-gray-800" id="title-line">
            <%= @effective_kind == "agriculture" ? "Produção ao Longo do Tempo" : "Métrica ao Longo do Tempo" %>
          </h3>
          <div id="chart-line" class="h-64"></div>
        </div>

        <div class="bg-white rounded-xl border shadow-sm p-4">
          <h3 class="font-semibold text-gray-800" id="title-bars">
            <%= @effective_kind == "agriculture" ? "Despesas por Categoria" : (@effective_kind=='aquaculture_sea' ? "Captura por Zona" : "Produção por Tanque") %>
          </h3>
          <div id="chart-bars" class="h-64"></div>
        </div>
      </div>

      <!-- Gráficos base -->
      <div class="grid grid-cols-1 xl:grid-cols-2 gap-4">
        <div class="bg-white rounded-xl border shadow-sm p-4">
          <h3 class="font-semibold text-gray-800" id="title-donut">
            <%= @effective_kind == "agriculture" ? "Distribuição de Despesas (sem irrigação)" : "Distribuição por Espécie" %>
          </h3>
          <div id="chart-donut" class="h-64"></div>
          <div id="chart-donut-legend" class="mt-3 text-xs text-gray-500"></div>
        </div>

        <div class="bg-white rounded-xl border shadow-sm p-4">
          <div class="flex items-center justify-between">
            <h3 class="font-semibold text-gray-800">Indicador de Performance</h3>
            <span class="text-xs rounded-full bg-emerald-50 text-emerald-700 px-2 py-0.5" x-text="gaugeBadge">—</span>
          </div>
          <div id="chart-gauge" class="h-64"></div>
          <p class="mt-2 text-center text-xl font-bold" id="gauge-val">—</p>
          <p class="text-center text-xs text-gray-500">Performance atual</p>
        </div>
      </div>
    </div>

    <!-- Sidebar AI Insights -->
    <aside class="lg:col-span-3">
      <div class="bg-white rounded-xl border shadow-sm p-4">
        <div class="flex items-center justify-between">
          <h3 class="font-semibold text-gray-800">AI Insights</h3>
          <button @click="fetchData()" class="text-sm px-2 py-1 rounded-lg border bg-white hover:bg-gray-50">Refresh</button>
        </div>
        <ul class="mt-3 space-y-3">
          <template x-for="it in insights" :key="it.title">
            <li class="p-3 rounded-lg border">
              <div class="flex items-center justify-between">
                <p class="text-sm font-medium text-gray-800" x-text="it.title"></p>
                <span class="text-[10px] px-2 py-0.5 rounded-full"
                      :class="badge(it.priority)"
                      x-text="it.priority"></span>
              </div>
              <p class="text-xs text-gray-600 mt-1" x-text="it.text"></p>
              <p class="text-[10px] text-gray-400 mt-1" x-text="`${it.confidence}% confiança`"></p>
            </li>
          </template>
        </ul>
        <button class="mt-4 w-full text-sm px-3 py-2 rounded-lg border bg-white hover:bg-gray-50">
          Ver Todos os Insights
        </button>
      </div>
    </aside>
  </div>
</div>

<script>
  function analyticsAjax(){
    return {
      // estado
      domain: '<%= @effective_kind %>',
      params: new URLSearchParams(<%= request.query_parameters.to_json.html_safe %>),
      auto: false, tmr: null, openExport: false,
      lastUpdate: '-', gaugeBadge: '—',
      insights: [
        { title: 'Otimização de Alimentação', priority: 'HIGH', confidence: 92, text: 'Reduzir ~8% sem perder crescimento.' },
        { title: 'Área/Zona Promissora',      priority: 'MEDIUM', confidence: 86, text: 'Condições apontam +20–25%.' },
        { title: 'Risco Sanitário',           priority: 'HIGH', confidence: 88, text: 'Planear prevenção e monitorização.' },
        { title: 'Eficiência Energética',     priority: 'LOW',  confidence: 76, text: 'Ajustes podem cortar ~15% consumo.' }
      ],

      start(){ this.fetchData(); },

      toggleAuto(){
        this.auto = !this.auto;
        if (this.tmr) { clearInterval(this.tmr); this.tmr = null; }
        if (this.auto) this.tmr = setInterval(() => this.fetchData(), 15000);
      },

      setPeriod(v){
        const url = new URL(window.location.href);
        if (v) url.searchParams.set('period', v); else url.searchParams.delete('period');
        window.location = url.toString(); // deixamos o controller decidir o range
      },

      exportUrl(fmt){
        const url = new URL(window.location.origin + '/analytics/export.' + fmt);
        this.params.forEach((v,k)=> url.searchParams.set(k,v));
        url.searchParams.set('production_kind', this.domain);
        return url.toString();
      },

      badge(p){
        return p === 'HIGH'   ? 'bg-rose-50 text-rose-700'
             : p === 'MEDIUM' ? 'bg-amber-50 text-amber-700'
                               : 'bg-slate-50 text-slate-700';
      },

      async fetchData(){
        // fixa o domínio atual
        this.params.set('production_kind', this.domain);
        const url = `/analytics/data.json?${this.params.toString()}`;

        const res = await fetch(url, { headers: { 'Accept':'application/json' }});
        if (!res.ok) return;
        const j = await res.json();

        // KPIs
        document.getElementById('kpi-total').innerText   = j.kpis.total ?? '—';
        document.getElementById('kpi-eff').innerText     = (j.kpis.efficiency_pct != null) ? `${j.kpis.efficiency_pct}%` : '—';
        document.getElementById('kpi-costs').innerText   = (j.kpis.costs_eur != null) ? new Intl.NumberFormat('pt-PT',{style:'currency',currency:'EUR'}).format(j.kpis.costs_eur) : '—';
        document.getElementById('kpi-quality').innerText = (j.kpis.water_quality_pct != null) ? `${j.kpis.water_quality_pct}%` : '—';

        // Titles dinâmicos (consoante o domínio)
        document.getElementById('title-line').innerText  =
          (j.domain === 'agriculture') ? 'Produção ao Longo do Tempo' : 'Métrica ao Longo do Tempo';
        document.getElementById('title-bars').innerText  =
          (j.domain === 'aquaculture_sea') ? 'Captura por Zona' : (j.domain === 'aquaculture_tank' ? 'Produção por Tanque' : 'Despesas por Categoria');
        document.getElementById('title-donut').innerText =
          (j.domain === 'agriculture') ? 'Distribuição de Despesas (sem irrigação)' : 'Distribuição por Espécie';

        this.lastUpdate = new Date(j.updated_at).toLocaleTimeString();

        // desenhar gráficos
        this.drawCharts(j);
      },

      clearChart(el){ if (el) el.innerHTML = ''; },

      drawCharts(j){
        // CLEAN containers (evita duplicações)
        this.clearChart(document.querySelector('#chart-line'));
        this.clearChart(document.querySelector('#chart-bars'));
        this.clearChart(document.querySelector('#chart-donut'));
        this.clearChart(document.querySelector('#chart-gauge'));

        // LINE
        new ApexCharts(document.querySelector('#chart-line'), {
          chart: { type: 'line', height: 260, toolbar: { show:false } },
          series: j.charts.line.series,
          xaxis: { categories: j.charts.line.categories },
          stroke: { width: 3, curve: 'smooth' },
          dataLabels: { enabled:false }
        }).render();

        // BARS
        new ApexCharts(document.querySelector('#chart-bars'), {
          chart: { type: 'bar', height: 260, toolbar: { show:false } },
          series: j.charts.bars.series,
          xaxis: { categories: j.charts.bars.categories },
          plotOptions: { bar: { borderRadius: 4, columnWidth: '45%' } },
          dataLabels: { enabled:false }
        }).render();

        // DONUT
        const donut = new ApexCharts(document.querySelector('#chart-donut'), {
          chart: { type: 'donut', height: 260 },
          labels: j.charts.donut.labels,
          series: j.charts.donut.data,
          legend: { show:false }
        });
        donut.render().then(()=>{
          const el = document.getElementById('chart-donut-legend');
          if (el) el.innerHTML = j.charts.donut.labels.map((l,i)=> `<span class="mr-3">${l}: <b>${(j.charts.donut.data[i]||0)}</b></span>`).join('');
        });

        // GAUGE
        const gv = j.charts.gauge.value ?? 0;
        const gval = Math.max(0, Math.min(100, gv));
        new ApexCharts(document.querySelector('#chart-gauge'), {
          chart: { type:'radialBar', height:260, toolbar:{show:false} },
          series: [gval],
          plotOptions:{ radialBar:{ hollow:{ size:'60%' }, dataLabels:{ show:false } } }
        }).render();
        document.getElementById('gauge-val').innerText = (j.charts.gauge.value == null) ? '—' : `${gval}%`;

        // Badge do gauge
        this.gaugeBadge = (gval >= 90) ? 'Excelente' : (gval >= 75 ? 'Bom' : 'Atenção');
      }
    }
  }
</script>
