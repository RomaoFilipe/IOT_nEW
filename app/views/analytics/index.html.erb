<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Farm Analytics</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="bg-gray-100 min-h-screen">
  <div class="max-w-7xl mx-auto px-4 py-6">

    <!-- Cabeçalho -->
    <div class="flex flex-col items-center gap-3 mb-6 text-center">
      <h1 class="text-4xl font-extrabold text-gray-900">📊 Analytics</h1>
      <span class="px-3 py-1 rounded-full text-sm border
        <%= {
          "agriculture"       => "bg-green-50 text-green-700 border-green-200",
          "aquaculture_sea"   => "bg-sky-50 text-sky-700 border-sky-200",
          "aquaculture_tank"  => "bg-indigo-50 text-indigo-700 border-indigo-200"
        }[@effective_kind] %>">
        <%= {
          "agriculture"       => "🌾 Agricultura",
          "aquaculture_sea"   => "🌊 Aquacultura (Mar)",
          "aquaculture_tank"  => "🚰 Aquacultura (Tanques)"
        }[@effective_kind] %>
      </span>
    </div>

    <!-- Filtros -->
    <div class="flex flex-wrap justify-center gap-4 mb-6">
      <!-- Campo -->
      <div class="flex items-center gap-2">
        <label class="text-sm font-medium text-gray-700">🌾 Campo:</label>
        <select id="fieldFilter" class="border-gray-300 rounded-md px-3 py-2 text-sm shadow">
          <option value="">Todos</option>
          <% @fields.each do |field| %>
            <option value="<%= field.id %>" <%= 'selected' if params[:field_id].to_s == field.id.to_s %>>
              <%= field.name %> (<%= field.production_kind %>)
            </option>
          <% end %>
        </select>
      </div>

      <!-- Tipo (se não filtrado por campo) -->
      <% unless params[:field_id].present? %>
        <div class="flex items-center gap-2">
          <label class="text-sm font-medium text-gray-700">Tipo:</label>
          <select id="kindFilter" class="border-gray-300 rounded-md px-3 py-2 text-sm shadow">
            <% [["agriculture","Agricultura"],["aquaculture_sea","Aquacultura Mar"],["aquaculture_tank","Aquacultura Tanques"]].each do |k,label| %>
              <option value="<%= k %>" <%= "selected" if @effective_kind == k %>><%= label %></option>
            <% end %>
          </select>
        </div>
      <% end %>

      <!-- Datas -->
      <div class="flex items-center gap-2">
        <label class="text-sm font-medium text-gray-700">📅 De:</label>
        <input type="date" id="startDate" value="<%= params[:start_date] %>" class="border-gray-300 rounded-md px-3 py-2 text-sm shadow">
        <label class="text-sm font-medium text-gray-700">até:</label>
        <input type="date" id="endDate" value="<%= params[:end_date] %>" class="border-gray-300 rounded-md px-3 py-2 text-sm shadow">
      </div>

      <!-- Botão -->
      <button onclick="applyFilter()" class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700">
        🔍 Aplicar
      </button>
    </div>

    <% ui = AnalyticsCatalog.config_for(@effective_kind) %>

    <!-- Tabs -->
    <div class="flex justify-center gap-2 mb-6 overflow-x-auto whitespace-nowrap">
      <% ui[:tabs].each do |id, label| %>
        <button data-tabs-target="<%= id %>"
                class="tab-btn px-5 py-2 rounded-lg text-sm font-medium border border-gray-300 bg-white hover:bg-green-100 transition">
          <%= label %>
        </button>
      <% end %>
    </div>

    <!-- Conteúdos -->
    <div>
      <% first_tab = ui[:tabs].keys.first %>
      <% ui[:charts].each do |tab_id, charts| %>
        <div data-tabs-content="<%= tab_id %>" class="<%= tab_id == first_tab ? "" : "hidden" %>">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <% charts.each do |cfg| %>
              <%= render partial: cfg[:partial], locals: { chart_id: cfg[:id] } %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const buttons  = document.querySelectorAll("[data-tabs-target]");
      const contents = document.querySelectorAll("[data-tabs-content]");

      function switchTab(target) {
        contents.forEach(c => c.classList.toggle("hidden", c.dataset.tabsContent !== target));
        buttons.forEach(b => {
          const active = b.dataset.tabsTarget === target;
          b.classList.toggle("bg-green-600", active);
          b.classList.toggle("text-white", active);
          b.classList.toggle("shadow", active);
          b.classList.toggle("bg-white", !active);
          b.classList.toggle("text-gray-700", !active);
        });
        // Renderizar gráficos do tab ativo
        setTimeout(() => {
          document.querySelectorAll(`[data-tabs-content="${target}"] canvas`).forEach(cv => {
            const fn = window[`renderChart_${cv.id}`];
            if (typeof fn === "function") fn();
          });
        }, 60);
      }

      buttons.forEach(b => b.addEventListener("click", () => switchTab(b.dataset.tabsTarget)));
      switchTab("<%= first_tab %>");
    });

    function applyFilter() {
      const params = new URLSearchParams(window.location.search);
      const fieldId   = document.getElementById("fieldFilter")?.value;
      const kind      = document.getElementById("kindFilter")?.value;
      const startDate = document.getElementById("startDate")?.value;
      const endDate   = document.getElementById("endDate")?.value;

      if (fieldId) params.set("field_id", fieldId); else params.delete("field_id");
      if (!fieldId && kind) params.set("production_kind", kind);
      if (startDate) params.set("start_date", startDate); else params.delete("start_date");
      if (endDate) params.set("end_date", endDate); else params.delete("end_date");

      window.location.search = params.toString();
    }
  </script>
</body>
</html>
