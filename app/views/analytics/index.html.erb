<!-- ApexCharts -->
<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>

<%# --------- Descobrir domínio atual (com fallback) --------- %>
<% dom = (respond_to?(:current_domain) ? current_domain : (current_user&.account&.production_kind || 'agriculture')) %>
<% agri = dom == 'agriculture' %>
<% aqua_tank = dom == 'aquaculture_tank' %>
<% aqua_sea  = dom == 'aquaculture_sea'  %>

<div id="analytics-root" data-domain="<%= dom %>" class="mx-auto max-w-[1400px] p-4 lg:p-6 space-y-6">
  <!-- Header -->
  <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-gradient-to-br from-white to-slate-50 dark:from-slate-900 dark:to-slate-950 p-5 shadow-sm">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div class="flex items-start gap-4">
        <div class="h-12 w-12 rounded-2xl bg-emerald-600/10 text-emerald-700 dark:text-emerald-300 flex items-center justify-center">
          <!-- leaf/water icon -->
          <% if agri %>
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
                d="M9 21c-4-2-6-6-6-10C3 6 7 3 12 3s9 3 9 8c0 4-2 8-6 10M9 21c0-5 3-8 6-10"/>
            </svg>
          <% else %>
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path stroke-width="1.8" d="M12 2C12 2 5 9 5 13a7 7 0 0014 0c0-4-7-11-7-11z"/>
            </svg>
          <% end %>
        </div>
        <div>
          <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100">Analytics</h1>
          <p class="text-sm text-slate-600 dark:text-slate-400">
            <% if agri %>Monitorização de Agricultura e Rega.
            <% elsif aqua_tank %>Monitorização de Aquacultura — Tanques.
            <% else %>Monitorização de Aquacultura — Mar.<% end %>
          </p>
          <p id="last-updated" class="text-xs text-slate-500 dark:text-slate-400 mt-1">A carregar…</p>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <a href="<%= url_for(controller: 'analytics', action: 'export', only_path: true, locale: I18n.locale) %>"
           class="inline-flex items-center gap-2 px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
              d="M12 3v12m0 0l-4-4m4 4l4-4M4 21h16"/>
          </svg>
          Exportar CSV
        </a>
      </div>
    </div>

    <!-- Toolbar sticky -->
    <div class="mt-4 sticky top-2 z-10">
      <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/80 backdrop-blur px-3 py-2 flex flex-wrap items-center gap-2">
        <!-- Período -->
        <div class="inline-flex overflow-hidden rounded-lg border border-slate-200 dark:border-slate-700">
          <button class="seg-btn active" data-period="7d">7d</button>
          <button class="seg-btn" data-period="30d">30d</button>
          <button class="seg-btn" data-period="quarter">Trim.</button>
          <button class="seg-btn" data-period="year">Ano</button>
        </div>

        <!-- Auto-refresh -->
        <label class="inline-flex items-center gap-2 px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700">
          <input id="auto-refresh" type="checkbox" class="rounded text-emerald-600 focus:ring-emerald-500">
          <span class="text-sm text-slate-700 dark:text-slate-300">Auto-refresh (30s)</span>
        </label>

        <!-- Atualizar -->
        <button id="refresh-btn" class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white shadow-sm">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
              d="M4 4v6h6M20 20v-6h-6M20 8a8 8 0 10-6.32 12.9"/>
          </svg>
          Atualizar
        </button>
      </div>
    </div>
  </div>

  <%# ==================== KPIs (apenas Agricultura) ==================== %>
  <% if agri %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="kpi">
        <div class="kpi-top">
          <div class="kpi-icon bg-emerald-600/10 text-emerald-700 dark:text-emerald-300">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path stroke-width="1.8" d="M12 2C12 2 5 9 5 13a7 7 0 0014 0c0-4-7-11-7-11z"/>
            </svg>
          </div>
          <span class="kpi-label">Média Solo</span>
          <span class="kpi-chip">%</span>
        </div>
        <div class="kpi-val" id="kpi-soil">—</div>
        <div class="kpi-trend" id="trend-soil"></div>
        <div id="spark-soil" class="spark"></div>
      </div>

      <div class="kpi">
        <div class="kpi-top">
          <div class="kpi-icon bg-amber-500/10 text-amber-600 dark:text-amber-300">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path stroke-width="1.8" d="M14 14.76V5a2 2 0 10-4 0v9.76a4 4 0 104 0z"/>
            </svg>
          </div>
          <span class="kpi-label">Temp. Ar</span>
          <span class="kpi-chip">°C</span>
        </div>
        <div class="kpi-val" id="kpi-airt">—</div>
        <div class="kpi-trend" id="trend-temp"></div>
        <div id="spark-temp" class="spark"></div>
      </div>

      <div class="kpi">
        <div class="kpi-top">
          <div class="kpi-icon bg-sky-500/10 text-sky-600 dark:text-sky-300">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path stroke-width="1.8" d="M12 2s7 7 7 11a7 7 0 11-14 0c0-4 7-11 7-11z"/>
            </svg>
          </div>
          <span class="kpi-label">Hum. Ar</span>
          <span class="kpi-chip">%</span>
        </div>
        <div class="kpi-val" id="kpi-airh">—</div>
        <div class="kpi-trend" id="trend-hum"></div>
        <div id="spark-hum" class="spark"></div>
      </div>

      <div class="kpi">
        <div class="kpi-top">
          <div class="kpi-icon bg-purple-500/10 text-purple-600 dark:text-purple-300">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path stroke-width="1.8" d="M12 21a9 9 0 100-18 9 9 0 000 18zm0-9l6-2"/>
            </svg>
          </div>
          <span class="kpi-label">Solo (Últ.)</span>
          <span class="kpi-chip">%</span>
        </div>
        <div class="kpi-val" id="gauge-last">—</div>
        <div class="kpi-trend" id="trend-lux"></div>
        <div id="spark-lux" class="spark"></div>
      </div>
    </div>
  <% end %>

  <%# ==================== Linha Agricultura ==================== %>
  <% if agri %>
    <div class="card">
      <div class="card-head">
        <h2 class="card-title">Agricultura — Tendências</h2>
        <div class="flex flex-wrap gap-2">
          <button class="chip" data-toggle-series="Humidade do Solo (%)">Solo</button>
          <button class="chip" data-toggle-series="Temperatura do Ar (°C)">Temp</button>
          <button class="chip" data-toggle-series="Humidade do Ar (%)">Hum</button>
          <button class="chip" data-toggle-series="Luz (lux)">Luz</button>
        </div>
      </div>
      <div id="chart-agri-line" class="h-[360px]"></div>
    </div>
  <% end %>

  <%# ==================== Aquacultura – Tanques ==================== %>
  <% if aqua_tank %>
    <div class="card">
      <div class="card-head">
        <h2 class="card-title">Aquacultura — Tanques</h2>
        <span id="aqua-tank-empty" class="text-sm text-slate-500 hidden">Sem dados.</span>
      </div>
      <div id="chart-aqua-tank" class="h-[360px]"></div>
    </div>
  <% end %>

  <%# ==================== Aquacultura – Mar ==================== %>
  <% if aqua_sea %>
    <div class="card">
      <div class="card-head">
        <h2 class="card-title">Aquacultura — Mar</h2>
        <span id="aqua-sea-empty" class="text-sm text-slate-500 hidden">Sem dados.</span>
      </div>
      <div id="chart-aqua-sea" class="h-[360px]"></div>
    </div>
  <% end %>

  <%# ==================== Barras Rega & Donut (apenas Agricultura) ==================== %>
  <% if agri %>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
      <div class="card">
        <div class="card-head">
          <h3 class="card-title">Minutos de Rega / Dia</h3>
        </div>
        <div id="chart-irrig-bars" class="h-[320px]"></div>
      </div>

      <div class="card">
        <div class="card-head">
          <h3 class="card-title">Solo Médio por Sensor</h3>
        </div>
        <div id="chart-donut" class="h-[320px]"></div>
      </div>
    </div>

    <!-- Próximas Regas -->
    <div class="card">
      <div class="card-head">
        <h3 class="card-title">Próximas Rega(s)</h3>
      </div>
      <ul id="upcoming-list" class="space-y-2">
        <li class="skeleton h-10 rounded-lg"></li>
        <li class="skeleton h-10 rounded-lg"></li>
        <li class="skeleton h-10 rounded-lg"></li>
      </ul>
    </div>
  <% end %>
</div>

<!-- Minimal styles utilitários -->
<style>
  .seg-btn{ padding:.5rem .75rem; font-size:.875rem; color:rgb(71,85,105); background:transparent }
  .seg-btn.active{ background:#059669; color:white }
  .kpi{ border:1px solid rgba(100,116,139,.2); border-radius:1rem; padding:1rem; background:linear-gradient(180deg,rgba(255,255,255,.9),rgba(248,250,252,.9)); box-shadow:0 1px 2px rgba(16,24,40,.05) }
  .dark .kpi{ background:linear-gradient(180deg,rgba(2,6,23,.9),rgba(15,23,42,.9)); border-color:rgba(51,65,85,.6) }
  .kpi-top{ display:grid; grid-template-columns:auto 1fr auto; align-items:center; gap:.5rem; margin-bottom:.25rem }
  .kpi-icon{ display:flex; align-items:center; justify-content:center; width:1.75rem; height:1.75rem; border-radius:.6rem }
  .kpi-label{ font-size:.875rem; color:rgb(71,85,105) }
  .dark .kpi-label{ color:rgb(148,163,184) }
  .kpi-chip{ font-size:.7rem; padding:.125rem .5rem; border-radius:999px; background:rgba(148,163,184,.15); color:rgb(71,85,105) }
  .dark .kpi-chip{ background:rgba(100,116,139,.25); color:rgb(203,213,225) }
  .kpi-val{ font-weight:700; font-size:1.75rem; color:rgb(15,23,42) }
  .dark .kpi-val{ color:white }
  .kpi-trend{ font-size:.75rem; color:rgb(71,85,105); margin-bottom:.25rem }
  .dark .kpi-trend{ color:rgb(148,163,184) }
  .spark{ height:44px }
  .card{ border:1px solid rgba(100,116,139,.2); border-radius:1rem; background:linear-gradient(180deg,rgba(255,255,255,.9),rgba(248,250,252,.9)); padding:1rem; box-shadow:0 1px 2px rgba(16,24,40,.05) }
  .dark .card{ background:linear-gradient(180deg,rgba(2,6,23,.9),rgba(15,23,42,.9)); border-color:rgba(51,65,85,.8) }
  .card-head{ display:flex; align-items:center; justify-content:space-between; margin-bottom:.5rem }
  .card-title{ font-weight:600; color:rgb(15,23,42) }
  .dark .card-title{ color:white }
  .chip{ font-size:.75rem; padding:.3rem .6rem; border-radius:999px; border:1px solid rgba(100,116,139,.35); color:rgb(71,85,105); background:transparent }
  .chip:hover{ background:rgba(15,23,42,.04) }
  .dark .chip{ color:rgb(203,213,225); border-color:rgba(51,65,85,.8) }
  .dark .chip:hover{ background:rgba(148,163,184,.12) }
  .skeleton{ animation:pulse 1.2s ease-in-out infinite; background:linear-gradient(90deg, rgba(148,163,184,.15), rgba(148,163,184,.25), rgba(148,163,184,.15)); background-size:200% 100% }
  @keyframes pulse{ 0%{background-position:200% 0} 100%{background-position:-200% 0} }
</style>

<script>
  // Endpoints robustos (independe do alias da rota)
  const DATA_URL = "<%= url_for(controller: 'analytics', action: 'data', only_path: true, locale: I18n.locale) %>";

  // Vars
  let agriLine = null, aquaTank = null, aquaSea = null, irrigBars = null, donut = null;
  let sparkSoil = null, sparkTemp = null, sparkHum = null, sparkLux = null;
  let timer = null;

  // Factories
  function makeLine(el, names){
    return new ApexCharts(document.querySelector(el), {
      chart: { type:'line', height: 360, toolbar:{ show:false }, animations:{ enabled:true } },
      series: names.map(n => ({ name:n, data:[] })),
      xaxis: { categories:[], labels:{ rotate:-30 } },
      stroke: { width:2, curve:'smooth' },
      markers:{ size:0 },
      grid:{ borderColor:'rgba(148,163,184,.3)' },
      tooltip:{ shared:true, intersect:false },
      noData:{ text:'Sem dados' }
    });
  }
  function makeBar(el){
    return new ApexCharts(document.querySelector(el), {
      chart:{ type:'bar', height:320, toolbar:{ show:false } },
      series:[{ name:'Minutos de rega', data:[] }],
      xaxis:{ categories:[], labels:{ rotate:-30 } },
      grid:{ borderColor:'rgba(148,163,184,.3)' },
      noData:{ text:'Sem dados' }
    });
  }
  function makeDonut(el){
    return new ApexCharts(document.querySelector(el), {
      chart:{ type:'donut', height:320 },
      labels:[], series:[],
      legend:{ position:'bottom' },
      noData:{ text:'Sem dados' }
    });
  }
  function makeSpark(el){
    return new ApexCharts(document.querySelector(el), {
      chart:{ type:'line', height:44, sparkline:{ enabled:true } },
      stroke:{ width:2, curve:'smooth' },
      series:[{ data:[] }],
      tooltip:{ enabled:false }
    });
  }

  // Init
  document.addEventListener('DOMContentLoaded', () => {
    // Que elementos existem (dependem do domínio)?
    const agriEl = document.querySelector('#chart-agri-line');
    const tankEl = document.querySelector('#chart-aqua-tank');
    const seaEl  = document.querySelector('#chart-aqua-sea');
    const barsEl = document.querySelector('#chart-irrig-bars');
    const dnutEl = document.querySelector('#chart-donut');

    if (agriEl) {
      agriLine = makeLine('#chart-agri-line', ['Humidade do Solo (%)','Temperatura do Ar (°C)','Humidade do Ar (%)','Luz (lux)']);
      agriLine.render();

      // KPIs & sparklines só em Agricultura
      sparkSoil = makeSpark('#spark-soil'); sparkSoil.render();
      sparkTemp = makeSpark('#spark-temp'); sparkTemp.render();
      sparkHum  = makeSpark('#spark-hum');  sparkHum.render();
      sparkLux  = makeSpark('#spark-lux');  sparkLux.render();
    }

    if (tankEl) { aquaTank = makeLine('#chart-aqua-tank', ['Temp. Água (°C)','pH','Salinidade (ppt)','Oxigénio (mg/L)']); aquaTank.render(); }
    if (seaEl)  { aquaSea  = makeLine('#chart-aqua-sea',  ['Temp. Mar (°C)','pH','Salinidade (ppt)','Oxigénio (mg/L)']);  aquaSea.render();  }
    if (barsEl) { irrigBars = makeBar('#chart-irrig-bars'); irrigBars.render(); }
    if (dnutEl) { donut     = makeDonut('#chart-donut');   donut.render(); }

    // Período
    document.querySelectorAll('.seg-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.seg-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        loadData();
      });
    });

    // Toggle séries de Agricultura (só se existir o gráfico)
    if (agriLine) {
      document.querySelectorAll('[data-toggle-series]').forEach(chip => {
        chip.addEventListener('click', () => {
          agriLine.toggleSeries(chip.dataset.toggleSeries);
          chip.classList.toggle('chip-active');
          chip.style.backgroundColor = chip.classList.contains('chip-active') ? 'rgba(16,185,129,.15)' : 'transparent';
          chip.style.borderColor     = chip.classList.contains('chip-active') ? 'rgba(16,185,129,.35)' : 'rgba(100,116,139,.35)';
        });
      });
    }

    // Botões
    document.getElementById('refresh-btn').addEventListener('click', loadData);
    const auto = document.getElementById('auto-refresh');
    auto.addEventListener('change', () => auto.checked ? startAuto() : stopAuto());

    // 1ª carga + auto on
    loadData(); auto.checked = true; startAuto();
  });

  function period(){ const a = document.querySelector('.seg-btn.active'); return a ? a.dataset.period : '7d'; }
  function startAuto(){ stopAuto(); timer = setInterval(loadData, 30000); }
  function stopAuto(){ if (timer){ clearInterval(timer); timer = null; } }

  async function loadData(){
    const url = `${DATA_URL}?period=${encodeURIComponent(period())}`;
    try{
      const res = await fetch(url, { headers:{ 'Accept':'application/json' } });
      const json = await res.json();
      if (json.error) throw new Error(json.error);

      // Atualizado
      const dt = new Date(json.updated_at);
      document.getElementById('last-updated').textContent = `Última atualização: ${dt.toLocaleString()}`;

      // ---------------- Agricultura ----------------
      if (agriLine && json.charts?.line) {
        // KPIs
        setText('kpi-soil',  json.kpis.avg_soil_pct, 2, '%');
        setText('kpi-airt',  json.kpis.avg_air_temp, 2, '°C');
        setText('kpi-airh',  json.kpis.avg_air_hum,  2, '%');
        setText('gauge-last',json.charts.gauge.value,2, '%');

        // Tendências / linha
        const line = json.charts.line || { categories: [], series: [] };
        agriLine.updateOptions({ xaxis:{ categories: line.categories || [] } });
        agriLine.updateSeries((line.series || []).map(s => ({ name:s.name, data:s.data || [] })));

        // Trends
        const agri = line.series || [];
        setTrend('trend-soil', agri[0]?.data);
        setTrend('trend-temp', agri[1]?.data);
        setTrend('trend-hum',  agri[2]?.data);
        setTrend('trend-lux',  agri[3]?.data);

        // Sparklines
        if (sparkSoil) sparkSoil.updateSeries([{ data: agri[0]?.data || [] }]);
        if (sparkTemp) sparkTemp.updateSeries([{ data: agri[1]?.data || [] }]);
        if (sparkHum)  sparkHum .updateSeries([{ data: agri[2]?.data || [] }]);
        if (sparkLux)  sparkLux .updateSeries([{ data: agri[3]?.data || [] }]);
      }

      if (irrigBars && json.charts?.bars) {
        irrigBars.updateOptions({ xaxis:{ categories: json.charts.bars.categories || [] } });
        irrigBars.updateSeries(json.charts.bars.series || []);
      }

      if (donut && json.charts?.donut) {
        donut.updateOptions({ labels: json.charts.donut.labels || [] });
        donut.updateSeries(json.charts.donut.data || []);
      }

      // ---------------- Aquacultura ----------------
      if (aquaTank) {
        const tank = json.charts?.aqua_tank || { categories: [], series: [] };
        document.getElementById('aqua-tank-empty')?.classList.toggle('hidden', (tank.categories || []).length > 0);
        aquaTank.updateOptions({ xaxis: { categories: tank.categories || [] } });
        aquaTank.updateSeries((tank.series || []).map(s => ({ name: s.name, data: s.data || [] })));
      }
      if (aquaSea) {
        const sea = json.charts?.aqua_sea || { categories: [], series: [] };
        document.getElementById('aqua-sea-empty')?.classList.toggle('hidden', (sea.categories || []).length > 0);
        aquaSea.updateOptions({ xaxis: { categories: sea.categories || [] } });
        aquaSea.updateSeries((sea.series || []).map(s => ({ name: s.name, data: s.data || [] })));
      }

      // Próximas regas (apenas Agricultura)
      if (document.getElementById('upcoming-list')) {
        renderUpcoming(json.irrigation?.upcoming || []);
      }
    } catch(e){ console.error(e); }
  }

  function renderUpcoming(items){
    const ul = document.getElementById('upcoming-list'); ul.innerHTML='';
    if (!items.length){
      const li = document.createElement('li');
      li.className='text-slate-500 dark:text-slate-400'; li.textContent='Sem agendamentos.'; ul.appendChild(li); return;
    }
    items.forEach(ir => {
      const li = document.createElement('li');
      li.className='flex items-center justify-between border border-slate-200 dark:border-slate-800 rounded-lg px-3 py-2';
      li.innerHTML = `<span class="text-sm text-slate-800 dark:text-slate-200">
        <strong>D${ir.day_of_week}</strong> · ${ir.time} — ${ir.duration} min
      </span>${ir.sensor_id ? `<span class="text-xs text-slate-500">Sensor #${ir.sensor_id}</span>` : ''}`;
      ul.appendChild(li);
    });
  }

  function setText(id, v, d, suf){
    const el = document.getElementById(id);
    if (!el) return;
    if (v === null || v === undefined || isNaN(v)) { el.textContent='—'; return; }
    el.textContent = `${Number(v).toFixed(d)}${suf}`;
  }

  function setTrend(id, arr){
    const el = document.getElementById(id); if (!el) return;
    if (!arr || arr.length < 2){ el.textContent=''; return; }
    const last = lastNumber(arr); const prev = lastNumber(arr, -2);
    if (last == null || prev == null){ el.textContent=''; return; }
    const diff = (last - prev).toFixed(2);
    const up = diff >= 0;
    el.innerHTML = `<span class="${up?'text-emerald-600':'text-rose-600'} inline-flex items-center gap-1">
      ${up ? '▲' : '▼'} ${Math.abs(diff)}
    </span>`;
  }

  function lastNumber(arr, idxOffset=-1){
    for (let i=arr.length+idxOffset; i>=0; i--){
      const n = Number(arr[i]); if (!isNaN(n)) return n;
    }
    return null;
  }
</script>
