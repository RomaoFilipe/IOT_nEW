<%# locals: icon:, title:, value:, sub: %>
<div class="card pad kpi">
  <div class="kpi-ic"><%= local_assigns[:icon] || "ℹ️" %></div>
  <div>
    <div class="kpi-val"><%= (local_assigns[:value].presence || "—") %></div>
    <div class="kpi-sub"><%= (local_assigns[:sub].presence || "") %></div>
  </div>
</div>
