<div class="bg-white p-4 rounded shadow">
  <div class="flex justify-between items-center mb-2">
    <h2 class="font-semibold">Humidade do Solo</h2>
    <div>
      <button onclick="toggleMoistureView('daily')" class="toggle-moisture bg-green-600 text-white px-3 py-1 rounded text-sm">Diário</button>
      <button onclick="toggleMoistureView('monthly')" class="toggle-moisture bg-gray-300 text-gray-800 px-3 py-1 rounded text-sm">Mensal</button>
    </div>
  </div>
  <canvas id="<%= chart_id %>" data-chart="true" class="h-64"></canvas>
</div>

<script>
  let moistureMode = 'daily'

  function toggleMoistureView(mode) {
    moistureMode = mode;

    document.querySelectorAll('.toggle-moisture').forEach(btn => {
      btn.classList.remove('bg-green-600', 'text-white')
      btn.classList.add('bg-gray-300', 'text-gray-800')
    });

    if (mode === 'daily') {
      document.querySelectorAll('.toggle-moisture')[0].classList.add('bg-green-600', 'text-white')
    } else {
      document.querySelectorAll('.toggle-moisture')[1].classList.add('bg-green-600', 'text-white')
    }

    renderChart_<%= chart_id %>();
  }

  function renderChart_<%= chart_id %>() {
    const ctx = document.getElementById("<%= chart_id %>").getContext("2d");

    if (window["chart_<%= chart_id %>"]) window["chart_<%= chart_id %>"].destroy();

    const dailyLabels = <%= raw @daily_moisture.keys.map(&:to_s).to_json %>;
    const dailyData = <%= raw @daily_moisture.values.map { |v| v.round(2) }.to_json %>;

    const monthlyLabels = <%= raw @monthly_moisture.keys.to_json %>;
    const monthlyData = <%= raw @monthly_moisture.values.map { |v| v.round(2) }.to_json %>;

    const data = {
      labels: (moistureMode === 'daily') ? dailyLabels : monthlyLabels,
      datasets: [{
        label: "Humidade (%)",
        data: (moistureMode === 'daily') ? dailyData : monthlyData,
        backgroundColor: "rgba(59, 130, 246, 0.6)",
        borderColor: "rgba(59, 130, 246, 1)",
        fill: true,
        tension: 0.4
      }]
    };

    window["chart_<%= chart_id %>"] = new Chart(ctx, {
      type: 'line',
      data: data,
      options: {
        responsive: true,
        plugins: {
          legend: { display: true, position: 'bottom' }
        },
        scales: {
          y: { beginAtZero: true, title: { display: true, text: '%' } }
        }
      }
    });
  }
</script>
