<div class="bg-white p-4 rounded shadow">
  <h2 class="font-semibold mb-2">🚨 Erros do Sensor (última leitura)</h2>
  <div class="relative h-64">
    <canvas id="<%= chart_id %>" data-chart="true" class="h-64 w-full"></canvas>
  </div>
</div>

<script>
  function renderChart_<%= chart_id %>() {
    const ctx = document.getElementById("<%= chart_id %>").getContext("2d");

    if (window["chart_<%= chart_id %>"]) window["chart_<%= chart_id %>"].destroy();

    const dataValue = <%= @latest_error_count || 0 %>;

    window["chart_<%= chart_id %>"] = new Chart(ctx, {
      type: 'bar',
      data: {
        labels: ['Erros'],
        datasets: [{
          label: 'Qtd. Erros',
          data: [dataValue],
          backgroundColor: "rgba(239, 68, 68, 0.6)", // vermelho
          borderColor: "rgba(239, 68, 68, 1)",
          borderWidth: 1
        }]
      },
      options: {
        indexAxis: 'y',
        responsive: true,
        plugins: {
          legend: { display: false }
        },
        scales: {
          x: {
            beginAtZero: true,
            title: {
              display: true,
              text: 'Erros'
            }
          }
        }
      }
    });
  }
</script>
