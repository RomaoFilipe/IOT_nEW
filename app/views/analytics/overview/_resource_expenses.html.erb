<div class="bg-white p-4 rounded shadow">
  <h2 class="font-semibold mb-2">💼 Gasto de Recursos Agrícolas</h2>
  <div class="relative h-64">
    <canvas id="<%= chart_id %>" data-chart="true" class="h-64 w-full"></canvas>
  </div>
</div>

<script>
<script>
  function renderChart_<%= chart_id %>() {
    const data = <%= raw (@non_irrigation_expenses || {}).values.to_json %>;
    const labels = <%= raw (@non_irrigation_expenses || {}).keys.map(&:capitalize).to_json %>;
    
    const ctx = document.getElementById("<%= chart_id %>").getContext("2d");

    if (window["chart_<%= chart_id %>"]) window["chart_<%= chart_id %>"].destroy();

    window["chart_<%= chart_id %>"] = new Chart(ctx, {
      type: "bar",
      data: {
        labels: labels,
        datasets: [{
          label: "Gastos (€)",
          data: data,
          backgroundColor: "#4ade80"
        }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: { display: false }
        }
      }
    });
  }
</script>
