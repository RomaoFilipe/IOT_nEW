<div class="bg-white p-6 rounded-lg shadow-md min-h-[320px] flex flex-col justify-between">
  <h2 class="font-semibold mb-2">🏞️ Comparação entre Campos</h2>
  <div class="relative h-64 flex-grow">
    <canvas id="<%= chart_id %>" data-chart="true" class="h-64 w-full"></canvas>
  </div>
</div>

<script>
  function renderChart_<%= chart_id %>() {
    const ctx = document.getElementById("<%= chart_id %>").getContext("2d");

    if (window["chart_<%= chart_id %>"]) window["chart_<%= chart_id %>"].destroy();

    const labels = <%= raw @field_comparison_data.map { |f| f[:field_name] }.to_json %>;

    const productionData = <%= raw @field_comparison_data.map { |f| f[:production] }.to_json %>;
    const expensesData = <%= raw @field_comparison_data.map { |f| f[:total_expenses] }.to_json %>;
    const irrigationData = <%= raw @field_comparison_data.map { |f| f[:irrigation_expenses] }.to_json %>;

    window["chart_<%= chart_id %>"] = new Chart(ctx, {
      type: 'bar',
      data: {
        labels: labels,
        datasets: [
          {
            label: 'Produção (ton)',
            data: productionData,
            backgroundColor: 'rgba(34, 197, 94, 0.7)' // verde
          },
          {
            label: 'Despesas (€)',
            data: expensesData,
            backgroundColor: 'rgba(239, 68, 68, 0.7)' // vermelho
          },
          {
            label: 'Gasto com Irrigação (€)',
            data: irrigationData,
            backgroundColor: 'rgba(59, 130, 246, 0.7)' // azul
          }
        ]
      },
      options: {
        responsive: true,
        plugins: {
          legend: { position: 'bottom' }
        },
        scales: {
          y: {
            beginAtZero: true
          }
        }
      }
    });
  }
</script>
