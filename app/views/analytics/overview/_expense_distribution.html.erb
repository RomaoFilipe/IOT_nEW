<div class="bg-white p-4 rounded shadow">
  <h2 class="font-semibold mb-2">Gastos por Categoria</h2>
  <div class="relative h-64">
    <canvas id="<%= chart_id %>" data-chart="true" class="h-64"></canvas>
  </div>
</div>

<script>
  function renderChart_<%= chart_id %>() {
    const ctx = document.getElementById("<%= chart_id %>").getContext("2d");
    if (window["chart_<%= chart_id %>"]) window["chart_<%= chart_id %>"].destroy();

    const labels = <%= raw @expense_distribution.keys.map(&:capitalize).to_json %>;
    const data = <%= raw @expense_distribution.values.to_json %>;

    window["chart_<%= chart_id %>"] = new Chart(ctx, {
      type: 'bar',
      data: {
        labels: labels,
        datasets: [{
          label: "Despesas (€)",
          data: data,
          backgroundColor: 'rgba(255, 99, 132, 0.7)',
          borderRadius: 4
        }]
      },
      options: {
        responsive: true,
        plugins: { legend: { display: false } }
      }
    });
  }
</script>
