
<div id="yieldChartContainer">
  <div class="bg-white p-4 rounded shadow">
    <h2 class="font-semibold mb-2">Produção por Cultura</h2>
    <div class="relative h-64">
      <canvas id="<%= chart_id %>" data-chart="true" class="h-64"></canvas>
    </div>
  </div>
</div>


<script>
  function renderChart_<%= chart_id %>() {
    const labels = <%= raw @crop_data[:labels].to_json %>;
    const datasets = <%= raw @crop_data[:datasets].to_json %>;
    console.log("LABELS:", labels)
    console.log("DATASETS:", datasets)

    const ctx = document.getElementById("<%= chart_id %>").getContext("2d");
    if (window["chart_<%= chart_id %>"]) window["chart_<%= chart_id %>"].destroy();

    window["chart_<%= chart_id %>"] = new Chart(ctx, {
      type: 'bar',
      data: { labels: labels, datasets: datasets },
      options: { responsive: true, plugins: { legend: { position: 'bottom' } } }
    });
  }
</script>
