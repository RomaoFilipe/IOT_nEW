<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= t("landing.title") %></title>

  <!-- Tailwind CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              50:  '#ecfdf5',
              100: '#d1fae5',
              200: '#a7f3d0',
              300: '#6ee7b7',
              400: '#34d399',
              500: '#10b981',
              600: '#059669',
              700: '#047857',
              800: '#065f46',
              900: '#064e3b'
            }
          },
          boxShadow: {
            'soft': '0 8px 30px rgba(2, 132, 199, .08)',
            'ring': '0 0 0 8px rgba(16,185,129,.08)'
          },
          backdropBlur: { xs: '2px' }
        }
      }
    }
  </script>

  <!-- Lucide Icons -->
  <script defer src="https://unpkg.com/lucide@latest"></script>

  <!-- OG / SEO básicos -->
  <meta name="description" content="<%= t('landing.hero.description') %>">
  <meta property="og:title" content="<%= t('landing.title') %>">
  <meta property="og:description" content="<%= t('landing.hero.description') %>">
  <meta property="og:type" content="website">
</head>

<body class="min-h-screen bg-gradient-to-b from-white via-emerald-50/30 to-white text-gray-800 antialiased selection:bg-emerald-200 selection:text-emerald-900">

  <main class="flex-grow">

    <!-- HERO -->
    <section class="relative overflow-hidden">
      <!-- background decor -->
      <div aria-hidden="true" class="pointer-events-none absolute inset-0">
        <div class="absolute -top-40 -right-32 h-96 w-96 rounded-full bg-emerald-200/40 blur-3xl"></div>
        <div class="absolute -bottom-40 -left-32 h-[28rem] w-[28rem] rounded-full bg-cyan-200/40 blur-3xl"></div>
        <svg class="absolute inset-0 opacity-[0.06]" viewBox="0 0 100 100" preserveAspectRatio="none">
          <defs>
            <pattern id="grid" width="10" height="10" patternUnits="userSpaceOnUse">
              <path d="M 10 0 L 0 0 0 10" fill="none" stroke="currentColor" stroke-width=".5"/>
            </pattern>
          </defs>
          <rect width="100" height="100" fill="url(#grid)" />
        </svg>
      </div>

      <div class="relative mx-auto max-w-7xl px-6 pt-24 pb-20 text-center">
        <div class="inline-flex items-center gap-2 rounded-full bg-white/60 backdrop-blur-xs px-3 py-1 text-emerald-700 shadow-soft ring-1 ring-emerald-100">
          <i data-lucide="sparkles" class="h-4 w-4"></i>
          <span class="text-xs font-medium"><%= t("landing.title") %></span>
        </div>

        <h1 class="mt-6 text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-emerald-900">
          <span class="bg-gradient-to-r from-emerald-700 via-emerald-600 to-cyan-600 bg-clip-text text-transparent">
            <%= t("landing.hero.title") %>
          </span>
        </h1>

        <p class="mx-auto mt-6 max-w-2xl text-lg text-gray-600">
          <%= t("landing.hero.description") %>
        </p>

<div class="mt-10 flex flex-wrap items-center justify-center gap-3">
  <% if user_signed_in? %>
    <%= link_to (t("landing.hero.cta.go_to_app", default: "Ir para a aplicação")),
                (defined?(fields_path) ? fields_path : root_path),
                class: "group inline-flex items-center gap-2 rounded-xl bg-emerald-700 px-6 py-3 font-semibold text-white shadow-lg shadow-emerald-700/10 hover:bg-emerald-800 focus:outline-none focus-visible:shadow-ring transition" do %>
      <i data-lucide="layout-dashboard" class="h-5 w-5 transition-transform group-hover:translate-x-0.5"></i>
      <span><%= t("landing.hero.cta.go_to_app", default: "Ir para a aplicação") %></span>
    <% end %>
  <% else %>
    <%= link_to new_user_registration_path, class: "group inline-flex items-center gap-2 rounded-xl bg-emerald-700 px-6 py-3 font-semibold text-white shadow-lg shadow-emerald-700/10 hover:bg-emerald-800 focus:outline-none focus-visible:shadow-ring transition" do %>
      <i data-lucide="rocket" class="h-5 w-5 transition-transform group-hover:translate-x-0.5"></i>
      <%= t("landing.hero.cta.get_started") %>
    <% end %>

    <%= link_to new_user_session_path, class: "inline-flex items-center gap-2 rounded-xl bg-white px-6 py-3 font-semibold text-emerald-900 ring-1 ring-emerald-200 hover:shadow-soft focus:outline-none" do %>
      <i data-lucide="play-circle" class="h-5 w-5"></i>
      <span><%= t("navbar.login") %></span>
    <% end %>
  <% end %>
</div>

        <!-- trust bar -->
        <div class="mx-auto mt-12 grid max-w-4xl grid-cols-2 gap-4 opacity-80 sm:grid-cols-4">
          <% (t("landing.trust_bar") || []).each do |label| %>
            <div class="rounded-lg bg-white/70 px-3 py-2 text-sm font-medium text-gray-700 ring-1 ring-gray-200 backdrop-blur-xs"><%= label %></div>
          <% end %>
        </div>
      </div>
    </section>

    <!-- TIPO DE EXPLORAÇÃO -->
    <section class="relative py-16">
      <div class="mx-auto max-w-7xl px-6 text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 tracking-tight">
          <%= t("landing.choose_type.title") %>
        </h2>
        <p class="mx-auto mt-3 max-w-2xl text-gray-600">
          <%= t("landing.choose_type.description", default: "") %>
        </p>

        <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <!-- Agricultura -->
          <button
            id="card-agriculture"
            data-exploration="agriculture"
            class="group relative overflow-hidden rounded-2xl bg-white p-6 text-left ring-1 ring-gray-200 transition hover:shadow-xl hover:shadow-emerald-600/10 focus:outline-none focus-visible:shadow-ring">
            <div class="absolute -right-8 -top-8 h-28 w-28 rounded-full bg-emerald-100"></div>
            <div class="relative flex items-center gap-3">
              <div class="grid h-12 w-12 place-items-center rounded-xl bg-emerald-600/10 text-emerald-700">
                <span class="text-2xl">🌾</span>
              </div>
              <div>
                <h3 class="text-lg font-semibold"><%= t("landing.choose_type.agriculture.title") %></h3>
                <p class="text-sm text-gray-600"><%= t("landing.choose_type.agriculture.description") %></p>
              </div>
            </div>
            <div class="mt-5 flex items-center gap-2 text-emerald-700 font-medium">
              <i data-lucide="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-1"></i>
              <span><%= t("landing.hero.cta.get_started") %></span>
            </div>
          </button>

          <!-- Mar -->
          <button
            id="card-aquaculture_sea"
            data-exploration="aquaculture_sea"
            class="group relative overflow-hidden rounded-2xl bg-white p-6 text-left ring-1 ring-gray-200 transition hover:shadow-xl hover:shadow-cyan-600/10 focus:outline-none focus-visible:shadow-ring">
            <div class="absolute -right-8 -top-8 h-28 w-28 rounded-full bg-cyan-100"></div>
            <div class="relative flex items-center gap-3">
              <div class="grid h-12 w-12 place-items-center rounded-xl bg-cyan-600/10 text-cyan-700">
                <span class="text-2xl">🌊</span>
              </div>
              <div>
                <h3 class="text-lg font-semibold"><%= t("landing.choose_type.sea.title") %></h3>
                <p class="text-sm text-gray-600"><%= t("landing.choose_type.sea.description") %></p>
              </div>
            </div>
            <div class="mt-5 flex items-center gap-2 text-cyan-700 font-medium">
              <i data-lucide="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-1"></i>
              <span><%= t("landing.hero.cta.get_started") %></span>
            </div>
          </button>

          <!-- Tanque -->
          <button
            id="card-aquaculture_tank"
            data-exploration="aquaculture_tank"
            class="group relative overflow-hidden rounded-2xl bg-white p-6 text-left ring-1 ring-gray-200 transition hover:shadow-xl hover:shadow-teal-600/10 focus:outline-none focus-visible:shadow-ring">
            <div class="absolute -right-8 -top-8 h-28 w-28 rounded-full bg-teal-100"></div>
            <div class="relative flex items-center gap-3">
              <div class="grid h-12 w-12 place-items-center rounded-xl bg-teal-600/10 text-teal-700">
                <span class="text-2xl">🐟</span>
              </div>
              <div>
                <h3 class="text-lg font-semibold"><%= t("landing.choose_type.tank.title") %></h3>
                <p class="text-sm text-gray-600"><%= t("landing.choose_type.tank.description") %></p>
              </div>
            </div>
            <div class="mt-5 flex items-center gap-2 text-teal-700 font-medium">
              <i data-lucide="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-1"></i>
              <span><%= t("landing.hero.cta.get_started") %></span>
            </div>
          </button>
        </div>
      </div>
    </section>

    <!-- COMO FUNCIONA -->
    <section class="relative bg-gradient-to-br from-emerald-50 to-white py-20">
      <div class="mx-auto max-w-7xl px-6 text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900"><%= t("landing.how_it_works.title") %></h2>
        <p class="mx-auto mt-3 max-w-2xl text-gray-600"><%= t("landing.how_it_works.description") %></p>

        <div id="howItWorksContent" class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <!-- preenchido por JS -->
        </div>
      </div>
    </section>

    <!-- HISTÓRIAS REAIS -->
    <section class="bg-white py-20">
      <div class="mx-auto max-w-7xl px-6 text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900"><%= t("landing.testimonials.title") %></h2>
        <p class="mx-auto mt-3 max-w-2xl text-gray-600"><%= t("landing.testimonials.subtitle") %></p>

        <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-3">
          <% [:marta, :tiago, :carlos].each do |person| %>
            <figure class="group relative overflow-hidden rounded-2xl bg-white p-6 text-left ring-1 ring-gray-200 transition hover:shadow-xl hover:shadow-emerald-600/10">
              <div class="flex items-start gap-4">
                <div class="h-12 w-12 shrink-0 rounded-full bg-gradient-to-br from-emerald-400 to-cyan-400 text-white grid place-items-center font-bold">
                  <%= t("landing.testimonials.#{person}.name")[0] %>
                </div>
                <div>
                  <blockquote class="text-sm text-gray-700 italic">
                    “<%= t("landing.testimonials.#{person}.quote") %>”
                  </blockquote>
                  <figcaption class="mt-4">
                    <div class="font-semibold text-gray-900"><%= t("landing.testimonials.#{person}.name") %></div>
                    <div class="text-xs text-gray-500"><%= t("landing.testimonials.#{person}.role") %></div>
                  </figcaption>
                </div>
              </div>
            </figure>
          <% end %>
        </div>
      </div>
    </section>

    <!-- COMPARATIVO ANTES/DEPOIS -->
    <section class="bg-gray-50 py-20">
      <div class="mx-auto max-w-7xl px-6">
        <div class="text-center">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3"><%= t("landing.comparison.title") %></h2>
          <p class="text-gray-600"><%= t("landing.comparison.subtitle") %></p>
        </div>

        <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2">
          <% [:before, :after].each do |phase| %>
            <div class="relative overflow-hidden rounded-2xl p-6 ring-1 ring-gray-200 <%= phase == :after ? 'bg-emerald-50' : 'bg-white' %>">
              <div class="mb-4 inline-flex items-center gap-2 rounded-full <%= phase == :after ? 'bg-emerald-100 text-emerald-800' : 'bg-gray-100 text-gray-700' %> px-3 py-1 text-sm font-medium">
                <span><%= t("landing.comparison.#{phase}.emoji") %></span>
                <span><%= t("landing.comparison.#{phase}.title") %></span>
              </div>
              <ul class="space-y-2 text-gray-700">
                <% (t("landing.comparison.#{phase}.items") || []).each do |item| %>
                  <li class="flex items-start gap-3">
                    <i data-lucide="<%= phase == :after ? 'check-circle-2' : 'minus' %>" class="h-5 w-5 <%= phase == :after ? 'text-emerald-600' : 'text-gray-400' %>"></i>
                    <span><%= item %></span>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>
        </div>
      </div>
    </section>

    <!-- TECNOLOGIAS -->
    <section class="bg-white py-20">
      <div class="mx-auto max-w-7xl px-6 text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900"><%= t("landing.technologies.title") %></h2>
        <p class="mx-auto mt-3 max-w-2xl text-gray-600"><%= t("landing.technologies.subtitle") %></p>

        <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-6">
          <% (t("landing.technologies.items") || []).each do |tech| %>
            <div class="rounded-xl bg-gray-50 px-4 py-3 text-sm font-medium text-gray-700 ring-1 ring-gray-200 hover:shadow-soft"><%= tech %></div>
          <% end %>
        </div>
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="relative overflow-hidden">
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-gradient-to-br from-emerald-700 via-emerald-600 to-cyan-600"></div>
      <div class="relative mx-auto max-w-7xl px-6 py-20 text-center text-white">
        <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight"><%= t("landing.cta_final.title") %></h2>
        <p class="mx-auto mt-3 max-w-2xl text-emerald-100"><%= t("landing.cta_final.subtitle") %></p>
        <div class="mt-8">
          <%= link_to new_user_registration_path, class: "inline-flex items-center gap-2 rounded-xl bg-white px-6 py-3 font-semibold text-emerald-800 shadow-lg hover:bg-gray-100 focus:outline-none" do %>
            <i data-lucide="leaf" class="h-5 w-5"></i>
            <%= t("landing.cta_final.button") %>
          <% end %>
        </div>
      </div>
    </section>

  </main>

  <!-- FOOTER -->
  <footer class="bg-white/70 backdrop-blur-xs border-t border-gray-200">
    <div class="mx-auto max-w-7xl px-6 py-12">
      <div class="grid grid-cols-1 gap-8 md:grid-cols-4 text-sm">
        <div>
          <div class="flex items-center gap-2 text-lg font-bold text-gray-900">
            <i data-lucide="cloud-cog" class="h-5 w-5 text-emerald-700"></i>
            AgriloT Synergy
          </div>
          <p class="mt-3 text-gray-600"><%= t("landing.footer.description") %></p>
        </div>

        <% ['platform', 'resources', 'company'].each do |section| %>
          <div>
            <h3 class="font-semibold uppercase tracking-wide text-gray-900"><%= t("landing.footer.sections.#{section}.title") %></h3>
            <ul class="mt-3 space-y-2">
              <% (t("landing.footer.sections.#{section}.links") || []).each do |item| %>
                <li><a href="#" class="text-gray-600 hover:text-emerald-700 transition"><%= item %></a></li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </div>

      <div class="mt-10 border-t pt-6 text-center text-xs text-gray-500">
        <%= t("landing.footer.copyright") %>
      </div>
    </div>
  </footer>

  <!-- SCRIPTS -->
  <script>
    // Lucide
    document.addEventListener("DOMContentLoaded", () => { lucide.createIcons(); });

    // Localized strings for "How it works"
    const L = <%= {
      how: {
        agriculture: {
          emoji: "🚜",
          title: t('landing.how_it_works.agriculture.step1.title'),
          desc:  t('landing.how_it_works.agriculture.step1.desc')
        },
        aquaculture_sea: {
          emoji: "🌊",
          title: t('landing.how_it_works.sea.step1.title'),
          desc:  t('landing.how_it_works.sea.step1.desc')
        },
        aquaculture_tank: {
          emoji: "🐟",
          title: t('landing.how_it_works.tank.step1.title'),
          desc:  t('landing.how_it_works.tank.step1.desc')
        },
        common: {
          step2: { emoji: "📊", title: t('landing.how_it_works.common.step2.title'), desc: t('landing.how_it_works.common.step2.desc') },
          step3: { emoji: "⚙️", title: t('landing.how_it_works.common.step3.title'), desc: t('landing.how_it_works.common.step3.desc') }
        }
      }
    }.to_json.html_safe %>;

    // “Como funciona” – conteúdo dinâmico + estados
    document.addEventListener("DOMContentLoaded", () => {
      const content = document.getElementById("howItWorksContent");
      const cards = {
        agriculture: document.getElementById("card-agriculture"),
        aquaculture_sea: document.getElementById("card-aquaculture_sea"),
        aquaculture_tank: document.getElementById("card-aquaculture_tank")
      };

      function cardHTML(emoji, title, desc) {
        return `
          <div class='rounded-2xl bg-white p-6 ring-1 ring-gray-200 shadow-soft'>
            <div class='text-emerald-600 text-3xl mb-4'>${emoji}</div>
            <h3 class='text-lg font-bold'>${title}</h3>
            <p class='text-sm text-gray-600 mt-2'>${desc}</p>
          </div>`;
      }

      function render(type) {
        Object.values(cards).forEach(el => el.classList.remove("ring-2", "ring-emerald-400", "shadow-ring"));
        const active =
          type === "agriculture" ? cards.agriculture :
          type === "aquaculture_sea" ? cards.aquaculture_sea :
          cards.aquaculture_tank;

        active.classList.add("ring-2", "ring-emerald-400", "shadow-ring");

        const domain = L.how[type];
        content.innerHTML =
          cardHTML(domain.emoji, domain.title, domain.desc) +
          cardHTML(L.how.common.step2.emoji, L.how.common.step2.title, L.how.common.step2.desc) +
          cardHTML(L.how.common.step3.emoji, L.how.common.step3.title, L.how.common.step3.desc);
      }

      Object.values(cards).forEach(el => el.addEventListener("click", () => render(el.dataset.exploration)));
      render("agriculture");
    });
  </script>
</body>
</html>
