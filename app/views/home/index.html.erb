<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('landing.title') %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50">

  <!-- Hero Section -->
  <div class="relative w-full h-screen bg-gradient-to-b from-white to-gray-100 flex flex-col items-center justify-center text-center px-6">
    <h1 class="text-5xl font-bold text-gray-900 leading-tight">
      <span class="text-green-700"><%= t('landing.hero.highlight') %></span> <%= t('landing.hero.title') %>
    </h1>
    <p class="text-lg text-gray-600 mt-4 max-w-2xl">
      <%= t('landing.hero.description') %>
    </p>
    <div class="mt-6 flex space-x-4">
      <a href="#" class="px-6 py-3 bg-green-700 text-white rounded-md font-medium flex items-center space-x-2 hover:bg-green-800 transition">
        <span><%= t('landing.hero.get_started') %></span>
        <span>&rarr;</span>
      </a>
      <a href="#" class="px-6 py-3 border border-gray-400 text-gray-700 rounded-md font-medium hover:bg-gray-100 transition">
        <%= t('landing.hero.request_demo') %>
      </a>
    </div>
  </div>

  <!-- Features Section -->
  <section class="bg-white py-20 text-center">
    <h2 class="text-3xl font-bold text-gray-900"><%= t('landing.features.title') %></h2>
    <p class="text-lg text-gray-600 mt-4 max-w-3xl mx-auto">
      <%= t('landing.features.description') %>
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-8 max-w-6xl mx-auto">

      <% features = [
        { icon: "M14 4v10.54a4 4 0 1 1-4 0V4a2 2 0 0 1 4 0Z", title: 'environment.title', desc: 'environment.desc' },
        { icon: "M7 16.3c2.2 0 4-1.83...", title: 'irrigation.title', desc: 'irrigation.desc' },
        { icon: "M3 3v16a2 2 0 0 0 2 2h16...", title: 'yield.title', desc: 'yield.desc' },
        { icon: "M12 20h.01 M2 8.82a15...", title: 'connectivity.title', desc: 'connectivity.desc' },
        { icon: "circle cx='12' cy='17' r='3'...", title: 'insights.title', desc: 'insights.desc' },
        { icon: "rect width='14' height='20'...", title: 'mobile.title', desc: 'mobile.desc' }
      ] %>

      <% features.each do |feature| %>
        <div class="bg-white shadow-md rounded-lg p-6 text-left">
          <div class="bg-gray-100 p-3 rounded-md inline-block">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                 stroke-linejoin="round" class="text-green-600">
              <%= raw feature[:icon] %>
            </svg>
          </div>
          <h3 class="text-lg font-bold mt-4"><%= t("landing.features.#{feature[:title]}") %></h3>
          <p class="text-gray-600 mt-2"><%= t("landing.features.#{feature[:desc]}") %></p>
        </div>
      <% end %>
    </div>
  </section>

  <!-- How It Works -->
  <section class="bg-gray-100 py-20 text-center">
    <h2 class="text-3xl font-bold text-gray-900"><%= t('landing.how.title') %></h2>
    <p class="text-lg text-gray-600 mt-4 max-w-3xl mx-auto"><%= t('landing.how.description') %></p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mt-8 max-w-6xl mx-auto">
      <% steps = ['deploy', 'connect', 'analyze', 'implement'] %>
      <% icons = ['🌱', '☁️', '📊', '⚡'] %>
      <% steps.each_with_index do |step, i| %>
        <div class="bg-white shadow-md rounded-lg p-6 text-center">
          <div class="bg-green-700 p-4 rounded-full inline-block text-white"><%= icons[i] %></div>
          <h3 class="text-lg font-bold mt-4"><%= t("landing.how.steps.#{step}.title") %></h3>
          <p class="text-gray-600 mt-2"><%= t("landing.how.steps.#{step}.desc") %></p>
        </div>
      <% end %>
    </div>

    <!-- Stats -->
    <div class="text-center mt-12">
      <p class="text-lg text-gray-700"><%= t('landing.how.join') %></p>
      <div class="flex justify-center gap-16 mt-6">
        <div>
          <p class="text-4xl font-bold text-green-700">95%</p>
          <p class="text-gray-600"><%= t('landing.how.stats.water') %></p>
        </div>
        <div>
          <p class="text-4xl font-bold text-green-500">30%</p>
          <p class="text-gray-600"><%= t('landing.how.stats.yield') %></p>
        </div>
        <div>
          <p class="text-4xl font-bold text-blue-600">40%</p>
          <p class="text-gray-600"><%= t('landing.how.stats.labor') %></p>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-white py-10 mt-20 border-t border-gray-200">
    <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-4 gap-8 text-gray-700">

      <div>
        <div class="flex items-center space-x-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="lucide lucide-cloud-cog text-gray-700" width="24" height="24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="17" r="3"/>
            <path d="M4.2 15.1A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.2"/>
            <path d="m15.7 18.4-.9-.3"/>
            <path d="m9.2 15.9-.9-.3"/>
            <path d="m10.6 20.7.3-.9"/>
            <path d="m13.1 14.2.3-.9"/>
            <path d="m13.6 20.7-.4-1"/>
            <path d="m10.8 14.3-.4-1"/>
            <path d="m8.3 18.6 1-.4"/>
            <path d="m14.7 15.8 1-.4"/>
          </svg>
          <span class="text-lg font-bold text-gray-900">AgriloT Synergy</span>
        </div>
        <p class="text-sm text-gray-600 mt-3">
          <%= t('landing.footer.description') %>
        </p>
      </div>

<% sections = ['platform', 'resources', 'company'] %>
<% sections.each do |section| %>
  <div>
    <h3 class="text-sm font-bold text-gray-900 uppercase"><%= t("landing.footer.sections.#{section}.title") %></h3>
    <ul class="mt-3 space-y-2 text-sm">
      <% t("landing.footer.sections.#{section}.links").each do |item| %>
        <li><a href="#" class="hover:text-green-600 transition"><%= item %></a></li>
      <% end %>
    </ul>
  </div>
<% end %>
    </div>

    <div class="border-t border-gray-200 mt-8 pt-6 text-center text-sm text-gray-600">
      <p>© 2025 AgriloT Synergy. <%= t('landing.footer.rights') %></p>
    </div>
  </footer>

</body>
</html>
