<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= t("landing.title") %></title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50">
    <!-- Hero Section -->
    <div class="relative w-full h-screen bg-gradient-to-b from-white to-gray-100 flex flex-col items-center justify-center text-center px-6">
        <h1 class="text-5xl font-bold text-gray-900 leading-tight">
            <span class="text-green-700"><%= t("landing.hero.highlight") %></span> <%= t("landing.hero.continuation") %>
        </h1>
        <p class="text-lg text-gray-600 mt-4 max-w-2xl">
            <%= t("landing.hero.description") %>
        </p>
        <div class="mt-6 flex space-x-4">
            <a href="#" class="px-6 py-3 bg-green-700 text-white rounded-md font-medium flex items-center space-x-2 hover:bg-green-800 transition">
                <span><%= t("landing.hero.cta.get_started") %></span>
                <span>&rarr;</span>
            </a>
            <a href="#" class="px-6 py-3 border border-gray-400 text-gray-700 rounded-md font-medium hover:bg-gray-100 transition">
                <%= t("landing.hero.cta.request_demo") %>
            </a>
        </div>
    </div>

    <!-- How It Works Section -->
    <section class="bg-gray-100 py-20 text-center">
        <h2 class="text-3xl font-bold text-gray-900"><%= t("landing.how_it_works.title") %></h2>
        <p class="text-lg text-gray-600 mt-4 max-w-3xl mx-auto">
            <%= t("landing.how_it_works.description") %>
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mt-8 max-w-6xl mx-auto">
            <% ['deploy', 'connect', 'analyze', 'implement'].each do |step| %>
                <div class="bg-white shadow-md rounded-lg p-6 text-center">
                    <div class="bg-green-700 p-4 rounded-full inline-block text-white">
                        <%= t("landing.how_it_works.items.\#{step}.icon") %>
                    </div>
                    <h3 class="text-lg font-bold mt-4"><%= t("landing.how_it_works.items.\#{step}.title") %></h3>
                    <p class="text-gray-600 mt-2"><%= t("landing.how_it_works.items.\#{step}.desc") %></p>
                </div>
            <% end %>
        </div>

        <!-- Estatísticas -->
        <div class="text-center mt-12">
            <p class="text-lg text-gray-700"><%= t("landing.stats.description") %></p>
            <div class="flex justify-center gap-16 mt-6">
                <div>
                    <p class="text-4xl font-bold text-green-700"><%= t("landing.stats.water.value") %></p>
                    <p class="text-gray-600"><%= t("landing.stats.water.label") %></p>
                </div>
                <div>
                    <p class="text-4xl font-bold text-green-500"><%= t("landing.stats.yield.value") %></p>
                    <p class="text-gray-600"><%= t("landing.stats.yield.label") %></p>
                </div>
                <div>
                    <p class="text-4xl font-bold text-blue-600"><%= t("landing.stats.labor.value") %></p>
                    <p class="text-gray-600"><%= t("landing.stats.labor.label") %></p>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-white py-10 mt-20 border-t border-gray-200">
        <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-4 gap-8 text-gray-700">
            <div>
                <div class="flex items-center space-x-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-cloud-cog text-gray-700">
                        <circle cx="12" cy="17" r="3"/>
                        <path d="M4.2 15.1A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.2"/>
                        <path d="m15.7 18.4-.9-.3"/>
                        <path d="m9.2 15.9-.9-.3"/>
                        <path d="m10.6 20.7.3-.9"/>
                        <path d="m13.1 14.2.3-.9"/>
                        <path d="m13.6 20.7-.4-1"/>
                        <path d="m10.8 14.3-.4-1"/>
                        <path d="m8.3 18.6 1-.4"/>
                        <path d="m14.7 15.8 1-.4"/>
                    </svg>
                    <span class="text-lg font-bold text-gray-900">AgriloT Synergy</span>
                </div>
                <p class="text-sm text-gray-600 mt-3">
                    <%= t("landing.footer.description") %>
                </p>
            </div>
<% ['platform', 'resources', 'company'].each do |section| %>
  <div>
    <h3 class="text-sm font-bold text-gray-900 uppercase"><%= t("landing.footer.sections.#{section}.title") %></h3>
    <ul class="mt-3 space-y-2 text-sm">
      <% t("landing.footer.sections.#{section}.links").each do |item| %>
        <li><a href="#" class="hover:text-green-600 transition"><%= item %></a></li>
      <% end %>
    </ul>
  </div>
<% end %>
        </div>

        <div class="border-t border-gray-200 mt-8 pt-6 text-center text-sm text-gray-600">
            <p><%= t("landing.footer.copyright") %></p>
        </div>
    </footer>
</body>
</html>
